<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="275588974610408078">Бұзылу туралы хабарлау мүмкіндігі Decentr қызметінде қолжетімді емес.</translation>
<translation id="3064346599913645280">Қауіпсіз Decentr бетін көрудесіз</translation>
<translation id="3255926992597692024">Decentr төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="358997566136285270">Decentr логотипі</translation>
<translation id="4050599136622776556">Decentr төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="4365115785552740256">Decentr қолданбасына <ph name="BEGIN_LINK_CHROMIUM" />Decentr<ph name="END_LINK_CHROMIUM" /> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS" />ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS" /> арқылы қол жеткізілді.</translation>
<translation id="4559775032954821361">"Decentr мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN параметрлері" тармағына өтіп,
          "LAN желіңіз үшін прокси серверді пайдалану" құсбелгісін алып тастаңыз.</translation>
<translation id="4622039161600275920">Бұл бетке Decentr тарапынан тыйым салынған.</translation>
<translation id="48558539577516920">Брандмауэр немесе антивирус параметрлерінде Decentr жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="580822234363523061">Decentr мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
           тармағына өтіп, конфигурацияңыз "проксисіз" немесе "тікелей" күйіне орнатылғандығын тексеріңіз.</translation>
<translation id="6549378540556750549">Сонымен қатар Decentr басқа <ph name="BEGIN_LINK_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6613594504749178791">Өзгертулеріңіз Decentr келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="7681937895330411637">Decentr браузері <ph name="BEGIN_LINK_CHROMIUM" />Decentr<ph name="END_LINK_CHROMIUM" /> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="7861509383340276692">Decentr мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION" />" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="8187289872471304532">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі &gt; Кеңейтілген &gt; Прокси серверлері" тармағына өтіп,
          таңдалған барлық прокси серверлерін таңдаудан алып тастаңыз.</translation>
<translation id="8597726643333341451">Қауіпсіз Decentr for Testing бетін көріп отырсыз.</translation>
<translation id="8684913864886094367">Decentr дұрыс өшірілмеді.</translation>
</translationbundle>