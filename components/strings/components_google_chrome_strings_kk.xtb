<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1016765312371154165">tomi дұрыс өшірілмеді.</translation>
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="1516530951338665275">Жұптауды жалғастыру үшін tomi-ға Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1635457557763038537">Өзгертулеріңіз tomi келесіде қайта іске қосылғанда күшіне енеді.</translation>
<translation id="2399868464369312507">tomi төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="2447485272386224171">tomi браузері <ph name="BEGIN_LINK_CHROMIUM" />tomi<ph name="END_LINK_CHROMIUM" /> ашық кодты бағдарлама жобасы мен басқа <ph name="BEGIN_LINK_OSS" />ашық кодты бағдарлама<ph name="END_LINK_OSS" /> негізінде жасалды.</translation>
<translation id="2588322182880276190">tomi логотипі</translation>
<translation id="3444832043240812445">Бұл бет <ph name="BEGIN_LINK" />жаңылыс туралы хабарлау<ph name="END_LINK" /> мүмкіндігін іске қоссаңыз, соңғы жаңылыстарыңыздағы ақпаратты ғана көрсетеді.</translation>
<translation id="3875312571075912821">Брандмауэр немесе антивирус параметрлерінде tomi жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="5005121315113832363">Бұл бетке tomi тарапынан тыйым салынған.</translation>
<translation id="6011049234605203654">tomi мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          тармағына өтіңіз және конфигурацияңыз "прокси жоқ" немесе "тікелей" күйіне орнатылғандығын тексеріңіз.</translation>
<translation id="6341737370356890233">tomi мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION" />" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, жүйенің жұмысын жақсарту үшін осы опцияны қайта таңдаған жөн.</translation>
<translation id="6855094794438142393">"tomi мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN параметрлері" тармағына өтіп,
          "LAN желісіне арналған прокси-серверді пайдалану" таңдауын алып тастаңыз.</translation>
<translation id="7230956101631259640">Қауіпсіз tomi бетін көрудесіз</translation>
<translation id="8187289872471304532">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі &gt; Кеңейтілген &gt; Прокси серверлері" тармағына өтіп,
          таңдалған барлық прокси серверлерін таңдаудан алып тастаңыз.</translation>
<translation id="8232971017369963250">tomi браузері <ph name="BEGIN_LINK_CHROMIUM" />tomi<ph name="END_LINK_CHROMIUM" /> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="8279509328145658601">Сонымен қатар tomi браузері басқа <ph name="BEGIN_LINK_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="8544217240017914508">tomi төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
</translationbundle>