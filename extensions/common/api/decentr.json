                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "set",
        "description": "Set value by key",
        "type": "function",
        "parameters": [
          {
            "name": "data",
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        ]
