<translation id="1674870198290878346">‏باز کردن پیوند در پنجره &amp;ناشناس tomi</translation>
<translation id="1682634494516646069">‏tomi نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1689338313606606627">‏‫tomi می‌تواند این برگه را غیرفعال کند تا تجربه مرور شما را بهبود بخشد و سرعت بالا را حفظ کند.</translation>
<translation id="1698376642261615901">‏‫tomi یک مرورگر وب است که برنامه‌های کاربردی و صفحات وب را در یک چشم به هم زدن اجرا و باز می‌کند. استفاده از آن سریع و آسان است و همیشه در دسترس است. با برنامه‌های حفاظت دربرابر رمزگیری و بدافزار تعبیه‌شده در tomi، وب را با امنیت بیشتر مرور کنید.</translation>
<translation id="1713301662689114961">{0,plural, =1{‏tomi یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏tomi # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏tomi # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="1722488837206509557">این کار به شما امکان می‌دهد از بین دستگاه‌های دردسترس انتخاب کنید و محتوا را در آن‌ها نمایش دهید.</translation>
<translation id="1734234790201236882">‏tomi این گذرواژه را در حساب tomi شما ذخیره می‌کند. لازم نیست آن را به خاطر بسپارید.</translation>
<translation id="1786003790898721085">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME" /> به سیستم tomi وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="1786044937610313874">‏میان‌برها در tomi باز می‌شود</translation>
<translation id="178701303897325119">‏دیگر از این افزونه پشتیبانی نمی‌شود. ‫tomi توصیه می‌کند آن را حذف کنید.</translation>
<translation id="1812689907177901597">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم tomi به سیستم سایت‌های tomi مانند Gmail وارد شوید</translation>
<translation id="1860536484129686729">‏tomi برای این سایت به مجوز دسترسی به دوربین نیاز دارد</translation>
<translation id="1873233029667955273">‏tomi مرورگر پیش‌فرض شما نیست</translation>
<translation id="1874309113135274312">‏tomi نسخه بتا (mDNS-In)</translation>
<translation id="1877026089748256423">‏نسخه tomi قدیمی است</translation>
<translation id="1907925560334657849">‏برای هم‌رسانی پنجره، «ضبط‌کن صفحه‌نمایش ویژه tomi» را در «اولویت‌های سیستم» مجاز کنید</translation>
