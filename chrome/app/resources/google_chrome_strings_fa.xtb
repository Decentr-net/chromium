<translation id="3718181793972440140">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم tomi شوید.</translation>
<translation id="3723744677043446310">{NUM_EXTENSIONS,plural, =1{‏‫tomi توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}one{‏‫tomi توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}other{‏‫tomi توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}}</translation>
<translation id="3744202345691150878">‏دریافت راهنمایی برای tomiOS</translation>
<translation id="3780814664026482060">tomi - <ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">‏به‌دلیل خطای ورود به سیستم، tomiOS Flex نتوانست داده‌هایتان را همگام‌سازی کند.</translation>
<translation id="3795971588916395511">tomiOS</translation>
<translation id="3809772425479558446">‏tomi به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="3835168907083856002">‏با این کار، نمایه tomi جدیدی برای <ph name="USER_EMAIL_ADDRESS" /> ایجاد خواهد شد</translation>
<translation id="383928141529488001">‏‫tomi برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="386202838227397562">‏لطفاً همه پنجره‌های tomi را ببندید و دوباره امتحان کنید.</translation>
<translation id="3865754807470779944">‏tomi نسخه <ph name="PRODUCT_VERSION" /> نصب شده است</translation>
<translation id="3873044882194371212">‏باز کردن پیوند در پنجره &amp;ناشناس tomi</translation>
<translation id="3889417619312448367">‏حذف نصب tomi</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="3973161977468201858">‏‫tomi می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="398236277091248993">‏‫tomi با ویژگی‌های تقویت‌کننده عملکرد سریع باقی می‌ماند</translation>
<translation id="3999683152997576765">‏می‌توانید موضوعات موردعلاقه را که سایت‌ها برای ارائه آگهی به شما استفاده می‌کنند ببینید یا حذف کنید. tomi علایق شما را براساس سابقه مرور اخیرتان تخمین می‌زند.</translation>
<translation id="4035053306113201399">‏برای اعمال به‌روزرسانی، tomiOS باید بازراه‌اندازی شود.</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4053720452172726777">‏‫سفارشی کردن و کنترل tomi</translation>
<translation id="408393047846373801">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم tomi وارد شوید بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب tomi» شما ذخیره خواهد شد.</translation>
<translation id="4084404300720192944">‏برای هم‌رسانی پنجره، «ضبط‌کن صفحه‌نمایش ویژه tomi» را در «اولویت‌های سیستم» مجاز کنید.</translation>
<translation id="4106587138345390261">‏tomi درحال کاوش ویژگی‌های جدیدی است که به سایت‌های امکان می‌دهد تجربه مرور یکسانی را با مصرف اطلاعات شخصی کمتر ارائه دهند</translation>
<translation id="4110895483821904099">‏راه‌اندازی نمایه tomi جدید</translation>
<translation id="4111566860456076004">‏‫tomi نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از tomi حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="4128488089242627000">‏tomi سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند (توصیه می‌شود)</translation>
<translation id="4147555960264124640">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه tomi خود را می‌دهید. داده‌های tomi شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های tomi حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">در حال نصب...</translation>
<translation id="4149882025268051530">‏نصب‌کننده در خارج کردن آرشیو از حالت فشرده ناموفق بود. لطفاً دوباره tomi را بارگیری کنید.</translation>
<translation id="4153934450158521343">‏tomi به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="4173512894976930765">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های tomi را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم tomi وارد شده باشید از «حساب tomi» خارج نخواهید شد.</translation>
<translation id="4175922240926474352">‏‫tomi این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="4191857738314598978">{0,plural, =1{‏tomi را ظرف یک روز راه‌اندازی مجدد کنید}one{‏tomi را ظرف # روز راه‌اندازی مجدد کنید}other{‏tomi را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="4205939740494406371">‏tomi نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید یا <ph name="BEGIN_LINK" />گذرواژه‌ها را در «حساب tomi» خود بررسی کنید<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="4242034826641750751">‏tomi برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="424864128008805179">‏از سیستم tomi خارج می شوید؟</translation>
<translation id="4251615635259297716">‏داده‌های tomi شما به این حساب مرتبط شوند؟</translation>
<translation id="4262915912852657291">‏<ph name="BEGIN_BOLD" />انواع داده‌ای که استفاده می‌شود:<ph name="END_BOLD" /> سابقه مرور شما، سابقه سایت‌هایی که بااستفاده از tomi در این دستگاه از آن‌ها بازدید کرده‌اید.</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="4293420128516039005">‏برای همگام‌سازی و شخصی‌سازی tomi در همه دستگاه‌هایتان، به سیستم وارد شوید</translation>
<translation id="430327780270213103">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار tomi</translation>
<translation id="4328355335528187361">‏tomi نسخه Dev‏، (mDNS-In)</translation>
<translation id="4329315893554541805">‏برای دریافت شخصی‌سازی و ویژگی‌های دیگر، tomi را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده tomi اضافه کنید</translation>
<translation id="4334294535648607276">بارگیری کامل شد.</translation>
<translation id="4335235004908507846">‏tomi می‌تواند به ایمن ماندن شما دربرابر نقض داده، افزونه‌های مخرب، و خطرهای دیگر کمک کند</translation>
<translation id="4343195214584226067">‏<ph name="EXTENSION_NAME" /> به tomi اضافه شده است</translation>
<translation id="4348548358339558429">‏برای دریافت شخصی‌سازی، tomi را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="436060642166082913">‏‫tomi این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما آسیب برساند</translation>
<translation id="4384570495110188418">‏چون به سیستم وارد نشده‌اید، tomi نمی‌تواند گذرواژه‌هایتان را بررسی کند</translation>
<translation id="4389991535395284064">‏هنگام مرور «درحالت ناشناس»، tomi قبل‌از اینکه سایت را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438657683599538446">‏ورود به سیستم tomi با <ph name="USER_EMAIL" /></translation>
<translation id="4450664632294415862">‏tomi - ورود به سیستم شبکه - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">‏عملکرد دیگری در tomi درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="4459234553906210702">‏سنجش آگهی به سایت‌هایی که بازدید می‌کنید اجازه می‌دهد اطلاعاتی را از tomi درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="4567424176335768812">با حساب <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم شده‌اید. اکنون در همه دستگاه‌هایی که با آنها به سیستم وارد شده‌اید می‌توانید به نشانک‌ها، سابقه و دیگر تنظیماتتان دسترسی داشته باشید.</translation>
<translation id="4571503333518166079">‏رفتن به تنظیمات اعلان tomi</translation>
<translation id="4575717501879784448">‏‫tomi می‌تواند این برگه‌ها را غیرفعال کند تا تجربه مرور شما را بهبود بخشد و منابع را آزاد کند.</translation>
<translation id="459622048091363950">‏وقتی tomi دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="4600710005438004015">‏tomi به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="4624065194742029982">‏حالت ناشناس tomi</translation>
<translation id="4627412468266359539">‏اختیاری: با ارسال خودکار داده‌های عیب‌یابی و داده‌های استفاده به tomi، به بهبود ویژگی‌ها و عملکرد tomiOS Flex کمک کنید.</translation>
<translation id="4633000520311261472">‏برای ایمن‌تر کردن tomi، برخی از افزونه‌هایی را که در<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="469553575393225953">‏افزونه‌ها، برنامه‌ها، و زمینه‌های دریافتی از منابع ناشناخته می‌توانند به دستگاهتان آسیب برسانند. tomi توصیه می‌کند آن‌ها را فقط از «نت‌بازار tomi» نصب کنید</translation>
<translation id="4710245680469034439">مرورگرتان را با زمینه‌های الهام‌گرفته از طبیعت، مجموعه هنرمندان، و غیره شخصی‌سازی کنید</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="4728575227883772061">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر tomi در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="4747730611090640388">‏tomi می‌تواند علایقتان را برآورد کند.  بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از tomi بخواهد علایق شما را ببیند.</translation>
<translation id="4754614261631455953">‏tomi Canary (ورودی mDNS)</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی tomi استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای tomi ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4793679854893018356">‏ببینید tomi چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="4828579605166583682">‏tomi می‌خواهد گذرواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="4842397268809523050">‏tomiOS Flex نتوانست داده‌هایتان را همگام‌سازی کند زیرا همگام‌سازی برای دامنه شما دردسترس نیست.</translation>
<translation id="4851866215237571846">‏‫<ph name="EXISTING_USER" /> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم tomi وارد شوید.</translation>
<translation id="4862446263930606916">‏سازمان شما می‌تواند داده‌های مرور نمایه کاری شما را (مثلاً نشانک‌ها، سابقه، و گذرواژه‌های شما) ببیند و مدیریت کند. سازمانتان نمی‌تواند داده‌های مرور نمایه‌های شخصی tomi را ببیند.</translation>
<translation id="4873692836499071887">‏برای دریافت به‌روزرسانی‌های بعدی tomi، باید macOS نسخه ۱۱ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۰.۱۵ استفاده می‌کند.</translation>
<translation id="4873783916118289636">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در tomi</translation>
<translation id="4891791193823137474">‏اجازه به tomi برای اجرا در پس‌زمینه</translation>
<translation id="4895437082222824641">‏باز کردن پیوند در &amp;برگه جدید tomi</translation>
<translation id="492720062778050435">‏tomi توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="4951177103388687412">با کمک گروه‌های برگه، منظم و متمرکز بمانید</translation>
<translation id="4953650215774548573">‏تنظیم tomi به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="495931528404527476">‏در tomi</translation>
<translation id="4969674060580488087">‏tomiOS Flex نتوانست داده‌هایتان را همگام‌سازی کند زیرا جزئیات ورود به سیستم حسابتان به‌روز نیست.</translation>
<translation id="4970761609246024540">‏به نمایه‌های tomi خوش‌آمدید</translation>
<translation id="4970880042055371251">‏نسخه tomiOS</translation>
<translation id="4990567037958725628">tomi Canary</translation>
<translation id="4997044641749333913">‏‫tomi می‌تواند این برگه‌ها را غیرفعال کند تا تجربه مرور شما را بهبود بخشد و سرعت بالا را حفظ کند.</translation>
<translation id="5003967926796347400">‏روی «مدیر گذرواژه tomi» کلیک کنید</translation>
<translation id="5120334927898581447">‏ورود به سیستم tomi هنگام وارد شدن به سیستم دیگر سرویس‌های tomi</translation>
<translation id="5126049312684316860">‏tomi صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بار شوند</translation>
<translation id="5132929315877954718">‏برنامه‌های کاربردی، بازی‌ها، افزونه‌ها و طرح‌های زمینه فوق‌العاده را برای tomi کاوش کنید.</translation>
<translation id="5139423532931106058">‏سفارشی کردن نمایه tomi</translation>
<translation id="5161361450770099246">‏‫tomi می‌تواند این برگه را غیرفعال کند تا تجربه مرور شما را بهبود بخشد و منابع را آزاد کند.</translation>
<translation id="5163087008893166964">‏به tomi خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="5170938038195470297">‏نمایهٔ شما نمی‌تواند استفاده شود زیرا مربوط به یک نسخه جدیدتر از tomi است. بعضی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک مسیر دیگر برای نمایه تعیین کنید یا از نسخه جدیدتر tomi استفاده کنید.</translation>
<translation id="5201744974236816379">‏به‌روزرسانی tomi</translation>
<translation id="521447420733633466">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و tomi را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="5239627039202700673">‏از tomi برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="5251420635869119124">‏مهمان‌‌ها می‌توانند از tomi استفاده کنند بدون اینکه اثری از خود به جا بگذارند.</translation>
<translation id="5320351714793324716">‏اگر کوکی‌ها را مجاز کنید، ممکن است tomi از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="5334309298019785904">‏tomiOS نتوانست داده‌هایتان را همگام‌سازی کند، زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="5334487786912937552">‏tomi برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="5337648990166757586">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به tomi، به بهبود ویژگی‌ها و عملکرد tomiOS کمک کنید.</translation>
<translation id="5357889879764279201">‏دریافت راهنمایی دررابطه با tomiOS Flex</translation>
<translation id="5368118228313795342">کد اضافی: <ph name="EXTRA_CODE" />.</translation>
<translation id="5386244825306882791">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی tomi یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="5394833366792865639">‏هم‌رسانی برگه tomi</translation>
<translation id="5412485296464121825">‏سایت‌ها می‌توانند بااستفاده از tomi اطلاعاتی درباره علایقتان ذخیره کنند. برای مثال، اگر برای خرید کفش مخصوص ماراتون از سایتی بازدید کنید، ممکن است آن سایت علاقه شما را به‌صورت دونده ماراتون مشخص کند. بعداً، اگر برای ثبت‌نام در مسابقه‌ای به سایتی دیگر مراجعه کردید، آن سایت می‌تواند براساس علایقتان آگهی‌ای برای کفش مخصوص دویدن به شما نشان دهد.</translation>
<translation id="5430073640787465221">‏فایل اولویت‌های شما خراب یا نامعتبر است. tomi نمی‌تواند تنظیمات شما را بازیابی کند.</translation>
<translation id="5468572406162360320">‏برای کمک به بهبود این ویژگی‌ها، tomi تعاملات شما با این ویژگی‌ها را به tomi ارسال می‌کند. ممکن است افراد بازبین این داده‌ها را بخوانند، و پردازش و حاشیه‌نویسی کنند.</translation>
<translation id="5524761631371622910">‏اگر نسخه آزمایشی روشن باشد و tomi به‌طور تصادفی نسخه آزمایشی را برایتان فعال کرده باشد، سابقه مرورتان بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، tomi علایقتان را هر ماه به‌طور چرخشی حذف می‌کند.</translation>
<translation id="5530733413481476019">‏سرعت tomi را افزایش دهید</translation>
<translation id="5566025111015594046">‏tomi (ورودی mDNS)</translation>
<translation id="5602351063754773347">‏‫tomi توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="5648328599815354043">‏‫tomi کارهای بیشتری برای حفظ ایمنی شما در فضای آنلاین انجام می‌دهد</translation>
<translation id="565744775970812598">‏<ph name="FILE_NAME" /> ممکن است خطرناک باشد، بنابراین tomi آن را مسدود کرده است.</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، tomi را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، tomi را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، tomi را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، tomi را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="5686916850681061684">‏tomi ‫را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="5690427481109656848">tomi LLC</translation>
<translation id="569897634095159764">اتصال به اینترنت برقرار نشد. سرور پروکسی به اصالت‌سنجی نیاز دارد.</translation>
<translation id="570005089986962444">‏وقتی روشن باشد، tomi حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌ها و سایر برنامه‌ها اختصاص داده می‌شود و سرعت tomi حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند.</translation>
<translation id="5709557627224531708">‏تنظیم tomi به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="5727531838415286053">‏اگر tomi به‌طور تصادفی نسخه آزمایشی را برایتان فعال کرده باشد، سابقه مرورتان بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، tomi علایقتان را هر ماه به‌طور چرخشی حذف می‌کند. ممکن است علایق بازآوری شود، مگر اینکه آن‌ها را بردارید.</translation>
<translation id="5736850870166430177">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، tomi ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه، به «مرور ایمن» ارسال کند</translation>
