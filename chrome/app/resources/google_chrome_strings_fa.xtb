<translation id="2401189691232800402">‏سیستم tomiOS</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه tomi به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه tomi به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه tomi به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه tomi به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="2424440923901031101">‏این افزونه خط‌مشی «نت‌بازار tomi» را نقض می‌کند و ممکن است ناامن باشد. آن را از tomi حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2467438592969358367">‏tomi می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2472092250898121027">‏این افزونه حاوی بدافزار است و ناامن است. آن را از tomi حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="2513154137948333830">بازراه‌اندازی لازم است: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">‏برای محافظت از داده‌هایتان، به tomi اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="2556847002339236023">‏اگر <ph name="TIMEOUT_DURATION" /> از tomi استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="2559253115192232574">‏بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از tomi بخواهد علایق شما را ببیند. tomi می‌تواند حداکثر ۳ علاقه را هم‌رسانی کند.</translation>
<translation id="2563121210305478421">‏tomi راه‌اندازی مجدد شود؟</translation>
<translation id="2569974318947988067">‏tomi سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="2571392474191184472">‏سازمان شما tomi را مدیریت می‌کند</translation>
<translation id="2574930892358684005">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه tomi وارد شده است. برای جدا نگه داشتن مرور، tomi می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="2580411288591421699">‏نمی‌توان همان نسخه tomi را که اکنون در حال اجراست نصب کرد. لطفاً tomi را ببندید و دوباره سعی کنید.</translation>
<translation id="2586406160782125153">‏این کار داده‌های محصول مرورتان را برای همیشه از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم tomi شوید.</translation>
<translation id="2597976513418770460">‏داده‌های مرورگر tomi را از <ph name="ACCOUNT_EMAIL" /> دریافت کنید</translation>
<translation id="259935314519650377">نصب‌کننده بارگیری‌شده در حافظه نهان ذخیره نشد. خطا: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2622559029861875898">‏tomi نمی‌تواند به‌روزرسانی‌ها را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
