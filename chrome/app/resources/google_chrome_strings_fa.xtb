<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME" /></translation>
<translation id="7606334485649076285">tomiOS Flex</translation>
<translation id="7626032353295482388">‏به tomi خوش آمدید</translation>
<translation id="7626072681686626474">‏<ph name="MANAGER" /> لازم می‌داند که شما «شرایط خدمات» زیر را قبل‌از استفاده از دستگاه بخوانید و بپذیرید. این شرایط بسط داده نمی‌شود، اصلاح نمی‌شود، یا «شرایط tomiOS» را محدود نمی‌کند.</translation>
<translation id="7629695634924605473">‏tomi می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="7641148173327520642">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME" /> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME" />، tomi را پیکربندی کرده است.</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="7651907282515937834">‏نشان‌واره tomi Enterprise</translation>
<translation id="76531479118467370">‏‫tomi این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="7655455401911432608">‏سابقه مرور شما، سابقه سایت‌هایی که بااستفاده از tomi در این دستگاه از آن‌ها بازدید کرده‌اید.</translation>
<translation id="7655472416356262023">‏برداشتن حساب از tomi</translation>
<translation id="7661924425853052955">‏اخیراً بازدیدی نداشته‌اید. ‫tomi ‏<ph name="PERMISSION_1" />،‏ <ph name="PERMISSION_2" />،‏ و <ph name="COUNT" /> مورد دیگر را برداشت</translation>
<translation id="7668816516367091728">کارهایی مثل ترجمه، محاسبه، و غیره را مستقیماً از نوار نشانی انجام دهید</translation>
<translation id="7670287553302121848">‏حساب tomi به اصالت‌سنجی مجدد نیاز دارد</translation>
<translation id="769538538642757151">‏اگر موردی نیاز به بررسی داشته باشد، tomi به شما اطلاع می‌دهد</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="7761834446675418963">‏برای باز کردن tomi و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="7763983146198734674">گذرواژه‌هایتان را ذخیره کنید و درحین حرکت به آن‌ها دسترسی داشته باشید</translation>
<translation id="7777080907402804672">‏اگر تصویری توضیح مفیدی نداشته باشد، tomi توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به tomi ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="778331955594035129">‏tomi برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="7785741298021097183">‏‫tomi به‌گونه‌ای طراحی شده است تا در همه دستگاه‌هایتان (از تلفن تا رایانه) سریع و ایمن باشد.</translation>
<translation id="7787950393032327779">‏ظاهراً نمایه توسط فرآیند tomi دیگری (<ph name="PROCESS_ID" />) در رایانه‌ای دیگر (<ph name="HOST_NAME" />) در حال استفاده است. tomi نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرآیندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و tomi را مجدداً راه‌اندازی نمایید.</translation>
<translation id="7801699035218095297">‏tomi می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="7802622118583152311">‏‫tomi جدیدترین فناوری را برای مرور بهتر دراختیارتان قرار می‌دهد</translation>
<translation id="7808348361785373670">‏حذف از tomi...</translation>
<translation id="7825851276765848807">‏بدلیل خطای نامشخص، نصب ناموفق بود. لطفاً دوباره tomi را بارگیری کنید.</translation>
<translation id="7836610565365456468">ظاهر مرورگرتان را با زمینه‌های زنده‌ای که از هنرمندان، طبیعت، و موارد دیگر الهام گرفته‌اند تغییر دهید</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="7852254990718225089">‏هوش مصنوعی در tomi به افزایش سرعت، ایمنی، و دسترس‌پذیری وب کمک می‌کند</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS" /> ثانیه باقی مانده است</translation>
<translation id="7880591377632733558">‏به tomi خوش آمدید، <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="7890208801193284374">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و tomi را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="7896673875602241923">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST" /> به سیستم tomi در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر tomi جدیدی ایجاد کنید.</translation>
<translation id="7917876797003313048">‏می‌توانید «حساب‌های tomi» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های tomi» شما در مرورگر tomi، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE" /> خود اضافه کنید. <ph name="LINK_BEGIN" />بیشتر بدانید<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">‏‫tomi این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="7947083960301164556">مشاهده ویژگی‌های جدید</translation>
<translation id="7951272445806340501">‏برای اعمال به‌روزرسانی، tomiOS Flex باید بازراه‌اندازی شود.</translation>
<translation id="7959172989483770734">‏مدیریت نمایه‌های tomi</translation>
<translation id="7962368738413920945">‏سایت‌ها احتمالاً عملکردی مطابق انتظار شما خواهند داشت اما بعداز بسته شدن همه پنجره‌های tomi، شما را به‌یاد نخواهند داشت</translation>
<translation id="7962410387636238736">‏این رایانه دیگر به‌روزرسانی‌های tomi را دریافت نمی‌کند زیرا Windows XP و Windows Vista دیگر پشتیبانی نمی‌شوند</translation>
<translation id="8005666035647241369">‏به «مدیر گذرواژه tomi» در این دستگاه</translation>
<translation id="8008534537613507642">‏نصب مجدد tomi</translation>
<translation id="8009904340233602924">‏استفاده از tomi بدون حساب</translation>
<translation id="8013993649590906847">‏اگر تصویری توضیح مفیدی نداشته باشد، tomi توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به tomi ارسال می‌شود.</translation>
<translation id="8019103195866286235">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از tomi حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="8040768861829554732">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم tomi وارد شوید</translation>
<translation id="80471789339884597">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید همه مرورگرها را بازراه‌اندازی کنید.</translation>
<translation id="8064015041956107954">‏می‌توانید نشانک‌ها، حالت مطالعه، و موارد دیگر را از منوِ tomi در بالا سمت چپ باز کنید</translation>
<translation id="8064015586118426197">tomiOS Flex</translation>
<translation id="8077579734294125741">‏دیگر نمایه‌های tomi</translation>
<translation id="8086881907087796310">نصب انجام نشد زیرا رایانه شما با حداقل شرایط سخت‌افزاری مطابقت ندارد.</translation>
<translation id="8111297389482307122">‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب tomi» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، tomi باید هویت شما را تأیید کند. اگر از سیستم خارج شوید، این داده‌ها در این دستگاه باقی خواهد ماند.</translation>
<translation id="8129812357326543296">‏درباره &amp;tomi</translation>
<translation id="813913629614996137">درحال مقداردهی اولیه…</translation>
<translation id="8162006532256575008">‏استفاده از tomi بدون حساب</translation>
<translation id="8255190535488645436">‏tomi درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="8257796129973882597">‏می‌توانید نشانک‌ها، حالت مطالعه، و موارد دیگر را از منوِ tomi باز کنید</translation>
<translation id="8267953129876836456">‏tomi چند توصیه ایمنی برای بررسی پیدا کرد</translation>
<translation id="8270775718612349140">‏گواهینامه‌های تحت‌مدیریت tomi</translation>
<translation id="8286862437124483331">‏tomi در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8290100596633877290">‏اوه! tomi با اشکال مواجه شده است. دوباره راه‌اندازی شود؟</translation>
<translation id="829923460755755423">‏میان‌بری به «مدیر گذرواژه tomi» اضافه کنید</translation>
<translation id="8336463659890584292">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌کند، tomi از سرورهای tomi استفاده می‌کند. با این کار هویتتان از سایت پیش‌بارگیری‌شده پنهان می‌شود، اما tomi متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="8342675569599923794">‏این فایل خطرناک است، بنابراین tomi آن را مسدود کرده است.</translation>
<translation id="8349795646647783032">‏<ph name="BEGIN_BOLD" />نحوه استفاده ما از این داده‌ها:<ph name="END_BOLD" /> سایت‌ها می‌توانند بااستفاده از tomi اطلاعاتی درباره علایقتان ذخیره کنند. برای مثال، اگر برای خرید کفش مخصوص ماراتون از سایتی بازدید کنید، ممکن است آن سایت علاقه شما را به‌صورت دونده ماراتون مشخص کند. بعداً، اگر برای ثبت‌نام در مسابقه‌ای به سایتی دیگر مراجعه کردید، آن سایت می‌تواند براساس علایقتان آگهی‌ای برای کفش مخصوص دویدن به شما نشان دهد.</translation>
<translation id="8370517070665726704">‏حق نشر <ph name="YEAR" /> tomi LLC.‎ کلیه حقوق محفوظ است.</translation>
<translation id="8383226135083126309">‏<ph name="BEGIN_BOLD" />نحوه استفاده ما از این داده‌ها:<ph name="END_BOLD" /> tomi می‌تواند علایق شما را برآورد کند. بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از tomi بخواهد علایق شما را ببیند.</translation>
<translation id="8387459386171870978">‏ادامه استفاده از tomi</translation>
<translation id="8394720698884623075">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در tomi ذخیره شده است مقایسه می‌کند</translation>
<translation id="8403038600646341038">‏نشان‌واره tomi درون صفحه‌نمایش رایانه.</translation>
<translation id="8416347857511542594">‏درباره شخصی‌سازی آگهی در tomi بیشتر بدانید</translation>
<translation id="8418845734693287262">‏tomiOS نتوانست داده‌هایتان را همگام‌سازی کند، چون جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="842386925677997438">‏ابزارهای ایمنی tomi</translation>
<translation id="8428213095426709021">تنظیمات</translation>
<translation id="8433638294851456451">‏برای ارسال شماره از اینجا به تلفن Android خود، در هر دو دستگاه به سیستم tomi وارد شوید.</translation>
<translation id="8451192282033883849">‏<ph name="MANAGER_NAME" /> حساب شما را مدیریت می‌کند. سرپرست شما می‌تواند این نمایه مرورگر tomi و داده‌های آن را (مانند نشانک‌ها، سابقه، و گذرواژه‌ها) ببیند و ویرایش کند.</translation>
<translation id="8496177819998570653">‏مدیر گذرواژه tomi</translation>
<translation id="8498858610309223613">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای tomi اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="8516431725144212809">‏علایق شما به‌طوری‌که tomi برآورد کرده است</translation>
<translation id="8521348052903287641">‏قانون ترافیک ورودی tomi نسخه Dev برای امکان دادن به ترافیک mDNS.</translation>
<translation id="8550334526674375523">این نمایه کاری کاملاً مجزا از نمایه شخصی‌تان است.</translation>
<translation id="8555465886620020932">خطای سرویس: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8571790202382503603">‏با نمایه‌های tomi می‌توانید همه‌چیزتان را در tomi جدا کنید. با این کار، راحت‌تر می‌توان کار و سرگرمی را ازهم جدا کرد.</translation>
<translation id="8614913330719544658">‏tomi پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="861702415419836452">‏tomi برای دسترسی به دوربین به اجازه نیاز دارد تا بتواند نقشه سه‌بعدی محیط شما را ایجاد کند</translation>
<translation id="8625237574518804553">{0,plural, =1{‏tomi ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏tomi ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏tomi ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="8641606876632989680">‏وقتی با گذرواژه‌ای لورفته به سیستم وارد شوید، tomi به شما اطلاع می‌دهد</translation>
<translation id="8649026945479135076">‏امری عادی است که سایت‌هایی که بازدید می‌کنید برای شخصی کردن تجربه‌تان، علایق شما را به‌خاطر آورند. به‌علاوه، سایت‌ها می‌توانند بااستفاده از tomi اطلاعاتی درباره علایقتان ذخیره کنند.</translation>
<translation id="8669527147644353129">‏راهنمای tomi</translation>
<translation id="8679801911857917785">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی tomi نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="8686817260976772516">‏با نمایه‌های tomi می‌توانید همه چیزتان را در tomi جدا کنید. برای دوستان و اعضای خانواده‌تان نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="8712767363896337380">‏تقریباً به‌روزرسانی شده است! برای تکمیل به‌روزرسانی، tomi را راه‌اندازی مجدد کنید.</translation>
<translation id="8718062187489036808">‏ثبت خروج از tomi</translation>
<translation id="873133009373065397">‏tomi نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="8765470054473112089">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، tomi آنچه تایپ می‌کنید را به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادهای بهتری دریافت کند. این ویژگی در «حالت ناشناس» خاموش است.</translation>
<translation id="8781673607513845160">‏برای استفاده از دوربین، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به tomi دسترسی دهید</translation>
<translation id="878572486461146056">خطای نصب: سرپرست شبکه شما «خط‌مشی گروهی» اعمال کرده است که از نصب جلوگیری می‌کند: <ph name="INSTALL_ERROR" /></translation>
<translation id="8796073561259064743">‏‫tomi این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما ازجمله <ph name="USER_EMAIL" /> آسیب برساند</translation>
<translation id="8797423385604279835">برگه‌هایتان را با کمک هوش مصنوعی سازمان‌دهی کنید</translation>
<translation id="8801657293260363985">‏V8 موتور WebAssembly و جاوا اسکریپت tomi است که از آن برای بهبود عملکرد سایت استفاده می‌شود</translation>
<translation id="8821043148920470810">‏برای دریافت به‌روزرسانی‌های آتی tomi، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="8823341990149967727">‏نسخه tomi قدیمی است</translation>
<translation id="8825634023950448068">‏برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشند به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. و اگر tomi به‌اشتباه علاقه‌ای را اضافه کند یا شما نخواهید آگهی‌های مشخصی را ببینید، می‌توانید آن علاقه را بردارید.</translation>
<translation id="8834965163890861871">‏tomi می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8843389967774722327">‏‫tomi به‌طور مرتب ویژگی‌های جدیدی برای کمک به شما در انجام کارها اضافه می‌کند</translation>
<translation id="8851180723659088381">{NUM_EXTENSIONS,plural, =1{‏tomi توصیه می‌کند آن را بردارید}one{‏tomi توصیه می‌کند آن را بردارید}other{‏tomi توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="8908277254462331033">مشاهده ویژگی‌های ایمنی</translation>
<translation id="8914504000324227558">‏راه‌اندازی مجدد tomi</translation>
<translation id="8922193594870374009">‏برای ارسال شماره از <ph name="ORIGIN" /> به تلفن Android خود، در هر دو دستگاه به سیستم tomi وارد شوید.</translation>
<translation id="8948460679427074738">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫tomi توصیه می‌کند آن را حذف کنید.</translation>
<translation id="8986207147630327271">با این کار، نمایه کاری را به این مرورگر اضافه می‌کنید و فقط کنترل نمایه کاری را دراختیار سرپرست قرار می‌دهید.</translation>
<translation id="8989968390305463310">‏سابقه مرور شما بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، tomi علایقتان را هر ماه به‌طور خودکار و چرخشی حذف می‌کند. ممکن است علایق بازآوری شود، مگر اینکه آن‌ها را بردارید.</translation>
<translation id="8999117580775242387">‏وقتی HTTPS دردسترس نباشد، tomi بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="8999208279178790196">{0,plural, =0{‏به‌روزرسانی tomi دردسترس است}=1{‏به‌روزرسانی tomi دردسترس است}one{‏به‌روزرسانی tomi از # روز پیش دردسترس است}other{‏به‌روزرسانی tomi از # روز پیش دردسترس است}}</translation>
<translation id="9014771989710951291">‏چندین سازمان tomi را مدیریت می‌کنند</translation>
<translation id="9024318700713112071">‏تنظیم tomi به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="9053892488859122171">‏سیستم tomiOS Flex</translation>
<translation id="9090566250983691233">‏ببینید چرا tomi برخی‌از فایل‌ها را مسدود می‌کند</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="9138603949443464873">‏برای اعمال تغییراتتان، tomi را راه‌اندازی مجدد کنید</translation>
<translation id="9195993889682885387">‏tomi می‌توانند علایقتان را براساس سابقه مرور چند هفته گذشته برآورد کند. این اطلاعات از دستگاهتان خارج نمی‌شود.</translation>
<translation id="919706545465235479">‏به‌روزرسانی tomi برای شروع همگام‌سازی</translation>
<translation id="922152298093051471">‏سفارشی‌سازی tomi</translation>
<translation id="92460355979482493">‏وقتی روشن باشد، tomi صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو سریع‌تر شود.</translation>
<translation id="93760716455950538">‏بازراه‌اندازی tomiOS Flex</translation>
<translation id="940313311831216333">‏برای دسترسی به چیزهای tomi در همه دستگاه‌هایتان، به سیستم وارد شوید، سپس همگام‌سازی را روشن کنید.</translation>
<translation id="943390475793766444">‏tomi توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="963650557422347554">‏وقتی روشن باشد، tomi با محدود کردن فعالیت پس‌زمینه و جلوه‌های بصری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند.</translation>
<translation id="983803489796659991">نصب انجام نشد چون سرور به‌روزرسانی هیچ‌گونه داده درهمی برای برنامه ندارد.</translation>
<translation id="989369509083708165">‏tomi مرورگر پیش‌فرضتان است</translation>
<translation id="989816563149873169">‏با <ph name="SHORTCUT" /> می‌توانید بین نمایه‌های tomi جابه‌جا شوید</translation>
</translationbundle>