<translation id="7099479769133613710">‏راه‌اندازی مجدد برای به‌روزرسانی tomiOS</translation>
<translation id="7100085796996987445">‏برای هم‌رسانی صفحه‌نمایش، «ضبط‌کن صفحه‌نمایش ویژه tomi» را در «اولویت‌های سیستم» مجاز کنید</translation>
<translation id="7106741999175697885">‏مدیر وظایف - tomi</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7155997830309522122">‏در این صورت، لطفاً گذرواژه ذخیره‌شده در tomi را ویرایش کنید تا با گذرواژه جدیدتان مطابقت داشته باشد.</translation>
<translation id="7161904924553537242">‏به tomi خوش آمدید</translation>
<translation id="7177959540995930968">‏در تنظیمات tomi می‌توانید اطلاعات بیشتری درباره این ویژگی‌ها کسب کنید.</translation>
<translation id="7193885263065350793">‏اگر <ph name="TIMEOUT_DURATION" /> از tomi استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="7242029209006116544">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه tomi خود را می‌دهید. داده‌های tomi شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های tomi حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های tomi موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE" /></translation>
<translation id="7285616922384953075">‏‫<ph name="MANAGER" /> ‏tomi را مدیریت می‌کند</translation>
<translation id="7295052994004373688">‏از این زبان برای نمایش واسط کاربر tomi استفاده می‌شود</translation>
<translation id="7296210096911315575">اطلاعات مهم درباره استفاده و ایمنی</translation>
<translation id="7302361266603927550">‏برخی‌از داده‌های tomi هنوز در «حساب tomi» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="7308322188646931570">‏tomi برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="7339898014177206373">پنجرهٔ جدید</translation>
<translation id="7352881504289275361">‏«مرور ایمن پیشرفته» قدرتمندترین محافظت آنلاین tomi را برای حفظ ایمنی شما هنگام مرور کردن ارائه می‌دهد</translation>
<translation id="7394745511930161845">مضمون خودتان را با هوش مصنوعی ایجاد کنید تا ظاهری منحصربه‌فرد به مرورگرتان بدهید</translation>
<translation id="7398801000654795464">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم tomi شدید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="7412494426921990001">‏روی منوی tomi کلیک کنید</translation>
<translation id="742463671275348370">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه tomi به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه tomi به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه tomi به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه tomi به # دستگاه USB دسترسی دارند}}</translation>
<translation id="7426611252293106642">‏tomi ممکن است درست کار نکند زیرا این توزیع Linux دیگر از آن پشتیبانی نمی‌کند.</translation>
<translation id="7437998757836447326">‏خروج از سیستم tomi</translation>
<translation id="7449333426561673451">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از tomi استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}one{‏اگر به‌مدت # دقیقه از tomi استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}other{‏اگر به‌مدت # دقیقه از tomi استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}}</translation>
<translation id="7452987490177144319">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از tomi استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از tomi استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از tomi استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="7477130805345743099">‏tomi قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="7481213027396403996">‏دریافت قوی‌ترین امنیت tomi</translation>
<translation id="749228101751499733">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب tomi» خود در tomi استفاده کنید. ‫<ph name="SHORTCUT" /> می‌تواند تنظیمات سرویس‌های tomi را تغییر دهد.</translation>
<translation id="7535429826459677826">‏tomi نسخه Dev</translation>
