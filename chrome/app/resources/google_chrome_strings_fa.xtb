<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE" /> دقیقه باقی مانده است</translation>
<translation id="1982647487457769627">‏‫tomi در همه پلاتفرم‌ها کار می‌کند تا صرف‌نظر از دستگاهی که استفاده می‌کند تجربه آشنایی به شما ارائه دهد</translation>
<translation id="2001586581944147178">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫tomi برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{‏دیگر از این افزونه پشتیبانی نمی‌شود. ‫tomi توصیه می‌کند آن را حذف کنید.}one{‏دیگر از این افزونه‌ها پشتیبانی نمی‌شود. ‫tomi توصیه می‌کند آن را حذف کنید.}other{‏دیگر از این افزونه‌ها پشتیبانی نمی‌شود. ‫tomi توصیه می‌کند آن را حذف کنید.}}</translation>
<translation id="2018528049276128029">‏هرکدام از نمایه‌های tomi دارای اطلاعات مختص خودش است (مثل نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2022471217832964798">‏اکنون که درحال راه‌اندازی دسترسی به حساب هستیم، می‌توانید همچنان از tomi استفاده کنید. ممکن است نتوانید تا زمان تکمیل راه‌اندازی به برخی منابع دسترسی پیدا کنید.</translation>
<translation id="2034233344106846793">‏‫tomi اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="207902854391093810">‏وقتی نسخه آزمایشی روشن باشد، «سنجش آگهی» به سایت‌هایی که بازدید می‌کنید اجازه می‌دهد اطلاعاتی را از tomi درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="2091012649849228750">‏برای دریافت به‌روزرسانی‌های آتی tomi، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
