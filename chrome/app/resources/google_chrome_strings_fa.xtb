<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1001534784610492198">‏آرشیو نصب‌کننده خراب یا نامعتبر است. لطفاً دوباره Decentr را بارگیری کنید.</translation>
<translation id="1018937009655463387">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Decentr مجاز کنید.</translation>
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="102763973188675173">‏سفارشی کردن و کنترل Decentr. به‌روزرسانی‌ در دسترس است.</translation>
<translation id="1028061813283459617">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Google»، <ph name="BEGIN_LINK" />از سیستم Decentr خارج شوید<ph name="END_LINK" />.</translation>
<translation id="1042270987544905725">‏برای بستن کادر گفتگوی ورود به سیستم Decentr، کلیک کنید</translation>
<translation id="1059838145689930908">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS" />، به سیستم Decentr وارد شوید.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="1086486568852410168">‏جستجو با «لنز Google»</translation>
<translation id="1088300314857992706">‏<ph name="USER_EMAIL_ADDRESS" /> قبلاً از Decentr استفاده می‌کرد</translation>
<translation id="110877069173485804">‏این Decentr شماست</translation>
<translation id="1125124144982679672">‏چه‌کسی از Decentr استفاده می‌کند؟</translation>
<translation id="1142745911746664600">‏به‌روزرسانی Decentr امکان‌پذیر نیست</translation>
<translation id="1152920704813762236">‏درباره DecentrOS</translation>
<translation id="1154147086299354128">‏&amp;باز کردن در Decentr</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="1194807384646768652">‏‫Decentr این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1278833599417554002">‏راه‌اندازی مجدد برای به‌روزرسانی Decentr</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1302523850133262269">‏لطفاً صبر کنید تا Decentr جدیدترین به‌روزرسانی‌های سیستم را نصب کند.</translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="1335640173511558774">‏<ph name="MANAGER" /> لازم می‌داند که پیش‌از استفاده از این دستگاه، «شرایط خدمات» زیر را بخوانید و آن‌ها را بپذیرید. این شرایط باعث بسط داده شدن، تغییر یافتن،‌ یا محدود شدن «شرایط DecentrOS Flex» نمی‌شود.</translation>
<translation id="1341711321000856656">‏برای دیدن گذرواژه‌های نمایه Decentr دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="1356661055722410047">جدید! می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="1363996462118479832">‏به‌دلیل بروز خطا هنگام ورود به سیستم، DecentrOS نتوانست داده‌هایتان را همگام‌سازی کند.</translation>
<translation id="137466361146087520">‏Decentr نسخه بتا</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="1399397803214730675">‏این رایانه از قبل دارای نسخه جدیدتر Decentr است. اگر نرم‌افزار کار نمی‌کند، لطفاً Decentr را حذف نصب کرده و دوباره امتحان کنید.</translation>
<translation id="1425903838053942728">{COUNT,plural, =0{‏به‌روزرسانی Decentr تمام شد. بلافاصله بعداز راه‌اندازی مجدد می‌توانید از جدیدترین نسخه استفاده کنید. بعداز آن، برگه‌های کنونی دوباره باز خواهند شد.}=1{‏به‌روزرسانی Decentr تمام شد. بلافاصله بعداز راه‌اندازی مجدد می‌توانید از جدیدترین نسخه استفاده کنید. بعداز آن، برگه‌های کنونی دوباره باز خواهند شد. پنجره ناشناس دوباره باز نخواهد شد.}one{‏به‌روزرسانی Decentr تمام شد. بلافاصله بعداز راه‌اندازی مجدد می‌توانید از جدیدترین نسخه استفاده کنید. بعداز آن، برگه‌های کنونی دوباره باز خواهند شد. # پنجره ناشناس دوباره باز نخواهد شد.}other{‏به‌روزرسانی Decentr تمام شد. بلافاصله بعداز راه‌اندازی مجدد می‌توانید از جدیدترین نسخه استفاده کنید. بعداز آن، برگه‌های کنونی دوباره باز خواهند شد. # پنجره ناشناس دوباره باز نخواهد شد.}}</translation>
<translation id="1434626383986940139">‏برنامه‌های Decentr Canary</translation>
<translation id="146866447420868597">‏به سیستم Decentr وارد می‌شوید؟</translation>
<translation id="1492280395845991349">‏راه‌اندازی مجدد برای تکمیل به‌روزرسانی Decentr</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR" /></translation>
<translation id="1507198376417198979">‏سفارشی کردن نمایه جدید Decentr</translation>
<translation id="1547295885616600893">‏ارائه DecentrOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی ممکن شده است.</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="1553358976309200471">‏به‌روزرسانی Decentr</translation>
<translation id="1587223624401073077">‏Decentr درحال استفاده از دوربین شما است.</translation>
<translation id="1587325591171447154">‏<ph name="FILE_NAME" /> خطرناک است، بنابراین Decentr آن را مسدود کرده ست.</translation>
<translation id="1597911401261118146">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم Decentr وارد شوید<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">‏برای ایمن‌تر کردن Decentr، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="1628000112320670027">‏دریافت کمک برای Decentr</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1651617469580841801">‏وقتی از «لنز Google» استفاده می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به Google ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
<translation id="1662146548738125461">‏درباره DecentrOS Flex</translation>
<translation id="1674870198290878346">‏باز کردن پیوند در پنجره &amp;ناشناس Decentr</translation>
<translation id="1682634494516646069">‏Decentr نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">‏‫Decentr یک مرورگر وب است که برنامه‌های کاربردی و صفحات وب را در یک چشم به هم زدن اجرا و باز می‌کند. استفاده از آن سریع و آسان است و همیشه در دسترس است. با برنامه‌های حفاظت دربرابر رمزگیری و بدافزار تعبیه‌شده در Decentr، وب را با امنیت بیشتر مرور کنید.</translation>
<translation id="1713301662689114961">{0,plural, =1{‏Decentr یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏Decentr # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏Decentr # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="1722488837206509557">این کار به شما امکان می‌دهد از بین دستگاه‌های دردسترس انتخاب کنید و محتوا را در آن‌ها نمایش دهید.</translation>
<translation id="1786003790898721085">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME" /> به سیستم Decentr وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="1786044937610313874">‏میان‌برها در Decentr باز می‌شود</translation>
<translation id="178701303897325119">‏دیگر از این افزونه پشتیبانی نمی‌شود. ‫Decentr توصیه می‌کند آن را حذف کنید.</translation>
<translation id="1812689907177901597">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Decentr به سیستم سایت‌های Google مانند Gmail وارد شوید</translation>
<translation id="1821644463306970002">{NUM_TABS,plural, =1{‏‫Decentr توصیه می‌کند برگه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Decentr توصیه می‌کند برگه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Decentr توصیه می‌کند برگه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="1860536484129686729">‏Decentr برای این سایت به مجوز دسترسی به دوربین نیاز دارد</translation>
<translation id="1873233029667955273">‏Decentr مرورگر پیش‌فرض شما نیست</translation>
<translation id="1874309113135274312">‏Decentr نسخه بتا (mDNS-In)</translation>
<translation id="1877026089748256423">‏نسخه Decentr قدیمی است</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="1919130412786645364">‏مجاز کردن ورود به سیستم Decentr</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE" /> دقیقه باقی مانده است</translation>
<translation id="2001586581944147178">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Decentr برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{‏دیگر از این افزونه پشتیبانی نمی‌شود. ‫Decentr توصیه می‌کند آن را حذف کنید.}one{‏دیگر از این افزونه‌ها پشتیبانی نمی‌شود. ‫Decentr توصیه می‌کند آن را حذف کنید.}other{‏دیگر از این افزونه‌ها پشتیبانی نمی‌شود. ‫Decentr توصیه می‌کند آن را حذف کنید.}}</translation>
<translation id="2018528049276128029">‏هرکدام از نمایه‌های Decentr دارای اطلاعات مختص خودش است (مثل نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2024959665595762054">‏برای ذخیره کردن داده‌های Decentr در «حساب Google» خود و استفاده کردن از آن‌ها، هویتتان را به‌تأیید برسانید</translation>
<translation id="2034233344106846793">‏‫Decentr اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="207902854391093810">‏وقتی نسخه آزمایشی روشن باشد، «سنجش آگهی» به سایت‌هایی که بازدید می‌کنید اجازه می‌دهد اطلاعاتی را از Decentr درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="2091012649849228750">‏برای دریافت به‌روزرسانی‌های آتی Decentr، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="2094648590148273905">‏شرایط DecentrOS Flex</translation>
<translation id="2094919256425865063">‏درهرصورت از Decentr خارج می‌شوید؟</translation>
<translation id="2106831557840787829">‏ارائه DecentrOS Flex با <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی مانند <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزاری Linux<ph name="END_LINK_LINUX_OSS" /> ممکن شده است.</translation>
<translation id="2108778574543343055">‏غیرفعال کردن اجرای Decentr در پس‌زمینه برای برنامه‌ها</translation>
<translation id="2120620239521071941">‏این کار <ph name="ITEMS_COUNT" /> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم Decentr شوید.</translation>
<translation id="2121284319307530122">‏راه‌اندازی مجدد برای به‌روزرسانی Decentr</translation>
<translation id="2123055963409958220">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن Decentr کمک کنید</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2128411189117340671">‏مدیریت نمایه‌های Decentr</translation>
<translation id="2131230230468101642">‏برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشند به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. یا می‌توانید علایقی را که نمی‌خواهید Decentr مدنظر قرار دهد حذف کنید.</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="2139300032719313227">‏بازراه‌اندازی DecentrOS</translation>
<translation id="2151406531797534936">‏لطفاً اکنون Decentr را بازراه‌اندازی کنید</translation>
<translation id="2163089732491971196">‏برای ذخیره و استفاده کردن از داده‌های Decentr در «حساب Google» خود، گذرعبارت خود را وارد کنید</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="2186206192313702726">‏لنز Decentr</translation>
<translation id="2190166659037789668">خطای بررسی به‌روزرسانی: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199691482078155239">‏‫Decentr به شما کمک می‌کند بر آگهی‌هایی که می‌بینید تسلط بیشتری داشته باشید و همچنین میزان اطلاعاتی را که سایت‌ها هنگام نمایش آگهی‌های شخصی‌سازی‌شده به شما درباره‌تان جمع‌آوری می‌کنند محدود می‌کند</translation>
<translation id="2216543877350048334">‏برای برداشتن «حساب Google» خود از Decentr، از سیستم خارج شوید</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="223889379102603431">‏اطلاعات مربوط به اینکه Decentr چگونه گواهینامه‌های ریشه‌اش را مدیریت می‌کند</translation>
<translation id="2290014774651636340">‏کلیدهای Google API وجود ندارد. برخی از عملکردهای Decentr از کار خواهد افتاد.</translation>
<translation id="2290095356545025170">‏آیا می‌خواهید Decentr را غیر فعال کنید؟</translation>
<translation id="2309047409763057870">‏این نصب ثانویه Decentr است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="2345992953227471816">‏Decentr متوجه شده است که این افزونه‌ها حاوی بدافزار هستند:</translation>
<translation id="2348335408836342058">‏Decentr برای این سایت به مجوز دسترسی به دوربین و میکروفون نیاز دارد</translation>
<translation id="234869673307233423">‏Decentr نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعداً دوباره امتحان کنید.</translation>
<translation id="235650106824528204">‏سرپرست نمایه کاری می‌تواند داده‌های Decentr را که درطول استفاده از این نمایه ایجاد شده‌اند (مثل ایجاد سابقه نشانک‌ها، گذرواژه‌ها، و دیگر تنظیمات) بردارد. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="2401189691232800402">‏سیستم DecentrOS</translation>
<translation id="2403703063067034158">خطای راه‌اندازی: فعلاً راه‌اندازی دیگری درحال اجرا است، لطفاً کمی بعد دوباره امتحان کنید.</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Decentr به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Decentr به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Decentr به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Decentr به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="2424440923901031101">‏این افزونه خط‌مشی «نت‌بازار Decentr» را نقض می‌کند و ممکن است ناامن باشد. آن را از Decentr حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2467438592969358367">‏Decentr می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2472092250898121027">‏این افزونه حاوی بدافزار است و ناامن است. آن را از Decentr حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="2513154137948333830">بازراه‌اندازی لازم است: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">‏برای محافظت از داده‌هایتان، به Decentr اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="2556847002339236023">‏اگر <ph name="TIMEOUT_DURATION" /> از Decentr استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="2559253115192232574">‏بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از Decentr بخواهد علایق شما را ببیند. Decentr می‌تواند حداکثر ۳ علاقه را هم‌رسانی کند.</translation>
<translation id="2563121210305478421">‏Decentr راه‌اندازی مجدد شود؟</translation>
