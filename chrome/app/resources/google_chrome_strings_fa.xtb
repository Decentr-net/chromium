<translation id="3622716124581627104">‏چیزها و مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «لنز Google» استفاده می‌کنید، نماگرفتی از صفحه به Google ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
<translation id="3622797965165704966">‏اکنون استفاده از Decentr با حساب Google شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="3635073343384702370">‏‫Decentr زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="3673813398384385993">‏Decentr متوجه شده است که این «<ph name="EXTENSION_NAME" />» حاوی بدافزار است</translation>
<translation id="3697952514309507634">‏دیگر نمایه‌های Decentr</translation>
<translation id="3703994572283698466">‏ارائه DecentrOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS" /> ممکن شده است.</translation>
<translation id="3716540481907974026">‏نسخه DecentrOS Flex</translation>
<translation id="3718181793972440140">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم Decentr شوید.</translation>
<translation id="3723744677043446310">{NUM_EXTENSIONS,plural, =1{‏‫Decentr توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}one{‏‫Decentr توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}other{‏‫Decentr توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}}</translation>
<translation id="3780814664026482060">Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">‏به‌دلیل خطای ورود به سیستم، DecentrOS Flex نتوانست داده‌هایتان را همگام‌سازی کند.</translation>
<translation id="3795971588916395511">DecentrOS</translation>
<translation id="3809772425479558446">‏Decentr به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="383928141529488001">‏‫Decentr برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="386202838227397562">‏لطفاً همه پنجره‌های Decentr را ببندید و دوباره امتحان کنید.</translation>
<translation id="3873044882194371212">‏باز کردن پیوند در پنجره &amp;ناشناس Decentr</translation>
<translation id="3885770153807205175">انتخابگر زبان</translation>
<translation id="3889417619312448367">‏حذف نصب Decentr</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="3968962723676998462">‏برای استفاده از داده‌های Decentr و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL" />)، گذرعبارت خود را وارد کنید</translation>
<translation id="3973161977468201858">‏‫Decentr می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="400161754580828648">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Decentr مجاز کنید.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE" /></translation>
<translation id="4035053306113201399">‏برای اعمال به‌روزرسانی، DecentrOS باید بازراه‌اندازی شود.</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4053720452172726777">‏‫سفارشی کردن و کنترل Decentr</translation>
<translation id="408393047846373801">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Decentr وارد شوید بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="4110895483821904099">‏راه‌اندازی نمایه Decentr جدید</translation>
<translation id="4111566860456076004">‏‫Decentr نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از Decentr حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="4128488089242627000">‏Decentr سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند (توصیه می‌شود)</translation>
<translation id="4147555960264124640">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Decentr خود را می‌دهید. داده‌های Decentr شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">در حال نصب...</translation>
<translation id="4149882025268051530">‏نصب‌کننده در خارج کردن آرشیو از حالت فشرده ناموفق بود. لطفاً دوباره Decentr را بارگیری کنید.</translation>
<translation id="415112847282352845">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Decentr وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="4153934450158521343">‏Decentr به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="4173512894976930765">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های Decentr را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Decentr وارد شده باشید از «حساب Google» خارج نخواهید شد.</translation>
<translation id="4175922240926474352">‏‫Decentr این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="4191857738314598978">{0,plural, =1{‏Decentr را ظرف یک روز راه‌اندازی مجدد کنید}one{‏Decentr را ظرف # روز راه‌اندازی مجدد کنید}other{‏Decentr را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="4205939740494406371">‏Decentr نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید یا <ph name="BEGIN_LINK" />گذرواژه‌ها را در «حساب Google» خود بررسی کنید<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="4242034826641750751">‏Decentr برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="424864128008805179">‏از سیستم Decentr خارج می شوید؟</translation>
<translation id="4251615635259297716">‏داده‌های Decentr شما به این حساب مرتبط شوند؟</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="4293420128516039005">‏برای همگام‌سازی و شخصی‌سازی Decentr در همه دستگاه‌هایتان، به سیستم وارد شوید</translation>
<translation id="430327780270213103">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار Decentr</translation>
<translation id="4326552909330437744">{NUM_TABS,plural, =1{‏‫Decentr توصیه می‌کند برگه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Decentr توصیه می‌کند برگه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Decentr توصیه می‌کند برگه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="4328355335528187361">‏Decentr نسخه Dev‏، (mDNS-In)</translation>
<translation id="4329315893554541805">‏برای دریافت شخصی‌سازی و ویژگی‌های دیگر، Decentr را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Google اضافه کنید</translation>
<translation id="4334294535648607276">بارگیری کامل شد.</translation>
<translation id="4337324600316876133">‏برای دریافت به‌روزرسانی‌های بعدی Decentr، باید macOS نسخه ۱۲ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۱ استفاده می‌کند.</translation>
<translation id="4343195214584226067">‏<ph name="EXTENSION_NAME" /> به Decentr اضافه شده است</translation>
<translation id="4348548358339558429">‏برای دریافت شخصی‌سازی، Decentr را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="436060642166082913">‏‫Decentr این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما آسیب برساند</translation>
<translation id="4367027658822022112">‏می‌توانید «لنز Google» را برای دسترسی آسان سنجاق کنید؛ روی دکمه «سنجاق کردن» در بالای پانل کناری کلیک کنید</translation>
<translation id="4389991535395284064">‏هنگام مرور «درحالت ناشناس»، Decentr قبل‌از اینکه سایت را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4450664632294415862">‏Decentr - ورود به سیستم شبکه - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">‏عملکرد دیگری در Decentr درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="4459234553906210702">‏سنجش آگهی به سایت‌هایی که بازدید می‌کنید اجازه می‌دهد اطلاعاتی را از Decentr درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="4567424176335768812">با حساب <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم شده‌اید. اکنون در همه دستگاه‌هایی که با آنها به سیستم وارد شده‌اید می‌توانید به نشانک‌ها، سابقه و دیگر تنظیماتتان دسترسی داشته باشید.</translation>
<translation id="4571503333518166079">‏رفتن به تنظیمات اعلان Decentr</translation>
<translation id="459622048091363950">‏وقتی Decentr دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="4598116752460667024">فرایندی را ازطریق فهرست جستجو کنید.</translation>
<translation id="4600710005438004015">‏Decentr به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="4624065194742029982">‏حالت ناشناس Decentr</translation>
<translation id="4627412468266359539">‏اختیاری: با ارسال خودکار داده‌های عیب‌یابی و داده‌های استفاده به Google، به بهبود ویژگی‌ها و عملکرد DecentrOS Flex کمک کنید.</translation>
<translation id="4633000520311261472">‏برای ایمن‌تر کردن Decentr، برخی از افزونه‌هایی را که در<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="4720851490453439956">‏سرویس داخلی به‌روزرسان Decentr</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="4728575227883772061">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Decentr در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="4737281654364167024">‏برای ادامه دادن، با حساب <ph name="EMAIL" /> به سیستم Decentr وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="4741235124132242877">‏سنجاق شد! دفعه بعد در نوارابزار از «لنز Google» استفاده کنید</translation>
<translation id="4747730611090640388">‏Decentr می‌تواند علایقتان را برآورد کند.  بعداً، سایتی که از آن بازدید می‌کنید می‌تواند برای شخصی کردن آگهی‌هایی که به شما نشان می‌دهد از Decentr بخواهد علایق شما را ببیند.</translation>
<translation id="475321580758063259">‏برای ادامه استفاده از داده‌های Decentr ذخیره‌شده در «حساب Google» خود (<ph name="ACCOUNT_EMAIL" />)،‏ Decentr را به‌روز کنید</translation>
<translation id="4754614261631455953">‏Decentr Canary (ورودی mDNS)</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Google استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Google ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4793679854893018356">‏ببینید Decentr چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="4828579605166583682">‏Decentr می‌خواهد گذرواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="4842397268809523050">‏DecentrOS Flex نتوانست داده‌هایتان را همگام‌سازی کند زیرا همگام‌سازی برای دامنه شما دردسترس نیست.</translation>
<translation id="4851866215237571846">‏‫<ph name="EXISTING_USER" /> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Decentr وارد شوید.</translation>
<translation id="4855026984605187434">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Decentr مجاز کنید</translation>
<translation id="4873783916118289636">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Decentr</translation>
<translation id="4885446229353981848">‏میان‌بر «لنز Google» همیشه نشان داده شود</translation>
<translation id="4891791193823137474">‏اجازه به Decentr برای اجرا در پس‌زمینه</translation>
<translation id="4895437082222824641">‏باز کردن پیوند در &amp;برگه جدید Decentr</translation>
<translation id="4918844574251943176">تصویر کپی شد</translation>
<translation id="492720062778050435">‏Decentr توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="4953650215774548573">‏تنظیم Decentr به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="495931528404527476">‏در Decentr</translation>
<translation id="4969674060580488087">‏DecentrOS Flex نتوانست داده‌هایتان را همگام‌سازی کند زیرا جزئیات ورود به سیستم حسابتان به‌روز نیست.</translation>
<translation id="4970761609246024540">‏به نمایه‌های Decentr خوش‌آمدید</translation>
<translation id="4970880042055371251">‏نسخه DecentrOS</translation>
<translation id="4990567037958725628">Decentr Canary</translation>
<translation id="5003967926796347400">‏روی «مدیر گذرواژه Google» کلیک کنید</translation>
<translation id="5114340746415930644">‏برای استفاده از داده‌های Decentr و ذخیره کردن آن‌ها در حسابتان (<ph name="USER_EMAIL" />)، گذرعبارت خود را وارد کنید</translation>
<translation id="5120334927898581447">‏ورود به سیستم Decentr هنگام وارد شدن به سیستم دیگر سرویس‌های Decentr</translation>
<translation id="5126049312684316860">‏Decentr صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بار شوند</translation>
<translation id="5132929315877954718">‏برنامه‌های کاربردی، بازی‌ها، افزونه‌ها و طرح‌های زمینه فوق‌العاده را برای Decentr کاوش کنید.</translation>
<translation id="5139423532931106058">‏سفارشی کردن نمایه Decentr</translation>
<translation id="5163087008893166964">‏به Decentr خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="5166439563123238795">‏‫Decentr برای ردیابی کردن دست‌های شما به اجازه نیاز دارد</translation>
<translation id="5170938038195470297">‏نمایهٔ شما نمی‌تواند استفاده شود زیرا مربوط به یک نسخه جدیدتر از Decentr است. بعضی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک مسیر دیگر برای نمایه تعیین کنید یا از نسخه جدیدتر Decentr استفاده کنید.</translation>
<translation id="5174969993834422967">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان ارسال کند، روی نماد اعلان در گوشه چپ نوار نشانی کلیک کنید.</translation>
<translation id="5201744974236816379">‏به‌روزرسانی Decentr</translation>
<translation id="521447420733633466">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و Decentr را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="5234764350956374838">رد کردن</translation>
<translation id="5239627039202700673">‏از Decentr برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="5251420635869119124">‏مهمان‌‌ها می‌توانند از Decentr استفاده کنند بدون اینکه اثری از خود به جا بگذارند.</translation>
<translation id="5286907366254680517">تشخیص داده شد</translation>
<translation id="5320351714793324716">‏اگر کوکی‌ها را مجاز کنید، ممکن است Decentr از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="5321325624576443340">‏«لنز Google» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="5334309298019785904">‏DecentrOS نتوانست داده‌هایتان را همگام‌سازی کند، زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="5334487786912937552">‏Decentr برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="5337648990166757586">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به Google، به بهبود ویژگی‌ها و عملکرد DecentrOS کمک کنید.</translation>
<translation id="5368118228313795342">کد اضافی: <ph name="EXTRA_CODE" />.</translation>
<translation id="5386244825306882791">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Decentr یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="5394833366792865639">‏هم‌رسانی برگه Decentr</translation>
<translation id="5412485296464121825">‏سایت‌ها می‌توانند بااستفاده از Decentr اطلاعاتی درباره علایقتان ذخیره کنند. برای مثال، اگر برای خرید کفش مخصوص ماراتون از سایتی بازدید کنید، ممکن است آن سایت علاقه شما را به‌صورت دونده ماراتون مشخص کند. بعداً، اگر برای ثبت‌نام در مسابقه‌ای به سایتی دیگر مراجعه کردید، آن سایت می‌تواند براساس علایقتان آگهی‌ای برای کفش مخصوص دویدن به شما نشان دهد.</translation>
<translation id="5430073640787465221">‏فایل اولویت‌های شما خراب یا نامعتبر است. Decentr نمی‌تواند تنظیمات شما را بازیابی کند.</translation>
<translation id="5468572406162360320">‏برای کمک به بهبود این ویژگی‌ها، Decentr تعاملات شما با این ویژگی‌ها را به Google ارسال می‌کند. ممکن است افراد بازبین این داده‌ها را بخوانند، و پردازش و حاشیه‌نویسی کنند.</translation>
<translation id="5524761631371622910">‏اگر نسخه آزمایشی روشن باشد و Decentr به‌طور تصادفی نسخه آزمایشی را برایتان فعال کرده باشد، سابقه مرورتان بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، Decentr علایقتان را هر ماه به‌طور چرخشی حذف می‌کند.</translation>
<translation id="5530733413481476019">‏سرعت Decentr را افزایش دهید</translation>
<translation id="5566025111015594046">‏Decentr (ورودی mDNS)</translation>
<translation id="5579324208890605088">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش کاربر معمولی اجرا کنید، نه با نقش سرپرست.</translation>
<translation id="5596627076506792578">گزینه‌های بیشتر</translation>
<translation id="5602351063754773347">‏‫Decentr توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="5649156266046089790">‏با نمایه‌های Decentr می‌توانید همه چیزهای مربوط به Decentr را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="565744775970812598">‏<ph name="FILE_NAME" /> ممکن است خطرناک باشد، بنابراین Decentr آن را مسدود کرده است.</translation>
<translation id="566568153320186256">‏‫Decentr با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK" />درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="567202749201779594">‏داده‌های Decentr ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Decentr را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Decentr را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Decentr را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Decentr را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="5686916850681061684">‏Decentr ‫را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="569897634095159764">اتصال به اینترنت برقرار نشد. سرور پروکسی به اصالت‌سنجی نیاز دارد.</translation>
<translation id="5709557627224531708">‏تنظیم Decentr به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="5727531838415286053">‏اگر Decentr به‌طور تصادفی نسخه آزمایشی را برایتان فعال کرده باشد، سابقه مرورتان بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، Decentr علایقتان را هر ماه به‌طور چرخشی حذف می‌کند. ممکن است علایق بازآوری شود، مگر اینکه آن‌ها را بردارید.</translation>
<translation id="5736850870166430177">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Decentr ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه، به «مرور ایمن» ارسال کند</translation>
<translation id="5756509061973259733">‏درحال‌حاضر یک نمایه Decentr با این حساب در این دستگاه وجود دارد</translation>
<translation id="5759947850379142561">‏نوشتار یا تصویری را برای جستجو کردن با «لنز Google» انتخاب کنید یا برای خارج شدن از «لنز Google»، کلید Escape را فشار دهید</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> - Decentr Canary</translation>
<translation id="5804318322022881572">‏Decentr راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="5809516625706423866">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۱ مجاز نیست. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
<translation id="5825922397106002626">‏حذف <ph name="EXTENSION_NAME" /> از Decentr</translation>
<translation id="58431560289969279">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Google» خود در Decentr استفاده کنید. هرزمان بخواهید می‌توانید این مورد را در تنظیمات تغییر دهید.</translation>
<translation id="5858486459377137936">‏وقتی همه پنجره‌های Decentr را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Decentr وارد شده باشید از «حساب Google» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK" />.</translation>
<translation id="586971344380992563">‏‫Decentr درباره بارگیری‌ها و سایت‌های ناامن <ph name="BEGIN_LINK" />به شما هشدار می‌دهد<ph name="END_LINK" /></translation>
<translation id="5895138241574237353">راه‌اندازی مجدد</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ورود به سیستم شبکه</translation>
<translation id="5924017743176219022">درحال اتصال به اینترنت…</translation>
<translation id="5940385492829620908">‏وب، نشانک‌ها و موارد دیگر Decentr شما در اینجا هستند.</translation>
<translation id="5941711191222866238">کوچک کردن</translation>
<translation id="5941830788786076944">‏Decentr مرورگر پیش‌فرض شود</translation>
<translation id="5947104538377036631">‏میان‌بر Decentr</translation>
<translation id="5953954252731207958">‏اخیراً بازدیدی نداشته‌اید. ‫Decentr ‏<ph name="PERMISSION" /> را برداشت</translation>
<translation id="5980111191913430208">‏افزونه‌ها، برنامه‌ها، و زمینه‌های دریافتی از منابع ناشناخته می‌توانند به دستگاهتان آسیب برسانند. ‫Decentr توصیه می‌کند آن‌ها را فقط از <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> نصب کنید</translation>
<translation id="6003112304606738118">درحال بارگیری… <ph name="HOURS" /> ساعت باقی مانده است</translation>
<translation id="6008161919456049856">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Decentr، دوباره به سیستم وارد شوید.</translation>
<translation id="6014316319780893079">‏با <ph name="BEGIN_LINK" />ابزارهای Decentr<ph name="END_LINK" />، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="6022659036123304283">‏Decentr را برای خود اختصاصی کنید</translation>
<translation id="6025087594896450715">‏Decentr تا <ph name="REMAINING_TIME" /> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="6040143037577758943">بستن</translation>
<translation id="604424701295382420">‏سنجاق شد! دفعه بعد می‌توانید ازطریق این دکمه جدید در نوارابزار به «لنز Google» دسترسی پیدا کنید</translation>
<translation id="6069027071882229820">کپی کردن به‌عنوان تصویر</translation>
<translation id="6070348360322141662">‏برای امنیت بیشتر، Decentr داده‌های شما را رمزگذاری می‌کند</translation>
<translation id="6075300983329039771">‏سازمانتان (<ph name="MANAGER" />) شما را ملزم می‌کند به سیستم Decentr وارد شوید</translation>
<translation id="608006075545470555">افزودن نمایه کاری به این مرورگر</translation>
<translation id="6113794647360055231">‏Decentr اکنون بهتر شده است</translation>
<translation id="6116252277240876590">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در Decentr استفاده می‌شود</translation>
<translation id="6134085236017727171">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به Decentr دسترسی دهید</translation>
<translation id="6135456723633883042">‏این برگه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Decentr آن‌ها را غیرفعال کند.</translation>
<translation id="6145313976051292476">‏بازکردن فایل‌های PDF در Decentr</translation>
<translation id="6150706324143004339">‏برای ذخیره و استفاده کردن از داده‌های Decentr در «حساب Google» خود، Decentr را به‌روزرسانی کنید</translation>
<translation id="6157638032135951407">‏اگر <ph name="TIMEOUT_DURATION" /> از Decentr استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="6165508094623778733">بیشتر بدانید</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> - Decentr Beta</translation>
<translation id="6180522807229584611">‏این برگه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Decentr آن را غیرفعال کند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="6200139057479872438">‏اخیراً بازدیدی نداشته‌اید. ‫Decentr ‏<ph name="PERMISSION_1" /> و <ph name="PERMISSION_2" /> را برداشت</translation>
<translation id="6235018212288296708">‏قانون ورودی برای Decentr به منظور اجازه به ترافیک mDNS.</translation>
<translation id="624230925347970731">‏Decentr به‌زودی بسته می‌شود</translation>
<translation id="6247557882553405851">‏مدیر گذرواژه Decentr</translation>
<translation id="6251759518630934363">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Google قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Decentr را رد کنید.</translation>
<translation id="6277547788421725101">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Decentr خاموش کرده است</translation>
<translation id="627882678981830918">‏‫Decentr را سفارشی‌سازی و کنترل کنید. ‫Decentr را به‌عنوان مرورگر پیش‌فرض تنظیم کنید.</translation>
<translation id="6288580400488258237">‏‫Decentr را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="6291089322031436445">‏برنامه‌های Decentr نسخه Dev</translation>
<translation id="6291549208091401781">‏Decentr از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="6319856120645568262">‏‫Decentr برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="6321592572353357376">‏افزونه «<ph name="EXTENSION_NAME" />» از شما می‌خواهد به سیستم Decentr وارد شوید</translation>
<translation id="6326175484149238433">‏حذف از Decentr</translation>
<translation id="6327105987658262776">به‌روزرسانی دردسترس نیست.</translation>
<translation id="6360449101159168105">‏وقتی این برگه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Decentr حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="6412673304250309937">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Decentr ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Decentr ممکن است نشانی‌های وب را نیز به همراه بخش‌های کوچکی از محتوای صفحه، به «مرور ایمن» ارسال کند.</translation>
<translation id="6417690341895039567">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Decentr استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Decentr استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Decentr استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
