<translation id="3100998948628680988">‏نام‌گذاری نمایه tomi</translation>
<translation id="3112458742631356345">‏‫tomi این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="3114643501466072395">‏برای بررسی اینکه از دیگر گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود یا نه، <ph name="BEGIN_LINK" />به سیستم tomi وارد شوید<ph name="END_LINK" />.</translation>
<translation id="3119573284443908657">‏‫tomi این بارگیری را مسدود کرد زیرا فایل بایگانی حاوی فایل‌های دیگری است که ممکن است بدافزار باشد</translation>
<translation id="3140883423282498090">‏دفعه بعد که tomi را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="3149510190863420837">‏برنامه‌های tomi</translation>
<translation id="3169523567916669830">‏درطول دوره‌های آزمایشی، می‌توانید موضوعات موردعلاقه را که سایت‌ها برای ارائه آگهی به شما استفاده می‌کنند ببینید یا حذف کنید. tomi علایق شما را براساس سابقه مرور اخیرتان تخمین می‌زند.</translation>
<translation id="3196187562065225381">‏‫tomi این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="3226612997184048185">‏اگر نشانک‌ها را در «حساب tomi» هم ذخیره کنید، می‌توانید قیمت محصولات را در tomi پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="3234642784688107085">ویژگی‌های جدید مبتنی بر هوش مصنوعی را برای ایجاد زمینه، دریافت کمک در نوشتن، و منظم ماندن امتحان کنید</translation>
<translation id="3245429137663807393">‏اگر گزارش‌های استفاده از tomi را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرند.</translation>
<translation id="3261565993776444564">با امتحان کردن رنگی جدید مرورگرتان را سفارشی‌سازی کنید</translation>
<translation id="3282568296779691940">‏ورود به tomi</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="3292333338048274092">‏سپس باید tomi را بازراه‌اندازی کنید.</translation>
<translation id="3360895254066713204">‏راهنمای tomi</translation>
<translation id="3379938682270551431">{0,plural, =0{‏tomi هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏tomi ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏tomi ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏tomi ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="3396977131400919238">‏هنگام نصب یک خطای سیستم‌عامل رخ داد. لطفاً دوباره tomi را بارگیری کنید.</translation>
<translation id="3428747202529429621">‏وقتی به سیستم وارد شده باشید، امنیت شما را در tomi حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر tomi استفاده شود</translation>
<translation id="3434246496373299699">‏tomi زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که با «حساب tomi» خود به سیستم وارد شوید</translation>
<translation id="3438681572027105609">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم tomi وارد شوید</translation>
<translation id="3450887623636316740">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK" />اگر گذرواژه را ارائه دهید، tomi می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن tomi» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
