<translation id="761356813943268536">‏يستخدم Decentr الكاميرا والميكروفون.</translation>
<translation id="7617377681829253106">‏Decentr أصبح أفضل</translation>
<translation id="7686590090926151193">‏Decentr ليس متصفحك التلقائي.</translation>
<translation id="7689606757190482937">‏يمكنك مزامنة Decentr وتخصيصه على جميع أجهزتك.</translation>
<translation id="7729447699958282447">‏تعذر على Decentr مزامنة البيانات نظرًا لأن المزامنة غير متاحة في نطاقك.</translation>
<translation id="7745317241717453663">‏سيؤدي هذا إلى حذف بيانات التصفح من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Decentr كـ <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">تعذر على أداة المثبِّت إنشاء دليل مؤقت. يُرجى التحقق من وجود مساحة خالية على القرص وتوفر الإذن اللازم لتثبيت البرنامج.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - Decentr Canary</translation>
<translation id="7828947555739565424">‏يتوفّر حاليًا على هذا الجهاز ملف شخصي لهذا الحساب على Decentr.</translation>
<translation id="7857220146454061152">‏للحصول على تحديثات Decentr في المستقبل، يجب أن تستخدم جهازًا يعمل بنظام التشغيل OS X 10.11 أو إصدار أحدث. يعمل جهاز الكمبيوتر هذا بنظام التشغيل OS X 10.10.</translation>
<translation id="7867198900892795913">‏تعذّرت إعادة التحميل Decentr إلى آخر إصدار، لذلك قد تفوتك الميزات الجديدة وعمليات إصلاح الأمان.</translation>
<translation id="7898472181347242998">‏للتأكّد من أن جهازك يستخدم أحدث إصدار من نظام التشغيل، يُرجى الانتقال إلى <ph name="LINK_BEGIN" />إعدادات نظام التشغيل Decentr<ph name="LINK_END" />.</translation>
<translation id="7937630085815544518">‏تم تسجيل دخولك إلى Decentr باعتبارك <ph name="USER_EMAIL_ADDRESS" />. يُرجى استخدام الحساب نفسه لتسجيل الدخول مرة أخرى.</translation>
<translation id="7975919845073681630">‏هذا تثبيت ثانوي من Decentr، ولا يمكن جعله متصفحك التلقائي.</translation>
<translation id="8013436988911883588">‏بعد حصول Decentr على إمكانية الوصول، ستتمكن المواقع الإلكترونية من مطالبتك بإمكانية الوصول.</translation>
<translation id="8045118833343856403">‏لم تسجّل الحسابات التالية الدخول إلى أي ملفات شخصية على Decentr. إذا كنت تريد استخدام حساب في ملف شخصي آخر، عليك إزالة هذا الملف الشخصي أولاً.</translation>
<translation id="8105840573057009683">‏يحتاج Decentr إلى إذن تحديد الموقع الجغرافي من أجل هذا الموقع الإلكتروني.</translation>
<translation id="81770708095080097">‏هذا الملف ضار، لذلك فقد حظره Decentr.</translation>
<translation id="8248265253516264921">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول Decentr توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى Google. ويمكنك إيقاف هذه الميزة في الإعدادات في أي وقت.</translation>
<translation id="8266560134891435528">‏يتعذّر على Decentr التحقّق من كلمات المرور لأنك لم تسجّل الدخول.</translation>
<translation id="8276522524898344151">‏يحاول Decentr نسخ كلمات المرور.</translation>
<translation id="8290862415967981663">‏قد يكون هذا الملف ضارًا، لذلك فقد حظره Decentr.</translation>
<translation id="8330519371938183845">‏يمكنك تسجيل الدخول لمزامنة Decentr وتخصيصه على جميع أجهزتك.</translation>
<translation id="8340674089072921962">‏كان <ph name="USER_EMAIL_ADDRESS" /> يستخدم Decentr مسبقًا</translation>
<translation id="8417404458978023919">{0,plural, =1{‏يجب إعادة تشغيل Decentr في غضون يوم واحد}zero{‏يجب إعادة تشغيل Decentr في غضون # يوم}two{‏يجب إعادة تشغيل Decentr في غضون يومين}few{‏يجب إعادة تشغيل Decentr في غضون # أيام}many{‏يجب إعادة تشغيل Decentr في غضون # يومًا}other{‏يجب إعادة تشغيل Decentr في غضون # يوم}}</translation>
<translation id="8453117565092476964">‏أرشيف أداة التثبيت تالف أو غير صالح. يُرجى إعادة تنزيل Decentr.</translation>
<translation id="8493179195440786826">‏إصدار Decentr قديم</translation>
<translation id="8550334526674375523">هذا الملف الشخصي للعمل منفصِل تمامًا عن ملفك الشخصي.</translation>
<translation id="8558383651099478961">‏أوقفَ أحد والدَيك "أذونات المواقع الإلكترونية والتطبيقات والإضافات" لمتصفِّح Decentr. ولا يمكن تثبيت <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="8568283329061645092">‏لا يستطيع Decentr التحقّق من كلمات المرور إلا عند تسجيل الدخول باستخدام حسابك على Google.</translation>
<translation id="8586442755830160949">‏حقوق الطبع والنشر لعام <ph name="YEAR" /> لصالح The Decentr Authors. جميع الحقوق محفوظة.</translation>
<translation id="8619360774459241877">‏جارٍ إطلاق Decentr...</translation>
<translation id="8621669128220841554">‏تعذّر التثبيت نظرًا لحدوث خطأ غير محدد. يُرجى إعادة تنزيل Decentr.</translation>
<translation id="8697124171261953979">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل Decentr أو إجراء بحث من المربع متعدد الاستخدامات.</translation>
<translation id="8704119203788522458">‏هذا هو Decentr الخاص بك</translation>
<translation id="8796602469536043152">‏يحتاج Decentr إلى إذن للوصول إلى الكاميرا والميكروفون من أجل الموقع الإلكتروني هذا.</translation>
<translation id="8803635938069941624">‏بنود نظام تشغيل Decentr</translation>
<translation id="8821041990367117597">‏تعذر على Decentr مزامنة البيانات نظرًا لأن تفاصيل تسجيل الدخول إلى حسابك قديمة.</translation>
<translation id="8862326446509486874">لا تملك الحقوق الكافية للتثبيت على مستوى النظام. جرّب تشغيل المثبِّت بصفة مشرف.</translation>
<translation id="8880203542552872219">‏في هذه الحالة، يُرجى تعديل كلمة المرور المحفوظة في Decentr لتتطابق مع كلمة المرور الجديدة.</translation>
<translation id="8897323336392112261">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل Decentr أو النقر على زر الصفحة الرئيسية.</translation>
<translation id="8907580949721785412">‏يحاول Decentr عرض كلمات المرور. اكتب كلمة مرور Windows للسماح بذلك.</translation>
<translation id="8941642502866065432">‏تعذّرت إعادة التحميل Decentr</translation>
<translation id="8974095189086268230">‏أصبح نظام التشغيل Decentr متاحًا من خلال المزيد من <ph name="BEGIN_LINK_CROS_OSS" />البرامج مفتوحة المصدر<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="8986207147630327271">أنت على وشك إضافة ملف شخصي للعمل إلى هذا المتصفِّح ومنح المشرف إمكانية التحكُّم في هذا الملف الشخصي للعمل فقط.</translation>
<translation id="9019929317751753759">‏لجعل Decentr أكثر أمنًا، أوقفنا الإضافة التالية التي لم تُدرج في <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> وربما تكون قد أضيفت بدون علمك.</translation>
<translation id="9089354809943900324">‏إصدار Decentr قديم</translation>
<translation id="9093206154853821181">{0,plural, =1{‏ستتم إعادة تشغيل Decentr في غضون ساعة واحدة}zero{‏ستتم إعادة تشغيل Decentr في غضون # ساعة}two{‏ستتم إعادة تشغيل Decentr في غضون ساعتين}few{‏ستتم إعادة تشغيل Decentr في غضون # ساعات}many{‏ستتم إعادة تشغيل Decentr في غضون # ساعةً}other{‏ستتم إعادة تشغيل Decentr في غضون # ساعة}}</translation>
<translation id="91086099826398415">‏فتح الرابط في علامة تبويب جديدة في Decentr</translation>
<translation id="911206726377975832">هل تريد أيضًا حذف بيانات التصفح؟</translation>
<translation id="9158494823179993217">‏ضَبَط مشرف النظام Decentr لفتح متصفِّح بديل للوصول إلى <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="9185526690718004400">‏إعادة تشغيل متصفِّح Decentr لتحديثه</translation>
<translation id="9190841055450128916">Decentr (mDNS-In)</translation>
<translation id="9214764063801632699">‏نظام التشغيل Decentr</translation>
<translation id="93478295209880648">‏قد لا يعمل Decentr بشكل صحيح لأنه لم يعد مدعومًا على أنظمة التشغيل Windows XP أو Windows Vista.</translation>
<translation id="965162752251293939">‏مَن يستخدم Decentr؟</translation>
<translation id="985602178874221306">The Decentr Authors</translation>
</translationbundle>