<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="1065672644894730302">لا يمكن قراءة إعداداتك المفضّلة. قد تكون بعض الميزات غير متاحة، ولن يتم حفظ التغييرات في الإعدادات المفضّلة.</translation>
<translation id="1098170124587656448">‏يستطيع Decentr مساعدتك في الحفاظ على أمان معلوماتك من عمليات اختراق البيانات والإضافات الضارة وغيرها من المشاكل.</translation>
<translation id="1104942323762546749">‏يرغب Decentr في تصدير كلمات المرور، لذا يُرجى كتابة كلمة مرور Windows للسماح بذلك.</translation>
<translation id="113122355610423240">‏Decentr هو متصفحك التلقائي</translation>
<translation id="1131805035311359397">‏للتحقُّق مما إذا كانت كلمات المرور آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK" />تسجيل الدخول إلى Decentr<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">‏لمحة عن Decentr</translation>
<translation id="1315551408014407711">‏إعداد ملفك الشخصي الجديد على Decentr</translation>
<translation id="1396446129537741364">‏يحاول Decentr إظهار كلمات المرور.</translation>
<translation id="1414495520565016063">‏تم تسجيل دخولك إلى Decentr!</translation>
<translation id="151962892725702025">‏تعذر على نظام التشغيل Decentr مزامنة البيانات نظرًا لأن المزامنة غير متاحة في نطاقك.</translation>
<translation id="1524282610922162960">‏مشاركة علامة تبويب Decentr</translation>
<translation id="1553461853655228091">‏يحتاج Decentr إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للبيئة المحيطة بك.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق تحديث.}=1{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق تحديث. لن تتم إعادة فتح نافذة التصفح المتخفي.}two{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق تحديث. لن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق تحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}many{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق تحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}other{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق تحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}}</translation>
<translation id="1667812772085710766">‏يمحو Decentr تلقائيًا بعد إغلاقه ملفات تعريف الارتباط وبيانات المواقع الإلكترونية من الصفحات التي تمت زيارتها.</translation>
<translation id="1708666629004767631">‏يتوفر إصدار جديد وأكثر أمانًا Decentr.</translation>
<translation id="1774152462503052664">‏دع Decentr يعمل في الخلفية</translation>
<translation id="1779356040007214683">‏لجعل Decentr أكثر أمانًا، تم إيقاف بعض الإضافات غير المدرجة في <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> والتي ربما تمت إضافتها بدون علمك.</translation>
<translation id="1808667845054772817">‏إعادة تثبيت Decentr</translation>
<translation id="185970820835152459">‏يمكنك إدارة حسابات Google التي تم تسجيل الدخول إليها. يتم استخدام حساباتك على Google في متصفّح Decentr و"متجر Play" وGmail والمزيد. إذا أردت إضافة حساب لمستخدم آخر، مثل أحد أفراد العائلة، أضِف شخصًا جديدًا إلى <ph name="DEVICE_TYPE" /> بدلاً من ذلك. <ph name="LINK_BEGIN" />مزيد من المعلومات<ph name="LINK_END" /></translation>
<translation id="1881322772814446296">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على Decentr. وستكون بياناتك في Decentr مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME" />. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات Google، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. ويُمكنك اختيار إنشاء ملف شخصي جديد للإبقاء على بياناتك الحالية في Decentr بشكل مستقل. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">‏من خلال إيقاف هذا الإعداد، يمكنك تسجيل الدخول إلى "مواقع Google" مثل Gmail بدون الحاجة إلى تسجيل الدخول إلى Decentr</translation>
<translation id="1929939181775079593">‏لا يستجيب Decentr. هل تريد إعادة التشغيل الآن؟</translation>
<translation id="1966382378801805537">‏يتعذَّر على Decentr تحديد المتصفح التلقائي أو تعيينه</translation>
<translation id="1981611865800294956">‏إعادة تشغيل نظام التشغيل Decentr لتحديثه</translation>
<translation id="2008474315282236005">‏سيعمل هذا على حذف عنصر واحد من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Decentr كـ <ph name="USER_EMAIL" />.</translation>
<translation id="2020032459870799438">‏للتحقُّق مما إذا كانت كلمات المرور الأخرى آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK" />تسجيل الدخول إلى Decentr<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">‏تخصيص Decentr</translation>
<translation id="2185166961232948079">‏Decentr - تسجيل الدخول إلى الشبكة - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">‏إذا كنت تشارك الكمبيوتر مع أصدقائك وعائلتك، فبإمكانهم التصفح على حدة وإعداد Decentr على النحو الذي يريدونه.</translation>
<translation id="2294245788148774212">‏اختياري: يمكنك المساعدة في تحسين ميزات نظام التشغيل Decentr وأدائه من خلال إرسال بيانات التشخيص والاستخدام تلقائيًا إلى Google.</translation>
<translation id="2343156876103232566">‏لإرسال رقم من هذا الجهاز إلى جهازك الذي يعمل بنظام التشغيل Android، يُرجى تسجيل الدخول إلى Decentr على الجهازَين.</translation>
<translation id="2347108572062610441">‏غيّرت هذه الإضافة الصفحة التي تظهر عند بدء Decentr.</translation>
<translation id="2396765026452590966">‏غيّرت الإضافة "<ph name="EXTENSION_NAME" />" الصفحة التي تظهر عند بدء Decentr.</translation>
<translation id="2401032172288869980">‏يحتاج Decentr إلى إذن للوصول إلى الكاميرا والميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="2483889755041906834">‏في Decentr</translation>
<translation id="2485422356828889247">إزالة التثبيت</translation>
<translation id="2535480412977113886">‏تعذر على نظام التشغيل Decentr مزامنة البيانات نظرًا لأن تفاصيل تسجيل الدخول إلى حسابك قديمة.</translation>
<translation id="2560420686485554789">‏يحتاج Decentr إلى الوصول إلى مساحة التخزين لتنزيل الملفات.</translation>
<translation id="2572494885440352020">‏أداة مساعدة Decentr</translation>
<translation id="2577788541081224677">‏للوصول من خلال جميع أجهزتك إلى بياناتك في Decentr، عليك تسجيل الدخول كي تتمكّن من تفعيل المزامنة.</translation>
<translation id="2583187216237139145">‏يمكن لمشرف الملف الشخصي للعمل إزالة أي بيانات مرتبطة بمتصفِّح Decentr والتي يتم إنشاؤها أثناء استخدام هذا الملف الشخصي (مثل إنشاء الإشارات المرجعية والسجلّ وكلمات المرور والإعدادات الأخرى).<ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">‏يلزم إعادة تشغيل نظام التشغيل Decentr حتى يتم تطبيق التحديث.</translation>
<translation id="2648074677641340862">‏حدث خطأ في نظام التشغيل أثناء عملية التثبيت. يُرجى إعادة تنزيل Decentr.</translation>
<translation id="2661879430930417727">‏في حال مشاركة جهاز مع الأصدقاء والعائلة، يمكنهم الحصول على تجربة تصفّح منفصلة وإعداد Decentr على النحو المفضّل لديهم.</translation>
<translation id="2711502716910134313">‏علامة تبويب Decentr</translation>
<translation id="2718390899429598676">‏لمزيد من الأمان، سيشفر Decentr بياناتك</translation>
<translation id="2770231113462710648">تغيير المتصفح التلقائي إلى:</translation>
<translation id="2799223571221894425">إعادة تشغيل</translation>
<translation id="2837693172913560447">‏سيؤدي هذا الإجراء إلى إنشاء ملف شخصي جديد على Decentr لحساب <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="2847479871509788944">‏إزالة من Decentr</translation>
<translation id="2885378588091291677">إدارة المهام</translation>
<translation id="2910007522516064972">‏حو&amp;ل Decentr</translation>
<translation id="2977470724722393594">‏Decentr محدّث</translation>
<translation id="2983934633046890458">‏يحاول Decentr تعديل كلمات المرور.</translation>
<translation id="3032706164202344641">‏يتعذّر على Decentr التحقّق من كلمات المرور. يُرجى إعادة المحاولة.</translation>
<translation id="3032787606318309379">‏جارٍ الإضافة إلى Decentr...</translation>
<translation id="3068515742935458733">‏يمكنك المساعدة في تحسين Decentr عن طريق إرسال تقارير الأعطال و<ph name="UMA_LINK" /> إلى Google</translation>
<translation id="3103660991484857065">‏تعذّرت أداة التثبيت في فك ضغط الأرشيف. يُرجى إعادة تنزيل Decentr.</translation>
<translation id="3130323860337406239">‏يستخدم Decentr الميكروفون.</translation>
<translation id="3155163173539279776">‏إعادة تشغيل Decentr</translation>
<translation id="3179665906251668410">‏فتح الرابط في نافذة تصفح متخفٍ في Decentr</translation>
<translation id="3185330573522821672">‏يمكنك الآن تخصيص ملفك الشخصي الجديد على Decentr.</translation>
<translation id="3190315855212034486">‏للأسف! تعطل Decentr. هل تريد إعادة التشغيل الآن؟</translation>
<translation id="3229526316128325841">‏يرغب Decentr في تصدير كلمات المرور.</translation>
<translation id="3258596308407688501">‏يتعذر على Decentr القراءة والكتابة في دليل البيانات الخاص به:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">‏الإصدار المُثبّت من Decentr: <ph name="PRODUCT_VERSION" /></translation>
<translation id="328888136576916638">‏مفاتيح واجهة برمجة تطبيقات Google مفقودة. وسيترتب على ذلك توقف بعض وظائف Decentr عن العمل.</translation>
<translation id="3296368748942286671">‏استمرار تشغيل تطبيقات الخلفية عند إغلاق Decentr</translation>
<translation id="331951419404882060">‏تعذر على نظام التشغيل Decentr مزامنة البيانات نظرًا لحدوث خطأ أثناء تسجيل الدخول.</translation>
<translation id="3349211344363550267">‏ينصح Decentr بعدم تنزيل هذا الملف أو فتحه.</translation>
<translation id="3350761136195634146">‏يتوفّر ملف شخصي بهذا الحساب حاليًا على Decentr.</translation>
<translation id="3406848076815591792">‏هل تريد الانتقال إلى الملف الشخصي الحالي على Decentr؟</translation>
<translation id="3430503420100763906">‏باستخدام الملفات الشخصية على Decentr، يمكنك الفصل بين جميع بيانات Decentr. ويمكنك إنشاء ملفات شخصية للأصدقاء والعائلة أو تقسيمها للعمل وأغراض الترفيه.</translation>
<translation id="347328004046849135">‏في حال تسجيل الدخول باستخدام كلمة مرور محتمَل تعرّضها للاختراق، سيرسل Decentr إشعارًا إليك.</translation>
<translation id="3474745554856756813">‏سيعمل هذا على حذف <ph name="ITEMS_COUNT" /> من العناصر من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Decentr كـ <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">‏يعمل الاختصار <ph name="SHORTCUT" /> على التبديل بين الملفات الشخصية على Decentr.</translation>
<translation id="3509308970982693815">‏يُرجى إغلاق جميع نوافذ Decentr وإعادة المحاولة.</translation>
<translation id="3575459661164320785">‏هناك برنامج ضار على جهاز الكمبيوتر. ويمكن لمتصفِّح Chrome إزالته واستعادة إعداداتك وإيقاف الإضافات لكي يعمل متصفِّحك بشكلٍ طبيعي من جديد.</translation>
<translation id="3639635944603682591">‏ستُحذَف بيانات تصفُّح هذا المستخدم من هذا الجهاز. ولاسترداد البيانات، سجّل الدخول إلى Decentr بصفتك <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{‏يتوفر تحديث جديد لبرنامج Decentr وسيتم تطبيقه عند إعادة التشغيل.}=1{‏يتوفر تحديث جديد لبرنامج Decentr وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نافذة التصفح المتخفي.}two{‏يتوفر تحديث جديد لبرنامج Decentr وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏يتوفر تحديث جديد لبرنامج Decentr وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}many{‏يتوفر تحديث جديد لبرنامج Decentr وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}other{‏يتوفر تحديث جديد لبرنامج Decentr وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}}</translation>
<translation id="3651803019964686660">‏لإرسال رقم من <ph name="ORIGIN" /> إلى هاتفك الذي يعمل بنظام التشغيل Android، يُرجى تسجيل الدخول إلى Decentr على الجهازَين.</translation>
<translation id="3685209450716071127">‏يتعذّر على Decentr التحقّق من كلمات المرور. يُرجى التحقّق من اتصال الإنترنت.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق هذا التحديث.}=1{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق هذا التحديث. لن تتم إعادة فتح نافذة التصفح المتخفي.}two{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق هذا التحديث. لن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق هذا التحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}many{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق هذا التحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}other{‏يطلب المشرف إعادة تشغيل Decentr لتطبيق هذا التحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}}</translation>
<translation id="3713809861844741608">‏فتح الرابط في علامة تبويب جديدة في Decentr</translation>
<translation id="3728336900324680424">‏سيصل Decentr إلى Drive لإنشاء الاقتراحات في شريط العناوين.</translation>
<translation id="378917192836375108">‏يتيح لك Decentr النقر على رقم هاتف على الويب والاتصال به باستخدام Skype!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="388648406173476553">‏تخصيص Decentr والتحكُّم فيه معلومات مهمة - انقر للحصول على التفاصيل.</translation>
<translation id="3889543394854987837">‏انقر على اسمك لفتح Decentr وبدء التصفح.</translation>
<translation id="390528597099634151">‏سبَق تسجيل دخول <ph name="EXISTING_USER" /> إلى هذا الملف الشخصي على Decentr. لتوفير تجربة تصفّح منفصلة دائمًا، يمكن لمتصفِّح Decentr إنشاء ملف شخصي خاص بك.</translation>
<translation id="3945058413678539331">‏يحاول Decentr نسخ كلمات المرور. اكتب كلمة مرور Windows للسماح بذلك.</translation>
<translation id="4036079820698952681">‏ساعد في تحسين Decentr بالإبلاغ عن <ph name="BEGIN_LINK" />الإعدادات الحالية<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">تحسينات الأمان المهمة والميزات الجديدة متاحة في أحدث إصدار.</translation>
<translation id="419998258129752635">‏<ph name="PAGE_TITLE" /> - تسجيل الدخول إلى الشبكة - Decentr</translation>
<translation id="421369550622382712">‏اكتشف تطبيقات، وألعاب، وإضافات، ومظاهر رائعة لمتصفح Decentr.</translation>
<translation id="4216212958613226427">‏يتم استخدام هذه اللغة لعرض واجهة مستخدم Decentr</translation>
<translation id="4230135487732243613">‏هل ترغب في ربط بياناتك في Decentr بهذا الحساب؟</translation>
<translation id="4264410486868823224">‏يشترط <ph name="MANAGER" /> عليك قراءة بنود الخدمة التالية وقبولها قبل استخدام هذا الجهاز، مع العلم بأنّ هذه البنود لا توسِّع نطاق بنود نظام التشغيل Decentr ولا تعدلِّها ولا تفرض قيودًا عليها.</translation>
<translation id="4271805377592243930">‏الحصول على مساعدة في Decentr</translation>
<translation id="4285930937574705105">‏تعذّر إتمام عملية التثبيت بسبب خطأ غير محدد. إذا كان Decentr في حالة التشغيل حاليًا، يُرجى إغلاقه وإعادة المحاولة.</translation>
<translation id="4407044323746248786">‏هل تريد الخروج من Decentr على أي حال؟</translation>
<translation id="4415566066719264597">‏السماح بتشغيل Decentr في الخلفية</translation>
<translation id="4423735387467980091">‏تخصيص Decentr والتحكم فيه</translation>
<translation id="452711251841752011">‏مرحبًا بك في Decentr. تم فتح نافذة متصفّح جديدة.</translation>
<translation id="4544142686420020088">‏تعذّر تحديث Decentr بسبب حدوث خطأ. <ph name="BEGIN_LINK" />حلّ مشاكل تحديث Chrome وتعذُّر التحديثات<ph name="END_LINK" /></translation>
<translation id="454579500955453258">‏هل تريد المتابعة باستخدام ملف شخصي جديد على Decentr؟</translation>
<translation id="4567424176335768812">لقد سجلت دخولك باعتبارك <ph name="USER_EMAIL_ADDRESS" />. ويُمكنك الآن الاستمتاع بالدخول إلى الإشارات المرجعية، والسجلّ، والإعدادات الأخرى على جميع الأجهزة التي تسجّل الدخول إليها.</translation>
<translation id="459535195905078186">‏تطبيقات Decentr</translation>
<translation id="4665829708273112819">‏تحذير: لا يستطيع Decentr منع الإضافات من تسجيل سجلّ التصفُّح. لإيقاف هذه الإضافة في وضع التصفُّح المتخفي، يجب إلغاء تحديد هذا الخيار.</translation>
<translation id="4677944499843243528">‏يبدو أن الملف الشخصي قيد الاستخدام بواسطة عملية أخرى في Decentr (<ph name="PROCESS_ID" />) على جهاز كمبيوتر آخر (<ph name="HOST_NAME" />). وقد تمّ قفل الملف الشخصي من جانب Decentr لضمان عدم تعرضه للتلف. فإذا كنت واثقًا من عدم وجود عمليات أخرى قيد التشغيل على جهاز الكمبيوتر، فيُمكنك فتح قفل الملف الشخصي وإعادة تشغيل Decentr مجددًا.</translation>
<translation id="469338717132742108">‏الحصول على مساعدة في نظام التشغيل Decentr</translation>
<translation id="4708774505295300557">‏سجّل شخص ما الدخول من قبل إلى Decentr على جهاز الكمبيوتر هذا باسم <ph name="ACCOUNT_EMAIL_LAST" />. يُرجى إنشاء حساب مستخدم جديد في Decentr للإبقاء على معلوماتك بشكلٍ منفصل.</translation>
<translation id="4746050847053251315">‏هل تريد الخروج من Decentr على أي حال؟</translation>
<translation id="4748217263233248895">‏تم للتو تطبيق تحديث أمان خاص لمتصفِّح Decentr. يمكنك إعادة التشغيل الآن وستتم استعادة علامات التبويب.</translation>
<translation id="4750035648288509542">‏أوشك التحديث على الانتهاء. يجب إعادة تشغيل Decentr لإكمال التحديث. ولن تتم إعادة فتح نوافذ التصفّح المتخفي.</translation>
<translation id="4788777615168560705">‏يتعذّر على Decentr التحقُّق من كلمات المرور. يُرجى إعادة المحاولة بعد 24 ساعة أو <ph name="BEGIN_LINK" />التحقُّق من كلمات المرور في حسابك على Google<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">‏يستخدم ذلك المدقق الإملائي نفسه الذي يتم استخدامه في "بحث Google". ويتم إرسال النص الذي تكتبه في المتصفّح إلى Google. يمكنك دائمًا تغيير هذا السلوك في الإعدادات.</translation>
<translation id="4888717733111232871">‏قاعدة الوارد إلى Decentr للسماح بحركة مرور mDNS.</translation>
<translation id="4893347770495441059">‏إعادة تشغيل متصفِّح Decentr لتحديثه</translation>
<translation id="4943838377383847465">‏Decentr في وضع الخلفية.</translation>
<translation id="4987820182225656817">‏يمكن للضيف استخدام Decentr بدون أن يترك أي أثر وراءه.</translation>
<translation id="4994636714258228724">‏إضافة نفسك إلى Decentr</translation>
<translation id="5224391634244552924">‏ما مِن كلمات مرور محفوظة. لا يستطيع Decentr التحقُّق من كلمات المرور إلا عند حفظها.</translation>
<translation id="5252179775517634216">‏سبَق تسجيل دخول <ph name="EXISTING_USER" /> إلى هذا الملف الشخصي على Decentr. سيؤدي هذا الإجراء إلى إنشاء ملف شخصي جديد على Decentr لحساب <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5277894862589591112">‏لتطبيق التغييرات، يُرجى إعادة تشغيل Decentr</translation>
<translation id="5358375970380395591">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على Decentr. وستكون بياناتك في Decentr مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME" />. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات Google، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">‏جارٍ تحديث Decentr (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">‏السماح بتسجيل الدخول إلى Decentr</translation>
<translation id="5398878173008909840">‏يتوفر إصدار جديد من Decentr.</translation>
<translation id="5416696090975899932">‏يتعذر على Decentr عرض معاينة الطباعة عندما يكون عارض PDF المضمّن مفقودًا.</translation>
<translation id="5427571867875391349">‏تعيين Decentr المتصفح التلقائي</translation>
<translation id="5438241569118040789">‏<ph name="PAGE_TITLE" /> - الإصدار التجريبي من Decentr</translation>
<translation id="5479196819031988440">‏يتعذر على نظام التشغيل Decentr فتح هذه الصفحة.</translation>
<translation id="5480860683791598150">‏يحتاج Decentr للوصول إلى موقعك الجغرافي لمشاركته مع هذا الموقع.</translation>
<translation id="549669000822060376">‏يُرجى الانتظار أثناء تثبيت Decentr لآخر تحديثات النظام.</translation>
<translation id="5496810170689441661">‏يحاول Decentr تعديل كلمات المرور. للسماح بذلك، يُرجى كتابة كلمة مرور Windows الخاصة بك.</translation>
<translation id="5527463683072221100">‏فتح ملفات PDF في Decentr</translation>
<translation id="5623402015214259806">{0,plural, =0{‏يتوفر تحديث لمتصفح Decentr}=1{‏يتوفر تحديث لمتصفح Decentr}two{‏يتوفر تحديث لمتصفح Decentr منذ يومين}few{‏يتوفر تحديث لمتصفح Decentr منذ # أيام}many{‏يتوفر تحديث لمتصفح Decentr منذ # يومًا}other{‏يتوفر تحديث لمتصفح Decentr منذ # يوم}}</translation>
<translation id="5634636535844844681">‏يتطلب Decentr نظام التشغيل Windows 7 أو إصدارًا أحدث.</translation>
<translation id="5653831366781983928">‏يُرجى إعادة تشغيل Decentr الآن</translation>
<translation id="5698481217667032250">‏عرض Decentr بهذه اللغة</translation>
<translation id="5820394555380036790">‏نظام التشغيل Decentr</translation>
<translation id="5854740544000584380">‏أصبح نظام التشغيل Decentr متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS" />برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS" />، كما هو الحال في <ph name="BEGIN_LINK_LINUX_OSS" />بيئة تطوير أدوات Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="5862307444128926510">‏مرحبًا بك في Decentr</translation>
<translation id="5883558403894052917">‏رصد Decentr أنّ هذه العناصر تحتوي على برامج ضارة:</translation>
<translation id="5895138241574237353">إعادة التشغيل</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - تسجيل الدخول إلى الشبكة</translation>
<translation id="5987687638152509985">‏تحديث Decentr لبدء المزامنة</translation>
<translation id="6039377483953237732">‏إصدار "نظام التشغيل Decentr"</translation>
<translation id="6055895534982063517">‏يتوفر إصدار جديد من Decentr، وهو أسرع بكثير من ذي قبل.</translation>
<translation id="6063093106622310249">‏&amp;فتح في Decentr</translation>
<translation id="6072279588547424923">‏تمت إضافة <ph name="EXTENSION_NAME" /> إلى Decentr</translation>
<translation id="608006075545470555">إضافة ملف شخصي للعمل على هذا المتصفِّح</translation>
<translation id="608189560609172163">‏تعذر على Decentr مزامنة البيانات نظرًا لحدوث خطأ أثناء تسجيل الدخول.</translation>
<translation id="6096348254544841612">‏تخصيص Decentr والتحكُّم فيه. هناك تحديث متوفر.</translation>
<translation id="6120345080069858279">‏سيحفظ Decentr كلمة المرور هذه في حسابك على Google ولن تحتاج تذكّرها.</translation>
<translation id="6129621093834146363">‏ملف <ph name="FILE_NAME" /> ضار، لذلك فقد حظره Decentr.</translation>
<translation id="6134968993075716475">‏تم إيقاف "التصفّح الآمن" ويقترح متصفّح Chrome تفعيله.</translation>
<translation id="6145820983052037069">‏يمكنك من هنا التبديل بين الملفات الشخصية على Decentr.</translation>
<translation id="6183079672144801177">‏يُرجى التأكُّد من تسجيل الدخول إلى متصفِّح Decentr على جهازك <ph name="TARGET_DEVICE_NAME" /> ثم محاولة الإرسال مرة أخرى.</translation>
<translation id="6212496753309875659">‏يحتوي هذا الكمبيوتر فعلاً على إصدار أحدث من Decentr. إذا كان البرنامج لا يعمل، يُرجى إزالة Decentr وإعادة المحاولة.</translation>
<translation id="6219195342503754812">{0,plural, =0{‏ستتم إعادة تشغيل Decentr الآن}=1{‏ستتم إعادة تشغيل Decentr في غضون ثانية واحدة}two{‏ستتم إعادة تشغيل Decentr في غضون ثانيتين}few{‏ستتم إعادة تشغيل Decentr في غضون # ثوان}many{‏ستتم إعادة تشغيل Decentr في غضون # ثانيةً}other{‏ستتم إعادة تشغيل Decentr في غضون # ثانية}}</translation>
<translation id="6241367896540709610">‏يحتاج Decentr إلى إذن للوصول إلى مساحة التخزين من أجل تنزيل الملفات.</translation>
<translation id="6248213926982192922">‏جعل Decentr المتصفح التلقائي</translation>
<translation id="6266342355635466082">‏يتعذّر على Decentr البحث عن تحديثات. يُرجى التحقّق من اتصال الإنترنت.</translation>
<translation id="6268381023930128611">‏هل تريد الخروج من Decentr؟</translation>
<translation id="6281746429495226318">‏تخصيص ملفك الشخصي في Decentr</translation>
<translation id="6290827346642914212">‏تسمية ملفك الشخصي على Decentr</translation>
<translation id="6295779123002464101">‏قد يكون ملف <ph name="FILE_NAME" /> ضارًا، لذلك فقد حظره Decentr.</translation>
<translation id="6309712487085796862">‏يستخدم Decentr الكاميرا.</translation>
<translation id="6333502561965082103">‏عملية أخرى على Decentr قيد التقدم. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="6334986366598267305">‏الآن أصبح استخدام Decentr مع حسابك في Google وفي أجهزة الكمبيوتر المشتركة أكثر سهولة.</translation>
<translation id="6373523479360886564">‏هل تريد فعلًا إزالة Decentr؟</translation>
<translation id="6403826409255603130">‏ إن Decentr هو متصفح ويب يشغّل صفحات الويب والتطبيقات بسرعة مذهلة. إنه سريع وثابت وسهل الاستخدام. يمكنك تصفح الويب بشكل أكثر أمانًا من خلال ميزات الحماية من البرامج الضارة والتصيّد الاحتيالي المدمجة في Decentr.</translation>
<translation id="6434250628340475518">‏نظام التشغيل Decentr</translation>
<translation id="6455857529632101747">‏مرحبًا بك في الملفات الشخصية على Decentr</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{‏ستتم إعادة تشغيل Decentr خلال ثانية واحدة}zero{‏ستتم إعادة تشغيل Decentr خلال # ثانية}two{‏ستتم إعادة تشغيل Decentr خلال ثانيتين (#)}few{‏ستتم إعادة تشغيل Decentr خلال # ثوانٍ}many{‏ستتم إعادة تشغيل Decentr خلال # ثانيةً}other{‏ستتم إعادة تشغيل Decentr خلال # ثانية}}</translation>
<translation id="6475912303565314141">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل Decentr.</translation>
<translation id="6510925080656968729">‏إزالة Decentr</translation>
<translation id="6542839706527980775">‏يحتفظ كل ملف شخصي بالمعلومات الخاصة به على Decentr، مثل الإشارات المرجعية والسجلّ وكلمات المرور وغير ذلك.</translation>
<translation id="6570579332384693436">‏لإصلاح الأخطاء الإملائية، يُرسِل Decentr ما تكتبه في حقول النص إلى Google</translation>
<translation id="6598877126913850652">‏الانتقال إلى إعدادات الإشعارات في Decentr</translation>
<translation id="6613594504749178791">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Decentr.</translation>
<translation id="665732753414869868">‏يحتاج Decentr إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للمكان حولك.</translation>
<translation id="6676384891291319759">الدخول إلى الإنترنت</translation>
<translation id="6709350901466051922">‏يحتاج Decentr إلى إذن للوصول إلى الميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="6717134281241384636">‏لا يمكن استخدام ملفك الشخصي نظرًا لأنه من إصدار أحدث من Decentr.

قد تكون بعض الميزات غير متاحة. يُرجى تحديد دليل ملف شخصي مختلف أو استخدام إصدار أحدث من Decentr.</translation>
<translation id="6734080038664603509">‏تح&amp;ديث Decentr</translation>
<translation id="6734291798041940871">‏يتم تثبيت Decentr بالفعل لجميع المستخدمين على جهاز الكمبيوتر.</translation>
<translation id="673636774878526923">‏للوصول من خلال جميع أجهزتك إلى بياناتك في Decentr، عليك تسجيل الدخول وتفعيل المزامنة.</translation>
<translation id="6774082503108938489">‏أوقفَ أحد والدَيك "أذونات المواقع الإلكترونية والتطبيقات والإضافات" لمتصفِّح Decentr. ولا يمكن تفعيل <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="6847869444787758381">‏يتم إعلامك من خلال Decentr في حال تم اختراق كلمات المرور في أي وقت.</translation>
<translation id="6857782730669500492">Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">‏Google Pay (تم النسخ إلى Decentr)</translation>
<translation id="6873893289264747459">‏رصد Decentr أنّ الإضافة "<ph name="EXTENSION_NAME" />" تحتوي على برامج ضارة.</translation>
<translation id="6893813176749746474">‏تم تحديث متصفح Decentr، ولكنك لم تستخدمه منذ أكثر من 30 يومًا.</translation>
<translation id="691026815377248078">‏يجب منح Decentr الإذن بالوصول إلى البلوتوث لمواصلة عملية 
الإقران. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">‏فتح الرابط في نافذة تصفح متخفٍ في Decentr</translation>
<translation id="6978145336957848883">‏من السهل تخمين كلمات المرور الضعيفة. يمكنك السماح لمتصفِّح Decentr <ph name="BEGIN_LINK" />بإنشاء كلمات مرور قوية وتذكُّرها نيابة عنك<ph name="END_LINK" />.</translation>
<translation id="6990124437352146030">‏يحتاج Decentr إلى إذن للوصول إلى الميكروفون من أجل الموقع الإلكتروني هذا.</translation>
<translation id="705851970750939768">‏تحديث Decentr</translation>
<translation id="7067091210845072982">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول Decentr توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى Google.</translation>
<translation id="718435575166326686">‏يحتاج Decentr إلى إذن للوصول إلى الكاميرا من أجل هذا الموقع الإلكتروني.</translation>
<translation id="7196312274710523067">‏تعذَّر إطلاق Decentr. يُرجى إعادة المحاولة.</translation>
<translation id="7197677400338048821">‏يتعذّر على Decentr التحقُّق من كلمات المرور. يُرجى إعادة المحاولة بعد 24 ساعة.</translation>
