<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна. 

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="1098170124587656448">Decentr нь таныг өгөгдлийн зөрчил, муу өргөтгөл болон бусад асуудлаас хамгаалахад туслах боломжтой</translation>
<translation id="1104942323762546749">Decentr таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="113122355610423240">Decentr таны өгөгдмөл хөтөч</translation>
<translation id="1131805035311359397">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />Decentr-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">Decentr-ийн тухай</translation>
<translation id="1315551408014407711">Decentr-н шинэ профайлаа тохируулах</translation>
<translation id="1396446129537741364">Decentr нь нууц үгийг үзүүлэхээр ачаалж байна.</translation>
<translation id="1414495520565016063">Та Decentr руу нэвтэрсэн байна!</translation>
<translation id="151962892725702025">Decentr-ийн үйлдлийн систем нь таны датаг синхрончлох боломжгүй байна. Учир нь таны домайнд Синх хийх боломжгүй.</translation>
<translation id="1524282610922162960">Decentr-н таб хуваалцах</translation>
<translation id="1553461853655228091">Орчин тойрны тань 3D газрын зургийг үүсгэхийн тулд таны камерт хандах зөвшөөрөл Decentr-д шаардлагатай</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr-г дахин ачаалахыг таны администратор танаас шаардаж байна}=1{Шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="1667812772085710766">Таныг Decentr-г хаах үед энэ нь таны зочилсон хуудаснаас күүки болон сайтын өгөгдлийг автоматаар арилгана</translation>
<translation id="1708666629004767631">Decentr-ийн шинэ, илүү аюулгүй хувилбар боломжтой байна.</translation>
<translation id="1774152462503052664">Decentr-ыг арын орчинд ажиллуулах</translation>
<translation id="1779356040007214683">Decentr аюулгүй байдлыг нэмэгдүүлэхийн тулд бид <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ны жагсаалтад байхгүй бөгөөд танд мэдэгдэлгүйгээр нэмэгдсэн байж болзошгүй зарим өргөтгөлүүдийг идэвхгүй болгосон.</translation>
<translation id="1808667845054772817">Decentr-ыг дахин суулгах</translation>
<translation id="185970820835152459">Та нэвтэрсэн Google Бүртгэлүүдээ удирдах боломжтой. Таны Google Бүртгэлүүдийг Decentr хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE" />-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN" />Нэмэлт мэдээлэл авах<ph name="LINK_END" /></translation>
<translation id="1881322772814446296">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн Decentr-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны Decentr-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME" /> руу нэгдэх болно. Та энэ мэдээллийг Google-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа Decentr-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">Үүнийг унтрааснаар та Gmail зэрэг Google-н сайтуудад Decentr-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="1929939181775079593">Decentr ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="1966382378801805537">Decentr нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="1981611865800294956">&amp;Decentr OS-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="2008474315282236005">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Decentr-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="2020032459870799438">Бусад нууц үгэндээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />Decentr-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">Decentr-г өөрчлөх</translation>
<translation id="2185166961232948079">Decentr - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ Decentr-ыг тохируулж болно.</translation>
<translation id="2294245788148774212">Заавал биш: Оношилгоо болон ашиглалтын өгөгдлийг Google-д автоматаар илгээх замаар Decentr үйлдлийн системийн онцлогууд болон гүйцэтгэлийг сайжруулахад туслах.</translation>
<translation id="2343156876103232566">Та эндээс Android утсандаа дугаар илгээхийн тулд хоёр төхөөрөмжийн аль алинаас нь Decentr-д нэвтэрнэ үү.</translation>
<translation id="2347108572062610441">Энэ өргөтгөл нь таныг Decentr эхлүүлэх үед хуудас дээр харуулах зүйлийг өөрчилсөн.</translation>
<translation id="2396765026452590966">"<ph name="EXTENSION_NAME" />" өргөтгөл нь таныг Decentr эхлүүлэх үед хуудасны харуулах зүйлийг өөрчилсөн.</translation>
<translation id="2401032172288869980">Decentr-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2483889755041906834">Decentr-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2535480412977113886">Таны бүртгэлийн мэдээлэл хэтэрхий хуучирсан байгаа учраас Decentr OS-аас таны өгөгдлийг sync хийж чадсангүй.</translation>
<translation id="2560420686485554789">Файл татахын тулд Decentr-д сангийн хандалт шаардлагатай</translation>
<translation id="2572494885440352020">Decentr-ийн туслагч</translation>
<translation id="2577788541081224677">Та бүх төхөөрөмж дээрээ Decentr-н зүйлсдээ хандахын тулд нэвтэрч синк хийхийг асаана уу.</translation>
<translation id="2583187216237139145">Энэ профайлыг ашиглах үед үүссэн Decentr-н аливаа өгөгдлийг (хавчуурга, түүх, нууц үг болон бусад тохиргоог үүсгэх зэрэг) ажлын профайлын админ хасах боломжтой. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">Шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr үйлдлийн системийг дахин эхлүүлнэ үү.</translation>
<translation id="2614883797045469742">Өгөгдмөл тохиргоо нь ихэнх хүнд тохирдог хэдий ч та үүнийг Decentr-г хэрхэн ашиглах хүсэлтэй байгаадаа тааруулан өөрчлөх боломжтой</translation>
<translation id="2648074677641340862">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. Decentr-ыг дахин татаж авна уу.</translation>
<translation id="2661879430930417727">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, Decentr-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="2711502716910134313">Decentr таб</translation>
<translation id="2718390899429598676">Таны аюулгүй байдлыг сайжруулахын тулд Decentr таны өгөгдлийг шифрлэх болно.</translation>
<translation id="2770231113462710648">Стандарт веб хөтчийг дараах руу өөрчил:</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="2837693172913560447">Энэ нь <ph name="USER_EMAIL_ADDRESS" />-д Decentr-н шинэ профайл үүсгэнэ</translation>
<translation id="2847479871509788944">Decentr-аас устгах ...</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="2910007522516064972">Decentr-ын тухай</translation>
<translation id="2977470724722393594">Decentr-г шинэчилсэн байна</translation>
<translation id="2983934633046890458">Decentr нууц үгсийг засахаар оролдож байна.</translation>
<translation id="3032706164202344641">Decentr таны нууц үгсийг шалгах боломжгүй байна. Дараа дахин оролдоно уу.</translation>
<translation id="3032787606318309379">Decentr-д өгөгдөл нэмэх нь ...</translation>
<translation id="3068515742935458733">Алдаа ослын тайлан болон <ph name="UMA_LINK" />-ыг Google рүү илгээх замаар Decentr-ыг улам сайжруулахад тусална уу.</translation>
<translation id="3103660991484857065">Програм суулгагч нь архивыг задалж үл чадсан тул Decentr-г дахин татаж авна уу.</translation>
<translation id="3130323860337406239">Decentr нь таны микрофоныг ашиглаж байна.</translation>
<translation id="3155163173539279776">Decentr-г дахин эхлүүлэх</translation>
<translation id="3179665906251668410">Холбоосыг Decentr-н нууцлалтай цонхонд нээх</translation>
<translation id="3185330573522821672">Decentr-н шинэ профайлаа тохируулна уу</translation>
<translation id="3190315855212034486">Decentr-д гамтал гарлаа. Дахин эхлүүлэх үү?</translation>
<translation id="3229526316128325841">Decentr таны төхөөрөмжийг экспортлох хүсэлтэй байна.</translation>
<translation id="3258596308407688501">Decentr нь өөрийн өгөгдлийн сан руу уншуулж бас бичиж чадахгүй байна: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">Decentr <ph name="PRODUCT_VERSION" /> хувилбарыг суулгасан</translation>
<translation id="328888136576916638">Google-ийн API түлхүүр байхгүй байна. Decentr-ийн зарим функц идэвхгүй болно.</translation>
<translation id="3296368748942286671">Decentr-ийг хаахад ард байгаа програмуудыг ажиллуулсан хэвээр бай.</translation>
<translation id="331951419404882060">Нэвтэрэхэд алдаа гарсны улмаас Decentr OS таны датаг синхрончилж чадсангүй.</translation>
<translation id="3349211344363550267">Decentr танд энэ файлыг татахгүй эсвэл нээхгүй байхыг зөвлөж байна</translation>
<translation id="3350761136195634146">Энэ бүртгэлтэй Decentr-н профайл аль хэдийн байна</translation>
<translation id="3406848076815591792">Decentr-н одоо байгаа профайл руу сэлгэх үү?</translation>
<translation id="3430503420100763906">Та Decentr профайлаар Decentr-н бүх зүйлээ тусгаарлах боломжтой. Найзууд, гэр бүлдээ профайл үүсгэх эсвэл ажил болон дуртай зүйлээ хооронд нь хуваагаарай.</translation>
<translation id="347328004046849135">Таныг алдагдсан нууц үгээр нэвтрэх үед Decentr танд мэдэгдэнэ</translation>
<translation id="3474745554856756813">Энэ нь төхөөрөмжөөс <ph name="ITEMS_COUNT" /> зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Decentr-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> Decentr-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="3509308970982693815">Decentr-н бүх цонхыг хаасны дараагаар дахин хандана уу.</translation>
<translation id="3575459661164320785">Таны компьютер дээр аюултай программ хангамж байна. Decentr таны хөтчийн ажиллагааг дахин хэвийн болгохын тулд үүнийг устгах, таны тохиргоог сэргээх болон өргөтгөлүүдийг идэвхгүй болгох боломжтой.</translation>
<translation id="3639635944603682591">Энэ хэрэглэгчийн хөтчийн өгөгдлийг энэ төхөөрөмжөөс устгана. Өгөгдлийг сэргээхийн тулд Decentr-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Decentr-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно.}=1{Decentr-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Decentr-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3651803019964686660"><ph name="ORIGIN" />-с Android утсандаа дугаар илгээхийн тулд хоёр төхөөрөмжийнхөө аль алинаас нь Decentr-д нэвтэрнэ үү.</translation>
<translation id="3685209450716071127">Decentr таны нууц үгсийг шалгах боломжгүй байна. Интернэт холболтоо шалгаж үзнэ үү.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr-г дахин ачаалахыг таны администратор танаас хүсэж байна}=1{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Decentr-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3713809861844741608">Холбоосыг шинэ Decentr болон табад нээх</translation>
<translation id="3728336900324680424">Decentr хаяг оруулах хэсэгт зөвлөмж харуулахын тулд таны Драйвт хандах болно</translation>
<translation id="378917192836375108">Decentr танд веб сайтад байгаа дугаар дээр дараад Skype-тай дуудлага хийх боломжийг олгоно.</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="388648406173476553">Decentr-г өөрчилж, хянана уу. Та ямар нэг зүйлд анхаарлаа хандуулах шаардлагатай байна. Дэлгэрэнгүй мэдээлэл авахын тулд товшино уу.</translation>
<translation id="3889543394854987837">Decentr-г нээх мөн хөтөчийг ашиглаж эхлэхийн тулд өөрийн нэр дээр дарна уу.</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> Decentr-н энэ профайлд аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд Decentr танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="3945058413678539331">Decentr нь нууц үгс хуулахыг оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />Одоогийн тохиргоог<ph name="END_LINK" /> мэдэгдэж Decentr-г сайжруулахад тусална уу</translation>
<translation id="4050175100176540509">Хамгийн сүүлийн хувилбар дээр аюулгүй байдлын чухал сайжруулалт болон шинэ функцийг санал болгож байна.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх - Decentr</translation>
<translation id="421369550622382712">Decentr-д зориулсан гайхалтай апп, тоглоом, өргөтгөл болон дэлгэцийн зургуудыг олж сонирхоорой.</translation>
<translation id="4216212958613226427">Энэ хэлийг Decentr UI-г харуулахад ашигладаг</translation>
<translation id="4230135487732243613">Та өөрийн Decentr өгөгдлийг энэ хаягтай холбох хүсэлтэй байна уу?</translation>
<translation id="4264410486868823224"><ph name="MANAGER" /> танаас энэ төхөөрөмжийг ашиглахаасаа өмнө дараах Үйлчилгээний нөхцөлийг уншиж, зөвшөөрөхийг шаардаж байна. Эдгээр нөхцөл нь Decentr үйлдлийн системийн нөхцөлийг өргөтгөж, өөрчилж, хязгаарлахгүй.</translation>
<translation id="4271805377592243930">Decentr-с тусламж авах</translation>
<translation id="4285930937574705105">Гэнэтийн асуудлаас болж суулгах ажиллагаа амжилтгүй боллоо. Хэрвээ Decentr яг одоо ажиллаж байгаа бол хаагаад дахин оролдож үзнэ үү.</translation>
<translation id="4407044323746248786">Ямар ч байсан Decentr-с гарах уу?</translation>
<translation id="4415566066719264597">Decentr-г цаана ажиллуулахыг зөвшөөрөх</translation>
<translation id="4423735387467980091">Decentr-ыг гүйцэтгэх ба хянах</translation>
<translation id="452711251841752011">Decentr-д тавтай морилно уу; хөтчийн шинэ цонхыг нээсэн</translation>
<translation id="4544142686420020088">Decentr-г шинэчлээгүй, ямар нэг алдаа гарлаа. <ph name="BEGIN_LINK" />Decentr-г шинэчлэхтэй холбоотой асуудлууд болон амжилтгүй болсон шинэчлэлтүүдийг засна уу.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Decentr-н шинэ профайлд үргэлжлүүлэх үү?</translation>
<translation id="4567424176335768812">Та <ph name="USER_EMAIL_ADDRESS" /> ингэж нэвтэрсэн байна. Одоо та өөрийн нэвтэрсэн бүх төхөөрөмжүүд дээрээ хайлтын жагсаалт, түүх болон бусад тохиргоонууд руугаа нэвтэрч болно.</translation>
<translation id="459535195905078186">Decentr App</translation>
<translation id="4665829708273112819">Анхааруулга: Decentr өргөтгөлүүдийг таны хөтчийн түүхийг бичихээс хамгаалж чадахгүй. Энэ өргөтгөлийг Нууцлалтай горимд идэвхгүй болгохын тулд энэ сонголтыг болиулна уу.</translation>
<translation id="4677944499843243528">Хувийн мэдээллийг (<ph name="HOST_NAME" />) өөр компьютер дээр өөр Decentr үйлдэлд (<ph name="PROCESS_ID" />) ашиглаж байна гэж харагдаж байна. Decentr-аас хувийн мэдээллийг түгжсэн байгаа учраас үүнийг өөр зүйлд ашиглах боломжгүй юм. Хэрэв та өөр ямар ч үйлдэлд энэ хувийн мэдээллийг ашиглахгүй байгаа гэдэгт та итгэлтэй байгаа бол хувийн мэдээллээ цоожилж Decentr-ыг дахин эхлүүлж болно.</translation>
<translation id="469338717132742108">Decentr үйлдлийн системээс тусламж авах</translation>
<translation id="4708774505295300557">Хэн нэгэн энэ компьютерт <ph name="ACCOUNT_EMAIL_LAST" /> бүртгэлээр Decentr-д нэвтэрсэн байна. Мэдээллээ тусад нь хадгалахын тулд Decentr-н шинэ хэрэглэгч үүсгэнэ үү.</translation>
<translation id="4746050847053251315">Ямар ч байсан Decentr-г орхих уу?</translation>
<translation id="4748217263233248895">Decentr-н аюулгүй байдлын тусгай шинэчлэлт хийгдэж дууслаа. Одоо дахин эхлүүлнэ үү. Бид таны табыг сэргээх болно.</translation>
<translation id="4750035648288509542">Шинэчилж дуусаж байна! Шинэчлэлтийг дуусгахын тулд Decentr-г дахин ачаална уу. Нууцлалтай цонхыг дахин нээхгүй.</translation>
<translation id="4788777615168560705">Decentr таны нууц үгсийг шалгах боломжгүй байна. 24 цагийн дараа дахин оролдоно уу эсвэл <ph name="BEGIN_LINK" />өөрийн Google Бүртгэл дэх нууц үгсийг шалгана уу<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Энэ нь Google хайлтад ашигладаг зөв бичгийн ижил алдаа шалгагчийг ашигладаг. Таны хөтчид бичсэн текстийг Google-д илгээдэг. Та энэ ажиллах төлөвийг хүссэн үедээ тохиргоонд өөрчилж болно</translation>
<translation id="4888717733111232871">MDNS урсгалыг зөвшөөрөхийн тулд Decentr-д зориулсан хөндлөнгийн дүрэм.</translation>
<translation id="4893347770495441059">&amp;Decentr-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="4943838377383847465">Decentr нь суурь горимд байна.</translation>
<translation id="4987820182225656817">Зочид Decentr-ийг ашигласнаар хамгийн сүүлийн үеийн мэдээллийг авна.</translation>
<translation id="4994636714258228724">Өөрийгөө Decentr руу нэмэх</translation>
<translation id="5224391634244552924">Хадгалсан ямар ч нууц үг алга. Таныг нууц үгсээ хадгалах үед Decentr тэднийг шалгах боломжтой.</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" /> Decentr-н энэ профайлд аль хэдийн нэвтэрсэн байна. Энэ нь <ph name="USER_EMAIL_ADDRESS" />-д Decentr-н шинэ профайл үүсгэнэ</translation>
<translation id="5277894862589591112">Өөрчлөлтөө хэрэгжүүлэхийн тулд Decentr-г дахин ажиллуулна уу</translation>
<translation id="5358375970380395591">Та удирдан ажиллаж буй хаягт нэвтэрч байгаагаас гадна таны Decentr профайлыг хянах эрхийг системийн ажилтанд шилжүүлж байна. Таны апп, хавчуурга, түүх, нууц үг болон бусад тохиргоо гэх мэт таны Decentr өгөгдлийг <ph name="USER_NAME" />-тэй холбох болно. Та энэхүү өгөгдлийг Google Accounts Dashboard-р дамжуулан устгах боломжтой боловч та энэхүү өгөгдлийн өөр хаягтай холбох боломжгүй байна. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Decentr-г шинэчилж байна (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Decentr-д нэвтрэхийг зөвшөөрөх</translation>
<translation id="5398878173008909840">Ашиглах боломжтой Decentr-ийн шинэ хувилбар байна.</translation>
<translation id="5416696090975899932">Суурилуулсан PDF харагч байхгүй тохиолдолд Decentr хэвлэх байдлаар урьдчилан харуулах боломжгүй.</translation>
<translation id="5427571867875391349">Decentr-ыг өөрийн анхдагч веб хөтөч болгон тохируулах</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Decentr Бета</translation>
<translation id="5479196819031988440">Decentr үйлдлийн систем энэ хуудсыг нээх боломжгүй.</translation>
<translation id="5480860683791598150">Таны байршлыг энэ сайттай хуваалцахын тулд Decentr-д таны байршилд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="549669000822060376">Decentr нь хамгийн сүүлийн үеийн системийн шинэчлэлтүүдийг суулгаж байгаа тул түр хүлээнэ үү.</translation>
<translation id="5496810170689441661">Decentr нь нууц үгсийг засах гэж оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="5527463683072221100">PDF-г Decentr-д нээх</translation>
<translation id="5623402015214259806">{0,plural, =0{Decentr-н шинэчлэлт боломжтой байна}=1{Decentr-н шинэчлэлт боломжтой байна}other{Decentr-н шинэчлэлт # хоногийн турш боломжтой байсаар байна}}</translation>
<translation id="5634636535844844681">Decentr-д Windows 7 болон үүнээс дээших хувилбарууд шаардлагатай.</translation>
<translation id="5653831366781983928">Decentr-г одоо дахин эхлүүлнэ үү</translation>
<translation id="5698481217667032250">Decentr-г энэ хэлээр харуулах</translation>
<translation id="5820394555380036790">Decentr-н үйлдлийн систем</translation>
<translation id="5854740544000584380">Decentr үйлдлийн системийг <ph name="BEGIN_LINK_LINUX_OSS" />Linux-н хөгжүүлэлтийн орчин <ph name="END_LINK_LINUX_OSS" /> болох нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамж<ph name="END_LINK_CROS_OSS" />-аар боломжтой болгосон.</translation>
<translation id="5862307444128926510">Decentr-д тавтай морил</translation>
<translation id="5883558403894052917">Эдгээр зүйл хортой программ агуулж байгааг Decentr олж мэдлээ:</translation>
<translation id="5895138241574237353">Дахин асаах</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх</translation>
<translation id="5987687638152509985">Синкийг эхлүүлэхийн тулд Decentr-г шинэчлэх</translation>
<translation id="6039377483953237732">Decentr үйлдлийн системийн хувилбар</translation>
<translation id="6055895534982063517">Decentr-ийн шинэ хувилбар боломжтой байна. Хэзээ хэзээнээс ч хурдан.</translation>
<translation id="6063093106622310249">&amp;Decentr-д нээх</translation>
<translation id="6072279588547424923"><ph name="EXTENSION_NAME" />-г Decentr-д нэмсэн</translation>
<translation id="608006075545470555">Энэ хөтчид ажлын профайл нэмэх</translation>
<translation id="608189560609172163">Decentr нь нэвтрэх хэсэгт гарсан алдаатай холбоотойгоор таны өгөгдлийн тохиргоог хийж чадсангүй.</translation>
<translation id="6096348254544841612">Decentr-г тохируулж, хянана уу. Шинэчлэх боломжтой.</translation>
<translation id="6120345080069858279">Decentr энэ нууц үгийг таны Google Бүртгэлд хадгалах тул та үүнийг санах шаардлагагүй.</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> аюултай тул үүнийг Decentr блок хийсэн.</translation>
<translation id="6134968993075716475">Аюулгүй үзэх онцлог унтраалттай байна. Decentr түүнийг асаахыг зөвлөж байна.</translation>
<translation id="6145820983052037069">Та энд Decentr-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="6183079672144801177">Та Decentr-д өөрийн <ph name="TARGET_DEVICE_NAME" />-с нэвтэрсэн эсэхээ шалгаад, дахин илгээхээр оролдоно уу.</translation>
<translation id="6212496753309875659">Энэ компьютерт Decentr-ийн хамгийн сүүлийн үеийн хувилбар байна. Хэрэв программ ажиллахгүй байвал Decentr-ийг устгаад, дахин суурьлуулж үзнэ үү.</translation>
<translation id="6219195342503754812">{0,plural, =0{Decentr-г одоо дахин ажиллуулна}=1{Decentr-г 1 секундийн дотор дахин ажиллуулна}other{Decentr-г # секундийн дотор дахин ажиллуулна}}</translation>
<translation id="6241367896540709610">Файл татахын тулд Decentr-д хадгалах санд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="6248213926982192922">Decentr-ыг анхдагч веб хөтөч болгох</translation>
<translation id="6266342355635466082">Decentr нь шинэчлэлтийг шалгах боломжгүй байна. Интернэт холболтоо шалгаж үзнэ үү.</translation>
<translation id="6268381023930128611">Decentr-с гарах уу?</translation>
<translation id="6281746429495226318">Decentr-н профайлаа өөрчлөх</translation>
<translation id="6290827346642914212">Decentr-н профайлаа нэрлэнэ үү</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> аюултай байж болзошгүй тул үүнийг Decentr блок хийсэн.</translation>
<translation id="6309712487085796862">Decentr таны камерыг ашиглаж байна.</translation>
<translation id="6333502561965082103">Decentr-д өөр үйл ажиллагаа явагдаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="6334986366598267305">Одоо та Google хаягаа ашиглан мөн өөр бусад компьютер дээр Decentr-г ашиглахад хялбар боллоо.</translation>
<translation id="6373523479360886564">Та Decentr-ыг устгахыг хүсэж байгаадаа итгэлтэй байна уу?</translation>
<translation id="6403826409255603130">Decentr бол веб хуудсууд болон аппликейшнуудыг цахилгааны хурдаар ажиллуулдаг веб хөтөч юм. Энэ нь хурдан, найдвартай мөн хэрэглэхэд хялбар. Decentr-д бий болгосон хорт вирус болон фишингийн хамгаалалтыг ашиглан вебээр илүү аюулгүй хайлт хийгээрэй.</translation>
<translation id="6434250628340475518">Decentr OS Систем</translation>
<translation id="6455857529632101747">Decentr профайлд тавтай морилно уу</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Decentr 1 секундийн дараа дахин эхэлнэ}other{Decentr # секундийн дараа дахин эхэлнэ}}</translation>
<translation id="6475912303565314141">Энэ нь мөн таныг Decentr-ыг эхлүүлж байх үед гарч ирсэн хуудсыг хянадаг.</translation>
<translation id="6510925080656968729">Decentr-ийг устгах</translation>
<translation id="6542839706527980775">Профайл тус бүр Decentr-н өөрийн мэдээллийг агуулах бөгөөд үүнд хавчуурга, түүх, нууц үг болон бусад мэдээлэл багтана</translation>
<translation id="6570579332384693436">Зөв бичгийн алдааг засахын тулд Decentr таны текстийн талбарт бичсэн текстийг Google-д илгээдэг</translation>
<translation id="6598877126913850652">Decentr-н мэдэгдлийн тохиргоо руу очих</translation>
<translation id="6613594504749178791">Таныг Decentr дахин эхлүүлэхэд өөрчлөлт идэвхжинэ.</translation>
<translation id="665732753414869868">Таны эргэн тойрны 3D газрын зургийг үүсгэхийн тулд Decentr-д камерын зөвшөөрөл шаардлагатай</translation>
<translation id="6676384891291319759">Интернэтэд нэвтрэх</translation>
<translation id="6709350901466051922">Decentr-д энэ сайтад зориулж микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="6717134281241384636">Таны профайлыг ашиглах боломжгүй байна. Учир нь энэ Decentr-ийн шинэ хувилбараас ирсэн байна.

Зарим функц ажиллахгүй байж болно. профайлын өөр зааварчилгааг тодорхойлж өгөх эсвэл Decentr-ийн шинэ хувилбарыг ашиглана уу.</translation>
<translation id="6734080038664603509">Decentr-ийг шинэчлэх</translation>
<translation id="6734291798041940871">Decentr-г таны компьютерийн бүх хэрэглэгчид суулгасан байна.</translation>
<translation id="673636774878526923">Та бүх төхөөрөмж дээрээ Decentr-н зүйлсдээ хандахын тулд нэвтэрч, дараа нь синк хийхийг асаана уу.</translation>
<translation id="6774082503108938489">Таны эцэг эх Decentr-н "Сайтууд, аппууд болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна. Энэ <ph name="EXTENSION_TYPE_PARAMETER" />-г идэвхжүүлэхийг зөвшөөрдөггүй.</translation>
<translation id="6847869444787758381">Хэрэв таны нууц үг алдагдсан байвал Decentr танд мэдэгдэнэ</translation>
<translation id="6857782730669500492">Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (Decentr-д хуулсан)</translation>
<translation id="6873893289264747459">"<ph name="EXTENSION_NAME" />" хортой программ агуулж байгааг Decentr олж мэдлээ</translation>
<translation id="6893813176749746474">Decentr нь шинэчлэгдсэн байгаа хэдий ч та үүнийг доод тал нь 30 хоногийн турш ашиглаагүй байна.</translation>
<translation id="691026815377248078">Үргэлжлүүлэн хослуулахын тулд Decentr-д Bluetooth-н 
 хандалт шаардлагатай. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">Холбоосыг Decentr-н нууцлалтай цонхонд нээх</translation>
<translation id="6978145336957848883">Сул нууц үгийг таахад хялбар байдаг. Decentr-д <ph name="BEGIN_LINK" />танд зориулан сайн нууц үг үүсгэж, санах<ph name="END_LINK" /> боломж олгоорой.</translation>
<translation id="6990124437352146030">Энэ сайтыг ашиглахын тулд Decentr-д таны микрофонд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="705851970750939768">Decentr-г шинэчлэх</translation>
<translation id="7067091210845072982">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол Decentr танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ.</translation>
<translation id="7147279922647361552">Decentr-н хамгийн чухал нууцлалын сонголтуудын заримыг нь өөрчлөөрэй</translation>
<translation id="718435575166326686">Decentr-д энэ сайтад зориулж камерын зөвшөөрөл шаардлагатай</translation>
<translation id="7196312274710523067">Decentr-г эхлүүлж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="7197677400338048821">Decentr таны нууц үгсийг шалгах боломжгүй байна. 24 цагийн дараа дахин оролдоно уу.</translation>
<translation id="7223968959479464213">Бодлогын менежер - Decentr</translation>
<translation id="731644333568559921">Шинэчлэлт &amp; Decentr үйлдлийн систем</translation>
<translation id="731795002583552498">Decentr-г шинэчилж байна</translation>
<translation id="7318036098707714271">Таны тохиргоо файл алдаатай эсвэл хүчин төгөлдөр бус байна. Decentr таны тохиргоог сэргээх боломжгүй байна.</translation>
<translation id="7337881442233988129">Decentr</translation>
<translation id="7339898014177206373">Шинэ цонх</translation>
<translation id="734373864078049451">Таны веб хуудас, хавчуурга, болон бусад Decentr-ийн зүйлс энд байдаг.</translation>
<translation id="7349591376906416160">Таны системийн админ Decentr-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд <ph name="ALTERNATIVE_BROWSER_NAME" />-г нээхээр тохируулсан байна.</translation>
<translation id="7448255348454382571">Decentr OS-г дахин эхлүүлэх</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - Decentr Дев</translation>
<translation id="7451052299415159299">Энэ сайтыг ашиглахын тулд Decentr-д таны камерт хандах зөвшөөрөл шаардлагатай</translation>
<translation id="7483335560992089831">Одоо ажиллаж байгаа Decentr-ын ижил хувилбарыг суулгаж чадахгүй байна. Decentr-аа хаагаад дахин оролдоно уу.</translation>
<translation id="753534427205733210">{0,plural, =1{Decentr-г 1 минутын дотор дахин ажиллуулна}other{Decentr-г # минутын дотор дахин ажиллуулна}}</translation>
<translation id="7549178288319965365">Decentr үйлдлийн системийн тухай</translation>
<translation id="7561906087460245826">Decentr-н (<ph name="URL" />) өгөгдлийг мөн адил устгах</translation>
<translation id="7585853947355360626">Хэрэв энэ хуудсан дээр тохиргоог харуулахгүй байгаа бол <ph name="LINK_BEGIN" />
      Decentr үйлдлийн системийнхээ тохиргоо<ph name="LINK_END" /> дотроос хайна уу</translation>
<translation id="761356813943268536">Decentr нь таны камер болон микрофоныг ашиглаж байна.</translation>
<translation id="7617377681829253106">Decentr сайжирлаа</translation>
<translation id="7686590090926151193">Decentr таны өгөгдмөл хөтөч биш юм</translation>
<translation id="7689606757190482937">Төхөөрөмжүүддээ Decentr-г синк хийж, хувийн болгох</translation>
<translation id="7729447699958282447">Таны домэйн хаяг өгөгдөл суурьлуулах боломжгүй байгаа тул Decentr-д таны өгөгдлийг оруулах боломжгүй байгаа болно.</translation>
<translation id="7745317241717453663">Энэ нь төхөөрөмжөөс таны хайлтын түүхийг устгана. Өгөгдлөө дараа сэргээхийн тулд Decentr-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="7747138024166251722">Суулгагч нь түр зуурын хадгалалтын санг үүсгэж чадсангүй. Дискэнд сул зай байгаа эсэхийг мөн программ хангамж суулгах зөвшөөрлийг шалгана уу.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - Decentr Канари</translation>
<translation id="7828947555739565424">Энэ бүртгэлтэй Decentr-н профайл аль хэдийн энэ төхөөрөмж дээр байна</translation>
<translation id="7857220146454061152">Decentr-н цаашдын шинэчлэлтийг авахын тулд танд OS X 10.11 буюу түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер OS X 10.10 хувилбарыг ашиглаж байна.</translation>
<translation id="7867198900892795913">Decentr-г хамгийн сүүлийн хувилбарт шинэчлээгүй тул та шинэ онцлог болон аюулгүй байдлын засвар авах боломжгүй байна.</translation>
<translation id="7898472181347242998">Таны төхөөрөмж шинэчлэгдсэн эсэхийг харахын тулд <ph name="LINK_BEGIN" />Decentr үйлдлийн системийн тохиргоо<ph name="LINK_END" /> руу очно уу</translation>
<translation id="7937630085815544518">Та Decentr-д <ph name="USER_EMAIL_ADDRESS" />-аар нэвтэрсэн байна. Нэвтрэхийн тулд ижил данс хэрэглэнэ үү.</translation>
<translation id="7975919845073681630">Энэ нь Decentr-н хоёр дахь суулгалт тул таны өгөгдмөл хөтчөөр сонгох боломжгүй.</translation>
<translation id="8013436988911883588">Decentr-д хандалт олгосны дараа веб сайтууд таны хандалтыг асуух боломжтой болно.</translation>
<translation id="8045118833343856403">Дараах бүртгэлүүд Decentr-н ямар ч профайлд нэвтрээгүй байна. Хэрэв та бүртгэлийг өөр профайлд ашиглахыг хүсвэл эхлээд тухайн профайлыг хасна уу.</translation>
<translation id="8105840573057009683">Decentr-д энэ сайтад зориулж байршлын зөвшөөрөл шаардлагатай</translation>
<translation id="81770708095080097">Энэ файл аюултай тул Decentr блоклосон байна.</translation>
<translation id="8248265253516264921">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол Decentr танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ. Та үүнийг хүссэн үедээ тохиргоонд унтрааж болно.</translation>
<translation id="8266560134891435528">Та нэвтрээгүй байгаа тул Decentr таны нууц үгсийг шалгах боломжгүй байна</translation>
<translation id="8276522524898344151">Decentr нь нууц үгс хуулахыг оролдож байна.</translation>
<translation id="8290862415967981663">Энэ файл аюултай тул Decentr блоклосон байна.</translation>
<translation id="8330519371938183845">Төхөөрөмжүүддээ Decentr-г синк хийж, хувийн болгохын тулд нэвтрэх</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> өмнө нь Decentr-г ашиглаж байсан</translation>
<translation id="8417404458978023919">{0,plural, =1{Decentr-г 1 хоногийн дотор дахин ажиллуулна уу}other{Decentr-г # хоногийн дотор дахин ажиллуулна уу}}</translation>
<translation id="8453117565092476964">Суулгагчийн архив устгагдсан эсвэл хүчингүй болсон байна. Decentr-ыг дахин татаж авна уу.</translation>
<translation id="8493179195440786826">Decentr нь хуучирсан байна</translation>
<translation id="8550334526674375523">Энэ ажлын профайл нь таны хувийн профайлаас бүрэн тусдаа байна.</translation>
<translation id="8558383651099478961">Таны эцэг эх Decentr-н "Сайтууд, аппууд болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна. Энэ <ph name="EXTENSION_TYPE_PARAMETER" />-г нэмэхийг зөвшөөрдөггүй.</translation>
<translation id="8568283329061645092">Decentr нь таныг Google Бүртгэлээрээ нэвтрэх үед таны нууц үгсийг шалгах боломжтой</translation>
<translation id="8586442755830160949">Decentr-ийн зохиогчийн эрх <ph name="YEAR" />. Бүх эрхийг хуулиар хамгаалсан.</translation>
<translation id="8619360774459241877">Decentr-г эхлүүлж байна...</translation>
<translation id="8621669128220841554">Гэнэтийн алдаанаас болж суулгах ажиллагаа амжилтгүй боллоо. Decentr-ыг дахин татаж авна уу.</translation>
<translation id="8697124171261953979">Энэ нь мөн таныг Decentr-ыг эхлүүлж байх үед эсвэл Omnibox-аас хайлт хийж буй үед гарч ирдэг хуудсыг хянаж байдаг.</translation>
<translation id="8704119203788522458">Энэ бол таны Decentr.</translation>
<translation id="8796602469536043152">Энэ сайтыг ашиглахын тулд Decentr-д таны камер болон микрофонд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="8803635938069941624">Decentr OS-ын нөхцлүүд</translation>
<translation id="8821041990367117597">Таны нэвтрэх мэдээлэл хуучирсан учир Decentr таны датаг синхрончилж чадсангүй.</translation>
<translation id="8862326446509486874">Танд системийн түвшинд суулгах зохих эрх байхгүй байна. Суулгагчийг админы хувиар дахин ажиллуулахыг оролдож үзнэ үү.</translation>
<translation id="8880203542552872219">Хэрэв тийм бол Decentr-д хадгалсан нууц үгээ засаж, шинэ нууц үгтэйгээ тааруулна уу.</translation>
<translation id="8897323336392112261">Энэ нь мөн таныг Decentr-ыг эхлүүлэх эсвэл Home товчлуурыг дарах үед гарч ирэх хуудсыг хянаж байдаг.</translation>
<translation id="8907580949721785412">Decentr нь нууц үгийг харуулахыг оролдож байна. Үүнийг зөвшөөрөхөөр бол  Windows нууц үгээ бичнэ үү.</translation>
<translation id="8941642502866065432">Decentr-г шинэчилж чадсангүй</translation>
<translation id="8974095189086268230">Decentr OS-ыг нэмэлт <ph name="BEGIN_LINK_CROS_OSS" /> нээлттэй эхийн программ хангамжаар <ph name="END_LINK_CROS_OSS" /> боломжтой болгосон байна.</translation>
<translation id="8986207147630327271">Та энэ хөтчид ажлын профайл нэмж байгаа бөгөөд администратордоо зөвхөн ажлын профайлын хяналтыг өгч байна.</translation>
<translation id="9019929317751753759">Decentr-г илүү аюулгүй болгохын тулд <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> жагсаалтанд байхгүй, танд мэдэгдэлгүйгээр нэмэгдсэн байж болох дараах өргөтгөлийг идэвхгүй болголоо.</translation>
<translation id="9089354809943900324">Decentr хуучирсан байна</translation>
