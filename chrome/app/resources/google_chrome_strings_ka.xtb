<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1001534784610492198">ინსტალატორის არქივი დაზიანებული ან არასწორია. გთხოვთ, ხელახლა ჩამოტვირთოთ Decentr.</translation>
<translation id="102763973188675173">მოირგეთ და გააკონტროლეთ Decentr. ხელმისაწვდომია განახლება.</translation>
<translation id="1051826050538111504">თქვენს კომპიუტერზე აღმოჩენილია საზიანო პროგრამული უზრუნველყოფა. Decentr-ს შეუძლია მისი ამოშლა, თქვენი პარამეტრების აღდგენა და გაფართოებების გათიშვა, რომ ბრაუზერმა კვლავ ნორმალურად იმუშაოს.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" /> დრე იყენებდა Decentr-ს</translation>
<translation id="110877069173485804">ეს არის თქვენი Decentr</translation>
<translation id="1125124144982679672">ვინ იყენებს Decentr-ს?</translation>
<translation id="1142745911746664600">Decentr-ის განახლება ვერ მოხერხდა</translation>
<translation id="1154147086299354128">Decentr-ში &amp;გახსნა</translation>
<translation id="1182414570724401860">Decentr გირჩევთ, არ ჩამოტვირთოთ და არც გახსნათ ეს ფაილი</translation>
<translation id="1278833599417554002">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="1293325835983155583"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის Decentr OS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="1302523850133262269">დაელოდეთ, სანამ Decentr დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="137466361146087520">Decentr Beta</translation>
<translation id="1399397803214730675">ამ კომპიუტერს უკვე აქვს Google Chrom-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ Decentr-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="1434626383986940139">Decentr Canary პროგრამები</translation>
<translation id="1507198376417198979">მოირგეთ თქვენი ახალი Decentr პროფილი</translation>
<translation id="1516530951338665275">დაწყვილების გასაგრძელებლად Decentr საჭიროებს Bluetooth-ზე წვდომას. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1553358976309200471">Decentr-ის განახლება</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> უკვე შესულია ამ Decentr პროფილში. ეს მოქმედება შექმნის ახალ Decentr პროფილს <ph name="USER_EMAIL_ADDRESS" />-ისთვის</translation>
<translation id="1587223624401073077">Decentr იყენებს თქვენს კამერას.</translation>
<translation id="1587325591171447154">Decentr-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="1597911401261118146"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1619887657840448962">Decentr-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="1628000112320670027">Decentr-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="1674870198290878346">ბმულის გახსნა Decentr-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="1682634494516646069">Decentr ვერ ახერხებს თავის მონაცემთა დირექტორიაში წაკითხვას და ჩაწერის განხორციელებას:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">Decentr არის ვებ-ბრაუზერი, რომელიც ძალიან სწრაფად ხსნის ვებ-გვერდებს და პროგრამებს. იგი სწრაფი, სტაბილური და ადვილად გამოსაყენებელია. უფრო უსაფრთხოდ დაათვალიერეთ ინტერნეტ-გვერდები, Decentr-ში ჩაშენებული საზიანო პროგრამების და თაღლითობის საწინააღმდეგო დაცვის დახმარებით.</translation>
<translation id="1713301662689114961">{0,plural, =1{Decentr ხელახლა გაეშვება 1 საათში}other{Decentr ხელახლა გაეშვება # საათში}}</translation>
<translation id="1734234790201236882">Decentr შეინახავს ამ პაროლს თქვენს Google ანგარიშში. მისი დამახსოვრება აუცილებელი არ არის.</translation>
<translation id="174539241580958092">შესვლის დროს დაშვებული შეცდომის გამო Decentr-მა ვერ მოახდინა თქვენი მონაცემების სინქრონიზაცია.</translation>
<translation id="1759842336958782510">Decentr</translation>
<translation id="1786003790898721085">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ Decentr-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="1812689907177901597">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Decentr-ში შესვლის გარეშე</translation>
<translation id="1860536484129686729">Decentr საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="1873233029667955273">Decentr არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="1874309113135274312">Decentr Beta (mDNS-In)</translation>
<translation id="1877026089748256423">Decentr მოძველებულია</translation>
<translation id="1919130412786645364">Decentr-ში შესვლის დაშვება</translation>
<translation id="2018528049276128029">თითოეულ პროფილში ინახება საკუთარი Decentr ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="2063848847527508675">განახლების მისასადაგებლად, Decentr OS უნდა გადაიტვირთოს.</translation>
<translation id="2094919256425865063">მაინც გსურთ Decentr-იდან გასვლა?</translation>
<translation id="2120620239521071941">ეს მოქმედება წაშლის <ph name="ITEMS_COUNT" /> ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="2123055963409958220">ხელი შეუწყვეთ Decentr-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="2151406531797534936">გთხოვთ, ახლავე გადატვირთოთ Decentr</translation>
<translation id="2189289170880510015">მოირგეთ Decentr-ის კონფიდენციალურობის კუთხით ყველაზე მნიშვნელოვანი ვარიანტები</translation>
<translation id="2246246234298806438">Decentr-ს არ შეუძლია აჩვენოს ნახვა ამობეჭდვამდე როდესაც ჩაშენებული PDF მნახველი არ არის.</translation>
<translation id="2290014774651636340">Google API გასაღები გამოტოვებულია. Decentr-ის ზოგიერთი ფუნქცია გამორთული იქნება.</translation>
<translation id="2290095356545025170">ნამდვილად გსურთ მოახდინოთ Decentr-ის დეინსტალაცია?</translation>
<translation id="2309047409763057870">ეს Decentr-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="2345992953227471816">Decentr-მა აღმოაჩინა, რომ შემდეგი გაფართოებები შეიცავს მავნე პროგრამას:</translation>
<translation id="2348335408836342058">Decentr საჭიროებს თქვენს კამერასა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="234869673307233423">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ მოგვიანებით.</translation>
<translation id="235650106824528204">ამ პროფილის გამოყენებისას შექმნილი Decentr მონაცემების (მაგ., შექმნილი სანიშნეების, ისტორიის, პაროლებისა და სხვა პარამეტრების) ამოშლა შეუძლია სამსახურის პროფილის ადმინისტრატორს. <ph name="LEARN_MORE" /></translation>
<translation id="2429317896000329049">Decentr-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან სინქრონიზაცია არ არის ხელმისაწვდომი თქვენი დომენისთვის.</translation>
<translation id="2467438592969358367">Decentr ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="2485422356828889247">დეინსტალაცია</translation>
<translation id="2518751521812750372">Decentr-ის დახურვისას ის ავტომატურად გაასუფთავებს თქვენ მიერ მონახულებულ გვერდებთან დაკავშირებულ ქუქი-ჩანაწერებსა და საიტების მონაცემებს</translation>
<translation id="2534507159460261402">Google Pay (Decentr-ში კოპირებული)</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> უკვე შესულია ამ Decentr პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Decentr-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="2580411288591421699">შეუძლებელია იმავე Decentr-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Decentr და ხელახლა სცადეთ.</translation>
<translation id="2586406160782125153">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2622559029861875898">Decentr ვერ ახერხებს განახლებების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="2644798301485385923">Decentr OS სისტემა</translation>
<translation id="2652691236519827073">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="2665296953892887393">დაგვეხმარეთ Decentr-ის გაუმჯობესებაში: გამოგზავნეთ მოხსენებები შეცდომების შესახებ <ph name="UMA_LINK" /> Google-ში</translation>
<translation id="2689103672227170538">ამ გაფართოებამ თქვენ მიერ Decentr-ის გაშვებისას ნაჩვენები გვერდი შეცვალა.</translation>
<translation id="2742320827292110288">გაფრთხილება: Decentr ვერ შეუშლის ხელს გაფართოებებს ვების დათვალიერების ისტორიის შენახვაში. ამ გაფართოების ინკოგნიტო რეჟიმში გამოსართავად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="2765403129283291972">Decentr საჭიროებს თქვენს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2770231113462710648">შეცვალეთ ნაგულისხმევი ბრაუზერი-ით:</translation>
<translation id="2775140325783767197">Decentr ვერ ახერხებს პაროლების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="2799223571221894425">ხელახლა გაშვება</translation>
<translation id="2847461019998147611">Decentr-ის ამ ენაზე ჩვენება</translation>
<translation id="2857540653560290388">მიმდინარეობს Decentr-ის გაშვება…</translation>
<translation id="2857972467023607093">ამ ანგარიშის მქონე Decentr პროფილი უკვე არსებობს</translation>
<translation id="2861074815332034794">მიმდინარეობს Decentr-ის განახლება (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">თქვენ შესული ხართ Decentr-ში!</translation>
<translation id="2885378588091291677">ამოცანების მმართველი</translation>
<translation id="2888126860611144412">Decentr-ის შესახებ</translation>
<translation id="2926676257163822632">სუსტი პაროლები ადვილი გამოსაცნობია, ამიტომ მიეცით საშუალება Decentr-ს, <ph name="BEGIN_LINK" />თქვენთვის შექმნას და დაიმახსოვროს ძლიერი პაროლები<ph name="END_LINK" />.</translation>
<translation id="2926952073016206995">Decentr საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2929907241665500097">Decentr-ის განახლება ვერ მოხერხდა შეფერხების გამო. <ph name="BEGIN_LINK" />შეასწორეთ Decentr-ის განახლებასთან დაკავშირებული პრობლემები და განუხორციელებელი განახლებები.<ph name="END_LINK" /></translation>
