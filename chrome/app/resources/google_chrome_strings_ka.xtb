<translation id="2094919256425865063">მაინც გსურთ Decentr-იდან გასვლა?</translation>
<translation id="2106831557840787829">DecentrOS Flex და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო<ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="2120620239521071941">ეს მოქმედება წაშლის <ph name="ITEMS_COUNT" /> ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="2123055963409958220">ხელი შეუწყვეთ Decentr-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="2126108037660393668">ჩამოტვირთული ფაილის დადასტურება ვერ მოხერხდა.</translation>
<translation id="2128411189117340671">Decentr-ის პროფილების მართვა</translation>
<translation id="2131230230468101642">თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. სურვილისამებრ, შეგიძლიათ წაშალოთ ინტერესები, რომლებიც არ გსურთ, Decentr-მა რომ გაითვალისწინოს.</translation>
<translation id="2139300032719313227">გადატვირთეთ DecentrOS</translation>
<translation id="2151406531797534936">გთხოვთ, ახლავე გადატვირთოთ Decentr</translation>
<translation id="2174917724755363426">ინსტალაცია არ დასრულებულა. ნამდვილად გსურთ გაუქმება?</translation>
<translation id="2190166659037789668">შეცდომა განახლების შემოწმებისასr: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199691482078155239">Decentr გაძლევთ მეტ კონტროლს თქვენთვის ხილულ რეკლამაზე. ის, ასევე, ზღუდავს იმას, თუ რომელ საიტებს შეუძლია თქვენ შესახებ ინფორმაციის მიღება, როცა მათ მიერ თქვენთვის ნაჩვენებია პერსონალიზებული რეკლამა.</translation>
<translation id="2216543877350048334">Decentr-იდან Decentr ანგარიში რომ ამოშალოთ, საჭიროა სისტემიდან გასვლა</translation>
<translation id="223889379102603431">ინფორმაცია Decentr-ის მიერ თავისი ძირეული სერტიფიკატების მართვის შესახებ</translation>
<translation id="2258103955319320201">Decentr ბრაუზერში თქვენს კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, შემდეგ კი ჩართეთ სინქრონიზაცია</translation>
<translation id="2290014774651636340">Decentr API გასაღები გამოტოვებულია. Decentr-ის ზოგიერთი ფუნქცია გამორთული იქნება.</translation>
<translation id="2290095356545025170">ნამდვილად გსურთ მოახდინოთ Decentr-ის დეინსტალაცია?</translation>
<translation id="2309047409763057870">ეს Decentr-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="2345992953227471816">Decentr-მა აღმოაჩინა, რომ შემდეგი გაფართოებები შეიცავს მავნე პროგრამას:</translation>
<translation id="2348335408836342058">Decentr საჭიროებს თქვენს კამერასა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="234869673307233423">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ მოგვიანებით.</translation>
<translation id="235650106824528204">ამ პროფილის გამოყენებისას შექმნილი Decentr მონაცემების (მაგ., შექმნილი სანიშნეების, ისტორიის, პაროლებისა და სხვა პარამეტრების) ამოშლა შეუძლია სამსახურის პროფილის ადმინისტრატორს. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">გაგრძელება</translation>
<translation id="2390624519615263404">უსაფრთხოების ფუნქციების ნახვა</translation>
<translation id="2401189691232800402">DecentrOS სისტემა</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{1 HID მოწყობილობაზე წვდომა ხორციელდებოდა ერთი ან რამდენიმე Decentr გაფართოების მიერ}=1{1 HID მოწყობილობაზე წვდომა ხორციელდება ერთი ან რამდენიმე Decentr გაფართოების მიერ}other{# HID მოწყობილობაზე წვდომა ხორციელდება ერთი ან რამდენიმე Decentr გაფართოების მიერ}}</translation>
<translation id="2424440923901031101">ეს გაფართოება არღვევს Decentr Web Store-ის წესებს და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="2467438592969358367">Decentr ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="2472092250898121027">ეს გაფართოება შეიცავს მავნე პროგრამას და ის არ არის უსაფრთხო. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="2485422356828889247">დეინსტალაცია</translation>
<translation id="2513154137948333830">საჭიროა გადატვირთვა: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Decentr-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="2556847002339236023">თქვენი ორგანიზაცია ხურავს Decentr-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="2559253115192232574">მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, Decentr-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით. Decentr-ს შეუძლია 3-მდე ინტერესის გაზიარება.</translation>
<translation id="2563121210305478421">გსურთ Decentr-ის ხელახლა გაშვება?</translation>
<translation id="2569974318947988067">Decentr შეეცდება, გადაიტანოს ნავიგაცია HTTPS-ზე</translation>
<translation id="2571392474191184472">თქვენი ორგანიზაცია მართავს Decentr-ს</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> უკვე შესულია ამ Decentr პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Decentr-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="2580411288591421699">შეუძლებელია იმავე Decentr-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Decentr და ხელახლა სცადეთ.</translation>
<translation id="2586406160782125153">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2597976513418770460">მიიღეთ Decentr ბრაუზერში შენახული თქვენი კონტენტი <ph name="ACCOUNT_EMAIL" />-დან</translation>
<translation id="259935314519650377">ჩამოტვირთული ინსტალატორის ქეშირება ვერ მოხერხდა. შეცდომა: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2622559029861875898">Decentr ვერ ახერხებს განახლებების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="2632707915638608719">Decentr-ის გაფართოებებით კიდევ უფრო მეტს შეძლებთ</translation>
<translation id="2645435784669275700">DecentrOS</translation>
<translation id="2649768380733403658">Decentr რეგულარულად ამოწმებს, არის თუ არა თქვენს ბრაუზერში ყველაზე უსაფრთხო პარამეტრები. გაცნობებთ, თუ რაიმეს შემოწმება იქნება საჭირო.</translation>
<translation id="2652691236519827073">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="2665296953892887393">დაგვეხმარეთ Decentr-ის გაუმჯობესებაში: გამოგზავნეთ მოხსენებები შეცდომების შესახებ <ph name="UMA_LINK" /> Decentr-ში</translation>
<translation id="2681444469812712297">გახსენით <ph name="URL" /> Decentr-ის ახალ ჩანართში.</translation>
<translation id="2738871930057338499">ინტერნეტთან დაკავშირება ვერ ხერხდება. HTTP 403 — აკრძალულია. შეამოწმეთ პროქსი-სერვერის კონფიგურაცია.</translation>
<translation id="2742320827292110288">გაფრთხილება: Decentr ვერ შეუშლის ხელს გაფართოებებს ვების დათვალიერების ისტორიის შენახვაში. ამ გაფართოების ინკოგნიტო რეჟიმში გამოსართავად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="2765403129283291972">Decentr საჭიროებს თქვენს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2770231113462710648">შეცვალეთ ნაგულისხმევი ბრაუზერი-ით:</translation>
<translation id="2775140325783767197">Decentr ვერ ახერხებს პაროლების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="2797864378188255696">Decentr სერვისებში, მაგალითად, Gmail-სა თუ YouTube-ში <ph name="USER_EMAIL" />-ით შესვლისას შეგიძლიათ ავტომატურად შეხვიდეთ Decentr-შიც იმავე ანგარიშით</translation>
<translation id="2799223571221894425">ხელახლა გაშვება</translation>
<translation id="2825024317344269723">სახიფათო საიტი Decentr-მა ამოშალა შეტყობინებები.</translation>
<translation id="2846251086934905009">შეცდომა ინსტალაციისას: ინსტალატორის მუშაობა ვერ დასრულდა. ინსტალაცია შეწყდა.</translation>
<translation id="2847461019998147611">Decentr-ის ამ ენაზე ჩვენება</translation>
<translation id="2853415089995957805">Decentr წინასწარ ჩატვირთავს გვერდებს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="2857540653560290388">მიმდინარეობს Decentr-ის გაშვება…</translation>
<translation id="2857972467023607093">ამ ანგარიშის მქონე Decentr პროფილი უკვე არსებობს</translation>
<translation id="286025080868315611">შეიტყვეთ, რატომ ბლოკავს Decentr ზოგიერთ ჩამოტვირთვას</translation>
<translation id="2861074815332034794">მიმდინარეობს Decentr-ის განახლება (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">თქვენ შესული ხართ Decentr-ში!</translation>
<translation id="2876628302275096482">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს Decentr თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="2885378588091291677">ამოცანების მმართველი</translation>
<translation id="2888126860611144412">Decentr-ის შესახებ</translation>
<translation id="29082080693925013">ორგანიზებული რომ იყოთ, ჩაამაგრეთ ხშირად მონახულებული ვებსაიტები და დააჯგუფეთ ჩანართები</translation>
<translation id="2915996080311180594">მოგვიანებით გადატვირთვა</translation>
<translation id="2926676257163822632">სუსტი პაროლები ადვილი გამოსაცნობია, ამიტომ მიეცით საშუალება Decentr-ს, <ph name="BEGIN_LINK" />თქვენთვის შექმნას და დაიმახსოვროს ძლიერი პაროლები<ph name="END_LINK" />.</translation>
<translation id="2926952073016206995">Decentr საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2928420929544864228">ინსტალაცია დასრულდა.</translation>
<translation id="2929907241665500097">Decentr-ის განახლება ვერ მოხერხდა შეფერხების გამო. <ph name="BEGIN_LINK" />შეასწორეთ Decentr-ის განახლებასთან დაკავშირებული პრობლემები და განუხორციელებელი განახლებები.<ph name="END_LINK" /></translation>
<translation id="2945997411976714835">შეცდომა ინსტალაციისას: ინსტალატორის პროცესი ვერ გაეშვა.</translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" /> — ქსელში შესვლა — Decentr</translation>
<translation id="2970681950995291301">Decentr-იდან Decentr ანგარიში რომ ამოშალოთ, საჭიროა, სისტემიდან გახვიდეთ Decentr-ის პარამეტრების გვერდზე</translation>
<translation id="3018957014024118866">ასევე, წაიშალოს მონაცემები Decentr-იდან (<ph name="URL" />)</translation>
<translation id="3019382870990049182">ხელახლა გაშვება &amp;DecentrOS Flex-ის გასაახლებლად</translation>
<translation id="3037838751736561277">Decentr ფონურ რეჟიმშია.</translation>
<translation id="3038232873781883849">ინსტალაციის მოლოდინში...</translation>
<translation id="3059710691562604940">Safe Browsing გამორთულია. Decentr გირჩევთ მის ჩართვას.</translation>
<translation id="306179102415443347">ისარგებლეთ მალსახმობით, Decentr პაროლების მმართველზე სწრაფად რომ გადახვიდეთ. მალსახმობის გადატანა შეგიძლიათ თქვენი კომპიუტერის მთავარ ეკრანზე ან აპების გამშვებში.</translation>
<translation id="3065168410429928842">Decentr-ის ჩანართი</translation>
<translation id="3080151273017101988">გაგრძელება გაშვებული ფონური პროგრამებით Decentr-ის დახურვისას</translation>
<translation id="3100998948628680988">დაასათაურეთ თქვენი Decentr პროფილი</translation>
<translation id="3112458742631356345">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="3114643501466072395"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს სხვა პაროლებს.</translation>
<translation id="3119573284443908657">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან არქივის ფაილი შეიცავს სხვა ფაილებს, რომლებშიც, შესაძლოა, მავნე პროგრამა იმალებოდეს</translation>
<translation id="3140883423282498090">თქვენი ცვლილებები Decentr.ის გადატვირთვის შემდეგ შევა ძალაში.</translation>
<translation id="3149510190863420837">Decentr-ის პროგრამები</translation>
<translation id="3169523567916669830">ცდების მსვლელობისას შეძლებთ იმ ინტერესთა თემების ნახვასა და ამოშლას, რომლებსაც საიტები იყენებს თქვენთვის რეკლამის საჩვენებლად. თქვენს ინტერესებს Decentr პროგნოზირებს თქვენ მიერ ვების დათვალიერების ბოლოდროინდელი ისტორიის საფუძველზე.</translation>
<translation id="3196187562065225381">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი სახიფათოა</translation>
<translation id="3226612997184048185">თუ თქვენს სანიშნეებს Decentr ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Decentr-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="3234642784688107085">გამოცადეთ ხელოვნური ინტელექტის ახალი ფუნქციები, რომ შექმნათ თემები, მიიღოთ დახმარება წერისას და იყოთ ორგანიზებული</translation>
<translation id="3245429137663807393">თუ თქვენ აზიარებთ Decentr-ის მოხმარების ანგარიშებსაც, ეს ანგარიშები ასევე მოიცავს თქვენ მიერ მონახულებულ URL-ებს</translation>
<translation id="3261565993776444564">ცადეთ ახალი ფერი თქვენი ბრაუზერის მოსარგებად</translation>
<translation id="3282568296779691940">შესვლა Decentr-ში</translation>
<translation id="3286538390144397061">გადატვირთეთ ახლა</translation>
<translation id="3292333338048274092">დაგჭირდებათ Decentr-ის გადატვირთვა.</translation>
<translation id="3360895254066713204">Decentr-ის დამხმარე</translation>
<translation id="3379938682270551431">{0,plural, =0{Decentr ახლა ხელახლა გაეშვება}=1{Decentr ხელახლა გაეშვება 1 წამში}other{Decentr ხელახლა გაეშვება # წამში}}</translation>
<translation id="3396977131400919238">ინსტალაციის დროს წარმოიქმნა ოპერატიული სისტემის შეცდომა. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="3428747202529429621">უზრუნველყოფს თქვენს უსაფრთხოებას Decentr-ში და Decentr-ის სხვა აპებში, როცა სისტემაში შესული ხართ</translation>
<translation id="3434246496373299699">პაროლების Decentr-ის მეშვეობით შესამოწმებლად შედით სისტემაში თქვენი Decentr ანგარიშით</translation>
<translation id="3438681572027105609">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Decentr-ში</translation>
<translation id="3450887623636316740">ეს ფაილი, შესაძლოა, სახიფათო იყოს<ph name="LINE_BREAK" />Decentr-ს შეუძლია, თქვენ ნაცვლად შეამოწმოს ეს ჩამოტვირთვა, თუ პაროლს მიუთითებთ. ფაილის შესახებ ინფორმაცია ეგზავნება Decentr Safe Browsing-ს, თუმცა ფაილების შიგთავსი და პაროლი რჩება თქვენს მოწყობილობაზე.</translation>
<translation id="3451115285585441894">Decentr-ში დამატება…</translation>
<translation id="345171907106878721">საკუთარი თავის დამატება Decentr-ში</translation>
<translation id="3453763134178591239">DecentrOS პირობები</translation>
<translation id="3503306920980160878">Decentr საჭიროებს თქვენს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის გასაზიარებლად</translation>
<translation id="3533694711092285624">შენახული პაროლები არ არის. პაროლების შემოწმებას Decentr მოახერხებს მათი შენახვის შემდეგ.</translation>
<translation id="3541482654983822893">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში.</translation>
<translation id="3564543103555793392">Decentr-ში შესვლის შემდეგ შეგიძლიათ სანიშნეების, პაროლებისა და სხვა მონაცემების შენახვა, რომ შემდეგ ისინი თქვენს ტელეფონში გამოიყენოთ</translation>
<translation id="3576528680708590453">თქვენი სისტემის ადმინისტრატორმა მოახდინა Decentr-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა ალტერნატიული ბრაუზერის გახსნა.</translation>
<translation id="3582972582564653026">მოახდინეთ Decentr-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="3583751698304738917">თქვენ უკვე შესული ხართ Decentr-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="3595784445906693824">გსურთ, შეხვიდეთ Decentr-ის ახალ პროფილში?</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას}=1{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="3597003331831379823">მაღალი პრივილეგიებით დაყენების გაშვება ვერ მოხერხდა. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3609788354808247807">ბოლო დროს არ ყოფილხართ. Decentr-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და <ph name="PERMISSION_3" /></translation>
<translation id="3622797965165704966">ადვილი გახდა თქვენი Decentr-ის ანგარიშის მეშვეობით Decentr-ის გამოყენება და საერთო მოხმარების კომპიუტერებზეც.</translation>
<translation id="3635073343384702370">პაროლების შემოწმებას Decentr შეძლებს მათი შენახვის შემდეგ</translation>
<translation id="3667616615096815454">ინსტალაცია ვერ მოხერხდა, რადგან აპლიკაცია სერვერისთვის ცნობილი არ არის.</translation>
<translation id="3673813398384385993">Decentr-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME" />“ შეიცავს მავნე პროგრამას</translation>
<translation id="3695446226812920698">შეიტყვეთ როგორ</translation>
<translation id="3697952514309507634">სხვა Decentr პროფილები</translation>
<translation id="3703994572283698466">DecentrOS და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო <ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="3716540481907974026">DecentrOS Flex-ის ვერსია</translation>
<translation id="3718181793972440140">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="3723744677043446310">{NUM_EXTENSIONS,plural, =1{Decentr გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}other{Decentr გირჩევთ მათ ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}}</translation>
<translation id="3744202345691150878">დახმარების მიღება DecentrOS-თან დაკავშირებით</translation>
<translation id="3780814664026482060">Decentr — <ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">DecentrOS Flex-მა ვერ მოახერხა თქვენი მონაცემების სინქრონიზაცია, რადგან შესვლისას მოხდა შეცდომა.</translation>
<translation id="3795971588916395511">DecentrOS</translation>
<translation id="3809772425479558446">Decentr-ის მუშაობისთვის საჭიროა Windows 10 ან უფრო ახალი ვერსია.</translation>
<translation id="3835168907083856002">ეს მოქმედება შექმნის ახალ Decentr პროფილს <ph name="USER_EMAIL_ADDRESS" />-ისთვის</translation>
<translation id="383928141529488001">Bluetooth მოწყობილობების აღმოსაჩენად Decentr საჭიროებს 
 Bluetooth-ზე წვდომას. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="386202838227397562">დახურეთ Decentr-ის ყველა ფანჯარა და ხელახლა სცადეთ.</translation>
<translation id="3865754807470779944">დაინსტალირებულია Decentr-ის ვერსია <ph name="PRODUCT_VERSION" /></translation>
<translation id="3873044882194371212">ბმულის გახსნა Decentr-ი ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="3889417619312448367">Decentr-ის დეინსტალაცია</translation>
<translation id="3941890832296813527">შეცდომა ინსტალაციისას: ინსტალატორის ფაილის სახელი არასწორი ან მხარდაუჭერელია.</translation>
<translation id="3973161977468201858">Decentr-ს სურს თქვენი Decentr პაროლების მმართველის მონაცემების წაშლა. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="398236277091248993">Decentr ინარჩუნებს სისწრაფეს ეფექტურობის გაძლიერების ფუნქციებით</translation>
<translation id="3999683152997576765">თქვენ შეძლებთ თქვენთვის საინტერესო იმ თემების ნახვასა და ამოშლას, რომლებსაც საიტები იყენებს თქვენთვის რეკლამის საჩვენებლად. თქვენს ინტერესებს Decentr პროგნოზირებს თქვენ მიერ ვების დათვალიერების ბოლოდროინდელი ისტორიის საფუძველზე.</translation>
<translation id="4035053306113201399">განახლების მისასადაგებლად, DecentrOS უნდა გადაიტვირთოს.</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="4053720452172726777">Decentr-ის მორგება და კონტროლი</translation>
<translation id="408393047846373801">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Decentr-ში. შესვლის შემდეგ ეს პაროლი შეინახება თქვენს Decentr ანგარიშში.</translation>
<translation id="4084404300720192944">თქვენი ფანჯრის გასაზიარებლად დაუშვით ეკრანის ჩაწერა Decentr-ისთვის სისტემის პარამეტრებში.</translation>
<translation id="4106587138345390261">Decentr მუშაობს ახალ ფუნქციებზე, რომელთა მეშვეობითაც საიტებს იგივე ფუნქციონალი შეუნარჩუნდება თქვენი ნაკლები ინფორმაციის გამოყენებით</translation>
<translation id="4110895483821904099">შექმენით ახალი Decentr პროფილი</translation>
<translation id="4111566860456076004">Decentr ვერ ადასტურებს ამ გაფართოების წარმომავლობას და შესაძლოა, ის სახიფათო იყოს. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="4128488089242627000">Decentr უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს (რეკომენდებული)</translation>
<translation id="4147555960264124640">თქვენ სისტემაში შედიხართ მართული ანგარიშზით და მის ადმინისტრატორს აძლევთ თქვენი Decentr-ის პროფილის კონტროლის შესაძლებლობას. თქვენი Decentr მონაცემები, როგორიცაა თქვენი პროგრამები, სანიშნეები, ისტორია, პაროლები, და სხვა პარამეტრები გახდება მუდმივად <ph name="USER_NAME" />-თან მიბმული. თქვენ შეძლებთ ამ მონაცემების წაშლას Decentr Accounts Dashboard-ის მეშვეობით, მაგრამ თქვენ ვერ შეძლებთ ამ მონაცემების დაკავშირებას სხვა ანგარიშთან. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">ინსტალაცია…</translation>
<translation id="4149882025268051530">ინსტალაციის პროგრამამ ვერ ამოიღო ფაილები არქივიდან. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="4153934450158521343">Decentr მალე დაიხურება, ხოლო მონაცემები წაიშლება</translation>
<translation id="4173512894976930765">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Decentr-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Decentr ანგარიში, თუ მასში შესული ხართ Decentr-იდან.</translation>
<translation id="4175922240926474352">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს საიტი არ იყენებს დაცულ კავშირს, ამიტომ ფაილი, შესაძლოა, მოდიფიცირებული იყოს</translation>
<translation id="4191857738314598978">{0,plural, =1{ხელახლა გაუშვით Decentr დღის განმავლობაში}other{ხელახლა გაუშვით Decentr # დღის განმავლობაში}}</translation>
<translation id="4205939740494406371">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში ან <ph name="BEGIN_LINK" />შეამოწმეთ პაროლები თქვენს Decentr ანგარიშში<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">მიმდინარეობს გაუქმება…</translation>
<translation id="4224210481850767180">ინსტალაცია გაუქმდა.</translation>
<translation id="4242034826641750751">Decentr საჭიროებს კამერისა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="424864128008805179">გსურთ Decentr-იდან გამოსვლა?</translation>
<translation id="4251615635259297716">მივამაგროთ Decentr-ის მონაცემები ამ ანგარიშზე?</translation>
<translation id="4262915912852657291"><ph name="BEGIN_BOLD" />გამოყენებული მონაცემების ტიპები:<ph name="END_BOLD" /> თქვენ მიერ ვების დათვალიერების ისტორია, ამ მოწყობილობაზე თქვენ მიერ Decentr-ის მეშვეობით მონახულებული საიტების ჩანაწერი.</translation>
<translation id="4281844954008187215">მომსახურების პირობები</translation>
<translation id="4293420128516039005">შედით სისტემაში, რათა მოახდინოთ Decentr-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="430327780270213103">გაფართოებისთვის Decentr-ის ხელსაწყოთა ზოლში წვდომის მოთხოვნების ჩვენების დაშვება</translation>
<translation id="4328355335528187361">Decentr Dev (mDNS-In)</translation>
<translation id="4329315893554541805">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Decentr როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Decentr სერვისებს</translation>
<translation id="4334294535648607276">ჩამოტვირთვა დასრულდა.</translation>
<translation id="4335235004908507846">Decentr დაგიცავთ პერსონალურ მონაცემთა გაჟონვის შემთხვევებისგან, არასათანადო გაფართოებებისა და სხვა უსიამოვნებისგან</translation>
<translation id="4343195214584226067"><ph name="EXTENSION_NAME" /> დაემატა Decentr-ს</translation>
<translation id="4348548358339558429">პერსონალიზაციით რომ ისარგებლოთ, დაურთეთ Decentr ვებსა და აპებში აქტივობას</translation>
<translation id="436060642166082913">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ფაილს შეუძლია თქვენი პირადი და სოციალური ქსელების ანგარიშების დაზიანება.</translation>
<translation id="4384570495110188418">Decentr ვერ ახერხებს თქვენი პაროლების შემოწმებას, რადგან შესული არ ხართ</translation>
<translation id="4389991535395284064">ვების ინკოგნიტო რეჟიმში დათვალიერებისას Decentr გაგაფრთხილებთ საიტის დაუცველი კავშირის გამოყენებით ჩატვირთვამდე</translation>
<translation id="4427306783828095590">გაძლიერებული დაცვა გთავაზობთ ფიშინგისა და მავნე პროგრამებისგან დაცვის მეტ საშუალებას</translation>
<translation id="4434353761996769206">ინსტალატორის შეცდომა: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438657683599538446">Decentr-ში შესვლა, როგორც <ph name="USER_EMAIL" /></translation>
<translation id="4450664632294415862">Decentr — ქსელში შესვლა — <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">Decentr-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="4459234553906210702">რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Decentr-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="4567424176335768812">თქვენ შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" />. ახლა შეგიძლიათ გახსნათ თქვენი სანიშნეები, ისტორია და სხვა პარამეტრები ყველა მოწყობილობიდან, რომელშიც შესული ხართ.</translation>
<translation id="4571503333518166079">Decentr-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="4575717501879784448">Decentr-ს შეუძლია, თქვენი ჩანართები უმოქმედო რეჟიმში გადაიტანოს, რათა გააუმჯობესოს თქვენი დათვალიერების გამოცდილება და გაასუფთაოს რესურსები.</translation>
<translation id="459622048091363950">Decentr-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="4600710005438004015">Decentr ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="4624065194742029982">Decentr-ის ინკოგნიტო რეჟიმი</translation>
<translation id="4627412468266359539">არასავალდებულო: ხელი შეუწყვეთ DecentrOS Flex-ის ფუნქციებისა თუ ეფექტურობის გაუმჯობესებას დიაგნოსტიკისა და გამოყენების მონაცემების Decentr-ისთვის ავტომატურად გაგზავნის მეშვეობით.</translation>
<translation id="4633000520311261472">Decentr-ის უსაფრთხოების გაზრდის მიზნით, ჩვენ გავთიშეთ რამდენიმე გაფართოება, რომელიც არ არის ჩამოთვლილი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, დამატებულია თქვენი თანხმობის გარეშე.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="469553575393225953">უცნობი წყაროებიდან მომავალ გაფართოებებს, აპებსა და თემებს შეუძლია თქვენი მოწყობილობის დაზიანება. Decentr გირჩევთ, დააინსტალიროთ ისინი მხოლოდ Decentr Web Store-იდან.</translation>
<translation id="4710245680469034439">მოირგეთ ბრაუზერი ხელოვანების, ბუნებისა და სხვა კოლექციებით შთაგონებული თემებით</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="4728575227883772061">ინსტალაცია ვერ გონხორციელდა გაურკვეველი შეცდომის გამო. თუ Decentr ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="4747730611090640388">Decentr-ს შეუძლია თქვენი ინტერესების პროგნოზირება.  მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, Decentr-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით.</translation>
<translation id="4754614261631455953">Decentr Canary (mDNS-In)</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Decentr Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Decentr-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="4793679854893018356">შეიტყვეთ, როგორ ზრუნავს Decentr თქვენს უსაფრთხოებაზე</translation>
<translation id="4828579605166583682">Decentr ცდილობს არსებული პაროლების ჩანაცვლებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="4842397268809523050">DecentrOS Flex-მა ვერ მოახერხა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენი დომენისთვის სინქრონიზაცია მიუწვდომელია.</translation>
<translation id="4851866215237571846"><ph name="EXISTING_USER" /> მზად არის შესასვლელად.  ცალკე დათვალიერების გასაგრძელებლად შედით Decentr-ში თქვენს პირად პროფილში <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4862446263930606916">თქვენს ორგანიზაციას შეუძლია თქვენ მიერ ვების დათვალიერების მონაცემების ნახვა და მართვა თქვენს სამსახურის პროფილში (მაგალითად, თქვენი სანიშნეების, ისტორიისა და პაროლების). ის ვერ შეძლებს თქვენი პერსონალური Decentr პროფილებით ვების დათვალიერების მონაცემების ნახვას.</translation>
<translation id="4873692836499071887">მომავალში Decentr-ის განახლებების მისაღებად დაგჭირდებათ macOS 11 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 10.15-ს.</translation>
<translation id="4873783916118289636">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Decentr-ში</translation>
<translation id="4891791193823137474">Decentr გაიშვას ფონურ რეჟიმში</translation>
<translation id="4895437082222824641">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="492720062778050435">Decentr გირჩევთ, შეამოწმოთ ეს გაფართოება</translation>
<translation id="4951177103388687412">იყავით ორგანიზებული და ფოკუსირებული ჩანართების ჯგუფების დახმარებით</translation>
<translation id="4953650215774548573">Decentr-ის დაყენება ნაგულისხმევ ბრაუზერად</translation>
<translation id="495931528404527476">Decentr-ში</translation>
<translation id="4969674060580488087">DecentrOS Flex-მა ვერ მოახერხა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენი ანგარიშის სისტემაში შესვლის მონაცემები მოძველდა.</translation>
<translation id="4970761609246024540">მოგესალმებათ Decentr პროფილები</translation>
<translation id="4970880042055371251">DecentrOS ვერსია</translation>
<translation id="4990567037958725628">Decentr Canary</translation>
<translation id="4997044641749333913">Decentr-ს შეუძლია, თქვენი ჩანართები უმოქმედო რეჟიმში გადაიტანოს, რათა გააუმჯობესოს თქვენი დათვალიერების გამოცდილება და უზრუნველყოს სისწრაფე.</translation>
<translation id="5003967926796347400">დაწკაპუნებით აირჩიეთ „Decentr პაროლების მმართველი“</translation>
<translation id="5120334927898581447">შედით Decentr-ში, როცა Decentr-ის სხვა სერვისებში შედიხართ</translation>
<translation id="5126049312684316860">Decentr წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="5132929315877954718">აღმოაჩინეთ დიდებული აპები, თამაშები, გაფართოებები და თემები Decentr-ისთვის.</translation>
<translation id="5139423532931106058">თქვენი Decentr პროფილის მორგება</translation>
<translation id="5161361450770099246">Decentr-ს შეუძლია, ეს ჩანართი უმოქმედო რეჟიმში გადაიტანოს, რათა გააუმჯობესოს თქვენი დათვალიერების გამოცდილება და გაასუფთაოს რესურსები.</translation>
<translation id="5163087008893166964">მოგესალმებით Decentr-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="5170938038195470297">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან იგი მიღებულია Decentr-ის უფრო ახალი ვერსიიდან.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. მიუთითეთ პროფილის სხვა დირექტორია ან გამოიყენეთ Decentr-ის უფრო ახალი ვერსია.</translation>
<translation id="5201744974236816379">Decentr-ის განახლება</translation>
<translation id="521447420733633466">თუ საზიარო მოწყობილობა გაქვთ, თქვენს მეგობრებსა და ოჯახის წევრებს შეუძლიათ ვების დამოუკიდებლად დათვალიერება და Decentr-ის საკუთარი შეხედულებისამებრ დაყენება</translation>
<translation id="5239627039202700673">გამოიყენეთ Decentr შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="5251420635869119124">სტუმრებს შეუძლიათ Decentr-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="5320351714793324716">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Decentr-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="5334309298019785904">DecentrOS-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან სინქრონიზაცია თქვენი დომენისთვის არ არის ხელმისაწვდომი.</translation>
<translation id="5334487786912937552">ფაილების ჩამოსატვირთად Decentr საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="5337648990166757586">არასავალდებულო: DecentrOS-ის ფუნქციებისა და წარმადობის გაუმჯობესების ხელშეწყობა დიაგნოსტიკური და გამოყენების მონაცემების Decentr-ისთვის ავტომატურად გაგზავნის მეშვეობით.</translation>
<translation id="5357889879764279201">დახმარების მიღება DecentrOS Flex-თან დაკავშირებით</translation>
<translation id="5368118228313795342">დამატებითი კოდი: <ph name="EXTRA_CODE" />.</translation>
<translation id="5386244825306882791">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას ან Omnibox-დან ძიების დროს.</translation>
<translation id="5394833366792865639">Decentr-ის ჩანართის გაზიარება</translation>
<translation id="5412485296464121825">საიტებს Decentr-ის მეშვეობით შეუძლია თქვენს ინტერესებთან დაკავშირებული ინფორმაციის შენახვა. მაგალითად, თუ მარათონისთვის ფეხსაცმლის საყიდლად რომელიმე საიტს მოინახულებთ, აღნიშნულმა საიტმა შეიძლება განსაზღვროს, რომ მარათონებში მონაწილეობა გაინტერესებთ. მოგვიანებით, თუ განსხვავებულ საიტს მოინახულებთ, მაგალითად, რბოლაში მონაწილეობის მისაღებად რეგისტრაციისთვის, ამ საიტმა შეიძლება სპორტული ფეხსაცმლის რეკლამა გაჩვენოთ თქვენი ინტერესების საფუძველზე.</translation>
<translation id="5430073640787465221">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

Decentr ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="5468572406162360320">ამ ფუნქციების გაუმჯობესების მიზნით, თქვენს მათთან ურთიერთქმედებას Decentr გაუგზავნის Decentr-ს. აღნიშნული მონაცემების წაკითხვა, დამუშავება და ანოტირება, შესაძლოა, განხორციელდეს ადამიანი მიმომხილველების მიერ.</translation>
<translation id="5524761631371622910">როცა ცდები ჩართულია და თუ Decentr შემთხვევითობის პრინციპით მიგაღებინებთ მონაწილეობას მიმდინარე ცდაში, თქვენ მიერ ვების დათვალიერების ისტორია აისახება თქვენთვის ხილულ რეკლამასა და თქვენს ინტერესებზე, ქვემოთ პროგნოზირებულის შესაბამისად. თქვენი კონფიდენციალურობის დაცვის მიზნით, Decentr წაშლის თქვენს ინტერესებს ყოველთვიურად რიგითობის მიხედვით.</translation>
<translation id="5530733413481476019">ააჩქარეთ Decentr-ის მუშაობა</translation>
<translation id="5566025111015594046">Decentr (mDNS-In)</translation>
<translation id="5602351063754773347">Decentr გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" /></translation>
<translation id="5648328599815354043">Decentr ყველაფერს აკეთებს თქვენს დასაცავად ონლაინ სივრცეში</translation>
<translation id="565744775970812598">Decentr-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას}=1{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="5686916850681061684">მოირგეთ და გააკონტროლეთ Decentr. საჭიროა თქვენი ყურადღება — დააწკაპუნეთ დეტალური ინფორმაციისთვის.</translation>
<translation id="5690427481109656848">Decentr LLC</translation>
<translation id="569897634095159764">ინტერნეტთან დაკავშირება ვერ ხერხდება. პროქსი-სერვერი საჭიროებს ავტორიზაციას.</translation>
<translation id="570005089986962444">ჩართვის შემთხვევაში, Decentr გამოათავისუფლებს მეხსიერებას არააქტიური ჩანართებიდან. აქტიურ ჩანართებსა და სხვა აპებს კომპიუტერის მეტი რესურსის გამოყენების საშუალება მიეცემა, რაც დააჩქარებს Decentr-საც. თქვენი არააქტიური ჩანართები ავტომატურად გააქტიურდება, როცა მათ დაუბრუნდებით.</translation>
<translation id="5709557627224531708">დააყენეთ Decentr ნაგულისხმევ ბრაუზერად</translation>
<translation id="5727531838415286053">თუ Decentr შემთხვევითობის პრინციპით მიგაღებინებთ მონაწილეობას მიმდინარე ცდაში, თქვენ მიერ ვების დათვალიერების ისტორია აისახება თქვენთვის ხილულ რეკლამასა და თქვენს ინტერესებზე, ქვემოთ პროგნოზირებულის შესაბამისად. თქვენი კონფიდენციალურობის დაცვის მიზნით, Decentr წაშლის თქვენს ინტერესებს ყოველთვიურად რიგითობის მიხედვით. ინტერესები გაახლდება, თუ რომელიმე მათგანს არ წაშლით.</translation>
<translation id="5736850870166430177">საიტის მიერ პაროლის მოპარვის მცდელობის ან თქვენ მიერ საზიანო ფაილის ჩამოტვირთვის შემთხვევაში Decentr-ის მიერ Safe Browsing-ს გაეგზავნება URL-ები და შესაბამისი გვერდის კონტენტის გარკვეული ნაწილი</translation>
<translation id="5756509061973259733">Decentr პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
