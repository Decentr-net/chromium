<translation id="1587325591171447154">Decentr-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="1597911401261118146"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1619887657840448962">Decentr-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="1627304841979541023"><ph name="BEGIN_BOLD" />თქვენი მონაცემების მართვის ხერხები:<ph name="END_BOLD" /> თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. სურვილისამებრ, შეგიძლიათ წაშალოთ ინტერესები, რომლებიც არ გსურთ, Decentr-მა რომ გაითვალისწინოს.</translation>
<translation id="1628000112320670027">Decentr-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1662146548738125461">DecentrOS Flex-ის შესახებ</translation>
<translation id="1674870198290878346">ბმულის გახსნა Decentr-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="1682634494516646069">Decentr ვერ ახერხებს თავის მონაცემთა დირექტორიაში წაკითხვას და ჩაწერის განხორციელებას:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1689338313606606627">Decentr-ს შეუძლია, ეს ჩანართი უმოქმედო რეჟიმში გადაიტანოს, რათა გააუმჯობესოს თქვენი დათვალიერების გამოცდილება და მოქმედებების შესრულება ააჩქაროს.</translation>
<translation id="1698376642261615901">Decentr არის ვებ-ბრაუზერი, რომელიც ძალიან სწრაფად ხსნის ვებ-გვერდებს და პროგრამებს. იგი სწრაფი, სტაბილური და ადვილად გამოსაყენებელია. უფრო უსაფრთხოდ დაათვალიერეთ ინტერნეტ-გვერდები, Decentr-ში ჩაშენებული საზიანო პროგრამების და თაღლითობის საწინააღმდეგო დაცვის დახმარებით.</translation>
<translation id="1713301662689114961">{0,plural, =1{Decentr ხელახლა გაეშვება 1 საათში}other{Decentr ხელახლა გაეშვება # საათში}}</translation>
<translation id="1722488837206509557">ამის საშუალებით თქვენ აირჩევთ ხელმისაწვდომი მოწყობილობებიდან და მათზე კონტენტს აჩვენებთ.</translation>
<translation id="1734234790201236882">Decentr შეინახავს ამ პაროლს თქვენს Decentr ანგარიშში. მისი დამახსოვრება აუცილებელი არ არის.</translation>
<translation id="1786003790898721085">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ Decentr-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="1786044937610313874">მალსახმობები იხსნება Decentr-ში</translation>
<translation id="178701303897325119">ეს გაფართოება აღარ არის მხარდაჭერილი. Decentr გირჩევთ მის ამოშლას.</translation>
<translation id="1812689907177901597">ამ პარამეტრის გამორთვის შემთხვევაში, Decentr-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Decentr-ში შესვლის გარეშე</translation>
<translation id="1860536484129686729">Decentr საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="1873233029667955273">Decentr არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="1874309113135274312">Decentr Beta (mDNS-In)</translation>
<translation id="1877026089748256423">Decentr მოძველებულია</translation>
<translation id="1907925560334657849">ფანჯრის გასაზიარებლად დაუშვით ეკრანის ჩაწერა Decentr-ისთვის სისტემის პრეფერენციებში</translation>
<translation id="1919130412786645364">Decentr-ში შესვლის დაშვება</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE" /> წუთი</translation>
<translation id="1982647487457769627">Decentr მუშაობს მრავალ პლატფორმაზე, რათა თქვენთვის უზრუნველყოფილი იყოს ნაცნობი გამოცდილება, მოწყობილობის ტიპის მიუხედავად</translation>
<translation id="2001586581944147178">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Decentr იყენებს უსაფრთხო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{ეს გაფართოება აღარ არის მხარდაჭერილი. Decentr გირჩევთ, ამოშალოთ ის.}other{ეს გაფართოებები აღარ არის მხარდაჭერილი. Decentr გირჩევთ, ამოშალოთ ისინი.}}</translation>
<translation id="2018528049276128029">თითოეულ პროფილში ინახება საკუთარი Decentr ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2022471217832964798">ანგარიშზე წვდომის კონფიგურირების დროსაც შეგიძლიათ Decentr-ის გამოყენება. შესაძლოა, გარკვეულ რესურსებზე არ გქონდეთ წვდომა დაყენების დასრულებამდე.</translation>
<translation id="2034233344106846793">Decentr ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="207902854391093810">როცა ცდები ჩართულია, რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Decentr-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="2091012649849228750">Decentr-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8-ს.</translation>
