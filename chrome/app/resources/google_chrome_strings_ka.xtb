<translation id="7665553140559834626">ხელახლა გაშვება &amp;Decentr OS-ის გასაახლებლად</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="7761834446675418963">დააწკაპუნეთ თქვენს სახელზე Decentr-ის გასახსნელად და დაიწყეთ დათვალიერება.</translation>
<translation id="7777080907402804672">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Decentr შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="7781002470561365167">ხელმისაწვდომია Decentr-ის უფრო ახალი ვერსია.</translation>
<translation id="778331955594035129">Decentr საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7787950393032327779">როგორც ჩანს, პროფილს იყენებს სხვა Decentr პროცესი (<ph name="PROCESS_ID" />) სხვა კომპიუტერზე (<ph name="HOST_NAME" />). Decentr-მა ჩაკეტა პროფილი, ასე რომ იგი არ დაზიანდება. თუ დარწმუნებული ხართ, რომ არც ერთი სხვა პროცესი არ იყენებს ამ პროფილს, თქვენ შეგიძლიათ პროფილის გახსნა და Decentr-ის ხელახლა გაშვება.</translation>
<translation id="7801699035218095297">Decentr ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="7808348361785373670">Decentr-იდან ამოღება...</translation>
<translation id="7825851276765848807">ინსტალაცია ვერ განხორციელდა გაურკვეველი შეცდომის გამო. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="7890208801193284374">თუ თქვენ აზიარებთ კომპიუტერს, თქვენი მეგობრები და ოჯახის წევრები შეძლებენ ინტერნეტ-გვერდების დამოუკიდებლად დათვალიერებას და Decentr-ის დაყენებას საკუთარი სურვილის შესაბამისად.</translation>
<translation id="7896673875602241923">Decentr-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Decentr-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="7917876797003313048">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Google ანგარიშები. თქვენი Google ანგარიშები გამოიყენება Decentr ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">Decentr ცდილობს პაროლების კოპირებას.</translation>
<translation id="7962410387636238736">ეს კომპიუტერი აღარ მიიღებს Decentr-ის განახლებებს, რადგან Windows XP და Windows Vista აღარ არის მხარდაჭერილი</translation>
<translation id="79947657522496226">Decentr OS და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო <ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="8008534537613507642">ხელახლა დააინსტალირეთ Decentr</translation>
<translation id="8013993649590906847">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Decentr შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში.</translation>
<translation id="8129812357326543296">&amp;Decentr-ის შესახებ</translation>
<translation id="822971176939352383">მითითებული ანგარიშები არ არის შესული Decentr პროფილებში. თუ ანგარიშის სხვა პროფილში გამოყენება გსურთ, პირველ რიგში, წაშალეთ შესაბამისი პროფილი.</translation>
<translation id="8255190535488645436">Decentr იყენებს თქვენს კამერასა და მიკროფონს.</translation>
<translation id="8286862437124483331">Decentr ცდილობს პაროლების ჩვენებას. აკრიფეთ თქვენი Windows-ის პაროლი, რათა დაუშვათ ეს.</translation>
<translation id="828798499196665338">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ Decentr-ისთვის. ეს <ph name="EXTENSION_TYPE_PARAMETER" /> ვერ ჩაირთვება.</translation>
<translation id="8290100596633877290">Decentr-ში შეცდომაა. გადავტვირთოთ?</translation>
<translation id="8342675569599923794">Decentr-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8370517070665726704">© <ph name="YEAR" />, Google LLC. ყველა უფლება დაცულია.</translation>
<translation id="840084489713044809">Decentr ითხოვს თქვენი პაროლების ექსპორტირებას.</translation>
<translation id="8433638294851456451">აქედან თქვენს Android ტელეფონზე ნომრის გასაგზავნად შედით Decentr-ში ორივე მოწყობილობაზე.</translation>
<translation id="8498858610309223613">Decentr-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე და თქვენი ჩანართებიც აღდგება.</translation>
<translation id="8521348052903287641">შემომავალი წესი Decentr Dev-ისთვის mDNS ტრაფიკის დასაშვებად.</translation>
<translation id="8540666473246803645">Decentr</translation>
<translation id="8550334526674375523">სამსახურის ეს პროფილი თქვენი პირადი პროფილისგან სრულიად დამოუკიდებლად ფუნქციონირებს.</translation>
<translation id="8556340503434111824">ხელმისაწვდომია Decentr-ის უფრო ახალი ვერსია, რომელიც უფრო სწრაფია.</translation>
<translation id="8614913330719544658">Decentr არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="861702415419836452">Decentr საჭიროებს თქვენს კამერაზე წვდომის ნებართვას, თქვენი გარემოს 3-განზომილებიანი რუკის შექმნა რომ შეძლოს</translation>
<translation id="8625237574518804553">{0,plural, =1{Decentr ხელახლა გაეშვება 1 წუთში}other{Decentr ხელახლა გაეშვება # წუთში}}</translation>
<translation id="8641606876632989680">Decentr შეგატყობინებთ, როცა სისტემაში გატეხილი პაროლით შეხვალთ</translation>
<translation id="8669527147644353129">Decentr-ის დახმარება</translation>
<translation id="8679801911857917785">იგი, ასევე, აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას.</translation>
<translation id="8686817260976772516">Decentr პროფილები Decentr-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="870251953148363156">&amp;Decentr-ის განახლება</translation>
<translation id="873133009373065397">Decentr ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="8823341990149967727">Decentr მოძველებულია</translation>
<translation id="8834965163890861871">Decentr ცდილობს პაროლების რედაქტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="884296878221830158">ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას ან როცა დააწკაპუნებთ ღილაკზე „საწყისი“.</translation>
<translation id="8862326446509486874">თქვენ არ გაქვთ შესაბამისი უფლებები სისტემის დონეზე ინსტალაციისთვის. სცადეთ ინსტალაციის პროგრამის ხელახლა გაშვება ადმინისტრატორის სტატუსით.</translation>
<translation id="8914504000324227558">Decentr-ის ხელახლა გაშვება</translation>
<translation id="8922193594870374009"><ph name="ORIGIN" />-დან თქვენს Android ტელეფონზე ნომრის გასაგზავნად შედით Decentr-ში ორივე მოწყობილობაზე.</translation>
<translation id="8986207147630327271">თქვენ აპირებთ, ამ ბრაუზერს სამსახურის პროფილი დაამატოთ, რითაც თქვენს ადმინისტრატორს კონტროლს მხოლოდ სამსახურის პროფილზე მიანიჭებთ.</translation>
<translation id="8999208279178790196">{0,plural, =0{ხელმისაწვდომია Decentr-ის განახლება}=1{ხელმისაწვდომია Decentr-ის განახლება}other{უკვე # დღეა, რაც ხელმისაწვდომია Decentr-ის განახლება}}</translation>
<translation id="9026991721384951619">Decentr OS-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან თქვენი ანგარიშის შესვლის დეტალები მოძველდა.</translation>
<translation id="9067395829937117663">Decentr-ის მუშაობისთვის საჭიროა Windows 7 ან უფრო ახალი ვერსია.</translation>
<translation id="911206726377975832">ასევე წაშალოთ თქვენი დათვალიერების მონაცემები?</translation>
<translation id="9138603949443464873">ცვლილებების მისასადაგებლად ხელახლა გაუშვით Decentr</translation>
<translation id="919706545465235479">სინქრონიზაციის დასაწყებად, განაახლეთ Decentr</translation>
<translation id="922152298093051471">Decentr-ის მორგება</translation>
<translation id="940313311831216333">თქვენს Decentr კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, შემდეგ კი ჩართეთ სინქრონიზაცია.</translation>
<translation id="989369509083708165">Decentr თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="989816563149873169"><ph name="SHORTCUT" /> გადართავს Decentr პროფილებს</translation>
</translationbundle>