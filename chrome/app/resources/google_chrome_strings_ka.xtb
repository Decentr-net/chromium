<translation id="7606334485649076285">DecentrOS Flex</translation>
<translation id="7626032353295482388">მოგესალმებათ Decentr!</translation>
<translation id="7626072681686626474"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის DecentrOS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="7629695634924605473">Decentr გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="7641148173327520642">თქვენი სისტემის ადმინისტრატორმა მოახდინა Decentr-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME" />-ის გახსნა.</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="7651907282515937834">Decentr Enterprise-ის ლოგო</translation>
<translation id="76531479118467370">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="7655455401911432608">თქვენ მიერ ვების დათვალიერების ისტორია, ამ მოწყობილობაზე თქვენ მიერ Decentr-ის მეშვეობით მონახულებული საიტების ჩანაწერი.</translation>
<translation id="7655472416356262023">ანგარიშის ამოშლა Decentr-იდან</translation>
<translation id="7661924425853052955">ბოლო დროს არ ყოფილხართ. Decentr-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" /></translation>
<translation id="7668816516367091728">შეასრულეთ ამოცანები, მაგალითად, თარგმნა, გამოთვლა და სხვა, უშუალოდ მისამართთა ზოლიდან</translation>
<translation id="7670287553302121848">Decentr ანგარიში საჭიროებს ხელახლა ავტორიზაციას</translation>
<translation id="769538538642757151">Decentr გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="7761834446675418963">დააწკაპუნეთ თქვენს სახელზე Decentr-ის გასახსნელად და დაიწყეთ დათვალიერება.</translation>
<translation id="7763983146198734674">შეინახეთ პაროლები და იქონიეთ მათზე წვდომა გზიდან</translation>
<translation id="7777080907402804672">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Decentr შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Decentr-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="778331955594035129">Decentr საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7785741298021097183">Decentr შექმნილია სწრაფი და უსაფრთხო გამოცდილების უზრუნველსაყოფად ყველა მოწყობილობაზე — ტელეფონსა თუ კომპიუტერზე.</translation>
<translation id="7787950393032327779">როგორც ჩანს, პროფილს იყენებს სხვა Decentr პროცესი (<ph name="PROCESS_ID" />) სხვა კომპიუტერზე (<ph name="HOST_NAME" />). Decentr-მა ჩაკეტა პროფილი, ასე რომ იგი არ დაზიანდება. თუ დარწმუნებული ხართ, რომ არც ერთი სხვა პროცესი არ იყენებს ამ პროფილს, თქვენ შეგიძლიათ პროფილის გახსნა და Decentr-ის ხელახლა გაშვება.</translation>
<translation id="7801699035218095297">Decentr ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="7802622118583152311">Decentr გთავაზობთ უახლეს ტექნოლოგიას დათვალიერების უკეთესი გამოცდილებისთვის</translation>
<translation id="7808348361785373670">Decentr-იდან ამოღება...</translation>
<translation id="7825851276765848807">ინსტალაცია ვერ განხორციელდა გაურკვეველი შეცდომის გამო. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="7836610565365456468">გაახალისეთ თქვენი ბრაუზერი ცოცხალი თემებით ხელოვანების, ბუნებისა და სხვა თემების შთაგონებით</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="7852254990718225089">ხელოვნური ინტელექტი Decentr-ში გეხმარებათ ვების სწრაფად, უსაფრთხოდ და მოხერხებულად დათვალიერებაში</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS" /> წამი</translation>
<translation id="7880591377632733558"><ph name="ACCOUNT_FIRST_NAME" />, მოგესალმებათ Decentr</translation>
<translation id="7890208801193284374">თუ თქვენ აზიარებთ კომპიუტერს, თქვენი მეგობრები და ოჯახის წევრები შეძლებენ ინტერნეტ-გვერდების დამოუკიდებლად დათვალიერებას და Decentr-ის დაყენებას საკუთარი სურვილის შესაბამისად.</translation>
<translation id="7896673875602241923">Decentr-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Decentr-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="7917876797003313048">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Decentr ანგარიშები. თქვენი Decentr ანგარიშები გამოიყენება Decentr ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="7947083960301164556">იხილეთ სიახლეები</translation>
<translation id="7951272445806340501">DecentrOS Flex უნდა გადაიტვირთოს განახლების გასააქტიურებლად.</translation>
<translation id="7959172989483770734">Decentr-ის პროფილების მართვა</translation>
<translation id="7962368738413920945">საიტები, სავარაუდოდ, მოლოდინისამებრ იმუშავებს, თუმცა ისინი არ დაგიმახსოვრებთ, როცა Decentr-ის ყველა ფანჯარას დახურავთ</translation>
<translation id="7962410387636238736">ეს კომპიუტერი აღარ მიიღებს Decentr-ის განახლებებს, რადგან Windows XP და Windows Vista აღარ არის მხარდაჭერილი</translation>
<translation id="8005666035647241369">Decentr პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="8008534537613507642">ხელახლა დააინსტალირეთ Decentr</translation>
<translation id="8009904340233602924">Decentr-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="8013993649590906847">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Decentr შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Decentr-ში.</translation>
<translation id="8019103195866286235">ამ გაფართოების გამოქვეყნება გაუქმდა მისი დეველოპერის მიერ და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="8040768861829554732">გაფართოების გამოსაყენებლად შედით Decentr-ში</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8064015041956107954">Decentr-ის მენიუდან, რომელიც მოცემულია ზედა მარჯვენა ნაწილში, შეგიძლიათ სანიშნეების, წაკითხვის რეჟიმისა და სხვა ერთეულების გახსნა</translation>
<translation id="8064015586118426197">DecentrOS Flex</translation>
<translation id="8077579734294125741">სხვა Decentr პროფილები</translation>
<translation id="8086881907087796310">ინსტალაცია ვერ მოხერხდა, რადგან თქვენი კომპიუტერი არ აკმაყოფილებს მინიმალურ მოთხოვნებს აპარატურის კუთხით.</translation>
<translation id="8111297389482307122">Decentr საჭიროებს თქვენი ვინაობის დადასტურებას, სანამ მონაცემები Decentr ანგარიშში შეინახება და მოწყობილობებში გამოიყენება. გამოსვლის შემთხვევაში ეს მონაცემები დარჩება ამ მოწყობილობაში.</translation>
<translation id="8129812357326543296">&amp;Decentr-ის შესახებ</translation>
<translation id="813913629614996137">მიმდინარეობს ინიცირება…</translation>
<translation id="8162006532256575008">Decentr-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="8255190535488645436">Decentr იყენებს თქვენს კამერასა და მიკროფონს.</translation>
<translation id="8257796129973882597">Decentr-ის მენიუდან შეგიძლიათ სანიშნეების, წაკითხვის რეჟიმისა და სხვა ერთეულების გახსნა</translation>
<translation id="8267953129876836456">Decentr-მა თქვენთვის იპოვა უსაფრთხოებასთან დაკავშირებული რეკომენდაციები</translation>
<translation id="8270775718612349140">Decentr-ის მიერ მართული სერტიფიკატები</translation>
<translation id="8286862437124483331">Decentr ცდილობს პაროლების ჩვენებას. აკრიფეთ თქვენი Windows-ის პაროლი, რათა დაუშვათ ეს.</translation>
<translation id="8290100596633877290">Decentr-ში შეცდომაა. გადავტვირთოთ?</translation>
<translation id="829923460755755423">დაამატეთ Decentr პაროლების მმართველის მალსახმობი</translation>
<translation id="8336463659890584292">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Decentr გამოიყენებს Decentr-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Decentr-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="8342675569599923794">Decentr-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8349795646647783032"><ph name="BEGIN_BOLD" />ამ მონაცემთა გამოყენების წესი:<ph name="END_BOLD" /> საიტებს Decentr-ის მეშვეობით შეუძლია თქვენს ინტერესებთან დაკავშირებული ინფორმაციის შენახვა. მაგალითად, თუ მარათონისთვის ფეხსაცმლის საყიდლად რომელიმე საიტს მოინახულებთ, აღნიშნულმა საიტმა შეიძლება განსაზღვროს, რომ მარათონებში მონაწილეობა გაინტერესებთ. მოგვიანებით, თუ განსხვავებულ საიტს მოინახულებთ, მაგალითად, რბოლაში მონაწილეობის მისაღებად რეგისტრაციისთვის, ამ საიტმა შეიძლება სპორტული ფეხსაცმლის რეკლამა გაჩვენოთ თქვენი ინტერესების საფუძველზე.</translation>
