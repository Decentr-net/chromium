<translation id="983803489796659991">Instalazioak huts egin du, eguneratze-zerbitzariak aplikaziorako hash-daturik ez duelako.</translation>
<translation id="989369509083708165">tomi da arakatzaile lehenetsia</translation>
<translation id="989816563149873169"><ph name="SHORTCUT" /> da tomi-ko profil batetik bestera aldatzeko lasterbidea</translation>
</translationbundle>