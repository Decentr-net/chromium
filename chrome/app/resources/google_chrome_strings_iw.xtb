<translation id="6893363893008038481">‏הסרת החשבון מ-tomi</translation>
<translation id="6933858244219479645">‏מערכת tomiOS</translation>
<translation id="6938166777909186039">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="6943584222992551122">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-tomi בתור<ph name="USER_EMAIL" />.</translation>
<translation id="6967962315388095737">‏כלל נכנס לגרסת הבטא של tomi כדי לאפשר תנועת mDNS.</translation>
<translation id="6979589607440534284">‏מידע על חסימה של קבצים מסוימים ב-tomi, נפתח בכרטיסייה חדשה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">ההתקנה נעצרה.</translation>
<translation id="7025800014283535195">‏כאן ניתן לעבור בין פרופילים של tomi</translation>
<translation id="7036251913954633326">‏אם ברצונך להשתמש בחשבון הזה באופן חד-פעמי, אפשר להשתמש <ph name="GUEST_LINK_BEGIN" />במצב אורח<ph name="GUEST_LINK_END" /> בדפדפן tomi. כדי להוסיף חשבון של מישהו אחר, <ph name="LINK_BEGIN" />יש להוסיף משתמש חדש<ph name="LINK_END" /> אל <ph name="DEVICE_TYPE" />.

יכול להיות שהרשאות שכבר נתת לאתרים ולאפליקציות יחולו על החשבון הזה. יש לך גם אפשרות לנהל את חשבונות tomi <ph name="SETTINGS_LINK_BEGIN" />בהגדרות<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="7048502283602470098">‏מידע על AI</translation>
<translation id="7059914902409643750">‏אפשר להתאים אישית את tomi בדרך שנוחה לך</translation>
<translation id="7071827361006050863">‏נתוני הגלישה ב-tomi יימחקו בקרוב</translation>
<translation id="7085332316435785646">‏בוחרים אם לכלול את ההיסטוריה ב-tomi להתאמה אישית מדויקת יותר בשירותי tomi</translation>
