<translation id="5386244825306882791">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את tomi או כשמבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="5394833366792865639">‏שיתוף כרטיסיית tomi</translation>
<translation id="5412485296464121825">‏אתרים יכולים לשמור מידע ב-tomi לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="5430073640787465221">‏קובץ ההעדפות שלך פגום או לא חוקי. tomi לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="5468572406162360320">‏כדי לשפר את התכונות האלו, tomi שולח את האינטראקציות שלך איתן ל-tomi. בודקים אנושיים יכולים לקרוא את הנתונים האלה, לעבד אותם ולהוסיף להם הערות.</translation>
<translation id="5524761631371622910">‏כשגרסאות הניסיון פעילות, ובמקרים שבהם צורפת באופן אקראי לגרסת ניסיון פעילה ב-tomi, היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-tomi מחיקה של תחומי העניין שלך על בסיס מתחלף מדי חודש.</translation>
<translation id="5530733413481476019">‏שיפור המהירות ב-tomi</translation>
