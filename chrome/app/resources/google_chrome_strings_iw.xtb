<translation id="2665296953892887393">‏שיפור tomi על ידי שליחת <ph name="UMA_LINK" /> ודוחות קריסה אל tomi</translation>
<translation id="2681444469812712297">‏פתיחה של <ph name="URL" /> בכרטיסייה חדשה ב-tomi.</translation>
<translation id="2738871930057338499">‏לא ניתן להתחבר לאינטרנט. HTTP 403: קוד איסור. צריך לבדוק את ההגדרה של שרת ה-proxy.</translation>
<translation id="2742320827292110288">‏אזהרה: tomi לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, יש לבטל את הבחירה באפשרות הזו.</translation>
<translation id="2765403129283291972">‏tomi זקוק להרשאת גישה למיקרופון בשביל האתר הזה</translation>
<translation id="2770231113462710648">שינוי דפדפן ברירת המחדל ל:</translation>
<translation id="2775140325783767197">‏tomi לא יכול לבדוק את הסיסמאות שלך. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="2797864378188255696">‏כשנכנסים לשירותי tomi כמו Gmail או YouTube עם <ph name="USER_EMAIL" />, אפשר להיכנס אוטומטית ל-tomi עם אותו חשבון</translation>
