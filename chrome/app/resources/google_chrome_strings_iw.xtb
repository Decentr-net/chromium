<translation id="7437998757836447326">‏יציאה מ-tomi</translation>
<translation id="7449333426561673451">{COUNT,plural, =1{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך דקה.}one{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}two{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}other{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}}</translation>
<translation id="7452987490177144319">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-tomi במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-tomi במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-tomi במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-tomi במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}}</translation>
<translation id="7477130805345743099">‏tomi יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="7481213027396403996">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של tomi?</translation>
<translation id="749228101751499733">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון tomi ב-tomi. אפשר לשנות את ההגדרות של שירותי tomi באמצעות קיצור הדרך <ph name="SHORTCUT" />.</translation>
<translation id="7535429826459677826">‏גרסת הפיתוח של tomi</translation>
<translation id="7572537927358445944">‏מושבת • tomi לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME" /></translation>
<translation id="7606334485649076285">tomiOS Flex</translation>
<translation id="7626032353295482388">‏ברוך בואך אל tomi</translation>
<translation id="7626072681686626474">‏לפי הדרישה של <ph name="MANAGER" />, יש לקרוא ולאשר את התנאים וההגבלות הבאים לפני השימוש במכשיר הזה. תנאים אלה לא מרחיבים, משנים או מגבילים את התנאים לשימוש ב-tomiOS.</translation>
<translation id="7629695634924605473">‏tomi מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="7641148173327520642">‏לפי הגדרת מנהל המערכת, tomi יפתח את <ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="7651907282515937834">‏לוגו של tomi Enterprise</translation>
<translation id="76531479118467370">‏tomi חס את ההורדה הזאת כי השבתת את הגלישה הבטוחה ואי אפשר לאמת את הקובץ</translation>
<translation id="7655455401911432608">‏היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות tomi במכשיר הזה.</translation>
<translation id="7655472416356262023">‏הסרת החשבון מ-tomi</translation>
<translation id="7661924425853052955">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות '<ph name="PERMISSION_1" />', '<ph name="PERMISSION_2" />' ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי tomi</translation>
<translation id="7668816516367091728">אפשר לבצע משימות כמו תרגום, חישוב ועוד ישירות מסרגל הכתובות</translation>
<translation id="7670287553302121848">‏נדרש אימות מחדש לחשבון tomi</translation>
<translation id="769538538642757151">‏tomi יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="7761834446675418963">‏אפשר ללחוץ על השם שלך כדי לפתוח את tomi ולהתחיל לגלוש.</translation>
<translation id="7763983146198734674">אפשר לשמור את הסיסמאות ולגשת אליהן מכל מקום</translation>
<translation id="7777080907402804672">‏אם אין לתמונה תיאור מועיל, tomi ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל tomi. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="778331955594035129">‏נדרשת הרשאת מיקום ב-tomi עבור האתר הזה</translation>
<translation id="7785741298021097183">‏‫tomi מתוכנן לפעול במהירות ובאופן מאובטח בכל המכשירים – מהטלפון ועד המחשב.</translation>
<translation id="7787950393032327779">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך אחר של tomi‏ (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. tomi נעל את הפרופיל כדי שלא ייפגם. אם ברור לך שאף תהליך אחר אינו משתמש בפרופיל זה, באפשרותך לבטל את נעילת הפרופיל ולהפעיל את tomi מחדש.</translation>
<translation id="7801699035218095297">‏tomi מנסה להעתיק את הסיסמאות. כדי לאפשר את הפעולה הזו, יש להקליד את הסיסמה שלך ל-Windows.</translation>
<translation id="7802622118583152311">‏‫tomi מספק לך את הטכנולוגיה הכי חדשנית לגלישה טובה יותר</translation>
<translation id="7808348361785373670">‏הסרה מ-tomi...</translation>
<translation id="7825851276765848807">‏ההתקנה נכשלה בשל שגיאה לא מזוהה. צריך להוריד שוב את tomi.</translation>
<translation id="7836610565365456468">אפשר לשנות את הדפדפן עם עיצובים מלאי חיים בהשראת אומנים, טבע ועוד</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="7852254990718225089">‏טכנולוגיית ה-AI ב-tomi עוזרת להפוך את האינטרנט למהיר, בטוח ונגיש יותר</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7880591377632733558">‏ברוך בואך אל tomi, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="7890208801193284374">‏כשמשתפים מחשב, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את tomi בדיוק כפי שהם רוצים.</translation>
<translation id="7896673875602241923">‏מישהו נכנס בעבר ל-tomi מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-tomi כדי לשמור על הפרדת המידע שלך.</translation>
<translation id="7917876797003313048">‏יש לך אפשרות לנהל את חשבונות tomi שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן tomi, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות tomi שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />מידע נוסף<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">‏tomi חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="7947083960301164556">לצפייה בתכונות החדשות</translation>
<translation id="7951272445806340501">‏צריך להפעיל מחדש את tomiOS Flex כדי להחיל את העדכון.</translation>
<translation id="7959172989483770734">‏ניהול הפרופילים ב-tomi</translation>
<translation id="7962368738413920945">‏סביר להניח שאתרים יפעלו כצפוי, אבל ההעדפות שלך באתרים האלו יימחקו לאחר סגירת כל החלונות ב-tomi</translation>
<translation id="7962410387636238736">‏המחשב הזה כבר לא יקבל עדכונים ל-tomi, מאחר שכבר אין תמיכה במערכות Windows XP ו-Windows Vista</translation>
<translation id="8005666035647241369">‏נשמרה במנהל הסיסמאות של tomi במכשיר הזה</translation>
<translation id="8008534537613507642">‏התקנת tomi מחדש</translation>
