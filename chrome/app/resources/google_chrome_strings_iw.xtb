<translation id="3037838751736561277">‏tomi נמצא במצב רקע.</translation>
<translation id="3038232873781883849">בהמתנה להתקנה…</translation>
<translation id="3059710691562604940">‏הגלישה הבטוחה כבויה. ההמלצה של tomi היא להפעיל אותה.</translation>
<translation id="306179102415443347">‏באמצעות קיצורי הדרך אפשר להגיע מהר למנהל הסיסמאות של tomi. ניתן להעביר את קיצור הדרך למרכז האפליקציות או למסך הבית של המחשב.</translation>
<translation id="3065168410429928842">‏כרטיסייה של tomi</translation>
<translation id="3080151273017101988">‏המשך הפעלת אפליקציות ברקע כאשר tomi סגור</translation>
<translation id="3100998948628680988">‏בחירת שם לפרופיל tomi שלך</translation>
<translation id="3112458742631356345">‏tomi חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="3114643501466072395">‏כדי לבדוק אם הסיסמאות האחרות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-tomi<ph name="END_LINK" />.</translation>
<translation id="3119573284443908657">‏‫tomi חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="3140883423282498090">‏השינויים ייכנסו לתוקף בפעם הבאה ש-tomi יופעל מחדש.</translation>
<translation id="3149510190863420837">‏אפליקציות tomi</translation>
<translation id="3169523567916669830">‏במהלך הפעולה של גרסאות הניסיון, תהיה לך אפשרות לראות ולהסיר את תחומי העניין שלפיהם האתרים הציגו לך את המודעות. ההערכה של תחומי העניין ב-tomi מתבססת על היסטוריית הגלישה שלך מהזמן האחרון.</translation>
<translation id="3196187562065225381">‏tomi חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="3226612997184048185">‏אם הסימניות שלך נשמרות גם בחשבון tomi, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-tomi ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="3234642784688107085">‏כדאי לנסות את התכונות החדשות מבוססות ה-AI כדי ליצור עיצובים, לקבל עזרה בכתיבה ולשמור על סדר וארגון</translation>
<translation id="3245429137663807393">‏אם בנוסף ישותפו דוחות שימוש ב-tomi, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="3261565993776444564">אפשר לנסות צבע חדש כדי להתאים אישית את הדפדפן</translation>
<translation id="3282568296779691940">‏כניסה ל-tomi</translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="3292333338048274092">‏לאחר מכן יהיה עליך להפעיל מחדש את tomi.</translation>
<translation id="3360895254066713204">tomi Helper</translation>
