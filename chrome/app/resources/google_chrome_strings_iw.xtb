<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1001534784610492198">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את tomi.</translation>
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="102763973188675173">‏כדי להתאים אישית את tomi ולשלוט בו טוב יותר, יש להוריד את העדכון החדש.</translation>
<translation id="1028061813283459617">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-tomi, <ph name="BEGIN_LINK" />עליך לצאת מהחשבון ב-tomi<ph name="END_LINK" />.</translation>
<translation id="1042270987544905725">‏אפשר ללחוץ כדי לסגור את תיבת הדו-שיח של הכניסה ל-tomi</translation>
<translation id="1059838145689930908">‏כדי להשתמש בתוסף הזה בתור <ph name="USER_EMAIL_ADDRESS" />, עליך להיכנס ל-tomi.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="1088300314857992706">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-tomi</translation>
<translation id="110877069173485804">‏זה ה-tomi שלך</translation>
<translation id="1125124144982679672">‏מי משתמש/ת ב-tomi?</translation>
<translation id="1142745911746664600">‏לא ניתן לעדכן את tomi</translation>
<translation id="1149651794389918149">‏יש להיכנס אל tomi. אם רוצים להיכנס לחשבון באופן חד-פעמי בלבד, אפשר <ph name="GUEST_LINK_BEGIN" />להשתמש במכשיר כאורח<ph name="GUEST_LINK_END" />.</translation>
<translation id="1152920704813762236">‏מידע על tomiOS</translation>
<translation id="1154147086299354128">‏&amp;פתיחה ב-tomi</translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="1194807384646768652">‏tomi חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1229096353876452996">‏‫tomi ממליצה להגדיר את tomi כברירת המחדל</translation>
<translation id="1265739287306757398">איך עושים זאת?</translation>
<translation id="1278833599417554002">‏הפעלה מחדש לצורך עדכון &amp;tomi</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1302523850133262269">‏יש להמתין בזמן ש-tomi מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="1335640173511558774">‏לפי דרישת <ph name="MANAGER" />, צריך לקרוא את התנאים וההגבלות הבאים ולהסכים להם לפני השימוש במכשיר הזה. התנאים האלה לא מרחיבים, משנים או מגבילים את התנאים לשימוש ב-tomiOS Flex.</translation>
<translation id="1341711321000856656">‏אפשר לעבור כדי לראות סיסמאות מפרופיל tomi אחר</translation>
<translation id="1363996462118479832">‏לא בוצע סנכרון של הנתונים ב-tomiOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="137466361146087520">‏גרסת הבטא של tomi</translation>
<translation id="1399397803214730675">‏במחשב זה מותקנת כבר גרסה עדכנית יותר של tomi. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של tomi ולנסות שוב.</translation>
<translation id="139993653570221430">‏יש לך אפשרות לשנות את הבחירה בכל שלב בהגדרות של tomi. גרסאות הניסיון יפעלו במקביל לשיטה הנוכחית של הצגת המודעות, אז השינויים לא יורגשו מיד.</translation>
<translation id="1407223320754252908">‏שירות tomi Translate מובנה ב-tomi, כך שאפשר לתרגם מתי שצריך</translation>
<translation id="1425903838053942728">{COUNT,plural, =0{‏העדכון של tomi הסתיים. אפשר להשתמש בגרסה העדכנית מיד עם ההפעלה מחדש. לאחר מכן, הכרטיסיות הנוכחיות ייפתחו מחדש.}=1{‏העדכון של tomi הסתיים. אפשר להשתמש בגרסה העדכנית מיד עם ההפעלה מחדש. לאחר מכן, הכרטיסיות הנוכחיות ייפתחו מחדש. החלון הפרטי לא ייפתח מחדש.}one{‏העדכון של tomi הסתיים. אפשר להשתמש בגרסה העדכנית מיד עם ההפעלה מחדש. לאחר מכן, הכרטיסיות הנוכחיות ייפתחו מחדש. # החלונות הפרטיים לא ייפתחו מחדש.}two{‏העדכון של tomi הסתיים. אפשר להשתמש בגרסה העדכנית מיד עם ההפעלה מחדש. לאחר מכן, הכרטיסיות הנוכחיות ייפתחו מחדש. # החלונות הפרטיים לא ייפתחו מחדש.}other{‏העדכון של tomi הסתיים. אפשר להשתמש בגרסה העדכנית מיד עם ההפעלה מחדש. לאחר מכן, הכרטיסיות הנוכחיות ייפתחו מחדש. # החלונות הפרטיים לא ייפתחו מחדש.}}</translation>
<translation id="1434626383986940139">‏אפליקציות tomi – קאנארי</translation>
<translation id="146866447420868597">‏להיכנס אל tomi?</translation>
<translation id="1492280395845991349">‏צריך להפעיל מחדש כדי לסיים את העדכון של tomi</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="1507198376417198979">‏רוצה להתאים אישית את פרופיל tomi?</translation>
<translation id="1547295885616600893">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-tomiOS.</translation>
<translation id="1553358976309200471">‏כדאי לעדכן את tomi</translation>
<translation id="1583073672411044740">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל tomi הזה. ייווצר פרופיל tomi חדש בשביל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1587223624401073077">‏tomi משתמש במצלמה שלך.</translation>
<translation id="1587325591171447154">‏<ph name="FILE_NAME" /> מסוכן, ולכן tomi חסם אותו.</translation>
<translation id="1597911401261118146">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-tomi<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">‏כדי לשפר את האבטחה של tomi, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="1627304841979541023">‏<ph name="BEGIN_BOLD" />איך ניתן לנהל את הנתונים שלך:<ph name="END_BOLD" /> כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-tomi כדי שלא יילקחו בחשבון.</translation>
<translation id="1628000112320670027">‏קבלת עזרה בנושא tomi</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1662146548738125461">‏מידע על tomiOS Flex</translation>
<translation id="1674870198290878346">‏פתיחת הקישור בחלון &amp;אנונימי של tomi</translation>
<translation id="1682634494516646069">‏tomi אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1689338313606606627">‏‫tomi יכול להשבית את הכרטיסייה הזו כדי לשפר את חוויית הגלישה ולהמשיך לגלוש במהירות.</translation>
<translation id="1698376642261615901">‏tomi הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש. הגלישה באינטרנט בטוחה יותר הודות להגנה מפני תוכנות זדוניות ופישינג, המובנית ב-tomi.</translation>
<translation id="1713301662689114961">{0,plural, =1{‏tomi יופעל מחדש בעוד שעה}one{‏tomi יופעל מחדש בעוד # שעות}two{‏tomi יופעל מחדש בעוד # שעות}other{‏tomi יופעל מחדש בעוד # שעות}}</translation>
<translation id="1722488837206509557">כך תהיה לך אפשרות לבחור מבין המכשירים הזמינים ולהציג בהם תוכן.</translation>
<translation id="1734234790201236882">‏הסיסמה הזאת תישמר על ידי tomi בחשבון tomi. אין צורך לזכור אותה.</translation>
<translation id="1786003790898721085">‏יש לוודא שנכנסת ל-tomi ב-<ph name="TARGET_DEVICE_NAME" /> ולשלוח שוב.</translation>
<translation id="1786044937610313874">‏קיצורי דרך ייפתחו ב-tomi</translation>
<translation id="178701303897325119">‏התוסף הזה כבר לא נתמך. ההמלצה של tomi היא להסיר אותו.</translation>
<translation id="1812689907177901597">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי tomi, כמו Gmail, בלי להיכנס אל tomi</translation>
<translation id="1860536484129686729">‏tomi זקוק להרשאת גישה למצלמה בשביל האתר הזה</translation>
<translation id="1873233029667955273">‏tomi‏ אינו דפדפן ברירת המחדל שלך</translation>
<translation id="1874309113135274312">‏גרסת הביטא של tomi‏ (mDNS-In)</translation>
<translation id="1877026089748256423">‏tomi אינו מעודכן</translation>
<translation id="1907925560334657849">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-tomi בקטע 'העדפות המערכת'</translation>
<translation id="1919130412786645364">‏התרת כניסה אל tomi</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE" /> דק'</translation>
<translation id="1982647487457769627">‏‫tomi פועל בפלטפורמות שונות כדי לספק לך חוויה מוכרת בכל המכשירים</translation>
<translation id="2001586581944147178">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫tomi משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{‏התוסף הזה כבר לא נתמך. אנחנו ממליצים להסיר אותו מ-tomi.}one{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-tomi.}two{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-tomi.}other{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-tomi.}}</translation>
<translation id="2018528049276128029">‏בכל פרופיל מאוחסנים נתוני tomi משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2022471217832964798">‏אנחנו מגדירים את הגישה לחשבון, אבל עדיין אפשר להשתמש ב-tomi. לחלק מהמשאבים תהיה לך גישה רק אחרי שההגדרה תסתיים.</translation>
<translation id="2034233344106846793">‏‫tomi משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="207902854391093810">‏כשגרסאות הניסיון פעילות, מדידת המודעות מאפשרת לאתרים שבהם ביקרת לבקש מ-tomi מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="2091012649849228750">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="2094648590148273905">‏התנאים של tomiOS Flex</translation>
<translation id="2094919256425865063">‏לסגור את tomi בכל זאת?</translation>
<translation id="2106831557840787829">‏השימוש ב-tomiOS Flex מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת כמו <ph name="BEGIN_LINK_LINUX_OSS" />סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="2120620239521071941">‏פעולה זו תמחק <ph name="ITEMS_COUNT" /> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל tomi עם <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">‏הפעלה מחדש לצורך עדכון &amp;tomi</translation>
<translation id="2123055963409958220">‏דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /> יעזור לשפר את tomi</translation>
<translation id="2126108037660393668">נכשל האימות של הקובץ שהורד.</translation>
<translation id="2128411189117340671">‏ניהול הפרופילים ב-tomi</translation>
<translation id="2131230230468101642">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-tomi כדי שלא יילקחו בחשבון.</translation>
<translation id="2139300032719313227">‏הפעלה מחדש של tomiOS</translation>
<translation id="2151406531797534936">‏יש להפעיל מחדש את tomi עכשיו</translation>
<translation id="2174917724755363426">ההתקנה לא הושלמה. להמשיך בביטול?</translation>
<translation id="2190166659037789668">השגיאה בבדיקת העדכון: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199691482078155239">‏ב-tomi יש לך יותר שליטה במודעות שמוצגות לך, וחלות הגבלות על המידע עליך שהאתרים יכולים לקבל בהצגת מודעות בהתאמה אישית</translation>
<translation id="2216543877350048334">‏כדי להסיר את החשבון שלך ב-tomi מ-tomi, צריך לצאת מהחשבון</translation>
<translation id="223889379102603431">‏מידע על האופן שבו tomi מנהל את אישורי הבסיס שלו</translation>
<translation id="2258103955319320201">‏כדי לקבל גישה אל הפריטים שלך בדפדפן tomi בכל המכשירים, צריך להיכנס לחשבון ולהפעיל את הסנכרון</translation>
<translation id="2290014774651636340">‏המפתחות של tomi API חסרים. פונקציונליות מסוימת של tomi תהיה מושבתת.</translation>
<translation id="2290095356545025170">‏ברצונך באמת להסיר את tomi?</translation>
<translation id="2309047409763057870">‏זוהי התקנה משנית של tomi, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="2345992953227471816">‏התוספים האלה שנמצאו ב-tomi מכילים תכונה זדונית:</translation>
<translation id="2348335408836342058">‏tomi זקוק להרשאת גישה אל המצלמה והמיקרופון בשביל האתר הזה</translation>
<translation id="234869673307233423">‏tomi לא יכול לבדוק את הסיסמאות שלך. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="235650106824528204">‏המנהל של פרופיל העבודה יכול להסיר נתוני tomi שמופקים בזמן השימוש בפרופיל (כמו יצירת סימניות, היסטוריה, סיסמאות והגדרות נוספות). <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">המשך</translation>
<translation id="2390624519615263404">צפייה בתכונות הבטיחות</translation>
<translation id="2401189691232800402">‏מערכת tomiOS</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-tomi ניגש למכשיר ממשק אנושי (HID) אחד}=1{‏תוסף אחד לפחות ל-tomi ניגש למכשיר ממשק אנושי (HID) אחד}one{‏תוסף אחד לפחות ל-tomi ניגש ל-# מכשירי ממשק אנושי (HID)}two{‏תוסף אחד לפחות ל-tomi ניגש ל-# מכשירי ממשק אנושי (HID)}other{‏תוסף אחד לפחות ל-tomi ניגש ל-# מכשירי ממשק אנושי (HID)}}</translation>
<translation id="2424440923901031101">‏התוסף הזה מפר את המדיניות של חנות האינטרנט של tomi, ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-tomi כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="2467438592969358367">‏tomi רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="2472092250898121027">‏התוסף הזה מכיל תוכנה זדונית והוא לא בטוח. צריך להסיר אותו מ-tomi כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="2485422356828889247">הסרת התקנה</translation>
<translation id="2513154137948333830">נדרשת הפעלה מחדש: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-tomi להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="2556847002339236023">‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="2559253115192232574">‏לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-tomi כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך. tomi יכול לשתף עד 3 תחומי עניין.</translation>
<translation id="2563121210305478421">‏להפעיל את tomi מחדש?</translation>
<translation id="2569974318947988067">‏tomi ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="2571392474191184472">‏הארגון שלך מנהל את tomi</translation>
<translation id="2574930892358684005">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל tomi הזה. כדי להפריד בין פעילויות גלישה, tomi יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="2580411288591421699">‏אין אפשרות להתקין את אותה גרסת tomi הפועלת כעת. יש לסגור את tomi ולנסות שוב.</translation>
<translation id="2586406160782125153">‏הפעולה תמחק את נתוני הגלישה מהמכשיר. כדי לאחזר את הנתונים מאוחר יותר, יש להיכנס אל tomi עם <ph name="USER_EMAIL" />.</translation>
<translation id="2597976513418770460">‏אפשר לקבל את הנתונים של <ph name="ACCOUNT_EMAIL" /> ולשמור אותם בדפדפן tomi</translation>
<translation id="259935314519650377">שמירת מנהל ההתקנה שהורד במטמון נכשלה. השגיאה: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2622559029861875898">‏tomi לא יכול לחפש עדכונים. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="2632707915638608719">‏אפשר להספיק יותר עם תוספים ל-tomi</translation>
<translation id="2645435784669275700">tomiOS</translation>
<translation id="2649768380733403658">‏tomi מוודא בקביעות שלדפדפן שלך יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
