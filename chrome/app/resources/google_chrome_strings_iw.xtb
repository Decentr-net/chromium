<translation id="3716540481907974026">‏הגרסה של tomiOS Flex</translation>
<translation id="3718181793972440140">‏פעולה זו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל tomi עם <ph name="USER_EMAIL" />.</translation>
<translation id="3723744677043446310">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של tomi היא להסיר אותו. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}one{‏ההמלצה של tomi היא להסיר אותם. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}two{‏ההמלצה של tomi היא להסיר אותם. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}other{‏ההמלצה של tomi היא להסיר אותם. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}}</translation>
<translation id="3744202345691150878">‏עזרה בנושא tomiOS</translation>
<translation id="3780814664026482060">‏tomi - ‏<ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">‏לא ניתן היה לסנכרן את הנתונים ב-tomiOS Flex בגלל שגיאה בכניסה.</translation>
<translation id="3795971588916395511">tomiOS</translation>
<translation id="3809772425479558446">‏כדי להשתמש ב-tomi, נדרש Windows מגרסה 10 ואילך.</translation>
<translation id="3835168907083856002">‏ייווצר פרופיל tomi חדש בשביל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="383928141529488001">‏ל-tomi נדרשת גישה ל-Bluetooth כדי למצוא 
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="386202838227397562">‏יש לסגור את כל החלונות של tomi ולנסות שוב.</translation>
<translation id="3865754807470779944">‏מותקנת גרסה <ph name="PRODUCT_VERSION" /> של tomi</translation>
<translation id="3873044882194371212">‏פתיחת הקישור בחלון &amp;אנונימי של tomi</translation>
<translation id="3889417619312448367">‏הסרת tomi</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="3973161977468201858">‏‫tomi רוצה למחוק את הנתונים שלך במנהל הסיסמאות של tomi. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="398236277091248993">‏‫tomi ממשיך לפעול במהירות עם תכונות שמשפרות את הביצועים</translation>
<translation id="3999683152997576765">‏יש לך אפשרות לראות ולהסיר את תחומי העניין שלפיהם האתרים מציגים לך את המודעות. ההערכה של תחומי העניין ב-tomi מתבססת על היסטוריית הגלישה שלך מהזמן האחרון.</translation>
<translation id="4035053306113201399">‏יש להפעיל מחדש את tomiOS כדי להחיל את העדכון.</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4053720452172726777">‏הגדרת tomi בהתאם לרצונך</translation>
<translation id="408393047846373801">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-tomi. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-tomi.</translation>
<translation id="4084404300720192944">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-tomi בקטע 'העדפות המערכת'.</translation>
<translation id="4106587138345390261">‏אנחנו בודקים תכונות חדשות ב-tomi שמאפשרות לאתרים לספק את אותה חוויית הגלישה תוך שימוש בפחות פרטים אישיים</translation>
<translation id="4110895483821904099">‏הגדרת הפרופיל החדש שלך ב-tomi</translation>
<translation id="4111566860456076004">‏‫tomi לא יכול לאמת את מקור התוסף הזה, ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-tomi כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="4128488089242627000">‏דפדפן tomi פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך (מומלץ)</translation>
<translation id="4147555960264124640">‏בחרת להיכנס לחשבון מנוהל, ומנהל המערכת שלו יקבל שליטה על הפרופיל שלך ב-tomi. הנתונים שלך ב-tomi, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות מרכז השליטה של חשבונות tomi, אבל לא ניתן יהיה לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="4149882025268051530">‏המתקין נכשל בביצוע דחיסה לארכיון. יש להוריד שוב את tomi.</translation>
<translation id="4153934450158521343">‏tomi ייסגר בקרוב והנתונים שבו יימחקו</translation>
<translation id="4173512894976930765">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של tomi, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון tomi אם הוא מחובר ל-tomi.</translation>
<translation id="4175922240926474352">‏ההורדה הזו נחסמה על ידי tomi כי האתר לא משתמש בחיבור מאובטח ויכול להיות שבוצעו שינויים לא מורשים בקובץ</translation>
<translation id="4191857738314598978">{0,plural, =1{‏צריך להפעיל מחדש את tomi תוך יום אחד}one{‏צריך להפעיל מחדש את tomi תוך # ימים}two{‏צריך להפעיל מחדש את tomi תוך # ימים}other{‏צריך להפעיל מחדש את tomi תוך # ימים}}</translation>
<translation id="4205939740494406371">‏tomi לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות או <ph name="BEGIN_LINK" />לבדוק את הסיסמאות בחשבון tomi<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4224210481850767180">ההתקנה בוטלה.</translation>
<translation id="4242034826641750751">‏נדרשות הרשאות גישה למצלמה ולמיקרופון ב-tomi עבור האתר הזה</translation>
<translation id="424864128008805179">‏האם לצאת מ-tomi?</translation>
<translation id="4251615635259297716">‏האם לקשר את הנתונים שלך ב-tomi לחשבון זה?</translation>
<translation id="4262915912852657291">‏<ph name="BEGIN_BOLD" />באילו נתונים נעשה שימוש:<ph name="END_BOLD" /> היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות tomi במכשיר הזה.</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="4293420128516039005">‏כניסה לחשבון תסנכרן ותתאים אישית את tomi בכל המכשירים שברשותך</translation>
<translation id="430327780270213103">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של tomi</translation>
<translation id="4328355335528187361">‏גרסת הפיתוח של tomi ‏(mDNS-In)</translation>
<translation id="4329315893554541805">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את tomi ב'פעילות באינטרנט ובאפליקציות' ובשירותי tomi המקושרים</translation>
<translation id="4334294535648607276">ההורדה הושלמה.</translation>
<translation id="4335235004908507846">‏tomi עוזר להגן עליך מפני פרצות באבטחת המידע, תוספים לא תקינים ועוד</translation>
<translation id="4343195214584226067">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏tomi</translation>
<translation id="4348548358339558429">‏כדי להשתמש בהתאמה אישית, צריך לכלול את tomi ב'פעילות באינטרנט ובאפליקציות'</translation>
<translation id="436060642166082913">‏‫tomi חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="4384570495110188418">‏tomi לא יכול לבדוק את הסיסמאות שלך כי לא נכנסת לחשבון</translation>
<translation id="4389991535395284064">‏בגלישה במצב פרטי, tomi יציג אזהרה לפני טעינת אתר באמצעות חיבור לא מאובטח</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="4434353761996769206">שגיאת מנהל התקנה: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438657683599538446">‏כניסה ל-tomi בתור <ph name="USER_EMAIL" /></translation>
<translation id="4450664632294415862">‏tomi – כניסה לרשת – <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">‏מתבצעת כרגע פעולה אחרת ב-tomi. יש לנסות שוב מאוחר יותר.</translation>
<translation id="4459234553906210702">‏מדידת המודעות מאפשרת לאתרים שביקרת בהם לבקש מ-tomi מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="4501471624619070934">ההתקנה נכשלה כי הגישה מוגבלת במדינה הזו.</translation>
<translation id="4567424176335768812">נכנסת למערכת בתור <ph name="USER_EMAIL_ADDRESS" />. כעת יש לך אפשרות לגשת אל הסימניות, ההיסטוריה והגדרות אחרות שלך בכל המכשירים שבהם התחברת לחשבון.</translation>
<translation id="4571503333518166079">‏מעבר אל הגדרות של הודעות ב-tomi</translation>
<translation id="4575717501879784448">‏‫tomi יכול להשבית את הכרטיסיות האלה כדי לשפר את חוויית הגלישה ולפנות משאבים.</translation>
<translation id="459622048091363950">‏אחרי מתן גישה ל-tomi, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="4600710005438004015">‏עדכון tomi לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="4624065194742029982">‏מצב פרטי ב-tomi</translation>
<translation id="4627412468266359539">‏אופציונלי: שליחה אוטומטית של נתוני השימוש וניתוח הביצועים אל tomi תעזור לשפר את התכונות ואת הביצועים של tomiOS Flex.</translation>
<translation id="4633000520311261472">‏כדי לשפר את האבטחה של tomi, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="469553575393225953">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של tomi היא להתקין אותם רק מחנות האינטרנט של tomi</translation>
<translation id="4710245680469034439">אפשר להתאים אישית את הדפדפן עם עיצובים בהשראת הטבע, אוספי יצירות של אומנים ועוד</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="4728575227883772061">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם tomi פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="4747730611090640388">‏tomi יכול להעריך מהם תחומי העניין שלך.  לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-tomi כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
<translation id="4754614261631455953">‏גרסה ניסיונית של tomi‏ (mDNS-In)</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש tomi. הטקסט המוקלד בדפדפן נשלח אל tomi. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="4793679854893018356">‏איך מערכת tomi שומרת על האבטחה שלך</translation>
<translation id="4828579605166583682">‏tomi מנסה להחליף סיסמאות קיימות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="4842397268809523050">‏לא ניתן היה לסנכרן את הנתונים שלך ב-tomiOS Flex כי הסנכרון לא זמין בדומיין שלך.</translation>
<translation id="4851866215237571846">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER" />.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-tomi בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4862446263930606916">‏האדמין בארגון שלך יכול לראות ולנהל את נתוני הגלישה בפרופיל העבודה שלך, כמו הסימניות, ההיסטוריה והסיסמאות. אין לאדמין אפשרות לראות את נתוני הגלישה בפרופילים אישיים של tomi.</translation>
<translation id="4873692836499071887">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-macOS מגרסה 11 ואילך. במחשב הזה פועלת גרסה 10.15 של macOS.</translation>
<translation id="4873783916118289636">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-tomi</translation>
<translation id="4891791193823137474">‏לאפשר ל-tomi לפעול ברקע</translation>
<translation id="4895437082222824641">‏פתיחת הקישור ב&amp;כרטיסיית tomi חדשה</translation>
<translation id="492720062778050435">‏לפי המלצת tomi, כדאי לבדוק את התוסף הזה</translation>
<translation id="4951177103388687412">בעזרת קבוצות של כרטיסיות קל לשמור על סדר ולהתמקד</translation>
<translation id="4953650215774548573">‏הגדרת tomi כדפדפן ברירת המחדל</translation>
<translation id="495931528404527476">‏ב-tomi</translation>
<translation id="4969674060580488087">‏לא ניתן לסנכרן את הנתונים שלך ב-tomiOS Flex כי פרטי הכניסה של החשבון שלך לא מעודכנים.</translation>
<translation id="4970761609246024540">‏ברוך בואך לפרופילים של tomi</translation>
<translation id="4970880042055371251">‏גרסת tomiOS</translation>
<translation id="4990567037958725628">tomi Canary</translation>
<translation id="4997044641749333913">‏‫tomi יכול להשבית את הכרטיסיות האלה כדי לשפר את חוויית הגלישה ולשמור על מהירות.</translation>
<translation id="5003967926796347400">‏לוחצים על 'מנהל הסיסמאות של tomi'</translation>
<translation id="5120334927898581447">‏כניסה אל tomi כשנכנסים לשירותי tomi אחרים</translation>
<translation id="5126049312684316860">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת tomi טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו</translation>
<translation id="5132929315877954718">‏מקום לגלות אפליקציות, משחקים, תוספים ועיצובים מעולים ל-tomi.</translation>
<translation id="5139423532931106058">‏התאמה אישית של פרופיל tomi</translation>
<translation id="5161361450770099246">‏‫tomi יכול להשבית את הכרטיסייה הזו כדי לשפר את חוויית הגלישה ולפנות משאבים.</translation>
<translation id="5163087008893166964">‏ברוך בואך אל tomi. נפתח חלון חדש בדפדפן</translation>
<translation id="5170938038195470297">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגרסה חדשה יותר של tomi. ייתכן שחלק מהתכונות לא יהיו זמינות. ציין ספריית פרופיל אחרת או השתמש בגרסה חדשה יותר של tomi.</translation>
<translation id="5201744974236816379">‏עדכון ל-tomi</translation>
<translation id="521447420733633466">‏כשמשתפים מכשיר, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את tomi בדיוק כפי שהם רוצים</translation>
<translation id="5239627039202700673">‏שימוש ב-tomi בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="5251420635869119124">‏אורחים יכולים להשתמש ב-tomi בלי להשאיר עקבות.</translation>
<translation id="5320351714793324716">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת tomi תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="5334309298019785904">‏לא בוצע סנכרון של הנתונים ב-tomiOS כי הסנכרון לא זמין לדומיין שלך.</translation>
<translation id="5334487786912937552">‏נדרשת הרשאת גישה לאחסון ב-tomi כדי להוריד את קבצים</translation>
<translation id="5337648990166757586">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל tomi תעזור לשפר את התכונות ואת הביצועים של tomiOS.</translation>
