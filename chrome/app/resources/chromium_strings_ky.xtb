<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="1065672644894730302">Жеке жөндөлөөрүңүз окулбай жатат.

Айрым мүмкүнчүлүктөр иштебегендиктен, жеке жөндөөлөрдөгү өзгөрүүлөр сакталбайт.</translation>
<translation id="1098170124587656448">Decentr сырсөздөрүңүздү коопсуз сактоого, кооптуу кеңейтүүлөрдөн жана башкалардан коргоого жардам берет</translation>
<translation id="1104942323762546749">Decentr сырсөздөрүңүздү экспорттогону жатат. Ага уруксат берүү үчүн Windows аккаунтуңуздун сырсөзүн териңиз.</translation>
<translation id="113122355610423240">Decentr демейки серепчи катары колдонулат</translation>
<translation id="1131805035311359397">Сырсөздөрүңүздүн бекем корголгонун, ошондой эле коопсуздукка байланыштуу көйгөйлөрдү текшерүү үчүн <ph name="BEGIN_LINK" />Decentr'га кириңиз<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">Decentr жөнүндө</translation>
<translation id="1315551408014407711">Жаңы Decentr профилин жөндөп алыңыз</translation>
<translation id="1396446129537741364">Decentr сырсөздөрдү көрсөткөнгө аракет кылып жатат.</translation>
<translation id="1414495520565016063">Decentr'га кирдиңиз!</translation>
<translation id="151962892725702025">Сиздин домениңизде шайкештештирүү мүмкүнчүлүгү жок болгондуктан, Decentr OS дайын-даректериңизди шайкештештире алган жок.</translation>
<translation id="1524282610922162960">Decentr өтмөгүн бөлүшүү</translation>
<translation id="1553461853655228091">Decentr айланаңыздын 3D картасын түзүү үчүн камераңызды колдонушу керек</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Администраторуңуз жаңыртууну колдонуу үчүн Decentr'ду кайра иштетүүнү талап кылууда}=1{Администраторуңуз жаңыртууну колдонуу үчүн Decentr'ду кайра иштетүүнү талап кылууда. Жашыруун терезеңиз кайра ачылбайт.}other{Администраторуңуз жаңыртууну колдонуу үчүн Decentr'ду кайра иштетүүнү талап кылууда. # жашыруун терезеңиз кайра ачылбайт.}}</translation>
<translation id="1667812772085710766">Decentr'ду жапканыңызда, ал сиз баш баккан барактардан сайттагы маалыматты жана cookie файлдарын автоматтык түрдө тазалайт</translation>
<translation id="1708666629004767631">Decentr'дун бир кыйла жаңы, коопсуз версиясы бар.</translation>
<translation id="1774152462503052664">Decentr'го фондо иштөө мүмкүнчүлүгүн берүү</translation>
<translation id="1779356040007214683">Жеке маалыматыңызды коргоо үчүн, айрым Decentr кеңейтүүлөрүн өчүрүп койдук, себеби <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ичинде аларга байланыштуу маалымат жок. Демек, бул курамдык бөлүктөр тымызын орнотулган.</translation>
<translation id="1808667845054772817">Decentr'ду кайра орнотуу</translation>
<translation id="185970820835152459">Кирип турган Google аккаунттарыңызды башкара аласыз. Google аккаунттарыңыз Decentr серепчисинде, Play Store'до, Gmail'де жана башка жерлерде колдонулат. Эгер кимдир бирөөнүн, мисалы, үй-бүлөлүк топтун мүчөсүнүн аккаунтун кошкуңуз келсе, жаңы адамды <ph name="DEVICE_TYPE" /> түзмөгүнө кошуп коюңуз. <ph name="LINK_BEGIN" />Кеңири маалымат<ph name="LINK_END" /></translation>
<translation id="1881322772814446296">Башкарылган аккаунт менен кирип, анын администраторунун милдетин Decentr профилиңизге өткөрүп берип жатасыз. Decentr дайын-даректериңизди, колдонмолоруңузду, кыстармаларыңызды, таржымалыңызды, сырсөздөрүңүздү жана башка жөндөөлөрдү <ph name="USER_NAME" /> менен биротоло байланыштырат. Бул дайындарды Google Каттоо эсептеринин жеке кеңсеси аркылуу жок кылсаңыз болот, бирок бул дайындарды башка аккаунтка байлай албайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">Ушуну өчүрүү менен Gmail сыяктуу Google сайттарына Decentr'суз кире аласыз</translation>
<translation id="1929939181775079593">Decentr жооп бербей жатат. Өчүрүп кайра ишке киргизесизби?</translation>
<translation id="1966382378801805537">Decentr демейки серепчини аныктап же коё албай жатат</translation>
<translation id="1981611865800294956">&amp;Decentr OS тутумун жаңыртуу үчүн кайра иштетиңиз</translation>
<translation id="2008474315282236005">Ушуну менен түзмөктөгү 1 нерсе өчүрүлөт. Дайын-даректериңизди кийинчерээк чыгарып алуу үчүн Decentr'га <ph name="USER_EMAIL" /> аккаунту менен кириңиз.</translation>
<translation id="2020032459870799438">Башка сырсөздөрүңүздүн бекем корголгонун, ошондой эле коопсуздукка байланыштуу көйгөйлөрдү текшерүү үчүн <ph name="BEGIN_LINK" />Decentr'га кириңиз<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">Decentr'ду ыңгайлаштыруу</translation>
<translation id="2185166961232948079">Decentr – Тармакка кирүү – <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">Компьютерди бөлүшсөңүз, жакындарыңыз өзүнчө серептеп, Decentr'ду өзүлөрү каалагандай орнотуп алышат.</translation>
<translation id="2294245788148774212">Кошумча: Google'га мүчүлүштүктөрдү аныктоо жана колдонуу статистикасы жөнүндө автоматтык түрдө кабарлоо менен Decentr OS'тун функцияларын жана өндүрүмдүүлүгүн өркүндөтүүгө жардам бериңиз.</translation>
<translation id="2343156876103232566">Номерди бул жерден Android телефонуңузга жөнөтүү үчүн эки түзмөгүңүздөн тең Decentr'га кириңиз.</translation>
<translation id="2347108572062610441">Бул кеңейтүү Decentr иштеп баштаганда көрсөтүлө турган бетти өзгөрттү.</translation>
<translation id="2396765026452590966">"<ph name="EXTENSION_NAME" />" кеңейтүүсү Decentr иштеп баштаганда көрсөтүлө турган бетти өзгөрттү.</translation>
<translation id="2401032172288869980">Decentr'га бул сайтта камера менен микрофонду колдонууга уруксат бериңиз</translation>
<translation id="2483889755041906834">Decentr'да</translation>
<translation id="2485422356828889247">Орнотуудан чыгаруу</translation>
<translation id="2535480412977113886">Аккаунтуңуздун кирүү чоо-жайлары эскирип калгандыктан, Decentr OS дайын-даректериңизди шайкештештире алган жок.</translation>
<translation id="2560420686485554789">Файлдарды жүктөп алуу үчүн Decentr сактагычка мүмкүнчүлүк алышы керек</translation>
<translation id="2572494885440352020">Decentr Жардамчы</translation>
<translation id="2577788541081224677">Decentr'дагы файлдарды бардык түзмөктөрүңүздө колдонуу үчүн аккаунтуңузга кирип, шайкештирүүнү күйгүзүңүз.</translation>
<translation id="2583187216237139145">Бул профилди колдонуп жатканда Decentr'да топтолгон бардык маалыматты (түзүлгөн кыстармалар, таржымал, сырсөздөр жана башка жөндөөлөр) жумуш профилинин администратору өчүрө алат. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">Жаңыртууну колдонуу үчүн Decentr OS өчүрүлүп күйгүзүлүшү керек.</translation>
<translation id="2614883797045469742">Decentr'дун демейки жөндөөлөрү көбүнчө кишилерге ылайыктуу, бирок өзүңүзгө жараша ыңгайлаштырып алсаңыз болот</translation>
<translation id="2648074677641340862">Орнотулуп жатканда иш тутумунда ката кетти. Decentr'ду кайра жүктөп алыңыз.</translation>
<translation id="2661879430930417727">Түзмөктү бөлүшсөңүз, жакындарыңыз өзүнчө серептеп, Decentr'ду өздөрү каалагандай жөндөп алышат</translation>
<translation id="2711502716910134313">Decentr өтмөгү</translation>
<translation id="2718390899429598676">Кошумча коопсуздук үчүн, Decentr дайын-даректериңизди шифрлейт.</translation>
<translation id="2770231113462710648">Демейки серепчини төмөнкүгө өзгөртүү:</translation>
<translation id="2799223571221894425">Кайра ишке киргизүү</translation>
<translation id="2837693172913560447">Ушуну менен <ph name="USER_EMAIL_ADDRESS" /> үчүн жаңы Decentr профили түзүлөт</translation>
<translation id="2847479871509788944">Decentr'дан чыгарып салуу…</translation>
<translation id="2885378588091291677">Тапшырмаларды башкаргыч</translation>
<translation id="2910007522516064972">&amp;Decentr жөнүндө</translation>
<translation id="2977470724722393594">Decentr жаңыртылган</translation>
<translation id="2983934633046890458">Decentr cырсөздөрдү өзгөртүүгө аракет кылууда.</translation>
<translation id="3032706164202344641">Decentr сырсөздөрүңүздү текшере албай жатат. Кийинчерээк кайталаңыз.</translation>
<translation id="3032787606318309379">Decentr'га кошууда…</translation>
<translation id="3068515742935458733">Google'га автоматтык түрдө каталар жана <ph name="UMA_LINK" /> жөнүндө кабар берип, Decentr'ду өркүндөткөнгө кол кабыш кылыңыз!</translation>
<translation id="3103660991484857065">Орноткуч архивди чыгара албай койду. Decentr'ду кайра жүктөп алыңыз.</translation>
<translation id="3130323860337406239">Decentr микрофонуңузду колдонууда.</translation>
<translation id="3155163173539279776">Decentr'ду кайра ишке киргизүү</translation>
<translation id="3179665906251668410">Шилтемени Decentr'дун жашы&amp;руун терезесинде ачуу</translation>
<translation id="3185330573522821672">Жаңы Decentr профилиңизди жекелештириңиз</translation>
<translation id="3190315855212034486">Ой! Decentr кыйрады. Кайра ишке киргизилсинби?</translation>
<translation id="3229526316128325841">Decentr сырсөздөрүңүздү экспорттогону жатат.</translation>
<translation id="3258596308407688501">Decentr дайындар каталогун окуп, ага жаза албайт:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848"><ph name="PRODUCT_VERSION" /> Decentr версиясы орнотулду</translation>
<translation id="328888136576916638">Google API ачкычтары жок болуп жатат. Decentr'дун айрым функциялары өчүрүлөт.</translation>
<translation id="3296368748942286671">Decentr жабылганда фондук колдонмолор иштей берсин</translation>
<translation id="331951419404882060">Decentr OS кирүү катасынан улам дайын-даректериңизди шайкештештире албай койду.</translation>
<translation id="3349211344363550267">Decentr'дун кеңеши боюнча бул файлды жүктөп албай же ачпай эле коюңуз</translation>
<translation id="3350761136195634146">Бул аккаунт менен Decentr профили мурунтан эле түзүлгөн</translation>
<translation id="3406848076815591792">Учурдагы Decentr профилине өтөсүзбү?</translation>
<translation id="3430503420100763906">Decentr профилдери менен Decentr'дагы маалыматты өзүнчө сактай аласыз. Досторуңуз менен үй-бүлөңүз үчүн профилдерди түзүңүз же жумуш менен эс алууну бири-бири менен аралаштырбаңыз.</translation>
<translation id="347328004046849135">Decentr уурдалган сырсөз менен киргениңизде эскертет</translation>
<translation id="3474745554856756813">Ушуну менен түзмөктөгү <ph name="ITEMS_COUNT" /> нерсе өчүрүлөт. Дайын-даректериңизди кийинчерээк чыгарып алуу үчүн Decentr'га <ph name="USER_EMAIL" /> аккаунту менен кириңиз.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> Decentr профилдерин которо алат</translation>
<translation id="3509308970982693815">Бардык Decentr терезелерин жаап, дагы аракет кылып көрүңүз.</translation>
<translation id="3575459661164320785">Компьютериңизде кооптуу программа бар. Серепчиңизди кайра ойдогудай иштетүү үчүн Decentr аны алып салып, жөндөөлөрдү калыбына келтирип, кеңейтүүлөрдү өчүрө алат.</translation>
<translation id="3639635944603682591">Бул адамдын серептөө дайындары бул түзмөктөн биротоло өчүрүлөт. Дайындарды калыбына келтирүү үчүн, Decentr'га <ph name="USER_EMAIL" /> аккаунту менен кириңиз.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Decentr үчүн жаңыртуу бар. Түзмөгүңүз өчүрүлүп-күйгүзүлгөндөн кийин ал колдонулуп баштайт.}=1{Decentr үчүн жаңыртуу бар. Түзмөгүңүз өчүрүлүп-күйгүзүлгөндөн кийин ал колдонулуп баштайт. Жашыруун терезеңиз кайра ачылбайт.}other{Decentr үчүн жаңыртуу бар. Түзмөгүңүз өчүрүлүп-күйгүзүлгөндөн кийин ал колдонулуп баштайт. # жашыруун терезеңиз кайра ачылбайт.}}</translation>
<translation id="3651803019964686660">Номерди <ph name="ORIGIN" /> сайтынан Android телефонуңузга жөнөтүү үчүн эки түзмөгүңүздөн тең Decentr'га кириңиз.</translation>
<translation id="3685209450716071127">Decentr сырсөздөрүңүздү текшере албай жатат. Интернет байланышын текшерип көрүңүз.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Администраторуңуз жаңыртууну колдонуу үчүн Decentr'ду кайра иштетүүнү суранууда}=1{Администраторуңуз жаңыртууну колдонуу үчүн Decentr'ду кайра иштетүүнү суранууда. Жашыруун терезеңиз кайра ачылбайт.}other{Администраторуңуз жаңыртууну колдонуу үчүн Decentr'ду кайра иштетүүнү суранууда. # жашыруун терезеңиз кайра ачылбайт.}}</translation>
<translation id="3713809861844741608">Шилтемени жаңы Decentr &amp;өтмөгүндө ачуу</translation>
<translation id="3728336900324680424">Дарек тилкесинде сунуштарды көрсөтүү үчүн Decentr кызматы Drive сактагычыңызды колдонот</translation>
<translation id="378917192836375108">Decentr аркылуу желеден телефон номерин чыкылдатып, ага Skype менен чала аласыз!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> – Decentr</translation>
<translation id="388648406173476553">Decentr'ду ыңгайлаштыруу жана көзөмөлдөө. Сиздин аракетиңиз талап кылынат – чоо-жайын көрүү үчүн чыкылдатыңыз.</translation>
<translation id="3889543394854987837">Decentr'ду ачып, серептеп баштоо үчүн ысымыңызды чыкылдатыңыз.</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> ушул Decentr профилине мурунтан эле кирип турат. Сиз серептеген нерселерди ажыратуу максатында Decentr сиз үчүн өзүнчө профиль түзүп бере алат.</translation>
<translation id="3945058413678539331">Decentr сырсөздөрдү көчүрүүгө аракет кылууда. Уруксат берүү үчүн Windows сырсөзүңүздү жазыңыз.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />Учурдагы жөндөөлөр<ph name="END_LINK" /> жөнүндө кабар берип, Decentr'ду өркүндөтүүгө кол кабыш кылыңыз</translation>
<translation id="4050175100176540509">Эң акыркы версияда коопсуздукту бекемдөө каражаттары менен жаңы мүмкүнчүлүктөр камтылган.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> – Тармакка кирүү – Decentr</translation>
<translation id="421369550622382712">Decentr үчүн укмуш колдонмолор, оюндар, кеңейтүүлөр жана темаларды таап алыңыз.</translation>
<translation id="4216212958613226427">Decentr UI ушул тилде иштейт</translation>
<translation id="4230135487732243613">Decentr дайын-даректериңиз бул аккаунтка байлансынбы?</translation>
<translation id="4264410486868823224">Бул түзмөктү колдонуудан мурун, <ph name="MANAGER" /> төмөнкү Тейлөө шарттарын окуп, кабыл алууңузду талап кылат. Бул шарттар Decentr OS шарттарын кеңейтип, өзгөртүп же чектебейт.</translation>
<translation id="4271805377592243930">Decentr'дан жардам алыңыз</translation>
<translation id="4285930937574705105">Белгисиз катадан улам, орнотулбай калды. Учурда Decentr иштеп жаткан болсо, аны жаап туруп, дагы аракет кылып көрүңүз.</translation>
<translation id="4407044323746248786">Баары бир Decentr'дан чыгасызбы?</translation>
<translation id="4415566066719264597">Decentr'га фондук режимде иштөөгө уруксат берүү</translation>
<translation id="4423735387467980091">Decentr'ду өзгөчөлөштүрүү жана көзөмөлдөө</translation>
<translation id="452711251841752011">Decentr'га кош келиңиз; серепчиде жаңы терезе ачылды</translation>
<translation id="4544142686420020088">Decentr жаңырган жок. Бир жерден ката кетти. <ph name="BEGIN_LINK" />Decentr'догу жаңыртуу маселелерин оңдоңуз.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Жаңы Decentr профилинде улантасызбы?</translation>
<translation id="4567424176335768812"><ph name="USER_EMAIL_ADDRESS" /> катары кирдиңиз. Эми кыстармаларды, таржымалды жана башка жөндөөлөрдү бардык катталган түзмөктөрүңүздөн колдоно аласыз.</translation>
<translation id="459535195905078186">Decentr колдонмолору</translation>
<translation id="4665829708273112819">Эскертүү: Decentr кеңейтүүлөргө көрүлгөн вебсайттарды жазып алууга тыюу сала албайт. Бул кеңейтүүнү жашыруун режимде өчүрүү үчүн бул параметрди тандоодон чыгарыңыз.</translation>
<translation id="4677944499843243528">Decentr процессинде бул профилди (<ph name="PROCESS_ID" />) башка компьютерде (<ph name="HOST_NAME" />) колдонуп жатат окшойт. Decentr профиль бузулбасын деп кулпулап койду. Бул профиль башка процесстерде колдонулбайт деп ишенсеңиз, профилдин кулпусун ачып, Decentr'ду өчүрүп күйгүзүңүз.</translation>
<translation id="469338717132742108">Decentr OS'тон жардам алыңыз</translation>
<translation id="4708774505295300557">Буга чейин кимдир бирөө бул компьютерден Decentr'га <ph name="ACCOUNT_EMAIL_LAST" /> аккаунту менен кирген. Маалыматыңызды өзүнчө сактоо үчүн жаңы Decentr колдонуучусун түзүңүз.</translation>
<translation id="4746050847053251315">Баары бир Decentr'ду токтотосузбу?</translation>
<translation id="4748217263233248895">Жаңы эле Decentr үчүн өзгөчө коопсуздук жаңыртуулары орнотулду. Өтмөктөрдү калыбына келтирүү үчүн аны өчүрүп-күйгүзүңүз.</translation>
<translation id="4750035648288509542">Жаңыртылганы аз калды! Жаңыртууну аягына чыгаруу үчүн Decentr'ду кайра иштетиңиз. Жашыруун терезелер кайра ачылбайт.</translation>
<translation id="4788777615168560705">Decentr сырсөздөрүңүздү текшере албай жатат. 24 сааттан кийин кайра аракет кылыңыз же <ph name="BEGIN_LINK" />Google аккаунтуңуздагы сырсөздөрдү текшериңиз<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Ал Google Издөөдө колдонулган орфографияны текшерүүчү программаны колдонот. Серепчиде терилген текстти Google кызматтарына жөнөтүп турат. Бул параметрди каалаган убакта жөндөөлөргө өтүп, өзгөртүп койсоңуз болот.</translation>
<translation id="4888717733111232871">mDNS трафигине уруксат берүү үчүн Decentr'дун кирүү эрежеси.</translation>
<translation id="4893347770495441059">&amp;Decentr'ду жаңыртуу үчүн кайра иштетиңиз</translation>
<translation id="4943838377383847465">Decentr фондук режимде.</translation>
<translation id="4987820182225656817">Коноктор Decentr'ду артында эч нерсе калтырбай колдоно алышат.</translation>
<translation id="4994636714258228724">Өзүңүздү Decentr'га кошуңуз</translation>
<translation id="5224391634244552924">Сакталган сырсөздөр жок. Сырсөздөрүңүздү сактаганда Decentr аларды текшере алат.</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" /> ушул Decentr профилине мурунтан эле кирип турат. Ушуну менен <ph name="USER_EMAIL_ADDRESS" /> үчүн жаңы Decentr профили түзүлөт</translation>
<translation id="5277894862589591112">Өзгөртүүлөрдү киргизүү үчүн Decentr'ду кайра иштетиңиз</translation>
<translation id="5358375970380395591">Башкарылган аккаунт менен кирип, анын администраторуна Chromiun профилиңизди көзөмөлдөө мүмкүнчүлүгүн берип жатасыз. Колдонмолоруңуз, кыстармалар, таржымал, сырсөздөр жана башка жөндөөлөр сыяктуу Decentr дайын-даректериңиз эми биротоло <ph name="USER_NAME" /> менен байланып калат. Бул дайындарды Google Каттоо эсептеринин Жеке кеңсеси аркылуу жок кылсаңыз болот, бирок башка аккаунтка байланыштыра албайсыз.<ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Decentr жаңыртылууда (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Decentr'га кирүүгө уруксат берүү</translation>
<translation id="5398878173008909840">Decentr'дун жаңы версиясы бар.</translation>
<translation id="5416696090975899932">PDF-файлдары менен иштей турган программа камтылбаган болсо, басылып чыга турган файлды Decentr'да алдын ала көрүүгө мүмкүн болбойт.</translation>
<translation id="5427571867875391349">Decentr'ду демейки серепчи катары коюп алыңыз</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> – Decentr бета сынамык версиясы</translation>
<translation id="5479196819031988440">Decentr OS бул баракты ача албайт.</translation>
<translation id="5480860683791598150">Бул сайт менен бөлүшүү үчүн Decentr жайгашкан жериңиз тууралуу маалыматты алышы керек</translation>
<translation id="549669000822060376">Decentr эң акыркы тутум жаңыртууларын орнотуп бүткүчө күтө туруңуз.</translation>
<translation id="5496810170689441661">Decentr сырсөздөрдү өзгөртүүгө аракет кылып жатат. Уруксат берүү үчүн Windows сырсөзүңүздү териңиз.</translation>
<translation id="5527463683072221100">PDF файлдарын Decentr'да ачуу</translation>
<translation id="5623402015214259806">{0,plural, =0{Decentr'дун жаңы версиясы жеткиликтүү}=1{Decentr'дун жаңы версиясы жеткиликтүү}other{Decentr'дун жаңы версиясы # күндөн бери жеткиликтүү}}</translation>
<translation id="5634636535844844681">Decentr'га Windows 7 же жаңыраак версиясы талап кылынат.</translation>
<translation id="5653831366781983928">Decentr'ду азыр өчүрүп күйгүзүңүз</translation>
<translation id="5698481217667032250">Decentr ушул тилде көрүнсүн</translation>
<translation id="5820394555380036790">Decentr OS</translation>
<translation id="5854740544000584380">Decentr OS тутуму, <ph name="BEGIN_LINK_LINUX_OSS" />Linux'ту өнүктүрүү чөйрөсү <ph name="END_LINK_LINUX_OSS" /> сыяктуу, кошумча <ph name="BEGIN_LINK_CROS_OSS" />баштапкы коду ачык программалык камсыздоонун<ph name="END_LINK_CROS_OSS" /> жардамы менен иштейт.</translation>
<translation id="5862307444128926510">Decentr'га кош келиңиз</translation>
<translation id="5883558403894052917">Decentr төмөнкүлөрдө кесепеттүү программанын болгонун аныктады:</translation>
<translation id="5895138241574237353">Өчүрүп күйгүзүү</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Тармакка кирүү</translation>
<translation id="5987687638152509985">Шайкештирип баштоо үчүн Decentr'ду жаңыртыңыз</translation>
<translation id="6039377483953237732">Decentr OS версиясы</translation>
<translation id="6055895534982063517">Decentr'дун чагылгандай тездик менен иштеген жаңы версиясы бар.</translation>
<translation id="6063093106622310249">&amp;Decentrда ачуу</translation>
<translation id="6072279588547424923"><ph name="EXTENSION_NAME" /> Decentr'га кошулду</translation>
<translation id="608006075545470555">Ушул серепчиге жумуш профилин кошуу</translation>
<translation id="608189560609172163">Кирүү катасынан улам, Decentr дайын-даректериңизди шайкештештире алган жок.</translation>
<translation id="6096348254544841612">Decentr'ду ыңгайлаштырып алып, көзөмөлдөңүз. Жаңыртуу бар.</translation>
<translation id="6120345080069858279">Decentr бул сырсөздү Google аккаунтуңузга сактап коёт. Аны эстеп калуунун кажети жок.</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> кооптуу файл болгондуктан, Decentr аны бөгөттөп койду.</translation>
<translation id="6134968993075716475">Коопсуз серептөө өчүк. Decentr аны күйгүзүүнү сунуштайт.</translation>
<translation id="6145820983052037069">Decentr профилдерин бул жерден которо аласыз</translation>
<translation id="6183079672144801177">Decentr'га <ph name="TARGET_DEVICE_NAME" /> түзмөгүңүздөн кирип турганыңызды текшерип, кайра аракет кылыңыз.</translation>
<translation id="6212496753309875659">Бул компьютерде Decentr'дун жаңыраак версиясы мурунтан эле орнотулган. Эгер программа иштебей жатса, Decentr'ду орнотуудан чыгарып, дагы бир жолу аракет кылып көрүңүз.</translation>
<translation id="6219195342503754812">{0,plural, =0{Decentr азыр кайра иштетилет}=1{Decentr 1 секунддан кийин кайра иштетилет}other{Decentr # секунддан кийин кайра иштетилет}}</translation>
<translation id="6241367896540709610">Файлдарды жүктөп алуу үчүн Decentr'га сактагычты колдонууга уруксат бериңиз</translation>
<translation id="6248213926982192922">Decentr'ду демейки серепчи кылуу</translation>
<translation id="6266342355635466082">Decentr жаңыртууларды текшере алган жок. Интернет байланышын текшерип көрүңүз.</translation>
<translation id="6268381023930128611">Decentr'дан чыгасызбы?</translation>
<translation id="6281746429495226318">Decentr профилимди ыңгайлаштыруу</translation>
<translation id="6290827346642914212">Decentr профилиңиздин аталышын коюңуз</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> файлы кооптуу болушу мүмкүн, ошондуктан Decentr аны бөгөттөп койду.</translation>
<translation id="6309712487085796862">Decentr камераңызды колдонууда.</translation>
<translation id="6333502561965082103">Decentr'да башка операция жүрүп жатат. Бир аздан кийин кайталап көрүңүз.</translation>
<translation id="6334986366598267305">Эми Google Аккаунтуңуз аркылуу жана бөлүшүлгөн компьютерлерден Decentr'да иштөө алдаганча жеңилирээк болуп калды.</translation>
<translation id="6373523479360886564">Decentr'ду чын эле орнотуудан чыгарасызбы?</translation>
<translation id="6403826409255603130">Decentr – веб-баракчалар жана колдонмолорду чагылгандай тездик менен иштеткен желе серепчиси. Ал оңой, тез жана туруктуу иштеген курал. Decentr кесепеттүү программалар менен фишингден коргоп тургандыктан, желени эч нерседен коркпостон серептей берсеңиз болот.</translation>
<translation id="6434250628340475518">Decentr OS тутуму</translation>
<translation id="6455857529632101747">Decentr профилдерине кош келиңиз</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Decentr 1 секунддан кийин өчүрүлүп-күйгүзүлөт}other{Decentr # секунддан кийин өчүрүлүп-күйгүзүлөт}}</translation>
<translation id="6475912303565314141">Decentr иштеп баштаганда кайсы бет көрүнө тургандыгын белгилейт.</translation>
<translation id="6510925080656968729">Decentr'ду орнотуудан чыгарып салуу</translation>
<translation id="6542839706527980775">Ар бир профилде өзүнө таандык кыстармалар, таржымал, сырсөздөр жана башкалар сыяктуу Decentr маалыматы бар</translation>
<translation id="6570579332384693436">Орфографиялык каталарды оңдоо максатында, Decentr сиз талааларда терген текстти Google'га жөнөтөт</translation>
<translation id="6598877126913850652">Decentr'дун эскертмелеринин жөндөөлөрүнө өтүү</translation>
<translation id="6613594504749178791">Өзгөртүүлөрүңүз Decentr кийинки жолу кайра ишке киргизилгенде күчүнө кирет.</translation>
<translation id="665732753414869868">Decentr'га айланаңыздын 3D картасын түзүү үчүн камераны колдонууга уруксат бериңиз</translation>
<translation id="6676384891291319759">Интернетке кирүү</translation>
<translation id="6709350901466051922">Decentr'га бул сайтта микрофонду колдонууга уруксат бериңиз</translation>
<translation id="6717134281241384636">Профилиңиз Decentr'дун жаңыраак версиясынан болгондуктан, аны колдонуу мүмкүн болбой жатат.

Айрым мүмкүнчүлүктөр иштебей калышы ыктымал. Башка профиль каталогун көрсөтүңүз же Decentr'дун жаңыраак версиясын колдонуңуз.</translation>
<translation id="6734080038664603509">Жаңыртуу &amp;Decentr</translation>
<translation id="6734291798041940871">Decentr компьютериңиздин бардык колдонуучулары үчүн орнотулуп коюлган.</translation>
<translation id="673636774878526923">Decentr'дагы файлдарды бардык түзмөктөрүңүздө колдонуу үчүн аккаунтуңузга кирип, шайкештирүүнү күйгүзүңүз.</translation>
<translation id="6774082503108938489">Ата-энеңиз Decentr үчүн "Сайттарга, колдонмолорго жана кеңейтүүлөргө уруксаттарды" өчүрүп койгон. Бул <ph name="EXTENSION_TYPE_PARAMETER" /> кеңейтүүсүн иштетүүгө болбойт.</translation>
<translation id="6847869444787758381">Decentr сырсөздөрүңүздү башка бирөөлөр билип алса сизге кабарлайт</translation>
<translation id="6857782730669500492">Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (Decentr'га көчүрүлдү)</translation>
<translation id="6873893289264747459">Decentr "<ph name="EXTENSION_NAME" />" кеңейтүүсүндө кесепеттүү программанын болгонун аныктады</translation>
<translation id="6893813176749746474">Decentr жаңырды, бирок аны 30 күндөн бери колдоно элексиз.</translation>
<translation id="691026815377248078">Жупташтырууну улантуу үчүн Decentr Bluetooth'ду 
 пайдаланууга уруксат алышы керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">Шилтемени Decentr'дун жашы&amp;руун терезесинде ачуу</translation>
<translation id="6978145336957848883">Начар сырсөздөрдү билип алуу оңой. Decentr'га <ph name="BEGIN_LINK" />сиз үчүн татаал сырсөздөрдү түзүп, эстеп калууга<ph name="END_LINK" /> уруксат бериңиз.</translation>
<translation id="6990124437352146030">Бул сайтта иштөө үчүн Decentr микрофонуңузду колдонушу керек</translation>
<translation id="705851970750939768">Decentr'ду жаңыртуу</translation>
<translation id="7067091210845072982">Эгер сүрөттөрдүн түшүндүрмөсү жок болсо, Decentr аны түшүндүрүп берүүгө аракет кылат. Түшүндүрмөлөрдү даярдоо үчүн, сүрөттөр Google'га жөнөтүлөт.</translation>
<translation id="7147279922647361552">Decentr'дун эң маанилүү купуялык тандоолорун ыңгайлаштырып алыңыз</translation>
<translation id="718435575166326686">Decentr'га бул сайтта камераны колдонууга уруксат бериңиз</translation>
<translation id="7196312274710523067">Decentr иштетилбей койду. Кайталап көрүңүз.</translation>
<translation id="7197677400338048821">Decentr сырсөздөрүңүздү текшере албай жатат. 24 сааттан кийин кайра аракет кылыңыз.</translation>
<translation id="7223968959479464213">Тапшырмаларды башкаргыч – Decentr</translation>
<translation id="731644333568559921">Decentr OS &amp;жаңыртуу</translation>
<translation id="731795002583552498">Decentr жаңыртылууда</translation>
<translation id="7318036098707714271">Өзгөчө шарттар файлыңыз бузулган же жараксыз.

Decentr жөндөөлөрүңүздү калыбына келтире албайт.</translation>
<translation id="7337881442233988129">Decentr</translation>
<translation id="7339898014177206373">Жаңы терезе</translation>
<translation id="734373864078049451">Веб, кыстармаларыңыз жана Decentr'дагы жеке дайын-даректериңиз бул жерде жайгашкан.</translation>
<translation id="7349591376906416160">Тутумуңуздун администратору Decentr'ду <ph name="TARGET_URL_HOSTNAME" /> доменин <ph name="ALTERNATIVE_BROWSER_NAME" /> аркылуу ачууга конфигуациялады.</translation>
<translation id="7448255348454382571">Decentr OS'ту өчүрүп-күйгүзүңүз</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> – Decentr Иштеп чыгуучулар үчүн</translation>
<translation id="7451052299415159299">Бул сайтта иштөө үчүн Decentr камераңызды колдонушу керек</translation>
<translation id="7483335560992089831">Decentr'дун учурда иштеп жаткан версиясы орнотулбай жатат. Decentr'ду жаап, кайра аракет кылып көрүңүз.</translation>
<translation id="753534427205733210">{0,plural, =1{Decentr 1 мүнөттөн кийин кайра иштетилет}other{Decentr # мүнөттөн кийин кайра иштетилет}}</translation>
<translation id="7549178288319965365">Decentr OS жөнүндө</translation>
<translation id="7561906087460245826">Decentr'дагы дайындар да тазалансын (<ph name="URL" />)</translation>
<translation id="7585853947355360626">Эгер жөндөө бул баракта көрүнбөсө, <ph name="LINK_BEGIN" />
      Decentr OS жөндөөлөрүнөн<ph name="LINK_END" /> карап көрүңүз</translation>
<translation id="761356813943268536">Decentr сиздин камера менен микрофонуңузду пайдаланууда.</translation>
<translation id="7617377681829253106">Decentr жаңы эле жакшыртылды</translation>
<translation id="7686590090926151193">Decentr сиздин демейки серепчиңиз эмес</translation>
<translation id="7689606757190482937">Decentr'ду бардык түзмөктөрүңүздө шайкештирип, жекелештиресиз</translation>
<translation id="7729447699958282447">Сиздин домениңизде шайкештештирүү мүмкүнчүлүгү жок болгондуктан, Decentr дайын-даректериңизди шайкештештире алган жок.</translation>
<translation id="7745317241717453663">Ушуну менен бул түзмөктөн серептөө дайын-даректериңиз өчүрүлөт. Дайын-даректериңизди кийинчерээк чыгарып алуу үчүн Decentr'га <ph name="USER_EMAIL" /> аккаунту менен кириңиз.</translation>
<translation id="7747138024166251722">Орнотуучу убактылуу каталогду түзө алган жок. Дискте бош орун бар экендигин жана программаны орнотууга боло тургандыгын текшериңиз.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> – Decentr Canary</translation>
<translation id="7828947555739565424">Бул түзмөктөгү аккаунт менен Decentr профили мурунтан эле түзүлгөн</translation>
<translation id="7857220146454061152">Decentr жаңыртууларын алып туруу үчүн OS X 10.11 же андан кийинки версиясын орнотушуңуз керек. Бул компьютерде OS X 10.10 версиясы колдонулууда.</translation>
<translation id="7867198900892795913">Decentr акыркы версиясына жаңыртылбай койду, андыктан жаңы функциялар менен коопсуздук оңдоолорун пайдалана албай калдыңыз.</translation>
<translation id="7898472181347242998">Түзмөгүңүздүн жаңыртылганын текшерүү үчүн <ph name="LINK_BEGIN" />Decentr OS Жөндөөлөрүнө<ph name="LINK_END" /> өтүңүз</translation>
<translation id="7937630085815544518">Decentr'га <ph name="USER_EMAIL_ADDRESS" /> катары кирдиңиз. Ушул аккаунт менен кайра кириңиз.</translation>
<translation id="7975919845073681630">Бул Decentr'дун кошумча орнотулушу болгондуктан, аны демейки серепчиңиз катары тандай албайсыз.</translation>
<translation id="8013436988911883588">Decentr'га уруксат берилгенден кийин вебсайттар уруксат сурай алышат.</translation>
<translation id="8045118833343856403">Төмөнкү аккаунттар Decentr профилдерине кирген жок. Эгер аккаунтту башка профилде колдонгуңуз келсе, адегенде ал профилди өчүрүңүз.</translation>
<translation id="8105840573057009683">Decentr'га бул сайтта жайгашкан жерди колдонууга уруксат бериңиз</translation>
<translation id="81770708095080097">Бул файл кооптуу, ошондуктан Decentr аны бөгөттөп койду.</translation>
<translation id="8248265253516264921">Эгер сүрөттөрдүн түшүндүрмөсү жок болсо, Decentr аны түшүндүрүп берүүгө аракет кылат. Түшүндүрмөлөрдү даярдоо үчүн, сүрөттөр Google'га жөнөтүлөт. Аны жөндөөлөрдөн каалаган убакта өчүрүп койсоңуз болот.</translation>
<translation id="8266560134891435528">Decentr сырсөздөрүңүздү текшере албайт, анткени аккаунтуңузга кирген жоксуз</translation>
<translation id="8276522524898344151">Decentr сырсөздөрдү көчүрүүгө аракет кылып жатат.</translation>
<translation id="8290862415967981663">Бул файл кооптуу болушу мүмкүн, ошондуктан Decentr аны бөгөттөп койду.</translation>
<translation id="8330519371938183845">Decentr'ду бардык түзмөктөрүңүздө шайкештирип, жекелештирүү үчүн аккаунтуңузга кириңиз</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> мурда Decentr'ду пайдаланчу</translation>
<translation id="8417404458978023919">{0,plural, =1{Decentr 1 күндүн ичинде кайра иштетилет}other{Decentr # күндүн ичинде кайра иштетилет}}</translation>
<translation id="8453117565092476964">Орноткуч архиви бузулган же жараксыз. Decentr'ду кайра жүктөп алыңыз.</translation>
<translation id="8493179195440786826">Decentr эскирип калган.</translation>
<translation id="8550334526674375523">Бул жумуш профили жеке профилиңизден толугу менен ажыратылган.</translation>
<translation id="8558383651099478961">Ата-энеңиз Decentr үчүн "Сайттарга, колдонмолорго жана кеңейтүүлөргө уруксаттарды" өчүрүп койгон. Бул <ph name="EXTENSION_TYPE_PARAMETER" /> кеңейтүүсүн кошууга болбойт.</translation>
<translation id="8568283329061645092">Google аккаунтуңуз менен киргенде Decentr сырсөздөрүңүздү текшерет</translation>
<translation id="8586442755830160949">Автордук укук <ph name="YEAR" /> Decentr авторлору. Бардык укуктар корголгон.</translation>
<translation id="8619360774459241877">Decentr иштетилүүдө…</translation>
<translation id="8621669128220841554">Белгиси катадан улам, орнотулбай калды. Decentr'ду кайра жүктөп алыңыз.</translation>
<translation id="8697124171261953979">Decentr иштеп баштаганда же Omnibox'тон изделгенде, кайсы бет көрсөтүлө тургандыгын көзөмөлдөйт.</translation>
<translation id="8704119203788522458">Бул сиздин Decentr</translation>
<translation id="8796602469536043152">Бул сайтта иштөө үчүн Decentr камераңызды жана микрофонуңузду колдонушу керек</translation>
<translation id="8803635938069941624">Decentr OS шарттары</translation>
<translation id="8821041990367117597">Аккаунтуңуздун кирүү чоо-жайлары эскирип калгандыктан, Decentr дайын-даректериңизди шайкештештире алган жок.</translation>
<translation id="8862326446509486874">Тутум деңгээлинде орнотууга тийиштүү укугуңуз жок. Орноткучту Администратор катары кайра иштетип көрүңүз.</translation>
<translation id="8880203542552872219">Эгер өзгөрткөн болсоңуз, Decentr'да сакталган сырсөзүңүздү жаңы сырсөзгө дал келгендей кылып түзөтүңүз.</translation>
<translation id="8897323336392112261">Decentr'ду иштетип баштаганда же Башкы бет баскычы чыкылдатылганда, кайсы бет көрсөтүлө тургандыгын көзөмөлдөйт.</translation>
<translation id="8907580949721785412">Decentr сырсөздөрдү көрсөткөнгө аракет кылууда. Уруксат берүү үчүн Windows сырсөзүңүздү жазыңыз.</translation>
<translation id="8941642502866065432">Decentr жаңырбай жатат</translation>
<translation id="8974095189086268230">Decentr OS кошумча <ph name="BEGIN_LINK_CROS_OSS" />ачык булак программасы<ph name="END_LINK_CROS_OSS" /> тарабынан мүмкүн болду.</translation>
<translation id="8986207147630327271">Жумуш профилин ушул серепчиге кошуп, администраторго жумуш профилин гана көзөмөлдөөгө уруксат берип жатасыз.</translation>
<translation id="9019929317751753759">Жеке маалыматыңызды коргоо үчүн, айрым Decentr кеңейтүүлөрүн өчүрүп койдук, себеби <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ичинде аларга байланыштуу маалымат жок. Демек, бул курамдык бөлүктөр тымызын орнотулган.</translation>
<translation id="9089354809943900324">Decentr эскирип калган.</translation>
