<translation id="6281746429495226318">የDecentr መገለጫዎን ያብጁ</translation>
<translation id="6290827346642914212">የDecentr መገለጫዎን ይሰይሙ</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> አደገኛ ሊሆን ስለሚችል Decentr አግዶታል።</translation>
<translation id="6309712487085796862">Decentr ካሜራዎን እየተጠቀመ ነው።</translation>
<translation id="6333502561965082103">ሌላ ሥርዓተ ክወና በDecentr ላይ በሂደት ላይ ነው። እባክዎ ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="6334986366598267305">አሁን Decentrን ከGoogle መለያዎ ጋር እና በተጋሩ ኮምፒውተሮች ላይ መጠቀም ይበልጥ ቀላል ነው።</translation>
<translation id="6373523479360886564">እርግጠኛ ነዎት Decentrን ማራገፍ ይፈልጋሉ?</translation>
<translation id="6403826409255603130">Decentr ድረ-ገጾችን እና መተግበሪያዎችን እጅግ በጣም ፈጣን በሆነ ፍጥነት የሚያሄድ ድር አሳሽ ነው። ፈጣን፣ የረጋ እና ለመጠቀም ቀላል ነው። Decentr ውስጥ አብሮ በተሰራላቸው የተንኮል-አዘል ሶፍትዌር እና የማስገሪያ መከላከያዎች አማካኝነት ደህንነትዎ ይበልጥ በተጠበቀ ሁኔታ ድሩን ያስሱ።</translation>
<translation id="6434250628340475518">Decentr OS ሥርዓት</translation>
<translation id="6455857529632101747">ወደ Decentr መገለጫዎች እንኳን በደህና መጡ</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Decentr በ1 ሰከንድ ውስጥ ዳግም ይጀምራል}one{Decentr በ# ሰከንዶች ውስጥ ዳግም ይጀምራል}other{Decentr በ# ሰከንዶች ውስጥ ዳግም ይጀምራል}}</translation>
<translation id="6475912303565314141">እንዲሁም Decentrን ሲጀምሩት የሚታየውን ገጽ ይቆጣጠራል።</translation>
<translation id="6510925080656968729">Decentrን ያራግፉ</translation>
<translation id="6542839706527980775">እያንዳንዱ መገለጫ እንደ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎችም ያሉ የራሱ የDecentr መረጃዎችን ይይዛል</translation>
<translation id="6570579332384693436">የሥርዓተ ፊደል አጻጻፍ ስህተቶችን ለማስተካከል፣ Decentr እርስዎ በጽሑፍ መስኮች ውስጥ የሚተይቡትን ጽሑፍ ወደ Google ይልካል</translation>
<translation id="6598877126913850652">ወደ የDecentr ማሳወቂያ ቅንብሮች ይሂዱ</translation>
<translation id="6613594504749178791">ለውጦችዎ Decentr በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="665732753414869868">Decentr የዙሪያዎን የ3ል ካርታ ለመፍጠር የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="6676384891291319759">በይነመረብን ተዳረስ</translation>
<translation id="6709350901466051922">Decentr ለዚህ ጣቢያ የማይክሮፎን ፈቃድ ያስፈልገዋል</translation>
<translation id="6717134281241384636">መገለጫዎ ከአዲስ የDecentr ስሪት ስለሆነ የመጣው ስራ ላይ ሊውል አይችልም።

አንዳንድ ባህሪያት ላይገኙ ይችላሉ። እባክዎ የተለየ የመገለጫ አቃፊ ይግለጹ ወይም ይበልጥ አዲስ የሆነ የDecentr ስሪት ይጠቀሙ።</translation>
<translation id="6734080038664603509">&amp;Decentrን አዘምን</translation>
<translation id="6734291798041940871">Decentr ለሁሉም በእርስዎ ኮምፒውተር ላይ ላሉ ተጠቃሚዎች አስቀድሞ ተጭኗል።</translation>
<translation id="673636774878526923">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን Decentr ነገሮች ለመድረስ ይግቡ፣ ከዚያ ስምረትን ያብሩ።</translation>
<translation id="6774082503108938489">የእርስዎ ወላጅ ለDecentr «የጣቢያዎች፣ መተግበሪያዎች እና ቅጥያዎች ፈቃዶች»ን አጥፍተዋል። ይህን <ph name="EXTENSION_TYPE_PARAMETER" /> ማንቃት አይፈቀድም።</translation>
<translation id="6847869444787758381">Decentr የእርስዎ የይለፍ ቃላት ከተነጠቁ እርስዎ እንዲያውቁት ያደርግዎታል</translation>
<translation id="6857782730669500492">Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (ወደ Decentr ተቀድቷል)</translation>
<translation id="6873893289264747459">Decentr «<ph name="EXTENSION_NAME" />» ተንኮል አዘል ዌር እንደያዘ አግኝቷል</translation>
<translation id="6893813176749746474">Decentr ተዘምኗል፣ ግን ቢያንስ ለ30 ቀኖች አልተጠቀሙበትም።</translation>
<translation id="691026815377248078">Decentr ማጣመርን ለመቀጠል የብሉቱዝ መዳረሻ ያስፈልገዋል። <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">አገናኙን በDecentr ማን&amp;ነትን በማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="6978145336957848883">ደካማ የይለፍ ቃላት ለመገመት ቀላል ናቸው። Decentr <ph name="BEGIN_LINK" /> ለእርስዎ ጠንካራ የይለፍ ቃላትን እንዲፈጥር እና እንዲያስታውስ<ph name="END_LINK" /> ይፍቀዱ።</translation>
<translation id="6990124437352146030">Decentr ለዚህ ጣቢያ የእርስዎን ማይክሮፎን ለመድረስ ፈቃድ ያስፈልገዋል</translation>
<translation id="705851970750939768">Decentrን አዘምን</translation>
<translation id="7067091210845072982">አንድ ምስል ጠቃሚ መግለጫ ከሌለው Decentr ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ Google ይላካሉ።</translation>
<translation id="718435575166326686">Decentr ለዚህ ጣቢያ የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="7196312274710523067">Decentrን ማስጀመር አልተቻለም። እንደገና ይሞክሩ።</translation>
<translation id="7197677400338048821">Decentr የእርስዎን የይለፍ ቃላት መፈተሽ አይችልም። ከ24 ሰዓቶች በኋላ እንደገና ይሞክሩ።</translation>
<translation id="7223968959479464213">ተግባር መሪ - Decentr</translation>
<translation id="731644333568559921">&amp;Decentr ስርዓተ ክወናን አዘምን</translation>
<translation id="731795002583552498">Decentrን በማዘመን ላይ...</translation>
<translation id="7318036098707714271">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

Decentr ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="7337881442233988129">Decentr</translation>
<translation id="7339898014177206373">አዲሰ መስኮት</translation>
<translation id="734373864078049451">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የDecentr ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="7349591376906416160">የእርስዎ ስርዓት አስተዳዳሪ Decentr <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME" />ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7448255348454382571">Decentr OSን ዳግም አስጀምር</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - Decentr ግንባታ</translation>
<translation id="7451052299415159299">Decentr ለዚህ ጣቢያ የእርስዎን ካሜራ ለመድረስ ፈቃድ ያስፈልገዋል</translation>
<translation id="7483335560992089831">እየሄደ ያለውን ተመሳሳዩን የDecentr ስሪት መጫን አይቻልም። እባክዎ Decentrን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="753534427205733210">{0,plural, =1{Decentr በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{Decentr በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{Decentr በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="7549178288319965365">ስለ Decentr OS</translation>
<translation id="7561906087460245826">በተጨማሪ ከDecentr (<ph name="URL" />) ውሂብን አጽዳ</translation>
<translation id="7585853947355360626">በዚህ ገጽ ላይ አንድ ቅንብር ካልታየ በእርስዎ <ph name="LINK_BEGIN" />
      የ Decentr አሳሽ ቅንብሮች<ph name="LINK_END" /> ውስጥ ይመልከቱ</translation>
<translation id="761356813943268536">Decentr ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="7617377681829253106">Decentr አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="7686590090926151193">Decentr ነባሪ አሳሽዎ አይደለም</translation>
<translation id="7689606757190482937">በመላ መሣሪያዎችዎ ላይ Decentrን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="7729447699958282447">ማመሳሰል ለጎራዎ ስለማይገኝ Decentr ውሂብዎን ማመሳሰል አይችልም።</translation>
<translation id="7745317241717453663">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Decentr ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - Decentr Canary</translation>
<translation id="7828947555739565424">ይህን መለያ ያለው አንድ የDecentr መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7857220146454061152">የወደፊቱን የDecentr ዝመኔዎችን ለማግኘት፣ OS X 10.11 ወይም ከዚያ በኋላ ያለው ያስፈልግዎታል። ይህ ኮምፒተር OS X 10.10 እየተጠቀመ ነው።</translation>
<translation id="7867198900892795913">Decentr ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። Decentrን ማዘመን አለብዎት።</translation>
<translation id="7898472181347242998">መሣሪያዎ የተዘመነ ከሆነ ለማየት ወደ <ph name="LINK_BEGIN" />የDecentr OS ቅንብሮች ይሂዱ<ph name="LINK_END" /></translation>
<translation id="7937630085815544518">እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Decentr ገብተዋል። እባክዎ እንደገና ለመግባት ተመሳሳዩን መለያ ይጠቀሙ።</translation>
<translation id="7975919845073681630">ይሄ ሁለተኛ የDecentr ጭነት ነው፣ እና ነባሪ አሳሽዎ ማድረግ አይቻልም።</translation>
<translation id="8013436988911883588">አንዴ Decentr መዳረሻ ከኖረው በኋላ ድር ጣቢያዎች እርስዎን መዳረሻ መጠየቅ ይችላሉ።</translation>
<translation id="8045118833343856403">የሚከተሉት መለያዎች በማናቸውም የDecentr መገለጫዎች ውስጥ አልገቡም። አንድ መለያ በሌላ መገለጫ ውስጥ ለመጠቀም ከፈለጉ መጀመሪያ ያንን መገለጫ ያስወግዱት።</translation>
<translation id="8105840573057009683">Decentr ለዚህ ጣቢያ የአካባቢ ፈቃድ ያስፈልገዋል</translation>
<translation id="81770708095080097">ይህ ፋይል አደገኛ ስለሆነ Decentr አግዶታል።</translation>
<translation id="8248265253516264921">አንድ ምስል ጠቃሚ መግለጫ ከሌለው Decentr ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ Google ይላካሉ። ይህን በማንኛውም ጊዜ በቅንብሮች ውስጥ ሊያጠፉት ይችላሉ።</translation>
<translation id="8266560134891435528">እርስዎ በመለያ ስላልገቡ ስለሆኑ Decentr የይለፍ ቃላትዎን መፈተሽ አይችልም</translation>
<translation id="8276522524898344151">Decentr የይለፍ ቃላትን ለመቅዳት እየሞከረ ነው።</translation>
<translation id="8290862415967981663">ይህ ፋይል አደገኛ ሊሆን ስለሚችል Decentr አግዶታል።</translation>
<translation id="8330519371938183845">Decentrን በመላ መሣሪያዎችዎ ላይ ለማሳመር እና ግላዊነት ለማላበስ</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> ከዚህ ቀደም Decentrን እየተጠቀመ ነበር</translation>
<translation id="8417404458978023919">{0,plural, =1{በአንድ ቀን ውስጥ Decentrን ዳግም አስጀምር}one{በ# ቀኖች ውስጥ Decentrን ዳግም አስጀምር}other{በ# ቀኖች ውስጥ Decentrን ዳግም አስጀምር}}</translation>
<translation id="8453117565092476964">የጫኚው መዝገብ ተበላሽቷል ወይም ትክክል አይደለም። እባክዎ Decentrን እንደገና ያውርዱ።</translation>
<translation id="8493179195440786826">Decentr ጊዜው አልፎበታል</translation>
<translation id="8550334526674375523">ይህ የስራ መገለጫ ከግል መገለጫዎ ሙሉ ለሙሉ የተለየ ነው።</translation>
<translation id="8558383651099478961">የእርስዎ ወላጅ ለDecentr «የጣቢያዎች፣ መተግበሪያዎች እና ቅጥያዎች ፈቃዶች»ን አጥፍተዋል። ይህን <ph name="EXTENSION_TYPE_PARAMETER" /> ማከል አይፈቀድም።</translation>
<translation id="8568283329061645092">Decentr በእርስዎ የGoogle መለያ በሚገቡበት ጊዜ የእርስዎን የይለፍ ቃላትን ሊፈትሽ ይችላል</translation>
<translation id="8586442755830160949">የቅጂ መብት <ph name="YEAR" /> የDecentr ደራሲያን። ሁሉም መብቶች የተጠበቁ ናቸው።</translation>
<translation id="8619360774459241877">Decentrን በማስጀመር ላይ...</translation>
<translation id="8621669128220841554">ተለይቶ ባልታወቀ ስህተት ምክንያት ጭነት ከሽፏል። እባክዎ Decentrን እንደገና ያውርዱ።</translation>
<translation id="8697124171261953979">እንዲሁም Decentrን ሲጀምሩት ወይም ከኦምኒቦክሱ ሆነው ሲፈልጉ የሚታየውን ገጽ ይቆጣጠራል።</translation>
<translation id="8704119203788522458">ይሄ የእርስዎ Decentr ነው</translation>
<translation id="8796602469536043152">Decentr ለዚህ ጣቢያ የእርስዎን ካሜራ እና ማይክሮፎን ለመድረስ ፈቃድ ያስፈልገዋል</translation>
<translation id="8803635938069941624">የDecentr OS ውል</translation>
<translation id="8821041990367117597">የመለያ መግቢያ ዝርዝሮችዎ ጊዜ ያለፈባቸው ስለሆኑ Decentr ውሂብዎን ማመሳሰል አልቻለም።</translation>
<translation id="8862326446509486874">ለስርዓተ-ደረጃ ጭነት ተገቢ መብቶች የሉዎትም። ጫኚውን እንደ አስተዳዳሪ በማሄድ እንደገና ይሞክሩ።</translation>
<translation id="8880203542552872219">እንደዚያ ከሆነ፣ ከእርስዎ አዲሱ የይለፍ ቃል ጋር እንዲዛመድ የእርስዎን በDecentr የተቀመጠ የይለፍ ቃል አርትዕ ያድርጉ።</translation>
<translation id="8897323336392112261">እንዲሁም Decentrን ሲጀምሩት ወይም የመነሻ አዝራሩን ጠቅ ሲያደርጉት የሚታየውን ገጽ ይቆጣጠራል።</translation>
<translation id="8907580949721785412">Decentr የይለፍ ቃሎችን ለማሳየት እየሞከረ ነው። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="8941642502866065432">Decentrን ማዘመን አልተቻለም</translation>
<translation id="8974095189086268230">Decentr ስርዓተ ክወና በተጨማሪ <ph name="BEGIN_LINK_CROS_OSS" />ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_CROS_OSS" /> እውን ሊሆን ችሏል።</translation>
<translation id="8986207147630327271">የስራ መገለጫን ወደዚህ አሳሽ እያከሉ እና ለአስተዳዳሪዎ በስራ መገለጫው ላይ ብቻ ቁጥጥር እየሰጡ ነው።</translation>
<translation id="9019929317751753759">Decentrን ይበልጥ ደህንነቱ የተጠበቀ እንዲሆን ለማድረግ፣ በ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ውስጥ ያልተዘረዘረውን የሚከተለውን ቅጥያ አሰናክለነዋል እና እርስዎ ሳያውቁት የታከለ ሊሆን ይችላል።</translation>
<translation id="9089354809943900324">Decentr ጊዜው አልፎበታል</translation>
<translation id="9093206154853821181">{0,plural, =1{Decentr በአንድ ሰዓት ውስጥ ዳግም ይጀምራል}one{Decentr በ# ሰዓቶች ውስጥ ዳግም ይጀምራል}other{Decentr በ# ሰዓቶች ውስጥ ዳግም ይጀምራል}}</translation>
<translation id="91086099826398415">አገናኙን በDecentr አዲስ &amp;ትር ውስጥ ክፈት</translation>
<translation id="911206726377975832">የአሰሳ ውሂብዎም ይሰረዝ?</translation>
<translation id="9158494823179993217">የእርስዎ የስርዓት አስተዳዳሪ <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ Decentr ተለዋጭ አሳሽን እንዲከፍት አዋቅረውታል።</translation>
