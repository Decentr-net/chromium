<translation id="6039377483953237732">የDecentr OS ስሪት</translation>
<translation id="6055895534982063517">አዲስ የDecentr ስሪት ይገኛል፣ እና ከመቼውም በበለጠ ፈጣን ሆኗል።</translation>
<translation id="6063093106622310249">በDecentr ውስጥ &amp;ክፈት</translation>
<translation id="6072279588547424923"><ph name="EXTENSION_NAME" /> ወደ Decentr ታክሏል።</translation>
<translation id="608006075545470555">የስራ መገለጫ ወደዚህ አሳሽ ያክሉ</translation>
<translation id="608189560609172163">በመለያ ሲገባ በነበረ ስህተት ምክንያት Decentr ውሂብዎን ማመሳሰል አልቻለም።</translation>
<translation id="6096348254544841612">Decentrን ያብጁትና ይቆጣጠሩት። ዝማኔ ይገኛል።</translation>
<translation id="6120345080069858279">Decentr ይህን የይለፍ ቃል በእርስዎ የGoogle መለያ ውስጥ ያስቀምጠዋል። ማስታወስ አይኖርብዎትም።</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> አደገኛ ነው፣ ስለዚህ Decentr አግዶታል።</translation>
<translation id="6134968993075716475">የጥንቃቄ አሰሳ ጠፍቷል። Decentr እንዲያበሩት ይመክራል።</translation>
<translation id="6145820983052037069">እዚህ በDecentr መገለጫዎች መካከል መቀያየር ይችላሉ</translation>
<translation id="6183079672144801177">በእርስዎ <ph name="TARGET_DEVICE_NAME" /> ላይ በመለያ ወደ Decentr መግባትዎን ያረጋግጡ እና እንደገና ለመላክ ይሞክሩ።</translation>
<translation id="6212496753309875659">ይህ ኮምፒውተር አስቀድሞ ይበልጥ አዲስ የሆነ የDecentr ስሪት አለው። ሶፍትዌሩ የማይሰራ ከሆነ እባክዎ Decentrን ያራግፉና እንደገና ይሞክሩ።</translation>
<translation id="6219195342503754812">{0,plural, =0{Decentr አሁን ዳግም ይጀመራል}=1{Decentr በ1 ሰከንድ ውስጥ ዳግም ይጀመራል}one{Decentr በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}other{Decentr በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="6241367896540709610">Decentr ፋይሎችን ለማውረድ የማከማቻ መዳረሻ ፈቃድ ያስፈልገዋል</translation>
<translation id="6248213926982192922">Decentr ነባሪውን አሳሽ ያድርጉ።</translation>
