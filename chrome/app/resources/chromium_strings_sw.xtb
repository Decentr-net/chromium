<translation id="7617377681829253106">Decentr imeboreshwa</translation>
<translation id="7649070708921625228">Usaidizi</translation>
<translation id="7682213815243802460">Unaweza kupata maelezo zaidi kuhusu vipengele hivi kwenye mipangilio ya Decentr.</translation>
<translation id="7686590090926151193">Decentr si kivinjari chako chaguomsingi</translation>
