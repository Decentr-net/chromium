<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="1026101648481255140">Endelea na Usakinishaji</translation>
<translation id="1029669172902658969">Fungua tena ili usasishe Mfumo wa Uendeshaji wa Decentr</translation>
<translation id="1040916596585577953">Decentr inapendekeza ukague kiendelezi hiki</translation>
<translation id="1042552502243217427">Decentr hutumia seva za Decentr, tovuti inapoomba viungo vipakiwe mapema kwenye ukurasa wake kwa njia ya faragha. Hali hii huficha utambulisho wako usionekane kwenye tovuti inayopakiwa mapema lakini Decentr hufahamu tovuti zinazopakiwa mapema.</translation>
<translation id="1065672644894730302">Mapendeleo yako hayawezi kusomwa.

Baadhi ya vipengele huenda visipatikane na mabadiliko katika mapendeleo hayatahifadhiwa.</translation>
<translation id="1083934481477628225">Mzazi wako amezima "Ruhusa za tovuti, programu na viendelezi" kwenye Decentr</translation>
<translation id="1098170124587656448">Decentr inaweza kukusaidia ulinde akaunti yako dhidi ya ufichuzi haramu wa data, viendelezi vibaya na zaidi</translation>
<translation id="1104942323762546749">Decentr ingependa kuhamisha manenosiri yako. Andika nenosiri lako la Windows ili uruhusu shughuli hii.</translation>
<translation id="113122355610423240">Decentr ni kivinjari chako chaguomsingi</translation>
<translation id="1131805035311359397">Ili uangalie kama manenosiri yako ni salama dhidi ya ufichuzi haramu wa data na matatizo mengine ya usalama, <ph name="BEGIN_LINK" />ingia katika akaunti kwenye Decentr<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Bofya menyu ya Decentr</translation>
<translation id="1184145431117212167">Imeshindwa kuweka kwenye kifaa kwa sababu toleo la Windows ulilonalo halitumiki.</translation>
<translation id="1185134272377778587">Kuhusu Decentr</translation>
<translation id="1188705220418984327">Ili uonyeshe dirisha lako, washa kinasa skrini katika Decentr kwenye Mapendeleo ya Mfumo.</translation>
<translation id="1203500561924088507">Asante kwa kusakinisha. Ni lazima uzime kisha uwashe tena kivinjari chako kabla ya kutumia <ph name="BUNDLE_NAME" />.</translation>
<translation id="1262876892872089030">Kichupo hiki kilipokuwa hakitumiki, nafasi ya hifadhi ilirejeshwa ili Decentr iwe na kasi ya utendaji. Unaweza kuchagua tovuti hii iendelee kutumika kila wakati.</translation>
<translation id="1265577313130862557">Decentr imezuia upakuaji huu kwa sababu faili si salama</translation>
<translation id="126567311906253476">Unapoingia katika akaunti za huduma za Decentr kama Gmail au YouTube ukitumia <ph name="USER_EMAIL" />, unaweza kuingia katika akaunti kiotomatiki kwenye Decentr ukitumia akaunti ile ile</translation>
<translation id="1290883685122687410">Hitilafu ya kuweka mipangilio: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Weka mipangilio ya wasifu wako mpya wa Decentr</translation>
<translation id="1324107359134968521">Decentr inahitaji ruhusa ya kufikia Bluetooth ili kugundua 
 vifaa vyenye Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1342274909142618978">Futa pia data kutoka Decentr (<ph name="URL" />)</translation>
<translation id="1414495520565016063">Umeingia kwenye Decentr!</translation>
<translation id="1478370723027452770">Pata usaidizi kuhusu Decentr ya Majaribio</translation>
<translation id="1497802159252041924">Hitilafu ya kusakinisha: <ph name="INSTALL_ERROR" /></translation>
<translation id="1524282610922162960">Shiriki kichupo cha Decentr</translation>
<translation id="1553461853655228091">Decentr inahitaji ruhusa ya kufikia kamera yako ili iunde ramani ya 3D ya mazingira yako</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Kiendelezi hiki hakitumiki tena. Decentr inapendekeza ukiondoe.}other{Viendelezi hivi havitumiki tena. Decentr inapendekeza uviondoe.}}</translation>
<translation id="1574377791422810894">Zana usalama za Decentr</translation>
<translation id="1591808205441691831">Decentr inahitaji kuthibitisha kuwa ni wewe kabla ya kuhifadhi baadhi ya data kwenye Akaunti yako ya Decentr na kutumiwa kwenye vifaa vyako vyote. Ukiondoka kwenye akaunti, data hii itasalia kwenye kifaa hiki.</translation>
<translation id="1594928384848033697">Decentr ingependa kufuta data yako ya Kidhibiti cha Manenosiri. Weka nenosiri lako la Windows ili uruhusu hatua hii.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Msimamizi wako anataka ufungue Decentr tena ili utumie sasisho}=1{Msimamizi wako anataka ufungue Decentr tena ili utumie sasisho. Haitafungua upya dirisha fiche.}other{Msimamizi wako anataka ufungue Decentr tena ili utumie sasisho. Haitafungua upya madirisha # fiche.}}</translation>
<translation id="1625909126243026060">Kagua vidhibiti muhimu vya faragha na usalama katika Decentr</translation>
<translation id="1632539827495546968">Iwapo unataka kutumia akaunti hii mara moja tu, unaweza kutumia kipengele cha <ph name="GUEST_LINK_BEGIN" />Matumizi ya Wageni<ph name="GUEST_LINK_END" /> katika kivinjari cha Decentr. Iwapo unataka kuongeza akaunti ya mtu mwingine, <ph name="LINK_BEGIN" />ongeza mtu mpya<ph name="LINK_END" /> kwenye <ph name="DEVICE_TYPE" /> yako.

Huenda ruhusa ambazo tayari umezipa tovuti na programu zikatumika kwenye akaunti hii. Unaweza kudhibiti Akaunti zako za Decentr katika <ph name="SETTINGS_LINK_BEGIN" />Mipangilio<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="1640672724030957280">Inapakua...</translation>
<translation id="1715127912119967311">Ili kusaidia kuboresha vipengele hivi, Decentr hutumia Decentr data ya jinsi unavyovitumia. Data hii inaweza kusomwa, kuchakatwa na kuwekewa vidokezo na wahakiki wanadamu.</translation>
<translation id="1722488837206509557">Hii itakuruhusu kuchagua kwenye vifaa vinavyopatikana na kuonyesha maudhui kwenye vifaa hivyo.</translation>
<translation id="17264556997921157">Unaweza kuona na kuondoa mada zinazokuvutia zinazotumiwa na tovuti kukuonyesha matangazo. Decentr hukadiria mambo yanayokuvutia kulingana na historia yako ya kuvinjari ya hivi karibuni.</translation>
<translation id="1733725117201708356">Decentr itafuta data ya kuvinjari hivi karibuni</translation>
<translation id="1736443181683099871">Decentr itajaribu kuboresha usogezaji ili utumie HTTPS</translation>
<translation id="1745121272106313518">Decentr itazima kisha iwake baada ya <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Wakati kiendelezi cha HTTPS hakipatikani, Decentr itatumia muunganisho usio salama bila kukutahadharisha</translation>
<translation id="1774152462503052664">Acha Decentr iendeshe katika mandharinyuma</translation>
<translation id="1779356040007214683">Ili kufanya Decentr salama zaidi, tumezima baadhi ya viendelezi ambavyo havijaorodheshwa katika <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> na ambavyo huendwa viliongezwa pasipo ridhaa yako.</translation>
<translation id="1808667845054772817">Sakinisha Decentr Upya</translation>
<translation id="1820835682567584003">Decentr inajaribu <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="18552579716432081">Ili ufute data ya kuvinjari kwenye kifaa hiki pekee, bila kuifuta katika Akaunti yako ya Decentr, <ph name="BEGIN_LINK" />ondoka kwenye akaunti ya Decentr<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">Unaweza kudhibiti Akaunti zako za Decentr ulizotumia kuingia katika tovuti na programu. Akaunti zako za Decentr hutumiwa kwenye kivinjari cha Decentr, Duka la Decentr Play, Gmail na kwingineko. Iwapo ungependa kuweka akaunti ya mtu mwingine, kama vile mwanafamilia, ongeza mtu mpya kwenye <ph name="DEVICE_TYPE" /> yako badala yake. <ph name="LINK_BEGIN" />Pata maelezo zaidi<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">Tovuti zinaweza kuhifadhi maelezo kuhusu mambo yanayokuvutia kwa kutumia Decentr. Kwa mfano, iwapo utatembelea tovuti ili kununua viatu kwa ajili ya kukimbia mbio za marathoni, tovuti hiyo huenda ikatambua kuwa moja ya mambo yanayokuvutia ni kukimbia mbio za marathoni. Baadaye, iwapo utatembelea tovuti tofauti ili kujisajili kwa ajili ya mbio, tovuti hiyo huenda ikakuonyesha tangazo la viatu vya kukimbilia kulingana na mambo yanayokuvutia.</translation>
<translation id="1881322772814446296">Unaingia katika akaunti ukitumia akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye Decentr. Data yako ya Decentr, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio nyingine itahusishwa na<ph name="USER_NAME" /> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za Decentr, lakini hutaweza  kuunganisha data hii na akaunti nyingine. Unaweza kwa hiari kuunda wasifu mpya ili kuweka data yako ya Decentr iliyo kando. <ph name="LEARN_MORE" /></translation>
<translation id="1906696617298807388">Unapoandika kwenye sehemu ya anwani au kisanduku cha kutafutia, Decentr hutuma unachokiandika kwenda kwenye Hifadhi ya Decentr ili upate mapendekezo ya kipengee. Kipengele hiki huwa kimezimwa katika Hali fiche.</translation>
<translation id="1911763535808217981">Kwa kuzima kipengele hiki, unaweza kuingia katika tovuti za Decentr kama vile Gmail bila kuingia katika akaunti ya Decentr</translation>
<translation id="1929939181775079593">Decentr haiamiliki. Zindua upya sasa?</translation>
<translation id="193439633299369377">Mfumo wa Uendeshaji wa Decentr unahitaji kuzimwa na kuwashwa ili utekeleze usasishaji.</translation>
<translation id="1951406923938785464">Decentr imezuia upakuaji huu kwa sababu aina hii ya faili kwa kawaida haipakuliwi na huenda si salama</translation>
<translation id="1953553007165777902">Inapakua... Zimesalia dakika <ph name="MINUTE" /></translation>
<translation id="1966382378801805537">Decentr haijafaulu kubainisha wala kuweka kivinjari chaguomsingi</translation>
<translation id="1990262977744080398">Fahamu kwa nini Decentr huzuia baadhi ya faili, huzifungua kwenye kichupo kipya</translation>
<translation id="2008474315282236005">Hatua hii itafuta kipengee 1 kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika Decentr ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Imeshindwa kusakinisha. Tafadhali jaribu tena.</translation>
<translation id="2020032459870799438">Ili uangalie kama manenosiri yako mengine ni salama dhidi ya ufichuzi haramu wa data na matatizo mengine ya usalama, <ph name="BEGIN_LINK" />ingia katika akaunti kwenye Decentr<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">Chagua iwapo ungependa kujumuisha historia kwenye Decentr ili upate hali ya utumiaji inayokufaa zaidi katika huduma za Decentr</translation>
<translation id="2086476982681781442">Decentr imezuia upakuaji huu kwa sababu faili inapotosha na huenda ikafanya mabadiliko yasiyotarajiwa kwenye kifaa chako</translation>
<translation id="2088953378266246249">Maelezo kuhusu jinsi Decentr inavyodhibiti vyeti vyake vya msingi</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Shirika lako hufuta kiotomatiki data ya kuvinjari Decentr isipotumika kwa dakika 1. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}other{Shirika lako hufuta kiotomatiki data ya kuvinjari Decentr isipotumika kwa dakika #. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}}</translation>
<translation id="2126108037660393668">Faili iliyopakuliwa imeshindwa kuthibitishwa.</translation>
<translation id="215352261310130060">Decentr imezuia upakuaji huu kwa sababu tovuti haitumii muunganisho salama na huenda faili imeharibiwa</translation>
<translation id="2157600032285353789">Unaweza kufungua alamisho, hali ya kusoma na zaidi katika menyu ya Decentr</translation>
<translation id="2174178932569897599">Weka mipangilio ya Decentr upendavyo</translation>
<translation id="2174917724755363426">Usakinishaji haujakamilika. Je, una uhakika unataka kughairi?</translation>
<translation id="2185166961232948079">Decentr - Kuingia katika Akaunti ya Mtandao - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Hitilafu ya ukaguzi wa sasisho: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Ondoa akaunti kwenye Decentr</translation>
<translation id="2210682093923538346">Tovuti hatari. Decentr imeondoa arifa.</translation>
<translation id="2240214816234246077">Hujatembelea hivi majuzi. Decentr imeondoa <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /></translation>
<translation id="2241627712206172106">Kama unatumia kompyuta pamoja na wengine, marafiki na familia wanaweza kuvinjari tofauti na kusanidi Decentr jinsi wapendavyo.</translation>
<translation id="2313870531055795960">Hukagua URL ili kuona iwapo zipo kwenye orodha ya tovuti zisizo salama zilizohifadhiwa katika Decentr. Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, Decentr inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwa kipengele cha Kuvinjari Salama.</translation>
<translation id="2329088755516916767">Decentr ikiwashwa, huwa inapakia mapema kurasa, hali inayofanya shughuli za utafutaji na kuvinjari ziwe za haraka zaidi.</translation>
<translation id="2343156876103232566">Ili uweze kutuma namba kwa simu yako ya Android kutoka hapa, ingia katika akaunti kwenye Decentr ukitumia vifaa vyote viwili.</translation>
<translation id="2359808026110333948">Endelea</translation>
<translation id="2361918034042471035">Kiendelezi cha "<ph name="EXTENSION_NAME" />" kinakuhitaji uingie katika Decentr</translation>
<translation id="2374216753258219393">Ili utumie kiendelezi hiki ukitumia <ph name="USER_EMAIL_ADDRESS" />, ingia katika Decentr.</translation>
<translation id="2384373936468275798">Mfumo wa Uendeshaji wa Decentr haukusawazisha data yako kwa sababu maelezo ya kuingia katika akaunti yako yamepitwa na wakati.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha Decentr kilikuwa kinafikia kifaa 1 cha HID}=1{Kiendelezi kimoja au zaidi cha Decentr kinafikia kifaa 1 cha HID}other{Kiendelezi kimoja au zaidi cha Decentr kinafikia vifaa # vya HID}}</translation>
<translation id="2401032172288869980">Decentr inahitaji ruhusa ya kufikia kamera na maikrofoni kwa ajili ya tovuti hii</translation>
<translation id="2440750600860946460">Kwa kutumia <ph name="BEGIN_LINK" />zana kutoka Decentr<ph name="END_LINK" />, unaweza kuvinjari kwa usalama na kuwa na udhibiti</translation>
<translation id="2451727308784734061">Tumia njia yako ya mkato ili ufikie Kidhibiti cha Manenosiri kwa haraka. Unaweza kuhamishia njia yako ya mkato kwenye skrini ya kwanza ya kompyuta yako au kifungua programu.</translation>
<translation id="2478295928299953161">Decentr itafungwa hivi karibuni</translation>
<translation id="2483889755041906834">Katika Decentr</translation>
<translation id="2485422356828889247">Ondoa</translation>
<translation id="2513154137948333830">Unahitaji kuwashwa tena: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2554739539410784893">Decentr inajaribu kubadilisha manenosiri yaliyopo. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="2560420686485554789">Decentr inahitaji ruhusa ya kufikia hifadhi ili ipakue faili</translation>
<translation id="2572494885440352020">Kisaidizi cha Decentr</translation>
<translation id="2576118232315942160">Ili upate manenosiri yako na zaidi kwenye vifaa vyako vyote, ingia katika akaunti kwenye Decentr</translation>
<translation id="2583187216237139145">Data yoyote ya Decentr inayozalishwa unapotumia wasifu huu (kama vile alamisho ulizoweka, historia, manenosiri na mipangilio mingine) inaweza kuondolewa na msimamizi wa wasifu huu wa kazini. <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">Endelea kutumia Decentr</translation>
<translation id="259935314519650377">Imeshindwa kuweka akiba ya kisakinishaji kilichopakuliwa. Hitilafu: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="264613044588233783">Decentr hufanya kazi kwa kasi na vipengele vinavyotumia JavaScript vinapaswa kufanya kazi kama vilivyobuniwa (inapendekezwa)</translation>
<translation id="2648074677641340862">Hitilafu ya mfumo wa uendeshaji imetokea wakati wa usakinishaji. Tafadhali pakua Decentr tena.</translation>
<translation id="2661879430930417727">Kama unatumia kifaa pamoja na wengine, marafiki na familia wanaweza kuvinjari kivyao na kuweka mipangilio ya Decentr wapendavyo</translation>
<translation id="268602741124540128"><ph name="ACCOUNT_FIRST_NAME" />, karibu kwenye Decentr</translation>
<translation id="2711502716910134313">Kichupo cha Decentr</translation>
<translation id="2718390899429598676">Kwa usalama ulioongezwa, Decentr itasimba data yako kwa njia fiche.</translation>
<translation id="2721354645805494590">Ili uondoe Akaunti yako ya Decentr kwenye Decentr, ondoka kwenye akaunti</translation>
<translation id="2738871930057338499">Imeshindwa kuunganisha kwenye Intaneti. HTTP 403 Hairuhusiwi. Tafadhali angalia mipangilio yako ya seva mbadala.</translation>
<translation id="2770231113462710648">Badilisha kivinjari chaguomsingi kiwe:</translation>
<translation id="2785438272836277133">Kiendelezi hiki kina programu hasidi na si salama. Kiondoe kwenye Decentr ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="2799223571221894425">Funga na ufungue</translation>
<translation id="2837693172913560447">Hatua hii itafungua wasifu mpya wa <ph name="USER_EMAIL_ADDRESS" /> kwenye Decentr</translation>
<translation id="2846251086934905009">Hitilafu ya kusakinisha: Kisakinishaji hakikukamilisha mchakato. Usakinishaji umeghairiwa.</translation>
<translation id="2847479871509788944">Ondoa kwenye Decentr...</translation>
<translation id="2850691299438350830">Hulinda usalama wako kwenye Decentr na inaweza kutumiwa kuboresha usalama wako kwenye programu nyingine za Decentr unapokuwa umeingia katika akaunti</translation>
<translation id="2885378588091291677">Kidhibiti cha Shughuli</translation>
<translation id="2910007522516064972">Kuhusu Decentr</translation>
<translation id="2915996080311180594">Ifunge kisha Uifungue Baadaye</translation>
<translation id="2928420929544864228">Usakinishaji umekamilika.</translation>
<translation id="2945997411976714835">Hitilafu ya kusakinisha: Mchakato wa kisakinishaji umeshindwa kuanza.</translation>
<translation id="2970426615109535079">Shirika lako linadhibiti Decentr</translation>
<translation id="2977470724722393594">Decentr imesasishwa</translation>
<translation id="2977506796191543575">Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, Decentr inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwenye kipengele cha Kuvinjari Salama</translation>
<translation id="2987208172821108655">Decentr inaweza kufanya vichupo hivi visitumike ili kuboresha hali yako ya kuvinjari na kufuta data ili upate nyenzo.</translation>
<translation id="3013473503895162900">Fungua <ph name="URL" /> kwenye kichupo kipya katika Decentr.</translation>
<translation id="3032706164202344641">Decentr imeshindwa kukagua manenosiri yako. Jaribu tena baadaye.</translation>
<translation id="3032787606318309379">Inaongeza kwenye Decentr...</translation>
<translation id="3038232873781883849">Inasubiri kusakinisha...</translation>
<translation id="3068187312562070417">Wasifu nyingine za Decentr</translation>
<translation id="3068515742935458733">Saidia kuboresha Decentr kwa kutuma ripoti za kuacha kufanya kazi na <ph name="UMA_LINK" /> kwenda Decentr</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha Decentr kilikuwa kinafikia kifaa 1 cha USB}=1{Kiendelezi kimoja au zaidi cha Decentr kinafikia kifaa 1 cha USB}other{Kiendelezi kimoja au zaidi cha Decentr kinafikia vifaa # vya USB}}</translation>
<translation id="3101560983689755071">Historia yako ya kuvinjari huathiri matangazo unayoyaona na mambo yanayokuvutia kama inavyokadiriwa hapa chini. Ili kulinda faragha yako, Decentr inafuta mambo yako yanayokuvutia kadiri unavyoendelea kutumia kila mwezi. Mambo yanayokuvutia yanaweza kuonyeshwa upya isipokuwa ukiyaondoa.</translation>
<translation id="3103660991484857065">Kisakinishi kilishindwa kufinyuza kumbukumbu. Tafadhali pakua Decentr tena.</translation>
<translation id="3130323860337406239">Decentr inatumia maikrofoni yako.</translation>
<translation id="3144188012276422546">Kichupo hiki kinatumia nyenzo za ziada. Ruhusu Decentr ikifanye kisitumike ili kuboresha utendaji wako.</translation>
<translation id="3155163173539279776">Zindua upya Decentr</translation>
<translation id="3179665906251668410">Fungua Kiungo katika Dirisha Fiche la Decentr</translation>
<translation id="3185330573522821672">Weka wasifu wako mpya wa Decentr uwe upendavyo</translation>
<translation id="3190315855212034486">Lo! Decentr imevurugika. Unataka kuzindua upya sasa?</translation>
<translation id="3224847870593914902">Ili uondoe Akaunti yako ya Decentr kwenye Decentr, ondoka kwenye Decentr katika ukurasa wa Mipangilio</translation>
<translation id="3258596308407688501">Decentr haiwezi kusoma na kuandika kwenye saraka yake ya data:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3268051428841342958">V8 ni mtambo wa JavaScript na WebAssembly wa Decentr unaotumika kuboresha utendaji wa tovuti</translation>
<translation id="3283186697780795848">Umesakinisha toleo la Decentr la <ph name="PRODUCT_VERSION" /></translation>
<translation id="3286538390144397061">Zima na uwashe sasa</translation>
<translation id="328888136576916638">Funguo za Decentr API zinakosekana. Utendaji fulani wa Decentr utazimwa.</translation>
<translation id="3296368748942286671">Endelea kuendesha programu za mandharinyuma wakati Decentr imefungwa</translation>
<translation id="3300643253493387004">Tunapoweka mipangilio ya idhini ya kufikia akaunti, bado unaweza kutumia Decentr. Huenda usiweze kufikia baadhi ya nyenzo hadi uwekaji wa mipangilio ukamilike.</translation>
<translation id="3313189106987092621">Decentr itakutahadharisha kabla ya kupakia tovuti yoyote kwa kutumia muunganisho usio salama</translation>
<translation id="3316771292331273802">Utaondolewa kwenye tovuti nyingi ukifunga madirisha yote ya Decentr, isipokuwa katika Akaunti yako ya Decentr ikiwa umeingia katika Decentr. Ili uruhusu tovuti zikukumbuke, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3350761136195634146">Tayari kuna wasifu kwenye Decentr unaotumia akaunti hii</translation>
<translation id="3387527074123400161">Mfumo wa uendeshaji wa Decentr</translation>
<translation id="3406848076815591792">Ungependa kutumia wasifu uliopo wa Decentr?</translation>
<translation id="3412460710772753638">Katika Kidhibiti cha Manenosiri kwenye kifaa hiki</translation>
<translation id="3430503420100763906">Ukitumia kipengele cha wasifu kwenye Decentr unaweza kutenganisha vitu vyako vyote vya Decentr. Tengeneza wasifu wa marafiki na familia au utenganishe kazi na burudani.</translation>
<translation id="347328004046849135">Decentr itakuarifu ukiingia katika akaunti ukitumia nenosiri lililoathiriwa</translation>
<translation id="3474745554856756813">Hatua hii itafuta vipengee <ph name="ITEMS_COUNT" /> kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika Decentr ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Unaweza kubonyeza <ph name="SHORTCUT" /> ili ubadilishe kati ya wasifu mmoja wa Decentr na mwingine</translation>
<translation id="3509308970982693815">Tafadhali funga madirisha yote ya Decentr na ujaribu tena.</translation>
<translation id="3530103706039034513">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />.  Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti kwenye Decentr katika wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3533435340678213462">Ili kulinda faragha yako, tunafuta kiotomatiki mambo yanayokuvutia ambayo yapo kwenye orodha kwa zaidi ya wiki nne. Kadiri unavyoendelea kuvinjari, jambo linalokuvutia linaweza kuonekana tena kwenye orodha. Au unaweza kuondoa mambo yanayokuvutia ambayo usingependa Decentr iyazingatie.</translation>
<translation id="3567254597502212821">Historia yako ya kuvinjari, kumbukumbu ya tovuti ulizozitembelea ukitumia Decentr kwenye kifaa hiki.</translation>
<translation id="3597003331831379823">Imeshindwa kuweka mipangilio ikitumia ufikiaji maalum. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">Data ya kuvinjari ya mtu huyu itafutwa kwenye kifaa hiki. Ili kurejesha data, ingia katika Decentr ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Sasisho jipya la Decentr linapatikana na litaanza kutumika pindi utakapofungua tena.}=1{Sasisho jipya la Decentr linapatikana na litaanza kutumika pindi utakapofungua tena. Haitafungua upya dirisha fiche.}other{Sasisho jipya la Decentr linapatikana na litaanza kutumika pindi utakapofungua tena. Haitafungua upya madirisha # fiche.}}</translation>
<translation id="3651803019964686660">Ili uweze kutuma namba kwa simu yako ya Android kutoka <ph name="ORIGIN" />, ingia katika akaunti kwenye Decentr ukitumia vifaa vyote viwili.</translation>
<translation id="3667616615096815454">Imeshindwa kusakinisha, seva haitambui programu hii.</translation>
<translation id="3669334504579945026">Ili uonyeshe skrini yako, washa kinasa skrini katika Decentr kwenye Mapendeleo ya Mfumo.</translation>
<translation id="3685209450716071127">Decentr imeshindwa kukagua manenosiri yako. Jaribu kuangalia muunganisho wako wa Intaneti.</translation>
<translation id="3702352323269013324">Pata maelezo zaidi kuhusu kuweka mapendeleo ya matangazo kwenye Decentr</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Msimamizi wako anataka ufungue Decentr tena ili utumie sasisho hili}=1{Msimamizi wako anataka ufungue Decentr tena ili utumie sasisho hili. Haitafungua upya dirisha fiche.}other{Msimamizi wako anataka ufungue Decentr tena ili utumie sasisho hili. Haitafungua upya madirisha # fiche.}}</translation>
<translation id="3713809861844741608">Fungua kiungo katika kichupo kipya cha Decentr</translation>
<translation id="3728124580182886854">Unganisha Decentr na huduma nyingine za Decentr ili upate mapendeleo na madhumuni mengine</translation>
<translation id="3788675262216168505">Dhibiti Wasifu wa Decentr</translation>
<translation id="3790262771324122253">Fahamu kwa nini Decentr huzuia baadhi ya vipakuliwa</translation>
<translation id="379589255253486813">Decentr itakufahamisha ikiwa kuna chochote kinachohitaji ukague</translation>
<translation id="3802055581630249637">Decentr hupakia mapema kurasa unazoweza kutembelea, ili zipakiwe kwa haraka zaidi unapozitembelea</translation>
<translation id="3830894615770080216">Mfumo wa Uendeshaji wa Decentr</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="386822487697155367">Pata usaidizi wa kutumia Mfumo wa Uendeshaji wa Decentr</translation>
<translation id="3871664619793219264">Pata vitu vinavyohusu kivinjari chako cha Decentr kwenye<ph name="ACCOUNT_EMAIL" /></translation>
<translation id="388648406173476553">Dhibiti na uweke mapendeleo kwenye Decentr. Unahitaji kushughulikia jambo fulani. Bofya ili upate maelezo.</translation>
<translation id="3889543394854987837">Bofya jina lako ili ufungue Decentr na uanze kuvinjari.</translation>
<translation id="390528597099634151">Tayari <ph name="EXISTING_USER" /> ameingia katika akaunti kwenye wasifu huu kwenye Decentr. Ili utenganishe shughuli zako za kuvinjari, Decentr inaweza kukutengenezea wasifu wako mwenyewe.</translation>
<translation id="3909353120217047026">Kiendelezi hiki kinakiuka sera ya Duka la Decentr kwenye Wavuti na huenda kisiwe salama. Kiondoe kwenye Decentr ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="391789666908693569">Akaunti yako inadhibitiwa na <ph name="MANAGER_NAME" />. Msimamizi wako anaweza kuona na kubadilisha wasifu wa kivinjari hiki cha Decentr na data yake kama vile alamisho, historia na manenosiri.</translation>
<translation id="3941890832296813527">Hitilafu ya kusakinisha: Jina la faili ya kisakinishaji si sahihi au haliwezi kutumika.</translation>
<translation id="3945058413678539331">Decentr inajaribu kunakili manenosiri. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="3962647064319009959">Pata maelezo ya jinsi ya Decentr inavyokufanya inavyohakikisha usalama wako</translation>
<translation id="3975724895399328945">Kuhusu &amp;Decentr ya Majaribio</translation>
<translation id="3997429360543082038">Kuhusu Mfumo wa Uendeshaji wa Decentr</translation>
<translation id="4019629340646866719">Mfumo wa Uendeshaji wa Decentr unawezeshwa na <ph name="BEGIN_LINK_CROS_OSS" />programu huria<ph name="END_LINK_CROS_OSS" /> za ziada, kama vile <ph name="BEGIN_LINK_LINUX_OSS" />mazingira ya wasanidi programu wa Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4036079820698952681">Saidia kuboresha Decentr kwa kuripoti kuhusu <ph name="BEGIN_LINK" />mipangilio ya sasa<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Maboresho muhimu ya usalama na vipengele vipya vinapatikana katika toleo jipya.</translation>
<translation id="4055805654398742145">Kidhibiti cha Nenosiri</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Shirika lako hufunga Decentr kiotomatiki isipotumika kwa dakika 1. Data ya kuvinjari hufutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.}other{Shirika lako hufunga Decentr kiotomatiki isipotumika kwa dakika #. Data ya kuvinjari hufutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.}}</translation>
<translation id="4118474109249235144">Hali fiche kwenye Decentr</translation>
<translation id="4122186850977583290">Nenda kwenye ukurasa wa Kuhusu Decentr</translation>
<translation id="4148957013307229264">Inasakinisha...</translation>
<translation id="4149336151887611710">Shirika lako linaweza kuona na kudhibiti data ya kuvinjari katika wasifu wako wa kazini, kama vile alamisho, historia na manenosiri yako. Haliwezi kuona data ya kuvinjari katika wasifu wa binafsi kwenye Decentr.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Kuingia katika Akaunt ya Mtandao - Decentr</translation>
<translation id="421369550622382712">Gundua programu, michezo, viendelezi na mandhari bora ya Decentr.</translation>
<translation id="4216212958613226427">Lugha hii inatumiwa kuonyesha Kiolesura cha Decentr</translation>
<translation id="4222932583846282852">Inaghairi...</translation>
<translation id="4224210481850767180">Mchakato wa kuweka kwenye kifaa umekatishwa.</translation>
<translation id="4230135487732243613">Ungependa kuunganisha data yako ya Decentr kwenye akaunti hii?</translation>
<translation id="4251772536351901305">Hukutahadharisha kuhusu tovuti hatari, hata zile ambazo hazikutambuliwa na Decentr hapo awali, kwa kuchambua data zaidi kutoka kwenye tovuti kuliko ulinzi wa kawaida. Unaweza kuchagua kuruka tahadhari za Decentr.</translation>
<translation id="4269093074552541569">Ondoka kwenye Decentr</translation>
<translation id="4271805377592243930">Pata usaidizi wa kutumia Decentr</translation>
<translation id="4281844954008187215">Sheria na Masharti</translation>
<translation id="4285930937574705105">Usanidi umeshindwa kwa sababu ya hitilafu isiyojulikana. Ikiwa Decentr inaendesha sasa, tafadhali ifunge na ujaribu tena.</translation>
<translation id="4304713468139749426">Kidhibiti cha Manenosiri</translation>
<translation id="4334294535648607276">Upakuaji umekamilika.</translation>
<translation id="439358628917130594"><ph name="MANAGER" /> inahitaji usome na ukubali Sheria na Masharti yafuatayo kabla ya kutumia kifaa hiki. Masharti haya hayapanui, hayarekebishi wala hayapunguzi Sheria na Masharti ya Mfumo wa Uendeshaji wa Decentr.</translation>
<translation id="4407044323746248786">Ungependa kufunga Decentr?</translation>
<translation id="4415566066719264597">Ruhusu Decentr itumike Chinichini</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Decentr inapendekeza ukiondoe. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK" />}other{Decentr inapendekeza uviondoe. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">Dhibiti na ugeuze Decentr ikufae</translation>
<translation id="4427306783828095590">Kipengele cha ulinzi wa hali ya juu hufanya mengi zaidi ili kuzuia programu hasidi na wizi wa data binafsi</translation>
<translation id="4434353761996769206">Hitilafu ya kisakinishaji: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614"><ph name="MANAGER" /> inadhibiti Decentr</translation>
<translation id="4447409407328223819">Kuhusu Decentr ya Majaribio</translation>
<translation id="4501471624619070934">Imeshindwa kusakinisha kwa sababu ufikiaji umedhibitiwa katika nchi hii.</translation>
<translation id="4510853178268397146">Kiendelezi hiki hakijachapisha desturi za faragha, kama vile jinsi kinavyokusanya na kutumia data. Decentr inapendekeza ukiondoe.</translation>
<translation id="452711251841752011">Karibu kwenye Decentr; dirisha jipya la kivinjari limefunguliwa</translation>
<translation id="4531137820806573936">Decentr inahitaji ruhusa ili kuweka ramani ya mazingira yako na kufuatilia mikono yako</translation>
<translation id="4536805923587466102">Tayari umeingia katika akaunti ukitumia <ph name="USER_EMAIL_ADDRESS" /> katika wasifu mwingine wa Decentr</translation>
<translation id="4544142686420020088">Decentr haijasasishwa, hitilafu fulani imetokea. <ph name="BEGIN_LINK" />Rekebisha matatizo ya sasisho la Decentr na masasisho ambayo hayakuwekwa.<ph name="END_LINK" /></translation>
<translation id="4545268686623374213">Decentr inaweza kufanya kichupo hiki kisitumike ili kuboresha hali yako ya kuvinjari na kufanya mambo haraka.</translation>
<translation id="454579500955453258">Ungependa kutumia wasifu mpya kwenye Decentr?</translation>
<translation id="4567424176335768812">Umeingia katika akaunti kama <ph name="USER_EMAIL_ADDRESS" />. Sasa unaweza kupata alamisho, historia, na mipangilio yako mingine kwenye vifaa vyako vyote vilivyoingia katika akaunti.</translation>
<translation id="4570813286784708942">Decentr imezuia upakuaji huu kwa sababu umezima kipengele cha Kuvinjari Salama na faili husika haiwezi kuthibitishwa</translation>
<translation id="4594305310729380060">Kwenye Kidhibiti cha Manenosiri katika kifaa hiki</translation>
<translation id="459535195905078186">Programu za Decentr</translation>
<translation id="4613863813562375431">Toleo la Mfumo wa Uendeshaji wa Decentr</translation>
<translation id="4617285639650863674">Ili uonyeshe skrini yako, washa kipengele cha kunasa skrini katika Decentr kwenye Mapendeleo ya Mfumo</translation>
<translation id="4621240073146040695">Inakaribia kukamilisha kusasishwa! Anzisha Decentr upya ili ukamilishe kusasisha.</translation>
<translation id="4665829708273112819">Onyo: Decentr haiwezi kuzuia viendelezi kurekodi historia yako ya kuvinjari. Ili uzime kiendelezi hiki katika hali fiche, usiteue chaguo hili.</translation>
<translation id="4673151026126227699">Ikiwa pia unashiriki ripoti za matumizi ya Decentr, ripoti hizo zinajumuisha URL unazotembelea</translation>
<translation id="4677944499843243528">Wasifu unaonekana kuwa unatumika na mchakato mwingine wa Decentr (<ph name="PROCESS_ID" />) kwenye kompyuta nyingine (<ph name="HOST_NAME" />). Decentr imefunga wasifu huu ili usifisidiwe. Kama una uhakika hakuna michakato mingine inatumia wasifu huu, unaweza kufungua wasifu na uzindue tena Decentr.</translation>
<translation id="4680828127924988555">Ghairi Usakinishaji</translation>
<translation id="469259825538636168">Baadhi ya data yako ya Decentr bado haijahifadhiwa kwenye Akaunti yako ya Decentr. Jaribu kusubiri kwa dakika chache kabla ya kuondoka kwenye akaunti. Ukiondoka kwenye akaunti sasa, data hii itafutwa.</translation>
<translation id="4708193446201257833">Wakati umeingia katika akaunti, unaweza kutumia manenosiri yako na mengineyo kwenye Akaunti yako ya Decentr katika Decentr. <ph name="SHORTCUT" /> inaweza kubadilisha mipangilio yako ya huduma za Decentr.</translation>
<translation id="4708774505295300557">Kuna mtu aliingia katika Decentr kwenye kompyuta hii akitumia <ph name="ACCOUNT_EMAIL_LAST" />. Tafadhali ongeza wasifu mpya wa Decentr ili utenganishe maelezo yako.</translation>
<translation id="4724676981607797757">Imeshindwa kusakinisha kwa sababu ya hitilafu ya itifaki isiyotumika.</translation>
<translation id="4746050847053251315">Ungependa kufunga Decentr?</translation>
<translation id="4748217263233248895">Sasisho maalum la usalama wa Decentr limewekwa sasa hivi. Ifunge kisha uifungue na tutarejesha vichupo vyako.</translation>
<translation id="4765210420921718862">Unaweza kubadilisha mawazo yako wakati wowote kwenye mipangilio ya Decentr. Vipindi vya kujaribu vinatekelezwa pamoja na jinsi matangazo yanavyoonyeshwa kwa sasa, hivyo hutaona mabadiliko papo hapo.</translation>
<translation id="4788777615168560705">Decentr imeshindwa kukagua manenosiri yako. Jaribu tena baada ya saa 24 au <ph name="BEGIN_LINK" />kagua manenosiri katika Akaunti yako ya Decentr<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Huduma hii hutumia kikagua tahajia sawa na kinachotumika kwenye Huduma ya Tafuta na Decentr. Maandishi unayoandika kwenye kivinjari yanatumwa kwa Decentr. Unaweza kubadilisha hali hii katika mipangilio wakati wowote.</translation>
<translation id="4814736265800133385">Tumia Decentr bila akaunti</translation>
<translation id="4888717733111232871">Sheria ya ndani ya Decentr ili kuruhusu trafiki ya mDNS.</translation>
<translation id="4893347770495441059">Fungua tena ili Usasishe &amp;Decentr</translation>
<translation id="4942295735032723435">Utahitaji toleo la macOS 11 au toleo jipya zaidi ili upate masasisho ya Decentr ya siku zijazo. Kompyuta hii inatumia toleo la macOS 10.15.</translation>
<translation id="4943838377383847465">Decentr iko katika hali ya chini chini.</translation>
<translation id="494490797786467921">Bofya ili ufunge kidirisha cha kuingia katika Decentr</translation>
<translation id="4987820182225656817">Walioalikwa wanaweza kutumia Decentr bila kuacha kitu chochote nyuma.</translation>
<translation id="4994636714258228724">Jiongeze kwenye Decentr</translation>
<translation id="5114678101347489141">Decentr inachunguza vipengele vipya vinavyoruhusu tovuti zikupatie hali ileile ya kuvinjari kwa kutumia taarifa zako chache</translation>
<translation id="5187123684706427865">Akaunti ya Decentr inahitaji kuthibitisha upya</translation>
<translation id="5224391634244552924">Hakuna manenosiri yaliyohifadhiwa. Decentr inaweza kukagua manenosiri yako ukiyahifadhi.</translation>
<translation id="5231355151045086930">Ondoka kwenye Decentr</translation>
<translation id="5252179775517634216">Tayari <ph name="EXISTING_USER" /> ameingia katika akaunti kwenye wasifu huu kwenye Decentr. Hatua hii itafungua wasifu mpya wa <ph name="USER_EMAIL_ADDRESS" /> kwenye Decentr</translation>
<translation id="5277894862589591112">Ili utumie mabadiliko uliyofanya, fungua Decentr upya</translation>
<translation id="5294316920224716406">Unapovinjari katika hali fiche, Decentr itakutahadharisha kabla ya kupakia tovuti kwa kutumia muunganisho usio salama</translation>
<translation id="5296845517486664001">Vipindi vya kujaribu vinapowashwa na iwapo Decentr imekuweka kwa unasibu katika kipindi cha kujaribu kinachoendelea, historia ya kuvinjari huathiri mambo yanayokuvutia na matangazo unayoyaona kama inavyokadiriwa hapa chini. Ili kulinda faragha yako, Decentr hufuta mambo yanayokuvutia kadiri unavyoendelea kutumia kila mwezi.</translation>
<translation id="5310474266708705970">Ingia katika Decentr ukitumia <ph name="USER_EMAIL" /></translation>
<translation id="5352264705793813212">Decentr imepata baadhi ya mapendekezo ya usalama unayopaswa kukagua</translation>
<translation id="5352361688875342522">Wasifu Nyingine za Decentr</translation>
<translation id="5358375970380395591">Unaingia katika akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye Decentr. Data yako ya Decentr, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio miingine itahusishwa na <ph name="USER_NAME" /> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za Decentr, lakini hutaweza  kuunganisha data hii na akaunti nyingine. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Msimbo wa ziada: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Ili upate mapendeleo, jumuisha Decentr katika Historia ya Shughuli kwenye Wavuti na Programu</translation>
<translation id="5383439451358640070">Fahamu kwa nini Decentr huzuia baadhi ya faili</translation>
<translation id="5386450000063123300">Inasasisha Decentr (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Ruhusu kuingia katika akaunti ya Decentr</translation>
<translation id="5405650547142096840">Ondoa kwenye Decentr</translation>
<translation id="5427571867875391349">Weka Decentr kuwa kivinjari chako chaguomsingi</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Beta ya Decentr</translation>
<translation id="5473971139929175403">Huenda Decentr haitafanya kazi vizuri kwa sababu haitumiki tena kwenye toleo hili la Linux</translation>
<translation id="5475924890392386523">Decentr imezuia upakuaji huu kwa sababu faili inaweza kuathiri akaunti zako binafsi na za mitandao ya kijamii</translation>
<translation id="5480860683791598150">Decentr inahitaji kufikia maelezo ya mahali ulipo ili kushiriki mahali ulipo na tovuti hii</translation>
<translation id="5487574057737591516">Ili kulinda faragha yako, tunafuta kiotomatiki mambo yanayokuvutia ambayo yapo kwenye orodha kwa zaidi ya wiki nne. Kadiri unavyoendelea kuvinjari, jambo linalokuvutia linaweza kuonekana tena kwenye orodha. Na iwapo Decentr itakosea au usingependa kuona matangazo fulani, unaweza kuondoa jambo hilo linalokuvutia.</translation>
<translation id="549669000822060376">Tafadhali subiri Decentr inaposakinisha sasisho mpya ya mfumo.</translation>
