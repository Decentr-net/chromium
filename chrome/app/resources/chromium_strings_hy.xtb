<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1001716830750249114">Անցնել Decentr-ի տարբերակի կարգավորումներ</translation>
<translation id="1026101648481255140">Վերսկսել տեղադրումը</translation>
<translation id="1029669172902658969">Վերագործարկել՝ &amp;ChromiumOS-ը թարմացնելու համար</translation>
<translation id="1040916596585577953">Decentr-ը խորհուրդ է տալիս ստուգել այս ընդլայնումը</translation>
<translation id="1042552502243217427">Երբ որևէ կայք հայցում է էջերի անանուն նախաբեռնում իր էջում առկա հղումների միջոցով, Decentr-ը օգտագործում է Google-ի սերվերները։ Այդպիսով ձեր անձնական տվյալները չեն փոխանցվում, սակայն Google-ը իմանում է, թե որ կայքերն են նախապես բեռնվում։</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="1083934481477628225">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը Decentr-ում</translation>
<translation id="1098170124587656448">Decentr-ը կարող է պաշտպանել տվյալների արտահոսքից, վնասաբեր ընդլայնումներից և այլ խնդիրներից</translation>
<translation id="1104942323762546749">Decentr-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="113122355610423240">Decentr-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="1131805035311359397">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Decentr դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="1153368717515616349">Սեղմեք Decentr-ի ընտրացանկը</translation>
<translation id="1185134272377778587">Decentr-ի մասին</translation>
<translation id="1203500561924088507">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր դիտարկիչը։</translation>
<translation id="1262876892872089030">Մինչ այս ներդիրն ակտիվ չէր, Decentr-ի աշխատանքի արագությունը պահպանելու համար տարածք է ազատվել։ Դուք կարող եք ընտրել, որ այս կայքը միշտ ակտիվ մնա։</translation>
<translation id="1265577313130862557">Decentr-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը վտանգավոր է</translation>
<translation id="1315551408014407711">Կարգավորեք Decentr-ի ձեր նոր պրոֆիլը</translation>
<translation id="1342274909142618978">Նաև հեռացնել տվյալները Decentr-ից (<ph name="URL" />)</translation>
<translation id="1414495520565016063">Դուք մուտք եք գործել Decentr:</translation>
<translation id="1478370723027452770">Ստանալ օգնություն Decentr for Testing-ի միջոցով</translation>
<translation id="1497802159252041924">Տեղադրման սխալ՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="1524282610922162960">Կիսվեք Decentr-ի ներդիրով</translation>
<translation id="1553461853655228091">Decentr-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն՝ ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար։</translation>
<translation id="1574377791422810894">Decentr-ի անվտանգության գործիքներ</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Decentr-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Decentr-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Decentr-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Decentr-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="1625909126243026060">Դիտեք գաղտնիության և անվտանգության հիմնական կառավարման տարրերը Decentr-ում։</translation>
<translation id="1632539827495546968">Եթե ուզում եք այս հաշիվն օգտագործել միայն մեկ անգամ, միացրեք <ph name="GUEST_LINK_BEGIN" />հյուրի ռեժիմը<ph name="GUEST_LINK_END" /> Decentr դիտարկիչում։ Եթե ուզում եք հաշիվ ավելացնել մեկ ուրիշի համար, <ph name="LINK_BEGIN" />ավելացրեք նոր օգտատեր<ph name="LINK_END" /> ձեր <ph name="DEVICE_TYPE" /> սարքում։

Թույլտվությունները, որոնք տրամադրել եք կայքերին և հավելվածներին, կարող են կիրառվել այս հաշվի նկատմամբ։ Ձեր Google հաշիվները կարող եք կառավարել <ph name="SETTINGS_LINK_BEGIN" />Կարգավորումներում<ph name="SETTINGS_LINK_END" />։</translation>
<translation id="1640672724030957280">Ներբեռնում…</translation>
<translation id="1708666629004767631">Մատչելի է Decentr-ի նոր, ավելի ապահով տարբերակ:</translation>
<translation id="1715127912119967311">Decentr-ը Google-ին ուղարկում է ձեր փոխազդեցությունների մասին տվյալները, որպեսզի օգնի բարելավել այս գործառույթերը։ Այդ տվյալները կարող են ընթերցվել, մշակվել և մեկնաբանվել մասնագետների կողմից։</translation>
<translation id="17264556997921157">Դուք կարող եք տեսնել և հեռացնել հետաքրքրությունները, որոնք կայքերն օգտագործում են՝ ձեզ գովազդ ցուցադրելու համար։ Decentr-ը որոշում է ձեր հետաքրքրությունները ձեր վերջին այցելությունների պատմության հիման վրա։</translation>
<translation id="1733725117201708356">Decentr-ը շուտով կջնջի դիտարկման տվյալները</translation>
<translation id="1736443181683099871">Decentr-ը կփորձի անցնել HTTPS հաղորդակարգի</translation>
<translation id="1745121272106313518">Decentr-ը կվերագործարկվի <ph name="REMAINING_TIME" />ից</translation>
<translation id="1749104137266986751">Երբ HTTPS հաղորդակարգը հասանելի չէ, Decentr-ը առանց ձեզ զգուշացնելու կօգտագործի ոչ ապահով միացում</translation>
<translation id="1774152462503052664">Թույլ տալ Decentr-ին աշխատել հետնաշերտում</translation>
<translation id="1779356040007214683">Decentr-ն ավելի ապահով դարձնելու համար որոշ ընդլայնումներ, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացվել առանց ձեր իմացության, անջատվել են։</translation>
<translation id="1808667845054772817">Նորից տեղադրել Decentr-ը</translation>
<translation id="1820835682567584003">Decentr-ը փորձում է <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="185970820835152459">Դուք կարող եք կառավարել ձեր Google հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են Decentr դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE" /> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN" />Իմանալ ավելին<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">Կայքերը կարող են ձեր հետաքրքրությունների մասին տեղեկություններ պահել Decentr-ում։ Օրինակ, եթե դուք այցելել եք ինչ-որ կայք՝ մարաթոնի համար վազքի կոշիկներ գնելու, այդ կայքը կորոշի, որ ձեզ հետաքրքրում է մարաթոնյան վազքը։ Ավելի ուշ, երբ դուք այցելեք մեկ այլ կայք՝ մրցավազքի համար գրանցվելու, այնտեղ կարող է վազքի կոշիկների գովազդ ցուցադրվել։</translation>
<translation id="1881322772814446296">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր Decentr պրոֆիլը: Ձեր Decentr տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները մշտապես կկցվեն <ph name="USER_NAME" />-ին: Դուք կարող եք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարող համակցել այս տվյալները այլ հաշվի հետ: Կարող եք ստեղծել նոր պրոֆիլ՝ ձեր առկա Decentr տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE" /></translation>
<translation id="1906696617298807388">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Decentr-ը ձեր հարցումն ուղարկում է Google Drive-ին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="1911763535808217981">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ Google-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու Decentr:</translation>
<translation id="1929939181775079593">Decentr-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="193439633299369377">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել ChromiumOS-ը։</translation>
<translation id="1951406923938785464">Decentr-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլի այս տեսակը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="1953553007165777902">Ներբեռնում… Մնաց <ph name="MINUTE" /> րոպե</translation>
<translation id="1966382378801805537">Decentr-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="2008474315282236005">1 տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Decentr <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2018879682492276940">Չհաջողվեց տեղադրել։ Նորից փորձեք։</translation>
<translation id="2020032459870799438">Որպեսզի պաշտպանեք ձեր մյուս գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Decentr դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="2049376729098081731">Ընտրեք, թե արդյոք ներառել Decentr-ի պատմությունը՝ Google-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="2086476982681781442">Decentr-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կասկածելի է և կարող է անսպասելի փոփոխություններ կատարել ձեր սարքում</translation>
<translation id="2088953378266246249">Տեղեկություններ այն մասին, թե ինչպես է Decentr-ը կառավարում իր արմատային հավաստագրերը</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Decentr-ը 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}one{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Decentr-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}other{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Decentr-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}}</translation>
<translation id="2126108037660393668">Ներբեռնված ֆայլը չանցավ հաստատումը։</translation>
<translation id="215352261310130060">Decentr-ն արգելափակել է այս ներբեռնումը, քանի որ կայքը չի օգտագործում անվտանգ կապ, և ֆայլում, հնարավոր է, չարտոնված գործողություններ են կատարվել</translation>
<translation id="2174178932569897599">Անհատականացնել Decentr-ը</translation>
<translation id="2174917724755363426">Տեղադրումը չի ավարտվել։ Իսկապե՞ս ուզում եք չեղարկել։</translation>
<translation id="2185166961232948079">Decentr – Ցանցի մուտք – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Թարմացումների ստուգման սխալ՝ <ph name="UPDATE_CHECK_ERROR" />։</translation>
<translation id="2241627712206172106">Եթե ձեզնից բացի որևէ այլ մեկն օգտվում է այս համակարգչից, օրինակ ձեր ընկերները կամ հարազատները, ապա նրանք կարող են առանձին աշխատել և կարգավորել Decentr-ն իրենց ուզած ձևով:</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Decentr-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Decentr-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2329088755516916767">Երբ այս կարգավորումը միացված է, Decentr-ը նախապես բեռնում է էջերը՝ արագացնելով դիտարկումն ու որոնումը։</translation>
<translation id="2343156876103232566">Հեռախոսահամարն այստեղից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի Decentr դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="2359920621792549529">Այցելությունների պատմությունը միայն այս սարքից ջնջելու, սակայն Google հաշվում պահպանելու համար <ph name="BEGIN_LINK" />դուրս գրվեք Decentr-ից<ph name="END_LINK" />։</translation>
<translation id="2384373936468275798">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են։</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Decentr-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 HID սարքի հասանելիություն}=1{Decentr-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 HID սարք}one{Decentr-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}other{Decentr-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}}</translation>
<translation id="2401032172288869980">Այս կայքի համար Decentr-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Decentr-ի գործիքների<ph name="END_LINK" /> միջոցով դուք կարող եք ապահով դիտարկել և կառավարել կարգավորումները</translation>
<translation id="2451727308784734061">Արագ բացեք Գաղտնաբառերի կառավարիչը դյուրանցման միջոցով։ Դյուրանցումը կարող եք տեղափոխել համակարգչի հիմնական էկրան կամ հավելվածների գործարկիչ։</translation>
<translation id="2478295928299953161">Decentr-ը շուտով կփակվի</translation>
<translation id="2483889755041906834">Decentr-ի մեջ</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="2513154137948333830">Հարկավոր է վերաբեռնել. <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2554739539410784893">Decentr-ը փորձում է փոխարինել գոյություն ունեցող գաղտնաբառերը։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="2560420686485554789">Ֆայլեր ներբեռնելու համար Decentr-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="2572494885440352020">Decentr օգնական</translation>
<translation id="2583187216237139145">Աշխատանքային պրոֆիլի ադմինիստրատորը կարող է ջնջել Decentr-ի բոլոր տվյալները, որոնք ստեղծվում են այս պրոֆիլի օգտագործման ընթացքում (օրինակ՝ էջանիշներ, պատմություն, գաղտնաբառեր և այլ կարգավորումներ)։ <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">Շարունակել Decentr-ի օգտագործումը</translation>
<translation id="259935314519650377">Չհաջողվեց քեշավորել ներբեռնված տեղադրիչը։ Սխալ՝ <ph name="UNPACK_CACHING_ERROR_CODE" />։</translation>
<translation id="264613044588233783">Decentr-ն ավելի արագ է աշխատում, իսկ JavaScript օգտագործող գործառույթները պետք է աշխատեն նախատեսվածի պես (խորհուրդ է տրվում)</translation>
<translation id="2648074677641340862">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից տեղադրեք Decentr-ը:</translation>
<translation id="2661879430930417727">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել Decentr-ը</translation>
<translation id="268602741124540128">Բարի գալուստ Decentr, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="2711502716910134313">Decentr-ի ներդիր</translation>
<translation id="2718390899429598676">Լրացուցիչ անվտանգության համար Decentr-ը կգաղտնագրի ձեր տվյալները:</translation>
<translation id="2738871930057338499">Հնարավոր չէ միանալ ինտերնետին։ HTTP 403 Forbidden։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="2770231113462710648">Կանխադրված դիտարկիչը դարձնել՝</translation>
<translation id="2785438272836277133">Այս ընդլայնումը պարունակում է վնասագիր և վտանգավոր է։ Հեռացրեք ընդլայնումը Decentr-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="2837693172913560447"><ph name="USER_EMAIL_ADDRESS" /> օգտատիրոջ համար կստեղծվի Decentr-ի նոր պրոֆիլ։</translation>
<translation id="2846251086934905009">Տեղադրման սխալ. չհաջողվեց ավարտել տեղադրումը։ Գործընթացն ընդհատվել է։</translation>
<translation id="2847479871509788944">Հեռացնել Decentr-ից...</translation>
<translation id="2850691299438350830">Ապահովում է ձեր անվտանգությունը Decentr-ում և Google հավելվածներում, երբ մտել եք ձեր հաշիվ։</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="2910007522516064972">&amp;Decentr-ի մասին</translation>
<translation id="2915996080311180594">Վերագործարկել ավելի ուշ</translation>
<translation id="2928420929544864228">Տեղադրումն ավարտված է։</translation>
<translation id="2945997411976714835">Տեղադրման սխալ. չհաջողվեց սկսել տեղադրումը։</translation>
<translation id="2977470724722393594">Decentr-ը թարմացված է</translation>
<translation id="2977506796191543575">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Decentr-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="3032706164202344641">Decentr-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Փորձեք ավելի ուշ։</translation>
<translation id="3032787606318309379">Ավելացվում է Decentr-ին…</translation>
<translation id="3038232873781883849">Սպասում ենք տեղադրմանը…</translation>
<translation id="3068187312562070417">Decentr-ի այլ պրոֆիլներ</translation>
<translation id="3068515742935458733">Օգնեք բարելավել Decentr-ը՝ Google-ին ուղարկելով խափանման մասին հաշվետվությունները և <ph name="UMA_LINK" />ը</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Decentr-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 USB սարքի հասանելիություն}=1{Decentr-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 USB սարք}one{Decentr-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}other{Decentr-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}}</translation>
<translation id="3101560983689755071">Ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով Decentr-ն ամեն ամիս ավտոմատ ջնջում է ձեր հետաքրքրությունները։ Հետաքրքրությունները կարող են թարմացվել, եթե դրանք չհեռացնեք։</translation>
<translation id="3103660991484857065">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք Decentr-ը:</translation>
<translation id="3130323860337406239">Decentr-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="3155163173539279776">Decentr-ի վերագործարկում</translation>
<translation id="3179665906251668410">Բացել հղումը Decentr-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="3185330573522821672">Կարգավորեք Decentr-ի նոր պրոֆիլը</translation>
<translation id="3190315855212034486">Decentr-ը խափանվեց: Վերագործարկե՞լ:</translation>
<translation id="3258596308407688501">Decentr-ը չի կարող կարդալ և գրել իր տվյալների գրացուցակում՝

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3268051428841342958">V8-ը Decentr-ի JavaScript և WebAssembly համակարգ է, որն օգտագործվում է կայքերի արդյունավետությունը բարձրացնելու համար</translation>
<translation id="3283186697780795848">Տեղադրված է Decentr-ի <ph name="PRODUCT_VERSION" /> տարբերակը</translation>
<translation id="3286538390144397061">Վերագործարկել հիմա</translation>
<translation id="328888136576916638">Google API-ի բանալիները չկան: Decentr-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="3296368748942286671">Շարունակել հետնաշերտի հավելվածների աշխատանքը, երբ Decentr-ը փակված է</translation>
<translation id="3313189106987092621">Նախքան ոչ ապահով միացման միջոցով որևէ կայք բեռնելը Decentr-ը ձեզ կնախազգուշացնի</translation>
<translation id="3350761136195634146">Այս հաշվի հետ կապված Decentr-ի պրոֆիլ արդեն գոյություն ունի</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">Անցնե՞լ Decentr-ի ընթացիկ պրոֆիլ</translation>
<translation id="3412460710772753638">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="3430503420100763906">Decentr պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների, կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="347328004046849135">Decentr-ը կտեղեկացնի ձեզ, երբ կոտրված գաղտնաբառ օգտագործեք։</translation>
<translation id="3474745554856756813"><ph name="ITEMS_COUNT" /> տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Decentr <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="3497319089134299931">Decentr-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT" /> ստեղների համադրության միջոցով</translation>
<translation id="3509308970982693815">Փակեք Decentr-ի բոլոր պատուհանները և կրկին փորձեք:</translation>
<translation id="3533435340678213462">Ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Որպեսզի Decentr-ը հաշվի չառնի որոշակի հետաքրքրությունները, կարող եք դրանք հեռացնել։</translation>
<translation id="3567254597502212821">Ձեր այցելությունների պատմությունը այն կայքերի ցանկն է, որոնք դուք այցելել եք Decentr-ի միջոցով այս սարքում։</translation>
<translation id="3593091352817399191">Դուք արդեն մեկ այլ հաշիվ եք մտել։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք Decentr-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="3639635944603682591">Այս օգտատիրոջ այցելությունների պատմությունը կհեռացվի այս սարքից։ Տվյալները վերականգնելու համար <ph name="USER_EMAIL" /> հաշվով մուտք գործեք Decentr-ում։</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Decentr-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{Decentr-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Decentr-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Decentr-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3651803019964686660">Հեռախոսահամարը <ph name="ORIGIN" /> կայքից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի Decentr դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="3667616615096815454">Չհաջողվեց տեղադրել․ հավելվածն անծանոթ է սերվերի համար։</translation>
<translation id="3685209450716071127">Decentr-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="3702352323269013324">Իմանալ ավելին Decentr-ում գովազդի անհատականացման մասին</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Decentr-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Decentr-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Decentr-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Decentr-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3713809861844741608">Բացել հղումը Decentr-ի նոր &amp;ներդիրում</translation>
<translation id="3788675262216168505">Կառավարել Decentr-ի պրոֆիլները</translation>
<translation id="378917192836375108">Decentr-ը թույլ է տալիս սեղմել համացանցում գտնվող հեռախոսահամարի վրա և զանգահարել Skype-ով:</translation>
<translation id="3790262771324122253">Իմացեք, թե ինչու է Decentr-ն արգելափակում որոշ ներբեռնումներ</translation>
<translation id="379589255253486813">Decentr-ը ձեզ կտեղեկացնի, եթե որևէ բան փոխելու անհրաժեշտություն լինի</translation>
<translation id="3802055581630249637">Decentr-ը նախապես բեռնում է էջերը, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="3830894615770080216">ChromiumOS համակարգ</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="386822487697155367">ChromiumOS-ի օգնության էջ</translation>
<translation id="3871664619793219264">Բացեք Decentr դիտարկիչի ձեր տվյալները <ph name="ACCOUNT_EMAIL" /> հաշվից</translation>
<translation id="388648406173476553">Decentr-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="3889543394854987837">Սեղմեք ձեր անվան վրա՝ Decentr-ը բացելու համար:</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել Decentr-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք Decentr-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="3909353120217047026">Այս ընդլայնումը խախտում է Decentr Web Store-ի քաղաքականությունը և կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Decentr-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="391789666908693569">Ձեր հաշիվը պատկանում է <ph name="MANAGER_NAME" /> տիրույթին: Ձեր ադմինիստրատորը կարող է տեսնել և խմբագրել Decentr դիտարկիչի այս պրոֆիլը և դրա տվյալները, օրինակ՝ էջանիշները, պատմությունը և գաղտնաբառերը։</translation>
<translation id="3941890832296813527">Տեղադրման սխալ. տեղադրման ծրագրի ֆայլի անվանումն անվավեր է կամ չի աջակցվում։</translation>
<translation id="3945058413678539331">Decentr-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="3962647064319009959">Ինչպես է Decentr-ն ապահով պահում ձեր տվյալները</translation>
<translation id="3975724895399328945">&amp;Decentr for Testing-ի մասին</translation>
<translation id="3997429360543082038">ChromiumOS-ի մասին</translation>
<translation id="4019629340646866719">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS" />Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS" />։</translation>
<translation id="4036079820698952681">Օգնեք կատարելագործել Decentr-ը՝ հաղորդելով <ph name="BEGIN_LINK" />ընթացիկ կարգավորումների<ph name="END_LINK" /> մասին</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4055805654398742145">Գ&amp;աղտնաբառերի կառավարիչ</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Decentr-ը, երբ այն 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Decentr-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Decentr-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}}</translation>
<translation id="4118474109249235144">Decentr ինկոգնիտո</translation>
<translation id="4148957013307229264">Տեղադրում…</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> – Ցանցի մուտքի էջ – Decentr</translation>
<translation id="421369550622382712">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի Decentr-ի համար:</translation>
<translation id="4216212958613226427">Այս լեզուն օգտագործվում է որպես Decentr-ի միջերեսի լեզու</translation>
<translation id="4222932583846282852">Չեղարկվում է…</translation>
<translation id="4230135487732243613">Կապել Decentr-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="4251772536351901305">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Google-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Decentr-ի նախազգուշացումները։</translation>
<translation id="4271805377592243930">Decentr-ի օգնության էջ</translation>
<translation id="4281844954008187215">Օգտագործման պայմաններ</translation>
<translation id="4285930937574705105">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Եթե Decentr-ը բաց է, փակեք այն և կրկին փորձեք:</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4334294535648607276">Ներբեռնումն ավարտվեց:</translation>
<translation id="439358628917130594">Ադմինիստրատորը (<ph name="MANAGER" />) պահանջում է, որ դուք նախքան սարքն օգտագործելը կարդաք և ընդունեք հետևյալ Օգտագործման պայմանները։ Այս պայմանները չեն ընդլայնում, փոփոխում կամ սահմանափակում Google ChromiumOS-ի պայմանները։</translation>
<translation id="4407044323746248786">Փակե՞լ Decentr-ը։</translation>
<translation id="4415566066719264597">Թույլատրել Decentr-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="4423735387467980091">Հարմարեցնել և վերահսկել Decentr-ը</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="4447409407328223819">Decentr for Testing-ի մասին</translation>
<translation id="4501471624619070934">Չհաջողվեց տեղադրել, քանի որ այս երկրում հասանելիության սահմանափակումներ կան։</translation>
<translation id="452711251841752011">Բարի գալուստ Decentr․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="4544142686420020088">Անհայտ սխալի պատճառով չհաջողվեց թարմացնել Decentr-ը։ <ph name="BEGIN_LINK" />Շտկել Decentr-ի թարմացման հետ կապված խնդիրները<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Շարունակե՞լ Decentr-ի նոր պրոֆիլով</translation>
<translation id="4567424176335768812">Դուք մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" />: Այժմ կարող եք օգտագործել ձեր էջանիշները, պատմությունը և այլ կարգավորումները ձեր բոլոր մուտք գործած սարքերում:</translation>
<translation id="4570813286784708942">Decentr-ն արգելափակել է այս ներբեռնումը, քանի որ դուք անջատել եք Անվտանգ դիտարկումը, և ֆայլը հնարավոր չէ ստուգել</translation>
<translation id="4594305310729380060">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="459535195905078186">Decentr հավելվածներ</translation>
<translation id="4613863813562375431">ChromiumOS-ի տարբերակը</translation>
<translation id="4621240073146040695">Գրեթե պատրաստ է: Վերագործարկեք Decentr-ը՝ թարմացումն ավարտելու համար:</translation>
<translation id="4665829708273112819">Ուշադրություն․ Decentr-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="4673151026126227699">Եթե դուք նաև ուղարկում եք Decentr-ի օգտագործման մասին հաշվետվություններ, դրանցում կներառվեն ձեր այցելած URL-ները։</translation>
<translation id="4677944499843243528">Կարծես թե պրոֆիլն օգտագործվում է Decentr-ի այլ գործընթացի կողմից (<ph name="PROCESS_ID" />) այլ համակարգչում (<ph name="HOST_NAME" />): Decentr-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացների կողմից, կարող եք ապակողպել պրոֆիլը և նորից գործարկել Decentr-ը:</translation>
<translation id="4680828127924988555">Չեղարկել տեղադրումը</translation>
<translation id="4708774505295300557">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST" /> հասցեով մուտք է գործել Decentr: Ստեղծեք Decentr-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="4724676981607797757">Չհաջողվեց տեղադրել հավելվածը, քանի որ չաջակցվող հաղորդակարգի կիրառման արդյունքում սխալ է առաջացել։</translation>
<translation id="4746050847053251315">Փակե՞լ Decentr-ը։</translation>
<translation id="4748217263233248895">Decentr-ի անվտանգության կարգավորումները հենց նոր թարմացվել են: Վերագործարկեք Decentr-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="4765210420921718862">Դուք ցանկացած ժամանակ Decentr-ի կարգավորումներում կարող եք փոխել ձեր ընտրությունը։ Փորձարկումներն ընթանում են գովազդի ցուցադրման ընթացիկ ռեժիմին զուգահեռ, ինչի արդյունքում փոփոխություններն անմիջապես տեսանելի չեն լինի ձեզ։</translation>
<translation id="4788777615168560705">Decentr-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք կամ <ph name="BEGIN_LINK" />ստուգեք ձեր Google հաշվի գաղտնաբառերը<ph name="END_LINK" />։</translation>
<translation id="479167709087336770">Օգտագործվում է միևնույն ուղղագրիչը, ինչ Google Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են Google-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="4814736265800133385">Օգտագործել Decentr-ն առանց հաշվի</translation>
<translation id="4888717733111232871">Թույլատրել Decentr-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="4893347770495441059">Վերագործարկել՝ &amp;Decentr-ը թարմացնելու համար</translation>
<translation id="4942295735032723435">Decentr-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 11 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 10.15 տարբերակը։</translation>
<translation id="4943838377383847465">Decentr-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="4987820182225656817">Օգտագործելով Decentr-ը հյուրի ռեժիմում՝ դուք ոչ մի հետք չեք թողնում:</translation>
<translation id="4994636714258228724">Ավելացրեք ձեր հաշիվը Decentr-ին</translation>
<translation id="5114678101347489141">Decentr-ն ուսումնասիրում է նոր գործառույթները, որոնք կայքերին թույլ են տալիս տրամադրել դիտարկման նույն հնարավորությունները՝ ձեր մասին ավելի քիչ տեղեկություններ օգտագործելով։</translation>
<translation id="5224391634244552924">Պահված գաղտնաբառեր չկան։ Decentr-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք։</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել Decentr-ի այս պրոֆիլը։ <ph name="USER_EMAIL_ADDRESS" /> օգտատիրոջ համար կստեղծվի Decentr-ի նոր պրոֆիլ։</translation>
<translation id="5277894862589591112">Փոփոխությունները կիրառելու համար վերագործարկեք Decentr-ը</translation>
<translation id="5294316920224716406">Երբ ինկոգնիտո ռեժիմում դիտարկելիս լինեք, նախքան ոչ ապահով միացման միջոցով կայք բեռնելը Decentr-ը ձեզ կնախազգուշացնի</translation>
<translation id="5296845517486664001">Եթե փորձնական գործառույթները միացված են, և Decentr-ը պատահականության սկզբունքով ձեզ ընտրում է ակտիվ փորձարկմանը մասնակցության համար, ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով Decentr-ը ամեն ամիս ջնջում է ձեր հետաքրքրությունները։</translation>
<translation id="5352264705793813212">Decentr-ը անվտանգության հետ կապված որոշ առաջարկներ է գտել ձեզ համար</translation>
<translation id="5352361688875342522">Decentr-ի այլ պրոֆիլներ</translation>
<translation id="5358375970380395591">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր Decentr պրոֆիլը: Ձեր Decentr-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկապվեն <ph name="USER_NAME" />-ի հետ: Դուք կկարողանաք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Լրացուցիչ կոդ՝ <ph name="EXTRA_CODE" />։</translation>
<translation id="5383439451358640070">Իմացեք, թե ինչու է Decentr-ն արգելափակում որոշ ֆայլեր</translation>
<translation id="5386450000063123300">Decentr-ի թարմացում (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Decentr-ում</translation>
<translation id="5398878173008909840">Մատչելի է Decentr-ի նոր տարբերակը:</translation>
<translation id="5405650547142096840">Հեռացնել Decentr-ից</translation>
<translation id="5427571867875391349">Դարձնել Decentr-ը կանխադրված դիտարկիչը</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> – Decentr բետա</translation>
<translation id="5473971139929175403">Decentr-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Լինուքսի այս բաշխման մեջ։</translation>
<translation id="5480860683791598150">Decentr-ին այս կայքի համար անհրաժեշտ է ձեզ տեղորոշելու թույլտվություն</translation>
<translation id="5487574057737591516">Ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Եթե Decentr-ը սխալ է որոշել ձեր հետաքրքրությունը, կամ դուք չեք ուզում տեսնել որոշակի գովազդներ, կարող եք հեռացնել հետաքրքրությունը։</translation>
<translation id="549669000822060376">Սպասեք` մինչ Decentr-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="5496810170689441661">Decentr-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="5527463683072221100">Բացել PDF ֆայլեր Decentr-ում</translation>
<translation id="5623402015214259806">{0,plural, =0{Հասանելի է Decentr-ի նոր տարբերակը}=1{Հասանելի է Decentr-ի նոր տարբերակը}one{Decentr-ի նոր տարբերակը # օր է հասանելի է}other{Decentr-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="5643865575100044307">Միշտ ջնջել կայքերի տվյալները սարքից՝ Decentr-ը փակելու դեպքում</translation>
<translation id="5653831366781983928">Վերագործարկեք Decentr-ը</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Decentr-ը ցուցադրել այս լեզվով</translation>
<translation id="569897634095159764">Հնարավոր չէ միանալ ինտերնետին։ Պրոքսի սերվերն իսկորոշում է պահանջում։</translation>
<translation id="5809516625706423866">Հնարավոր չէ միանալ ինտերնետին։ HTTP 401 Unauthorized։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="5862307444128926510">Բարի գալուստ Decentr</translation>
<translation id="5883558403894052917">Decentr-ը այս տարրերում վնասագիր է հայտնաբերել՝</translation>
<translation id="5889361821821684993">Decentr-ը պարբերաբար ստուգում է իրականացնում՝ համոզվելու, որ ձեր դիտարկիչն ամենաանվտանգ կարգավորումներն ունի։ Մենք ձեզ կտեղեկացնենք, եթե որևէ բան փոխելու անհրաժեշտություն լինի։</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Ցանցի մուտք</translation>
<translation id="5924017743176219022">Միացում համացանցին…</translation>
<translation id="5941711191222866238">Նվազեցնել</translation>
<translation id="5972142260211327093">Եթե Decentr-ը պատահականության սկզբունքով ձեզ ընտրում է ակտիվ փորձարկմանը մասնակցության համար, ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով Decentr-ը ամեն ամիս ջնջում է ձեր հետաքրքրությունները։ Հետաքրքրությունները թարմացվում են, եթե դրանք չեք հեռացնում։</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Decentr-ը, երբ այն 1 րոպե չի օգտագործվում։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Decentr-ը, երբ այն # րոպե չի օգտագործվում։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Decentr-ը, երբ այն # րոպե չի օգտագործվում։}}</translation>
<translation id="5987687638152509985">Թարմացրեք Decentr-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="5988505247484123880">Սովորաբար կայքերը, որոնք դուք այցելում եք, հիշում են, թե ձեզ ինչն է հետաքրքրում, որպեսզի անհատականացնեն գովազդը ձեզ համար։ Կայքերը կարող են նաև ձեր հետաքրքրությունների մասին տեղեկություններ պահել Decentr-ում։</translation>
<translation id="6003112304606738118">Ներբեռնում… Մնաց <ph name="HOURS" /> ժամ</translation>
<translation id="6040143037577758943">Փակել</translation>
<translation id="6055895534982063517">Մատչելի է Decentr-ի նոր տարբերակ, որը շատ ավելի արագ է:</translation>
<translation id="6058380562449900225">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Decentr-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։ Ընդ որում՝ ծանուցումները չեն անջատվի։</translation>
<translation id="6063093106622310249">&amp;Բացել Decentr-ում</translation>
<translation id="6072279588547424923">«<ph name="EXTENSION_NAME" />» ընդլայնումն ավելացվել է Decentr-ին</translation>
<translation id="6072463441809498330">Արագացրեք Decentr-ի աշխատանքը</translation>
<translation id="608006075545470555">Աշխատանքային պրոֆիլի ավելացում այս դիտարկիչում</translation>
<translation id="6096348254544841612">Հասանելի է Decentr-ի նոր տարբերակը։</translation>
<translation id="6102072151902574948">Երբ այս ռեժիմը միացված է, Decentr-ը տնտեսում է մարտկոցի լիցքը՝ սահմանափակելով աշխատանքը ֆոնային ռեժիմում և վիզուալ էֆեկտները, օրինակ՝ սահուն ոլորումը և տեսանյութերի կադրերի հաճախականությունը։</translation>
<translation id="6119438414301547735">Թույլատրել ընդլայնմանը մուտքի հարցումներ ցուցադրել Decentr-ի գործիքագոտում</translation>
<translation id="6120345080069858279">Decentr-ը կպահի այս գաղտնաբառը ձեր Google հաշվում: Գաղտնաբառը հիշելու կարիք չի լինի:</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> ֆայլը վտանգավոր է, և Decentr-ն արգելափակել է այն։</translation>
<translation id="6132897690380286411">Decentr-ը շուտով կփակվի և կջնջի տվյալները</translation>
<translation id="6134968993075716475">Անվտանգ դիտարկումն անջատված է։ Decentr-ը խորհուրդ է տալիս միացնել այն։</translation>
<translation id="6144416395842701622">Մտեք հաշիվ՝ Decentr-ի բոլոր գործառույթներից օգտվելու համար</translation>
<translation id="6145820983052037069">Այստեղ կարող եք անցնել Decentr-ի այլ պրոֆիլի</translation>
<translation id="615103374448673771">Եթե դուք թույլատրում եք քուքիների օգտագործումը, Decentr-ը կարող է դրանք օգտագործել նախաբեռնման ժամանակ</translation>
<translation id="6174920971222007286">Այս ֆայլը կարող է վտանգավոր լինել<ph name="LINE_BREAK" />Decentr-ը կարող է ստուգել այն, եթե մուտքագրեք ձեր գաղտնաբառը։ Ֆայլի մասին տեղեկությունները կուղարկվեն «Google Ապահով դիտարկում» ծառայությանը, սակայն ֆայլի բովանդակությունը և գաղտնաբառը կմնան ձեր սարքում։</translation>
<translation id="6182736845697986886">Չհաջողվեց տեղադրել հավելվածը թարմացումն իրականացնող սերվերի ներքին սխալի պատճառով։</translation>
<translation id="6183079672144801177">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME" /> սարքի Decentr դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="6212496753309875659">Այս համակարգչում արդեն տեղադրված է Decentr-ի ավելի նոր տարբերակը: Եթե ծրագրակազմը չի աշխատում, ապատեղադրեք Decentr-ը և նորից փորձեք:</translation>
<translation id="6219195342503754812">{0,plural, =0{Decentr-ը հիմա կվերագործարկվի}=1{Decentr-ը կվերագործարկվի 1 վայրկյանից}one{Decentr-ը կվերագործարկվի # վայրկյանից}other{Decentr-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="6241367896540709610">Ֆայլեր ներբեռնելու համար Decentr-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="6245734527075554892">Ստուգում է URL-ները Decentr-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="6248213926982192922">Դարձնել Decentr-ը կանխադրված դիտարկիչ</translation>
<translation id="6266342355635466082">Decentr-ը չի կարող ստուգել թարմացումների առկայությունը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="6268381023930128611">Դուրս գա՞լ Decentr-ից:</translation>
<translation id="6273793429163604305">Նախապատրաստում…</translation>
<translation id="6281746429495226318">Անհատականացնել Decentr-ի պրոֆիլը</translation>
<translation id="6290827346642914212">Անվանեք ձեր Decentr պրոֆիլը</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> ֆայլը կարող է վտանգավոր լինել, և Decentr-ն արգելափակել է այն։</translation>
<translation id="6309712487085796862">Decentr-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="6327105987658262776">Հասանելի թարմացումներ չկան։</translation>
<translation id="6333502561965082103">Decentr-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="6334986366598267305">Այժմ ավելի հեշտ է օգտագործել Decentr-ը ձեր Google հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="6366160072964553914">Decentr-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="6373523479360886564">Հեռացնե՞լ Decentr-ը:</translation>
<translation id="6375219077595103062">Ավելացրեք Գաղտնաբառերի կառավարչի դյուրանցումը</translation>
<translation id="6384011394608460044"><ph name="BEGIN_BOLD" />Ինչպես ենք մենք օգտագործում այս տվյալները.<ph name="END_BOLD" /> Decentr-ը կարող է որոշել ձեր հետաքրքրությունները։ Ավելի ուշ կայքը, որն այցելում եք, կարող է Decentr-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։</translation>
<translation id="6400112897226594999">Decentr-ի լոգոն՝ համակարգչի էկրանին։</translation>
<translation id="6403826409255603130">Decentr-ը վեբ դիտարկիչ է, որը կայծակի արագությամբ է բացում վեբէջերն ու հավելվածները: Այն արագ է, կայուն և պարզ՝ օգտագործման մեջ: Ավելի ապահով աշխատեք համացանցում՝ վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության շնորհիվ:</translation>
<translation id="6442900851116057561">Վերագործարկեք ChromiumOS-ը</translation>
<translation id="6443470774889161065">Decentr-ը նախապես բեռնում է էլ ավելի շատ էջեր, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="6455857529632101747">Բարի գալուստ Decentr պրոֆիլներ</translation>
<translation id="6475912303565314141">Այն նաև վերահսկում է, թե որ էջը ցուցադրվի Decentr-ը մեկնարկելիս:</translation>
<translation id="648319183876919572">Բարելավված Ապահով դիտարկումն օգնում է պաշտպանվել վտանգավոր կայքերից և ներբեռնումներից</translation>
<translation id="6510925080656968729">Ապատեղադրել Decentr-ը</translation>
<translation id="6539122709674868420">Ձեր կազմակերպությունը փակում է Decentr-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այցելությունների պատմությունը ջնջվել է։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="6542839706527980775">Յուրաքանչյուր պրոֆիլում առանձին պահվում են Decentr-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="6563921047760808519">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Decentr-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="656935081669708576">Դուք կարող եք դիտել գաղտնաբառերը՝ անցնելով մյուս Decentr պրոֆիլ</translation>
<translation id="6570579332384693436">Ուղղագրական սխալները շտկելու համար Decentr-ը Google-ին է ուղարկում տեքստային դաշտերում ձեր մուտքագրած տեքստը</translation>
<translation id="6598877126913850652">Անցնել Decentr-ի ծանուցումների կարգավորումներ</translation>
<translation id="6613594504749178791">Փոփոխություններն ուժի մեջ կմտնեն Decentr-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="665732753414869868">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար Decentr-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="6663852025006259149">Կայքերը հավանաբար կաշխատեն պատշաճ կերպով, սակայն չեն պահպանի ձեր գործողությունները, երբ դուք փակեք Decentr-ի բոլոր պատուհանները</translation>
<translation id="6669284030132180248">Պահելով էջանիշները Google հաշվում՝ դուք կարող եք հետագծել ապրանքների գները Decentr-ում և ստանալ զեղչերի մասին ծանուցումներ</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="668175097507315160">Մուտքի սխալի պատճառով ChromiumOS-ը չկարողացավ համաժամացնել ձեր տվյալները։</translation>
<translation id="6692797197837897398">Decentr-ը ձեզ տալիս է ավելի շատ հնարավորություններ՝ վերահսկելու ձեզ ցուցադրվող գովազդները, և սահմանափակում է ձեր մասին այն տվյալների ծավալը, որոնք հասանելի են դառնում կայքերին, երբ դրանք ձեզ անհատականացված գովազդ են ցուցադրում</translation>
<translation id="6709350901466051922">Այս կայքի համար Decentr-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="6712881677154121168">Ներբեռնման սխալ՝ <ph name="DOWNLOAD_ERROR" />։</translation>
<translation id="6717134281241384636">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն Decentr-ի նոր տարբերակից է:

Որոշ գործառույթներ մատչելի չեն լինի: Հատկորոշեք այլ պրոֆիլի գրացուցակ կամ օգտվեք Decentr-ի ավելի նոր տարբերակից:</translation>
<translation id="6734291798041940871">Decentr-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="673636774878526923">Decentr-ի ձեր տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք և միացրեք համաժամացումը։</translation>
<translation id="67706546131546258">Decentr-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել։</translation>
<translation id="6779406956731413166">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա։</translation>
<translation id="6847869444787758381">Decentr-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="684888714667046800">Հնարավոր չէ միանալ ինտերնետին։ Հրապատ օգտագործելու դեպքում համոզվեք, որ <ph name="PRODUCT_EXE_NAME" /> ֆայլը թույլատրվածների ցուցակում է։</translation>
<translation id="6857782730669500492">Decentr – <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">Decentr-ը «<ph name="EXTENSION_NAME" />» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="6893813176749746474">Decentr-ը թարմացվել է, սակայն դուք չեք օգտագործել այն առնվազն 30 օր:</translation>
<translation id="691026815377248078">Զուգակցումը շարունակելու համար Decentr-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6929417474050522668">Երբ փորձաշրջանները միացված են, գովազդի արդյունավետության գնահատումը թույլ է տալիս ձեր այցելած կայքերին ստանալ Decentr-ից տեղեկություններ, որոնք օգնում են չափել այդ կայքերում ցուցադրվող գովազդի արդյունավետությունը։ Գովազդի արդյունավետության գնահատումը սահմանափակում է օգտատերերի գործողությունների միջկայքային հետագծումը՝ նվազագույնի հասցնելով կայքերի միջև տեղեկությունների փոխանցումը։</translation>
<translation id="6940431691900807093">Ավելի ուշ կայքը, որն այցելում եք, կարող է Decentr-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։ Decentr-ը կարող է հասանելի դարձնել ձեր մինչև 3 հետաքրքրությունների մասին տեղեկությունները։</translation>
<translation id="6964305034639999644">Բացել հղումը Decentr-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="6978145336957848883">Թույլ գաղտնաբառերը հեշտ է գուշակել։ Թույլատրեք Decentr-ին <ph name="BEGIN_LINK" />գաղտնաբառեր ստեղծել և պահել ձեզ համար<ph name="END_LINK" />։</translation>
<translation id="6981396265751285733">Երբ այս կարգավորումը միացված է, Decentr-ն ազատում է ոչ ակտիվ ներդիրների հիշողությունը։ Դրա շնորհիվ ակտիվ ներդիրներն ու մյուս հավելվածները համակարգչի ավելի շատ ռեսուրսներից են կարողանում օգտվել, իսկ Decentr-ը կարողանում է արագ աշխատել։ Ոչ ակտիվ ներդիրներն ավտոմատ կակտիվանան, երբ նորից սկսեք օգտագործել դրանք։</translation>
<translation id="6985329841647292029">ChromiumOS-ի պայմաններ</translation>
<translation id="6990124437352146030">Decentr-ին այս կայքի համար անհրաժեշտ է ձեր խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="7011190694940573312">Տեղադրումը ձախողվեց, քանի որ օպերացիոն համակարգի այս տարբերակը չի աջակցվում։</translation>
<translation id="7024536598735240744">Ապափաթեթավորման սխալ՝ <ph name="UNPACK_ERROR" />։</translation>
<translation id="7025789849649390912">Տեղադրումը կանգնեցվել է։</translation>
<translation id="705851970750939768">Թարմացնել Decentr-ը</translation>
<translation id="7067091210845072982">Եթե պատկերն օգտակար նկարագրություն չունի, Decentr-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="7141270731789036260">Անհատականացրեք Decentr for Testing-ը</translation>
<translation id="7173822816570314652">Ձեր կազմակերպությունը ջնջում է Decentr-ի տվյալները, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="718435575166326686">Այս կայքի համար Decentr-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="7196312274710523067">Չհաջողվեց գործարկել Decentr-ը։ Նորից փորձեք։</translation>
<translation id="7197677400338048821">Decentr-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք։</translation>
<translation id="7213407614656404070">Օգտագործեք Decentr-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="7223968959479464213">Խնդիրների կառավարիչ - Decentr</translation>
<translation id="7246575524853130370">Ձեր հետաքրքրությունները (ըստ Decentr-ի)</translation>
<translation id="7309928523159922338">Գովազդի արդյունավետության գնահատումը թույլ է տալիս ձեր այցելած կայքերին ստանալ Decentr-ից տեղեկություններ, որոնք օգնում են չափել այդ կայքերում ցուցադրվող գովազդի արդյունավետությունը։ Գովազդի արդյունավետության գնահատումը սահմանափակում է օգտատերերի գործողությունների միջկայքային հետագծումը՝ նվազագույնի հասցնելով կայքերի միջև տեղեկությունների փոխանցումը։</translation>
<translation id="731795002583552498">Decentr-ը թարմացվում է</translation>
<translation id="7318036098707714271">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

Decentr-ին չհաջողվեց վերականգնել ձեր կարգավորումները:</translation>
<translation id="7339898014177206373">Նոր պատուհան</translation>
<translation id="734373864078049451">Բոլոր վեբէջերը, էջանիշները և Decentr-ի այլ տվյալները պահվում են այստեղ:</translation>
<translation id="7349591376906416160">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Decentr-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME" /> դիտարկիչով։</translation>
<translation id="7398989605938454041">Decentr պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։Այդպես ավելի հեշտ է տարանջատել գործնական և անձնական նպատակներով օգտագործումը։</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> – Decentr Dev</translation>
<translation id="7451052299415159299">Decentr-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="7461356015007898716">Decentr-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 7 տարբերակը։</translation>
<translation id="7467949745582939695">Վերագործարկե՞լ Decentr-ը</translation>
<translation id="7483335560992089831">Հնարավոր չէ տեղադրել Decentr-ի նույն տարբերակը, որն այժմ գործարկվում է: Փակեք Decentr-ը և նորից փորձեք:</translation>
<translation id="751935028865900641">Կայքերի մեծ մասը ամենայն հավանականությամբ պատշաճ կերպով կաշխատի։ Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Decentr-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել Decentr։</translation>
<translation id="753534427205733210">{0,plural, =1{Decentr-ը կվերագործարկվի 1 րոպեից}one{Decentr-ը կվերագործարկվի # րոպեից}other{Decentr-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="7582945390259497898">Decentr-ը կարող է որոշել ձեր հետաքրքրությունները։ Ավելի ուշ կայքը, որն այցելում եք, կարող է Decentr-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" />-ի տեղադրիչ</translation>
<translation id="761356813943268536">Decentr-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="7617377681829253106">Decentr-ը կատարելագործվել է</translation>
<translation id="7649070708921625228">Օգնություն</translation>
<translation id="7682213815243802460">Ավելին այս գործառույթների մասին կարող եք իմանալ Decentr-ի կարգավորումներում։</translation>
<translation id="7686590090926151193">Decentr-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="7689606757190482937">Համաժամացրեք և անհատականացրեք Decentr-ը ձեր բոլոր սարքերում</translation>
<translation id="7699779824407626136">Decentr-ի թարմացում</translation>
<translation id="7745317241717453663">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Decentr <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="7786760609782648049">Արագացրեք Decentr-ի աշխատանքը</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> – Decentr Canary</translation>
<translation id="7803986347287457849">Արեք այնպես, որ ձեր ինտերնետ թրաֆիկի հասանելիություն ունեցող մարդիկ չկարողանան տեսնել, թե ինչ կայքեր եք այցելել։ Decentr-ն օգտագործում է ապահով միացում՝ DNS-ում (տիրույթի անունների համակարգ) կայքերի IP հասցեները որոնելու համար։</translation>
<translation id="7828947555739565424">Այս հաշվի հետ կապված Decentr-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="7845233973568007926">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր համակարգիչը։</translation>
<translation id="7859018312476869945">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Decentr-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="7867198900892795913">Չհաջողվեց տեղադրել Decentr-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="7872446069773932638">Ներբեռնում… Մնաց <ph name="SECONDS" /> վայրկյան</translation>
<translation id="7877292582355102282"><ph name="BEGIN_BOLD" />Ինչպես կարող եք կառավարել ձեր տվյալները.<ph name="END_BOLD" /> ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Որպեսզի Decentr-ը հաշվի չառնի որոշակի հետաքրքրությունները, կարող եք դրանք հեռացնել։</translation>
<translation id="7937630085815544518">Դուք մուտք եք գործել Decentr որպես <ph name="USER_EMAIL_ADDRESS" />: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="7975919845073681630">Սա Decentr-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="7997934263947464652">Անհայտ աղբյուրներից ընդլայնումները, հավելվածներն ու թեմաները կարող են վնասել ձեր սարքը։ Decentr-ը խորհուրդ է տալիս դրանք տեղադրել միայն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ից։</translation>
<translation id="8013436988911883588">Երբ Decentr-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="80471789339884597">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր բոլոր դիտարկիչները։</translation>
<translation id="8086881907087796310">Տեղադրումը ձախողվեց, քանի որ ձեր համակարգիչը չի համապատասխանում սարքակազմի նվազագույն պահանջներին։</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Decentr for Testing</translation>
<translation id="8105840573057009683">Այս կայքի համար Decentr-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="8133124826068723441">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ այդ գործառույթը հասանելի չէ ձեր տիրույթի համար։</translation>
<translation id="813913629614996137">Նախապատրաստվում է...</translation>
<translation id="8166782796394721554">Միացրեք լրացուցիչ պաշտպանությունը Decentr-ի JavaScript և WebAssembly համակարգում</translation>
<translation id="81770708095080097">Այս ֆայլը վտանգավոր է, և Decentr-ն արգելափակել է այն։</translation>
<translation id="8248265253516264921">Եթե պատկերն օգտակար նկարագրություն չունի, Decentr-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="8266560134891435528">Decentr-ը չի կարող ստուգել ձեր գաղտնաբառերը, քանի որ դուք հաշիվ չեք մտել։</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Decentr-ը զգուշացնում է ձեզ<ph name="END_LINK" /> վտանգավոր կայքերի և ներբեռնումների մասին</translation>
<translation id="8290862415967981663">Այս ֆայլը կարող է վտանգավոր լինել, և Decentr-ն արգելափակել է այն։</translation>
<translation id="8318772038038596122">Ձեր կազմակերպությունը փակում է Decentr-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։</translation>
<translation id="8325404639443959713">Արեք ավելին Decentr-ի միջոցով</translation>
<translation id="8330519371938183845">Մտեք հաշիվ՝ Decentr-ը ձեր բոլոր սարքերում անհատականացնելու համար</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" />-ը նախկինում Decentr է օգտագործել</translation>
<translation id="8357820681460164151">Decentr դիտարկիչի ձեր տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք և միացրեք համաժամացումը</translation>
<translation id="8360718212975266891">Decentr-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8 տարբերակը։</translation>
<translation id="8370517070665726704">© Google LLC <ph name="YEAR" />։ Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8401454788024434101">Այս ընդլայնման հրապարակումը չեղարկվել է մշակողի կողմից, և այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Decentr-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="8417404458978023919">{0,plural, =1{Վերագործարկեք Chromium-ը մեկ օրվա ընթացքում}one{Վերագործարկեք Chromium-ը # օրվա ընթացքում}other{Վերագործարկեք Chromium-ը # օրվա ընթացքում}}</translation>
<translation id="8453117565092476964">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք Chromium-ը:</translation>
<translation id="8458614432758743027">Chromium-ի համար պահանջվում է Windows 10 կամ ավելի նոր տարբերակ։</translation>
<translation id="8463672209299734063">Ըստ ցանկության. օգնեք բարելավել ChromiumOS-ի գործառույթներն ու աշխատանքը՝ Google-ին ավտոմատ կերպով ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="8493179195440786826">Chromium-ը հնացած է</translation>
<translation id="8522801943730206384">Chromium-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք</translation>
<translation id="8550334526674375523">Այս աշխատանքային պրոֆիլն ամբողջովին առանձնացված է ձեր անձնական պրոֆիլից։</translation>
<translation id="8555465886620020932">Ծառայության սխալ՝ <ph name="SERVICE_ERROR" />։</translation>
<translation id="8568283329061645092">Chromium-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ մտնեք ձեր Google հաշիվ։</translation>
<translation id="8586442755830160949">© <ph name="YEAR" /> The Chromium Authors: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="858822505990366713">Անհատականացնել Chromium-ը</translation>
<translation id="8608079656141766906"><ph name="BEGIN_BOLD" />Ինչպես ենք մենք օգտագործում այս տվյալները.<ph name="END_BOLD" /> կայքերը կարող են ձեր հետաքրքրությունների մասին տեղեկություններ պահել Chromium-ում։ Օրինակ, եթե դուք այցելել եք ինչ-որ կայք՝ մարաթոնի համար վազքի կոշիկներ գնելու, այդ կայքը կորոշի, որ ձեզ հետաքրքրում է մարաթոնյան վազքը։ Ավելի ուշ, երբ դուք այցելեք մեկ այլ կայք՝ մրցավազքի համար գրանցվելու, այնտեղ կարող է վազքի կոշիկների գովազդ ցուցադրվել։</translation>
<translation id="8619360774459241877">Chromium-ի գործարկում...</translation>
<translation id="8621669128220841554">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Նորից ներբեռնեք Chromium-ը:</translation>
<translation id="8648201657708811153">Decentr for Testing-ը չի կարող դառնալ ձեր կանխադրված դիտարկիչը։</translation>
<translation id="8697124171261953979">Այն նաև վերահսկում է Chromium-ի մեկնարկի կամ Omnibox-ից որոնում կատարելու ժամանակ ցուցադրվող էջը:</translation>
<translation id="8704119203788522458">Սա ձեր Chromium-ն է</translation>
<translation id="8719993436687031146">Մուտք գործե՞լ Chromium</translation>
<translation id="878572486461146056">Տեղադրման սխալ. ձեր ցանցի ադմինիստրատորը կիրառել է խմբային կանոն, որը կանխում է տեղադրումը՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="8796602469536043152">Chromium-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն ու խոսափողը օգտագործելու թույլտվություն</translation>
<translation id="8826492472752484139">Սեղմեք «Գաղտնաբառերի կառավարիչ»</translation>
<translation id="8833697763442816810">ChromiumOS համակարգ</translation>
<translation id="8846118132221683440"><ph name="BEGIN_BOLD" />Ինչ տվյալներ են օգտագործվում.<ph name="END_BOLD" /> ձեր այցելությունների պատմությունը այն կայքերի ցանկն է, որոնք դուք այցելել եք Chromium-ի միջոցով այս սարքում։</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="8880203542552872219">Եթե այո, ապա փոխեք ձեր պահված գաղտնաբառը Chromium-ում, որպեսզի այն համապատասխանի ձեր նոր գաղտնաբառին։</translation>
<translation id="8907580949721785412">Chromium-ը փորձում է ցուցադրել գաղտնաբառերը: Մուտքագրեք ձեր Windows-ի գաղտնաբառը՝ այս գործողությունը թույլ տալու համար:</translation>
<translation id="8931379085695076764">Chromium-ը որոշում է ձեր հետաքրքրությունները վերջին մի քանի շաբաթվա ընթացքում ձեր այցելությունների պատմության հիման վրա։ Այս տեղեկությունները չեն փոխանցվում ձեր սարքից։</translation>
<translation id="8941642502866065432">Չհաջողվեց թարմացնել Chromium-ը</translation>
<translation id="895999862145835951">Անհատականացնել Chromium-ը</translation>
<translation id="897581876605952338">Chromium Enterprise-ի լոգո</translation>
<translation id="8986207147630327271">Դուք ավելացնում եք աշխատանքային պրոֆիլ այս դիտարկիչում և միայն դրա վերահսկողությունը տրամադրում ադմինիստրատորին։</translation>
<translation id="8988036198400390003">Կառավարել Chromium-ի պրոֆիլները</translation>
<translation id="9019929317751753759">Chromium-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="9022552996538154597">Մուտք գործել Chromium</translation>
<translation id="907832235989677238">Մուտք գործեք Chromium։ Եթե ուզում եք միայն մեկ անգամ մուտք գործել հաշիվ, կարող եք <ph name="GUEST_LINK_BEGIN" />օգտագործել սարքը որպես հյուր<ph name="GUEST_LINK_END" />։</translation>
<translation id="9078733879136747090">Chromium-ն ավտոմատ փակվել է</translation>
<translation id="9089354809943900324">Chromium-ը հնացել է</translation>
<translation id="9093206154853821181">{0,plural, =1{Chromium-ը կվերագործարկվի մեկ ժամից}one{Chromium-ը կվերագործարկվի # ժամից}other{Chromium-ը կվերագործարկվի # ժամից}}</translation>
<translation id="9106612006984859720">Chromium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8.1 տարբերակը։</translation>
<translation id="91086099826398415">Բացել հղումը Chromium-ի նոր &amp;ներդիրում</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="9144490074902256427">Փորձարկումների ընթացքում դուք կարող եք տեսնել և հեռացնել հետաքրքրությունները, որոնք կայքերն օգտագործում են ձեզ գովազդ ցուցադրելու համար։ Chromium-ը որոշում է ձեր հետաքրքրությունները ձեր վերջին այցելությունների պատմության հիման վրա։</translation>
<translation id="9158494823179993217">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Chromium-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="9185526690718004400">Վերագործարկել՝ &amp;Chromium-ը թարմացնելու համար</translation>
<translation id="9190841055450128916">Chromium (mDNS-In)</translation>
<translation id="924957577793602335">Անհատականացրեք Chromium-ը</translation>
<translation id="93478295209880648">Chromium-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Windows XP և Windows Vista համակարգերում</translation>
<translation id="942598560705308788">Chromium-ի կողմից կառավարվող հավաստագրեր</translation>
<translation id="965162752251293939">Ո՞վ է օգտագործում Chromium-ը</translation>
<translation id="967427899662692980">Ուժեղացրեք Chromium-ի անվտանգությունը</translation>
<translation id="983803489796659991">Չհաջողվեց տեղադրել հավելվածը, քանի որ թարմացումն իրականացնող սերվերը չունի հավելվածի համար անհրաժեշտ հեշերի տվյալներ։</translation>
<translation id="985602178874221306">Chromium Authors</translation>
</translationbundle>