<translation id="9089354809943900324">Decentr ហួសសម័យហើយ</translation>
<translation id="9093206154853821181">{0,plural, =1{Decentr នឹង​ចាប់ផ្ដើមឡើងវិញ​ក្នុងរយៈពេល​មួយ​ម៉ោងទៀត}other{Decentr នឹង​ចាប់ផ្ដើមឡើងវិញ​ក្នុងរយៈពេល # ម៉ោងទៀត}}</translation>
<translation id="9106236359747881194">ជ្រើសរើសអក្សរដើម្បីស្វែងរក</translation>
<translation id="9106612006984859720">ដើម្បីទទួលបានកំណែថ្មីរបស់ Decentr នាពេលខាងមុខ អ្នកនឹងត្រូវការ Windows 10 ឬកំណែក្រោយនេះ។ កុំព្យូទ័រនេះកំពុងប្រើ Windows 8.1។</translation>
<translation id="91086099826398415">បើក​តំណ​នៅក្នុងផ្ទាំង​ Decentr ថ្មី</translation>
<translation id="911206726377975832">លុបទិន្នន័យរុករករបស់អ្នកផងដែរ?</translation>
<translation id="9148058034647219655">ចាកចេញ</translation>
<translation id="9158494823179993217">អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​របស់អ្នកបាន​កំណត់​រចនាសម្ព័ន្ធ Decentr ឱ្យបើក​កម្មវិធីរុករកតាម​អ៊ីនធឺណិត​ផ្សេងសម្រាប់​ចូលប្រើ <ph name="TARGET_URL_HOSTNAME" /> ។</translation>
<translation id="9185526690718004400">ចាប់​ផ្តើមឡើងវិញដើម្បីដំឡើងកំណែ &amp;Decentr</translation>
<translation id="9190841055450128916">Decentr (mDNS-In)</translation>
<translation id="924957577793602335">កំណត់​ឱ្យ Decentr ក្លាយជារបស់អ្នក</translation>
<translation id="93478295209880648">Decentr អាច​នឹង​​ដំណើរការ​មិន​​ត្រឹមត្រូវ​ ដោយសារ​វា​មិន​អាចប្រើ​បាន​នៅលើ Windows XP ឬ Windows Vista ទៀត​ឡើយ។</translation>
<translation id="942598560705308788">វិញ្ញាបនបត្រ​ត្រូវបានគ្រប់គ្រង​ដោយ Decentr</translation>
<translation id="945522503751344254">ផ្ញើមតិ</translation>
<translation id="965162752251293939">តើនរណា​កំពុងប្រើ Decentr?</translation>
<translation id="967427899662692980">ទទួលបាន​សុវត្ថិភាពខ្លាំង​បំផុតរបស់ Decentr</translation>
<translation id="983803489796659991">ការដំឡើងមិនបានសម្រេចទេ ដោយសារម៉ាស៊ីនមេដំឡើងកំណែមិនមានទិន្នន័យកូដតំណាងសម្រាប់កម្មវិធី។</translation>
<translation id="985498048907240953">ប្រើ Decentr ដោយមិនប្រើគណនី</translation>
<translation id="985602178874221306">ផលិតករ Decentr</translation>
<translation id="989970834842471429">ជ្រើសរើស​អក្សរ ឬ​រូបភាព ដើម្បី​ស្វែងរក​ដោយប្រើ​ការស្វែងរក​រូបភាព</translation>
<translation id="992780518932311116">ដើម្បីប្រើ​ទីតាំង​របស់អ្នក សូមផ្ដល់​សិទ្ធិចូលប្រើឱ្យ Decentr នៅក្នុង<ph name="BEGIN_LINK" />ការកំណត់ប្រព័ន្ធ<ph name="END_LINK" /></translation>
</translationbundle>