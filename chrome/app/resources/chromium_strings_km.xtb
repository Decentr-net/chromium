<translation id="1966382378801805537">Decentr មិនអាច​សម្រេចយក ឬ​កំណត់កម្មវិធីរុករក​លំនាំដើម​បានទេ</translation>
<translation id="1990262977744080398">ស្វែងយល់អំពីមូលហេតុដែល Decentr ទប់ស្កាត់ឯកសារមួយចំនួន, បើកនៅក្នុងផ្ទាំងថ្មី</translation>
<translation id="1999715455684970349">រក្សាកម្មវិធី Decentr របស់អ្នកឱ្យមានកំណែថ្មីបំផុត។ ប្រសិនបើសេវាកម្មនេះត្រូវបានបិទ ឬបញ្ឈប់ កម្មវិធី Decentr របស់អ្នកនឹងមិនត្រូវបានរក្សាឱ្យមានកំណែថ្មីបំផុតទេ ដែលមានន័យថាមិនអាចដោះស្រាយភាពងាយរងគ្រោះផ្នែកសុវត្ថិភាពដែលអាចកើតមាន ហើយមុខងារអាចមិនដំណើរការឡើយ។ សេវាកម្មនេះលុបដោយខ្លួនឯង នៅពេលគ្មានកម្មវិធី Decentr ណាប្រើសេវាកម្មនេះ។</translation>
<translation id="2008474315282236005">វា​នឹង​លុប​ធាតុ 1 ចេញ​ពី​ឧបករណ៍​នេះ។ ដើម្បី​ទាញ​យក​ទិន្នន័យ​របស់អ្នក​មកវិញ​នៅ​ពេល​ក្រោយ សូម​ចូល​ទៅ​កាន់ Decentr ជា <ph name="USER_EMAIL" /> ។</translation>
<translation id="2018879682492276940">ការដំឡើង​មិនបាន​សម្រេចទេ។ សូមព្យាយាមម្ដងទៀត។</translation>
<translation id="2020032459870799438">ដើម្បីពិនិត្យមើលថា​តើពាក្យសម្ងាត់​ផ្សេងទៀតរបស់អ្នក​មានសុវត្ថិភាពពី​ការបែកធ្លាយ​ទិន្នន័យ និងបញ្ហាសុវត្ថិភាព​ផ្សេងទៀតឬអត់ សូម​<ph name="BEGIN_LINK" />ចូល Decentr<ph name="END_LINK" />។</translation>
<translation id="2049376729098081731">ជ្រើសរើសថាត្រូវរួមបញ្ចូលប្រវត្តិ Decentr ដើម្បីទទួលបានបទពិសោធន៍ប្រើប្រាស់កាន់តែស្របនឹងបុគ្គលនៅក្នុងសេវាកម្ម Google ឬអត់</translation>
<translation id="2054039611381840095">ដើម្បី​ទទួលបាន​កំណែថ្មីៗ​របស់ Decentr នាពេលអនាគត អ្នកនឹង​ត្រូវការ macOS 12 ឡើងទៅ។ កុំព្យូទ័រនេះ​កំពុងប្រើ macOS 11។</translation>
<translation id="2086476982681781442">Decentr បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារនេះ​មានលក្ខណៈ​បោកប្រាស់ និង​អាចធ្វើការផ្លាស់ប្ដូរ​ដែលមិនបានរំពឹងទុក​ចំពោះ​ឧបករណ៍​របស់អ្នក</translation>
<translation id="2088953378266246249">ព័ត៌មាន​អំពី​របៀប​ដែល Decentr គ្រប់គ្រង​វិញ្ញាបនបត្រ​គោល​របស់ខ្លួន</translation>
<translation id="2099452623287920103">ពាក្យ​សម្ងាត់ និង​ទិន្នន័យ Decentr ផ្សេងទៀត​របស់អ្នក​ដែលអ្នកបាន​រក្សាទុក​នៅក្នុង​គណនី Google របស់អ្នក​នឹង​ត្រូវបាន​ដកចេញ​ពីឧបករណ៍​នេះ។ ដើម្បីប្រើព័ត៌មានទាំងនេះម្ដងទៀតនៅក្នុង Decentr សូមចូលគណនីវិញ។</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{ស្ថាប័ន​របស់អ្នក​លុប​ទិន្នន័យរុករក​ដោយស្វ័យប្រវត្តិ នៅពេលដែល​មិនប្រើប្រាស់ Decentr រយៈពេល 1 នាទី។ ទិន្នន័យ​នេះ​អាច​រួមមាន​ប្រវត្តិ ការបំពេញស្វ័យប្រវត្តិ និង​ការទាញយក។ ផ្ទាំង​របស់អ្នក​នឹងបន្តបើក។}other{ស្ថាប័ន​របស់អ្នក​លុប​ទិន្នន័យរុករក​ដោយស្វ័យប្រវត្តិ នៅពេលដែល​មិនប្រើប្រាស់ Decentr រយៈពេល # នាទី។ ទិន្នន័យ​នេះ​អាច​រួមមាន​ប្រវត្តិ ការបំពេញស្វ័យប្រវត្តិ និង​ការទាញយក។ ផ្ទាំង​របស់អ្នក​នឹងបន្តបើក។}}</translation>
<translation id="2126108037660393668">មិនអាច​ផ្ទៀងផ្ទាត់​ឯកសារ​ដែលបានទាញយក​បានទេ។</translation>
