<translation id="18552579716432081">ដើម្បីលុប​ទិន្នន័យរុករក​ចេញពី​ឧបករណ៍​នេះតែប៉ុណ្ណោះ ប៉ុន្តែរក្សា​ទិន្នន័យនេះនៅក្នុង​គណនី Google របស់អ្នក សូម<ph name="BEGIN_LINK" />ចេញពីគណនីលើ Decentr<ph name="END_LINK" />។</translation>
<translation id="185970820835152459">អ្នកអាចគ្រប់គ្រង​គណនី Google ដែលអ្នកចូល។ គណនី Google របស់អ្នក​ត្រូវបានប្រើ​សម្រាប់​កម្មវិធីរុករកតាមអ៊ីនធឺណិត Decentr, Play Store, Gmail និងអ្វីៗជាច្រើនទៀត។ ប្រសិនបើអ្នក​ចង់បញ្ចូល​គណនីសម្រាប់​អ្នកផ្សេងទៀត​ដូចជា សមាជិកគ្រួសារជាដើម សូមបញ្ចូលមនុស្សថ្មី​ទៅក្នុង <ph name="DEVICE_TYPE" /> របស់អ្នក​ជំនួសវិញ។ <ph name="LINK_BEGIN" />ស្វែងយល់បន្ថែម<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ស្វែងរកដោយប្រើការស្វែងរករូបភាព</translation>
<translation id="1863308913976887472">គេហទំព័រអាច​រក្សាទុក​ព័ត៌មានជាមួយ Decentr អំពីចំណាប់អារម្មណ៍​របស់អ្នក។ ឧទាហរណ៍ ប្រសិនបើអ្នក​ចូលមើល​គេហទំព័រ ដើម្បីទិញស្បែកជើង​សម្រាប់រត់ម៉ារ៉ាតុង នោះគេហទំព័រនោះ​ប្រហែលជាកំណត់​ចំណាប់អារម្មណ៍​របស់អ្នក​ថាជាការរត់ម៉ារ៉ាតុង។ ក្រោយមកទៀត ប្រសិនបើអ្នកចូលមើល​គេហទំព័រផ្សេង ដើម្បីចុះឈ្មោះ​ចូលរួមការប្រណាំង គេហទំព័រនោះ​អាចបង្ហាញ​ការផ្សាយពាណិជ្ជកម្ម​អំពីស្បែកជើងសម្រាប់​រត់ប្រណាំងដល់អ្នក ដោយផ្អែកលើ​ចំណាប់អារម្មណ៍​របស់អ្នក។</translation>
<translation id="1880677175115548835">ជ្រើសរើស​អត្ថបទ</translation>
<translation id="1881322772814446296">អ្នកកំពុងចូលជាមួយគណនីដែលបានគ្រប់គ្រង ហើយផ្តល់ឲ្យអ្នកគ្រប់គ្រងនូវការគ្រប់គ្រងលើទម្រង់ Decentr របស់អ្នក។ ទិន្នន័យ Decentr របស់អ្នក ដូចជាកម្មវិធី គេហទំព័រ ប្រវត្តិ ពាក្យសម្ងាត់ និងការកំណត់ផ្សេងទៀតរបស់អ្នកនឹងភ្ជាប់ជាមួយ <ph name="USER_NAME" /> ជាអចិន្ត្រៃយ៍។ អ្នកនឹងអាចលុបទិន្នន័យនេះតាមរយៈ Google Accounts Dashboard ប៉ុន្តែអ្នកនឹងមិនអាចភ្ជាប់ទិន្នន័យនេះជាមួយគណនីដ៏ទៃទៀតឡើយ។ ជាជម្រើស អ្នកអាចបង្កើតទម្រង់ថ្មីដើម្បីរក្សាទិន្នន័យ Decentr ដែលមានស្រាប់របស់អ្នកដាច់ដោយឡែក។ <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Decentr សន្សំ​ថាមពល​ថ្ម​ដោយ​ដាក់កំហិត​សកម្មភាព​ផ្ទៃខាងក្រោយ និង​បែបផែន​ដែលមើលឃើញ ដូចជា​ការរំកិលយ៉ាងរលូន និង​អត្រាហ្វ្រេមវីដេអូជាដើម។ <ph name="BEGIN_LINK" />ស្វែងយល់​បន្ថែមអំពី​មុខងារសន្សំសំចៃថាមពល<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">សេវាកម្មកម្មវិធីដំឡើងកំណែ Decentr</translation>
<translation id="1911763535808217981">ប្រសិនបើ​បិទ​មុខងារនេះ មានន័យ​ថាអ្នក​អាចចូល​គេហទំព័រផ្សេងៗ​របស់ Google ដូចជា Gmail ដោយមិន​ចាំបាច់ចូល Decentr នោះទេ</translation>
<translation id="1916451563296275579">ដក​ទិន្នន័យ​កម្មវិធីនេះ​ចេញពី Decentr</translation>
<translation id="1929939181775079593">Decentr មិនឆ្លើយតប។ បើកដំណើរការឡើងវិញឥឡូវនេះ?</translation>
<translation id="1933341829955786215">ស្ថាប័ន <ph name="MANAGER" /> របស់អ្នកតម្រូវឱ្យអ្នក​ចូលគណនី Decentr</translation>
<translation id="193439633299369377">DecentrOS ត្រូវការចាប់ផ្ដើមឡើងវិញ ដើម្បីប្រើកំណែថ្មី។</translation>
<translation id="1951406923938785464">Decentr បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ប្រភេទ​ឯកសារនេះ​មិនត្រូវបាន​ទាញយក​ជាទូទៅទេ ហើយវាអាច​បង្កគ្រោះថ្នាក់</translation>
