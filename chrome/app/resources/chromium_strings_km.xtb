<translation id="6366160072964553914">Decentr បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារនេះ​មិនត្រូវបាន​ទាញយក​ជាទូទៅទេ ហើយវាអាច​បង្កគ្រោះថ្នាក់</translation>
<translation id="6373523479360886564">តើអ្នកប្រាកដថាចង់លុបការតំឡើង Decentr ទេ?</translation>
<translation id="6375219077595103062">បញ្ចូល​ផ្លូវកាត់​ទៅកាន់​កម្មវិធីគ្រប់គ្រង​ពាក្យសម្ងាត់</translation>
<translation id="6390800440335263989">ដើម្បី​បន្ត សូម​ចូលគណនី Decentr ជា <ph name="EMAIL" />។ ការធ្វើបែបនេះ​ធានាថា អ្នកគោរពតាម​គោលការណ៍​របស់ស្ថាប័ន​អ្នក។</translation>
<translation id="6400112897226594999">រូបសញ្ញា Decentr នៅក្នុង​អេក្រង់​កុំព្យូទ័រ។</translation>
<translation id="6403826409255603130">Decentr គឺជាកម្មវិធីរុករកអ៊ីនធឺណិត ដែលដំណើរការគេហទំព័រ និងកម្មវិធីបានយ៉ាងរហ័សបំផុត។ វាលឿន មានស្ថេរភាព និងងាយស្រួលប្រើ។ រុករកគេហទំព័រប្រកបដោយសុវត្ថិភាពជាមួយការពារពីមេរោគ និងការលួចឆ្មក់យកទិន្នន័យដែលភ្ជាប់នៅក្នុង Decentr។</translation>
<translation id="6436260184216827876">មិនអាចប្រើការស្វែងរករូបភាពបានទេ។ សូមព្យាយាមម្ដងទៀតនៅពេលក្រោយ។</translation>
