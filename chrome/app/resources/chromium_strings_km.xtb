<translation id="6539122709674868420">ស្ថាប័ន​របស់អ្នក​បិទ Decentr នៅពេលដែល​មិនប្រើប្រាស់វា​រយៈពេល <ph name="TIMEOUT_DURATION" />។ ទិន្នន័យរុករក​ត្រូវបាន​លុប។ ទិន្នន័យ​នេះ​អាច​រួមមាន​ប្រវត្តិ ការ​បំពេញស្វ័យប្រវត្តិ និង​ការទាញ​យក។</translation>
<translation id="6542839706527980775">កម្រងព័ត៌មាននីមួយៗមានព័ត៌មាន Decentr របស់វាផ្ទាល់ដូចជា ចំណាំ ប្រវត្តិ ពាក្យ​សម្ងាត់ និងអ្វីៗជាច្រើនទៀត</translation>
<translation id="6563921047760808519">ស្វែងយល់​បន្ថែម​អំពី<ph name="BEGIN_LINK" />របៀបដែល Decentr រក្សាទិន្នន័យ​របស់អ្នក​ជាលក្ខណៈ​ឯកជន<ph name="END_LINK" /></translation>
<translation id="6564039629497156115">ការផ្លាស់ប្ដូរ​ចំពោះ​ការកំណត់នេះ​នឹង​ត្រូវបាន​អនុវត្ត​បន្ទាប់ពី Decentr ចាប់ផ្ដើម​ឡើងវិញ។</translation>
<translation id="656935081669708576">អ្នកអាចប្ដូរ ដើម្បីមើល​ពាក្យសម្ងាត់​ពីកម្រងព័ត៌មាន Decentr ផ្សេងទៀត</translation>
<translation id="6570579332384693436">ដើម្បី​កែ​កំហុសអក្ខរាវិរុទ្ធ​, Decentr ផ្ញើ​អក្សរ​ដែលអ្នក​វាយបញ្ចូល​នៅក្នុង​កន្លែង​បញ្ចូលអក្សរ​ទៅ Decentr</translation>
<translation id="6598877126913850652">ចូលទៅ​កាន់ការ​កំណត់​ការជូន​ដំណឹង Decentr</translation>
<translation id="6600016381025017075">ស្វែងរកអ្វីមួយនៅលើទំព័រនេះ</translation>
