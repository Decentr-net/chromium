<translation id="9090566250983691233">‏tomi کے کچھ فائلز کو مسدود کرنے کی وجہ جانیں</translation>
<translation id="911206726377975832">نیز آپ کا براؤزنگ ڈیٹا حذف کریں؟</translation>
<translation id="9138603949443464873">‏اپنی تبدیلیوں کو لاگو کرنے کیلئے، tomi کو دوبارہ شروع کریں</translation>
<translation id="9195993889682885387">‏tomi گزشتہ کچھ ہفتوں کی آپ کی براؤزنگ کی سرگزشت کی بنیاد پر آپ کی دلچسپیوں کا اندازہ لگا سکتا ہے۔ یہ معلومات آپ کے آلے پر برقرار رہتی ہے۔</translation>
<translation id="919706545465235479">‏مطابقت پذیری شروع کرنے کیلئے tomi کو اپ ڈیٹ کریں</translation>
<translation id="922152298093051471">‏tomi کو حسب ضرورت بنائیں</translation>
<translation id="92460355979482493">‏آن ہونے پر، tomi صفحات کو پہلے سے لوڈ کرتا ہے جو براؤزنگ اور تلاش کو تیز تر بناتا ہے۔</translation>
<translation id="93760716455950538">‏tomiOS Flex ری سٹارٹ کریں</translation>
<translation id="940313311831216333">‏اپنے تمام آلات پر اپنی tomi کی چیزوں تک رسائی حاصل کرنے کیلئے، سائن ان کریں اور پھر مطابقت پذیری کو آن کریں۔</translation>
<translation id="943390475793766444">‏tomi اس فائل کو اسکین کرنے کی تجویز کرتا ہے کیونکہ یہ خطرناک ہو سکتی ہے۔</translation>
<translation id="963650557422347554">‏آن ہونے پر، tomi پس منظر کی سرگرمی اور ویژوئل اثرات، جیسے ہموار اسکرولنگ اور ویڈیو فریم ریٹس کو محدود کر کے بیٹری پاور کو محفوظ کرتا ہے۔</translation>
<translation id="983803489796659991">انسٹالیشن ناکام ہو گئی کیونکہ اپ ڈیٹ سرور کے پاس ایپلیکیشن کے لیے کوئی ہیش ڈیٹا نہیں ہے۔</translation>
<translation id="989369509083708165">‏tomi آپ کا ڈیفالٹ براؤزر ہے</translation>
<translation id="989816563149873169">‏<ph name="SHORTCUT" /> سے tomi پروفائلز کے درمیان میں سوئچ کیا جا سکتا ہے</translation>
</translationbundle>