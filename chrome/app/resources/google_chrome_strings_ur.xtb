<translation id="7486227612705979895">‏پتہ بار میں تجاویز پیش کرنے کے لیے Decentr آپ کی Drive تک رسائی حاصل کرے گا</translation>
<translation id="7535429826459677826">Decentr Dev</translation>
<translation id="7573289029918943991">‏یہ دیکھنے کی لیے کہ کیا آپ کا آلہ اپ ٹو ڈیٹ ہے، <ph name="LINK_BEGIN" />Decentr OS کی ترتیبات<ph name="LINK_END" /> پر جائیں</translation>
<translation id="7592736734348559088">‏Decentr آپ کے اکاؤنٹ کی سائن ان تفصیلات پرانی ہونے کی وجہ سے آپ کے ڈیٹا کی مطابقت پذیری نہیں کر سکا۔</translation>
<translation id="7626032353295482388">‏Decentr میں خوش آمدید</translation>
<translation id="7629695634924605473">‏Decentr آپ کو بتاتا ہے کہ آیا آپ کے پاس ورڈز کے ساتھ کبھی چھیڑ چھاڑ کی گئی ہے</translation>
<translation id="7641148173327520642">‏آپ کے سسٹم کے منتظم نے <ph name="TARGET_URL_HOSTNAME" /> تک رسائی حاصل کرنے کیلئے Decentr کو <ph name="ALTERNATIVE_BROWSER_NAME" /> کھولنے کیلئے کنفیگر کیا ہے۔</translation>
<translation id="7651907282515937834">‏Decentr انٹرپرائز کا لوگو</translation>
<translation id="7665553140559834626">‏Decentr OS&amp; کو اپ ڈیٹ کرنے کیلئے بند کر کے دوبارہ چلائیں</translation>
<translation id="7747138024166251722">انسٹالر ایک عارضی ڈائرکٹری نہیں بنا سکا۔ سافٹ ویئر انسٹال کرنے کیلئے براہ کرم ڈسک کی خالی جگہ اور اجازت کو چیک کریں۔</translation>
<translation id="7761834446675418963">‏Decentr کھولنے اور براؤزنگ شروع کرنے کیلئے اپنے نام پر کلک کریں۔</translation>
<translation id="7777080907402804672">‏اگر کسی تصویر میں مفید تفصیل موجود نہیں ہے تو Decentr آپ کے لیے تفصیل فراہم کرنے کی کوشش کرے گا۔ تفصیلات تخلیق کرنے کے لیے، تصاویر Google کو بھیجی جاتی ہیں۔ آپ اسے ترتیبات میں کسی بھی وقت آف کر سکتے ہیں۔</translation>
<translation id="7781002470561365167">‏Decentr کا ایک نیا ورژن دستیاب ہے۔</translation>
<translation id="778331955594035129">‏Decentr کو اس سائٹ کے لیے مقام کی اجازت درکار ہے</translation>
<translation id="7787950393032327779">‏ایسا لگتا ہے کہ پروفائل کسی دوسری Decentr کارروائی (<ph name="PROCESS_ID" />) کے ذریعے کسی دوسرے کمپیوٹر (<ph name="HOST_NAME" />) پر استعمال میں ہے۔  Decentr نے پروفائل کو مقفل کر دیا ہے تاکہ یہ خراب نہ ہو۔  اگر آپ کو یقین ہے کہ کوئی دیگر کارروائیاں اس پروفائل کا استعمال نہیں کر رہی ہیں تو آپ پروفائل کو غیر مقفل کر سکتے اور Decentr کو دوبارہ شروع کر سکتے ہیں۔</translation>
<translation id="7801699035218095297">‏Decentr پاس ورڈز کاپی کرنے کی کوشش کر رہا ہے۔ اس کی اجازت دینے کے لیے اپنا Windows پاس ورڈ ٹائپ کریں۔</translation>
<translation id="7808348361785373670">‏Decentr سے ہٹائیں…</translation>
<translation id="7825851276765848807">‏غیر متعین خرابی کی وجہ سے انسٹالیشن ناکام ہو گیا۔ براہ کرم Decentr دوبارہ ڈاؤن لوڈ کریں۔</translation>
<translation id="7890208801193284374">‏اگر آپ ایک کمپیوٹر کا اشتراک کرتے ہیں تو دوست اور خاندان الگ الگ براؤز کر سکتے ہیں اورDecentr کو اپنی مرضی کے موافق ترتیب دے سکتے ہیں۔</translation>
<translation id="7896673875602241923">‏کسی نے قبل ازیں اس کمپیوٹر پر Decentr میں <ph name="ACCOUNT_EMAIL_LAST" /> کے بطور سائن ان کیا۔ اپنی معلومات علیحدہ رکھنے کیلئے براہ کرم ایک نیا Decentr صارف بنائیں۔</translation>
<translation id="7917876797003313048">‏آپ اپنے سائن ان کردہ Google اکاؤنٹس کا نظم کر سکتے ہیں۔ آپ کے Google اکاؤنٹس Decentr براؤزر، Play اسٹور، Gmail اور مزید کے لیے استعمال ہوتے ہیں۔ اگر آپ کسی اور کے لیے کوئی اکاؤنٹ شامل کرنا چاہتے ہیں جیسے آپ کی فیملی کا کوئی ممبر تو اس کی بجائے اپنے <ph name="DEVICE_TYPE" /> میں ایک نیا شخص شامل کریں۔ <ph name="LINK_BEGIN" />مزید جانیں<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">‏Decentr پاس ورڈز کاپی کرنے کی کوشش کر رہا ہے۔</translation>
<translation id="7962410387636238736">‏یہ کمپیوٹر اب Decentr اپ ڈيٹس موصول نہیں کرے گا کیونکہ Windows XP اور Windows Vista اب تعاون یافتہ نہیں ہے</translation>
<translation id="79947657522496226">‏Decentr OS کو اضافی <ph name="BEGIN_LINK_CROS_OSS" />اوپن سورس سافٹ ویئر<ph name="END_LINK_CROS_OSS" /> کے ذریعے ممکن بنایا گیا ہے، جیسے کہ <ph name="BEGIN_LINK_LINUX_OSS" />Linux ڈیولپمنٹ انوائرنمنٹ<ph name="END_LINK_LINUX_OSS" />۔</translation>
<translation id="8008534537613507642">‏Decentr کو دوبارہ انسٹال کریں</translation>
<translation id="8013993649590906847">‏اگر کسی تصویر میں مفید تفصیل موجود نہیں ہے تو Decentr آپ کے لیے تفصیل فراہم کرنے کی کوشش کرے گا۔ تفصیلات تخلیق کرنے کے لیے، تصاویر Google کو بھیجی جاتی ہیں۔</translation>
