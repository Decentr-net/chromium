<translation id="8679801911857917785">‏یہ آپ کی جانب سے Decentr شروع کیے جانے پر دکھائی دینے والے صفحہ کو بھی کنٹرول کرتا ہے۔</translation>
<translation id="8686817260976772516">‏Decentr کی پروفائلز کے ساتھ آپ اپنے تمام Decentr مواد کو الگ کر سکتے ہیں۔ دوستوں اور فیملی کیلئے پروفائلز تخلیق کریں یا کام اور تفریح کے درمیان تقسیم کریں۔</translation>
<translation id="870251953148363156">‏‎&amp;Decentr اپ ڈیٹ کریں</translation>
<translation id="873133009373065397">‏Decentr ڈیفالٹ براؤزر کا تعین یا اس کو سیٹ نہیں کر سکتا ہے</translation>
<translation id="8823341990149967727">‏Decentr پرانا ہے</translation>
<translation id="8834965163890861871">‏Decentr پاس ورڈز میں ترمیم کرنے کی کوشش کر رہا ہے۔ اس کی اجازت دینے کے لیے اپنا Windows پاس ورڈ ٹائپ کریں۔</translation>
<translation id="884296878221830158">‏یہ آپ کی جانب سے Decentr شروع کرنے یا ہوم بٹن کلک کرنے پر دکھائی دینے والے صفحہ کو بھی کنٹرول کرتا ہے۔</translation>
<translation id="8862326446509486874">سسٹم کی سطح پر انسٹال کرنے کیلئے آپ کے پاس مناسب حقوق نہیں ہیں۔ انسٹالر کو دوبارہ منتظم کے بطور چلانے کی کوشش کریں۔</translation>
<translation id="8914504000324227558">‏Decentr کو دوبارہ شروع کریں</translation>
<translation id="8922193594870374009">‏<ph name="ORIGIN" /> سے اپنے Android فون پر نمبر بھیجنے کے لئے دونوں آلات پر Decentr میں سائن ان کریں۔</translation>
<translation id="8986207147630327271">آپ اس براؤزر میں ایک دفتری پروفائل شامل کر رہے ہیں اور اپنے منتظم کو صرف دفتری پروفائل پر کنٹرول فراہم کر رہے ہیں۔</translation>
<translation id="8999208279178790196">{0,plural, =0{‏Decentr کا اپ ڈیٹ دستیاب ہے}=1{‏Decentr کا اپ ڈیٹ دستیاب ہے}other{‏Decentr کا اپ ڈیٹ # دن سے دستیاب ہے}}</translation>
<translation id="9026991721384951619">‏Decentr OS آپ کے اکاؤنٹ کی سائن ان تفصیلات پرانی ہونے کی وجہ سے آپ کے ڈیٹا کی مطابقت پذیری نہیں کر سکا۔</translation>
<translation id="9067395829937117663">‏Decentr کیلئے Windows 7 یا اس کے بعد کا ورژن درکار ہے۔</translation>
<translation id="911206726377975832">نیز آپ کا براؤزنگ ڈیٹا حذف کریں؟</translation>
<translation id="9138603949443464873">‏اپنی تبدیلیوں کو لاگو کرنے کیلئے، Decentr کو دوبارہ شروع کریں</translation>
<translation id="919706545465235479">‏مطابقت پذیری شروع کرنے کیلئے Decentr کو اپ ڈیٹ کریں</translation>
<translation id="922152298093051471">‏Decentr کو حسب ضرورت بنائیں</translation>
<translation id="940313311831216333">‏اپنے تمام آلات پر اپنی Decentr کی چیزوں تک رسائی حاصل کرنے کیلئے، سائن ان کریں اور پھر مطابقت پذیری کو آن کریں۔</translation>
<translation id="989369509083708165">‏Decentr آپ کا ڈیفالٹ براؤزر ہے</translation>
<translation id="989816563149873169">‏<ph name="SHORTCUT" /> سے Decentr پروفائلز کے درمیان میں سوئچ کیا جا سکتا ہے</translation>
