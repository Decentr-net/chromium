<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1065672644894730302">તમારી પસંદગીઓને વાંચી શકાતી નથી.

કેટલીક સુવિધાઓ ઉપલબ્ધ હોઈ શકે છે અને પસંદગીઓ પરના ફેરફારોને સાચવવામાં આવશે નહીં.</translation>
<translation id="1098170124587656448">Decentr તમને ડેટા ઉલ્લંઘન, ખરાબ એક્સ્ટેંશન અને બીજી ઘણી બાબતોથી સુરક્ષિત રાખી શકે છે</translation>
<translation id="1104942323762546749">Decentr તમારા પાસવર્ડની નિકાસ કરવા માગે છે. આને મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="113122355610423240">Decentr તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="1131805035311359397">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK" />Decentriumમાં સાઇન ઇન કરો<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">Decentr વિશે</translation>
<translation id="1315551408014407711">તમારી નવી Decentr પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="1396446129537741364">Decentr પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="1414495520565016063">તમે Decentr માં સાઇન ઇન કર્યું છે!</translation>
<translation id="151962892725702025">Decentr OS તમારા ડેટાને સિંક કરી શક્યું નથી, કારણ કે તમારા ડોમેન માટે સિંક ઉપલબ્ધ નથી.</translation>
<translation id="1524282610922162960">Decentr ટૅબ શેર કરો</translation>
<translation id="1553461853655228091">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Decentrને તમારા કૅમેરાના ઍક્સેસની પરવાનગી જરૂરી છે</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે તમે Decentrને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે}=1{અપડેટ લાગુ કરવા માટે તમે Decentrને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે તમે Decentrને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે તમે Decentrને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="1667812772085710766">તમે જ્યારે Decentr બંધ કરો, ત્યારે તે ઑટોમૅટિક રીતે કુકી અને તમે મુલાકાત લીધેલા પેજમાંના સાઇટનો ડેટા સાફ કરે છે</translation>
<translation id="1708666629004767631">Decentrનું નવું, સુરક્ષિત વર્ઝન ઉપલબ્ધ છે.</translation>
<translation id="1774152462503052664">Decentr ને પૃષ્ઠભૂમિમાં ચાલવા દો</translation>
<translation id="1779356040007214683">Decentr ને સુરક્ષિત બનાવવા માટે, અમે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યાં હોઈ શકે છે તેવા કેટલાક એક્સ્ટેન્શન્સને અક્ષમ કર્યા છે.</translation>
<translation id="1808667845054772817">Decentr ફરીથી ઇન્સ્ટોલ કરો</translation>
<translation id="185970820835152459">તમે તમારા સાઇન ઇન કરેલા હોય એવા Google એકાઉન્ટ મેનેજ કરી શકો છો. તમારા Google એકાઉન્ટનો ઉપયોગ Decentr બ્રાઉઝર, Play Store, Gmail અને વધુ માટે થાય છે. જો તમે કોઈ બીજા, જેમકે તમારા કુટુંબના સભ્ય માટે એકાઉન્ટ ઉમેરવા માંગતા હો, તો તેના બદલે નવી વ્યક્તિને તમારા <ph name="DEVICE_TYPE" />માં ઉમેરો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="1881322772814446296">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Decentr પ્રોફાઇલ પર એનું એડમિન નિયંત્રણ આપી રહ્યાં છો. તમારો Decentr ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" /> થી બંધાયેલ રહેશે. તમે Google એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને કાઢી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહિ. તમે અસ્તિત્વમાં છે તે Decentr ડેટાને અલગ રાખવા માટે વૈકલ્પિક રૂપે એક નવી પ્રોફાઇલ બનાવી શકો છો. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">આને બંધ કરવાથી, તમે Decentrમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Googleની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="1929939181775079593">Decentr પ્રતિસાદ આપતું નથી. હવે ફરીથી લોંચ કરીએ?</translation>
<translation id="1966382378801805537">Decentr ડિફૉલ્ટ બ્રાઉઝરને નિર્ધારિત અથવા સેટ કરી શકતું નથી</translation>
<translation id="1981611865800294956">&amp;Decentr OS અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="2008474315282236005">આ, 1 આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Decentr માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2020032459870799438">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા અન્ય પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK" />Decentrમાં સાઇન ઇન કરો<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">Decentr કસ્ટમાઇઝ કરો</translation>
<translation id="2185166961232948079">Decentr - નેટવર્ક સાઇન ઇન - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">જો તમે કમ્પ્યુટરને શેર કરો છો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી અને તેમને જોઇએ તેમ Decentr ને સેટ કરી શકે છે.</translation>
<translation id="2294245788148774212">વૈકલ્પિક: Googleને નિદાન અને વપરાશ ડેટા ઑટોમૅટિક રીતે મોકલીને Decentr OSની સુવિધાઓ અને કાર્યપ્રદર્શનને સુધારવામાં સહાય કરો.</translation>
<translation id="2343156876103232566">અહીંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Decentrમાં સાઇન ઇન કરો.</translation>
<translation id="2347108572062610441">જ્યારે તમે Decentr શરૂ કરો છો ત્યારે જે પૃષ્ઠ દર્શાવવામાં આવે છે તે આ એક્સટેન્શને બદલ્યું છે.</translation>
<translation id="2396765026452590966">જ્યારે તમે Decentr શરૂ કરો છો ત્યારે જે પૃષ્ઠ દર્શાવવામાં આવે છે તે <ph name="EXTENSION_NAME" /> એક્સટેન્શને બદલ્યું છે.</translation>
<translation id="2401032172288869980">આ સાઇટ માટે Decentrને કૅમેરા અને માઇક્રોફોનની પરવાનગીઓની જરૂર છે</translation>
<translation id="2483889755041906834">Decentr માં</translation>
<translation id="2485422356828889247">અનઇન્સ્ટૉલ કરો</translation>
<translation id="2535480412977113886">તમારી એકાઉન્ટ સાઇન ઇન વિગતો જૂની હોવાને કારણે Decentr OS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="2560420686485554789">ફાઇલો ડાઉનલોડ કરવા માટે Decentrને સ્ટોરેજના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="2572494885440352020">Decentr હેલ્પર</translation>
<translation id="2577788541081224677">Decentr પરની તમારી વસ્તુઓને તમારા બધા ડિવાઇસ પર ઍક્સેસ કરવા માટે સાઇન ઇન કરો, જેથી તમે સિંક કરવાની સુવિધા ચાલુ કરી શકો.</translation>
<translation id="2583187216237139145">આ પ્રોફાઇલના ઉપયોગ (જેમકે બુકમાર્ક, ઇતિહાસ, પાસવર્ડ બનાવવા અને અન્ય સેટિંગ ગોઠવવા) દરમિયાન જનરેટ થયેલા કોઈપણ Decentr ડેટાને ઑફિસની પ્રોફાઇલના વ્યવસ્થાપક કાઢી નાખી શકે છે. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">અપડેટ લાગુ કરવા માટે Decentr OSને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="2614883797045469742">મોટા ભાગના લોકો માટે ડિફૉલ્ટ સેટિંગ કામ કરે છે, પરંતુ તમે Decentrનો ઉપયોગ જે રીતે કરવા માગતા હો, એ પ્રમાણે તમે તેમને કસ્ટમાઇઝ કરી શકો છો</translation>
<translation id="2648074677641340862">ઇન્સ્ટૉલેશન દરમિયાન ઓપરેટિંગ સિસ્ટમ ભૂલ આવી. કૃપા કરીને ફરીથી Decentr ડાઉનલોડ કરો.</translation>
<translation id="2661879430930417727">જો તમે ડિવાઇસ શેર કરતા હો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેઓ તેમને જોઈએ તે પ્રમાણે Decentrનું સેટઅપ કરી શકે છે</translation>
<translation id="2711502716910134313">Decentr ટૅબ</translation>
<translation id="2718390899429598676">ઉમેરેલી સુરક્ષા માટે, Decentr તમારા ડેટાને એન્ક્રિપ્ટ કરશે.</translation>
<translation id="2770231113462710648">ડિફૉલ્ટ બ્રાઉઝરને આના પર બદલો:</translation>
<translation id="2799223571221894425">ફરીથી લોંચ કરો</translation>
<translation id="2837693172913560447">આને લીધે <ph name="USER_EMAIL_ADDRESS" /> માટે નવી Decentr પ્રોફાઇલ બનશે</translation>
<translation id="2847479871509788944">Decentr માંથી દૂર કરો...</translation>
<translation id="2885378588091291677">કાર્ય વ્યવસ્થાપક</translation>
<translation id="2910007522516064972">&amp;Decentr વિશે</translation>
<translation id="2977470724722393594">Decentr અપ ટૂ ડેટ છે</translation>
<translation id="2983934633046890458">Decentr પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે.</translation>
<translation id="3032706164202344641">Decentr તમારા પાસવર્ડ ચેક કરી શકતું નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="3032787606318309379">Decentr માં ઉમેરી રહ્યું છે...</translation>
<translation id="3068515742935458733">ક્રૅશ રિપોર્ટ અને <ph name="UMA_LINK" /> Googleને મોકલીને Decentr ને વધુ સારું બનાવવામાં મદદ કરો.</translation>
<translation id="3103660991484857065">ઇન્સ્ટૉલર આર્કાઇવને અનકોમ્પ્રેસ કરવામાં નિષ્ફળ. કૃપા કરીને Decentr ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="3130323860337406239">Decentr તમારા માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="3155163173539279776">Decentr ને ફરીથી લોંચ કરો</translation>
<translation id="3179665906251668410">Decentr છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="3185330573522821672">તમારી નવી Decentr પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="3190315855212034486">ઓહ! Decentr ક્રેશ થઈ ગયું. હમણાં ફરીથી લોંચ કરીએ?</translation>
<translation id="3229526316128325841">Decentr તમારા પાસવર્ડની નિકાસ કરવા માગે છે.</translation>
<translation id="3258596308407688501">Decentr એની ડેટા ડિરેક્ટરી વાંચી અથવા લખી શકતુંં નથી:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">Decentrનું <ph name="PRODUCT_VERSION" /> વર્ઝન ઇન્સ્ટૉલ કરવામાં આવેલું છે</translation>
<translation id="328888136576916638">Google API કીઝ ખૂટે છે. Decentr ની કેટલીક કાર્યક્ષમતા અક્ષમ થશે.</translation>
<translation id="3296368748942286671">જ્યારે Decentr બંધ થાય ત્યારે પૃષ્ઠભૂમિ ઍપ્લિકેશનો ચલાવવાનું ચાલુ રાખો</translation>
<translation id="331951419404882060">સાઇન ઇનમાં ભૂલ આવવાને કારણે Decentr તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="3349211344363550267">Decentr સુઝાવ આપે છે કે તમે આ ફાઇલને ડાઉનલોડ કરશો નહીં કે ખોલશો નહીં</translation>
<translation id="3350761136195634146">આ એકાઉન્ટ સાથેની Decentr પ્રોફાઇલ પહેલેથી અસ્તિત્વમાં છે</translation>
<translation id="3406848076815591792">વર્તમાન Decentr પ્રોફાઇલ પર સ્વિચ કરીએ?</translation>
<translation id="3430503420100763906">Decentr પ્રોફાઇલ વડે તમે તમારી બધી વસ્તુઓ Decentr પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="347328004046849135">જ્યારે તમે ચેડાં કરવામાં આવેલા પાસવર્ડ વડે સાઇન ઇન કરશો ત્યારે Decentr તમને સૂચિત કરશે</translation>
<translation id="3474745554856756813">આ, <ph name="ITEMS_COUNT" /> આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Decentr માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> વડે એક Decentr પ્રોફાઇલથી બીજી Decentr પ્રોફાઇલ પર સ્વિચ કરી શકાય છે</translation>
<translation id="3509308970982693815">કૃપા કરીને બધી Decentr વિંડોઝ બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="3575459661164320785">તમારા કમ્પ્યુટરમાં નુકસાનકારક સૉફ્ટવેર છે. Decentr તે કાઢી શકે છે, તમારું સેટિંગ પાછું મેળવી શકે છે અને એક્સ્ટેંશન બંધ કરી શકે છે જેથી તમારું બ્રાઉઝર ફરી સામાન્ય રીતે કામ કરી શકે.</translation>
<translation id="3639635944603682591">આ વ્યક્તિનો બ્રાઉઝિંગ ડેટા આ ડિવાઇસમાંથી ડિલીટ કરવામાં આવશે. આ ડેટા પાછો મેળવવા માટે, Decentrમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Decentr માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે.}=1{Decentr માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{Decentr માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{Decentr માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="3651803019964686660"><ph name="ORIGIN" />માંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Decentrમાં સાઇન ઇન કરો.</translation>
<translation id="3685209450716071127">Decentr તમારા પાસવર્ડ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{આ અપડેટ લાગુ કરવા માટે Decentr ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે}=1{આ અપડેટ લાગુ કરવા માટે Decentr ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{આ અપડેટ લાગુ કરવા માટે Decentr ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{આ અપડેટ લાગુ કરવા માટે Decentr ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="3713809861844741608">નવા Decentr &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="3728336900324680424">ઍડ્રેસ બારમાં સૂચનો કરવા માટે, Decentr તમારી ડ્રાઇવને ઍક્સેસ કરશે</translation>
<translation id="378917192836375108">Decentr થી તમે વેબ પર એક ફોન નંબર પર ક્લિક કરી શકો છો અને તેને Skype થી કૉલ કરી શકો છો!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="388648406173476553">Decentrને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. તમારે ક્યાંક ધ્યાન આપવાની જરૂર છે - વિગતો માટે ક્લિક કરો.</translation>
<translation id="3889543394854987837">Decentr ને ખોલવા માટે તમારા નામને ક્લિક કરો અને બ્રાઉઝ કરવાનું પ્રારંભ કરો.</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> આ Decentr પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, Decentr તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="3945058413678539331">Decentr પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />વર્તમાન સેટિંગ<ph name="END_LINK" />ની જાણ કરીને Decentrને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="4050175100176540509">નવીનતમ વર્ઝનમાં મહત્ત્વપૂર્ણ સુરક્ષા સુધારણાઓ અને નવી સુવિધાઓ ઉપલબ્ધ છે.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન - Decentr</translation>
<translation id="421369550622382712">Decentr માટે શ્રેષ્ઠ એપ્લીકેશન્સ, રમતો, એક્સટેન્શન્સ અને થીમ્સ શોધો.</translation>
<translation id="4216212958613226427">આ ભાષાનો ઉપયોગ Decentr UI પ્રદર્શિત કરવા માટે થાય છે</translation>
<translation id="4230135487732243613">તમારા Decentr ડેટાને આ એકાઉન્ટ સાથે લિંક કરીએ?</translation>
<translation id="4264410486868823224">આ ડિવાઇસનો ઉપયોગ કરતા પહેલાં <ph name="MANAGER" />ને નીચે સેવાની શરતોને વાંચવાની અને સ્વીકારવાની જરૂર છે. આ શરતો Decentr OSની શરતોને વિસ્તૃત, તેમાં ફેરફાર અથવા મર્યાદિત કરતી નથી.</translation>
<translation id="4271805377592243930">Decentr સાથે સહાય મેળવો</translation>
<translation id="4285930937574705105">અમઉલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ થયું. જો Decentr હાલમાં ચાલી રહ્યું હોય, તો તેને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="4407044323746248786">છતાં પણ Decentrમાંથી બહાર નિકળવું છે?</translation>
<translation id="4415566066719264597">Decentrને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="4423735387467980091">Decentr ને કસ્ટમાઇઝ અને નિયંત્રિત કરો</translation>
<translation id="452711251841752011">Decentr પર આપનું સ્વાગત છે; નવી બ્રાઉઝર વિન્ડો ખોલી છે</translation>
<translation id="4544142686420020088">કંઈક ખોટુ થયું હોવાને કારણે Decentr અપડેટ થયું નથી. <ph name="BEGIN_LINK" />Decentr અપડેટ કરવામાં આવતી સમસ્યાઓ અને નિષ્ફળ થયેલા અપડેટ સુધારો.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">નવી Decentr પ્રોફાઇલમાં બ્રાઉઝિંગ ચાલુ રાખીએ?</translation>
<translation id="4567424176335768812">તમે <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન છો. હવે તમે તમારા બધા સાઇન ઇન કરેલા ડિવાઇસ પર તમારા બુકમાર્ક, ઇતિહાસ અને અન્ય સેટિંગને ઍક્સેસ કરી શકો છો.</translation>
<translation id="459535195905078186">Decentr ઍપ્લિકેશનો</translation>
<translation id="4665829708273112819">ચેતવણી: એક્સ્ટેન્શનને તમારો બ્રાઉઝિંગ ઇતિહાસ રેકોર્ડ કરવાથી Decentr અટકાવી શકતું નથી. છૂપા મોડમાં આ એક્સ્ટેન્શનને બંધ કરવા માટે, આ વિકલ્પની પસંદગી નાપસંદ કરો.</translation>
<translation id="4677944499843243528">બીજા કમ્પ્યુટર (<ph name="HOST_NAME" />) પર પ્રોફાઇલ બીજી Decentr પ્રક્રિયા (<ph name="PROCESS_ID" />) દ્વારા ઉપયોગમાં હોય એવું લાગે છે. Decentr એ પ્રોફાઇલને લૉક કરી છે જેથી તે દૂષિત ન થઈ જાય. જો તમને ખાતરી છે કે કોઈ અન્ય પ્રક્રિયાઓ આ પ્રોફાઇલનો ઉપયોગ કરી રહી નથી, તો તમે પ્રોફાઇલને અનલૉક કરી અને Decentr ને ફરીથી લોંચ કરી શકો છો.</translation>
<translation id="469338717132742108">Decentr OS સાથે સહાય મેળવો</translation>
<translation id="4708774505295300557">કોઈએ આ કોમ્પ્યુટર પર પહેલા <ph name="ACCOUNT_EMAIL_LAST" /> તરીકે Decentrમાં સાઇન ઇન કર્યું છે. તમારી માહિતી અલગ રાખવા માટે કૃપા કરીને નવો Decentr વપરાશકર્તા બનાવો.</translation>
<translation id="4746050847053251315">છતાં પણ Decentr બંધ કરવું છે?</translation>
<translation id="4748217263233248895">Decentr માટેનું એક વિશિષ્ટ સુરક્ષા અપડેટ હમણાં જ લાગુ કરવામાં આવ્યું. હવે ફરી શરૂ કરો અને અમે તમારાં ટૅબની પુનઃસ્થાપના કરીશું.</translation>
<translation id="4750035648288509542">લગભગ અપ ટૂ ડેટ છે! અપડેટ કરવાનું સમાપ્ત કરવા માટે Decentr ફરી શરૂ કરો. છૂપી વિંડો ફરીથી ખૂલશે નહીં.</translation>
<translation id="4788777615168560705">Decentr તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરજો અથવા <ph name="BEGIN_LINK" />તમારા Google એકાઉન્ટમાં પાસવર્ડ ચેક કરો<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">આ પણ Google શોધમાં જે જોડણી તપાસનારનો ઉપયોગ થાય છે તેનો જ ઉપયોગ કરે છે. તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Googleને મોકલવામાં આવે છે. તમે સેટિંગમાં આ વર્તણૂકને હંમેશાં બદલી શકો છો.</translation>
<translation id="4888717733111232871">mDNS ટ્રાફિકને મંજૂરી આપવા Decentr માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="4893347770495441059">&amp;Decentr અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="4943838377383847465">Decentr પૃષ્ઠભૂમિ મોડમાં છે.</translation>
<translation id="4987820182225656817">અતિથિઓ કંઈપણ પાછળ છોડ્યાં વિના Decentr નો ઉપયોગ કરી શકે છે.</translation>
<translation id="4994636714258228724">સ્વયંને Decentr માં ઉમેરો</translation>
<translation id="5224391634244552924">કોઈ સાચવેલા પાસવર્ડ નથી. જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Decentr તેને ચેક કરી શકે છે.</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" /> આ Decentr પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. આને લીધે <ph name="USER_EMAIL_ADDRESS" /> માટે નવી Decentr પ્રોફાઇલ બનશે</translation>
<translation id="5277894862589591112">તમારા ફેરફારો લાગુ કરવા માટે, Decentrને ફરી લૉન્ચ કરો</translation>
<translation id="5358375970380395591">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Decentr પ્રોફાઇલ પર એનું એડમિન નિયંત્રણ આપી રહ્યાં છો. તમારો Decentr ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" /> થી બંધાયેલ રહેશે. તમે Google એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને કાઢી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહિ. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Decentr અપડેટ થઈ રહ્યું છે (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Decentrમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="5398878173008909840">Decentrનું નવું વર્ઝન ઉપલબ્ધ છે.</translation>
<translation id="5416696090975899932">જ્યારે બિલ્ટ-ઇન PDF વ્યૂઅર ઉપલબ્ધ ન હોય, ત્યારે Decentr પ્રિન્ટ પ્રીવ્યૂ બતાવી શકાતું નથી.</translation>
<translation id="5427571867875391349">Decentr ને તમારા ડિફોલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Decentr બીટા</translation>
<translation id="5479196819031988440">Decentr OS, આ પેજને ખોલી શકતું નથી.</translation>
<translation id="5480860683791598150">Decentrને આ સાઇટ સાથે તમારું સ્થાન શેર કરવા માટે તમારા સ્થાનના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="549669000822060376">કૃપા કરીને Decentr, નવીનતમ સિસ્ટમ અપડેટ્સ ઇન્સ્ટોલ કરે ત્યાં સુધી રાહ જુઓ.</translation>
<translation id="5496810170689441661">Decentr પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="5527463683072221100">Decentrમાં PDFs ખોલો</translation>
<translation id="5623402015214259806">{0,plural, =0{Decentr અપડેટ ઉપલબ્ધ છે}=1{Decentr અપડેટ ઉપલબ્ધ છે}one{Decentr અપડેટ # દિવસ માટે ઉપલબ્ધ છે}other{Decentr અપડેટ # દિવસ માટે ઉપલબ્ધ છે}}</translation>
<translation id="5634636535844844681">Decentr માટે Windows 7 અથવા તે પછીનું સંસ્કરણ આવશ્યક છે.</translation>
<translation id="5653831366781983928">કૃપા કરીને હવે Decentr ફરી શરૂ કરો</translation>
<translation id="5698481217667032250">આ ભાષામાં Decentr બતાવો</translation>
<translation id="5820394555380036790">Decentr OS</translation>
<translation id="5854740544000584380"><ph name="BEGIN_LINK_LINUX_OSS" />Linux ડેવલપમેન્ટ વાતાવરણ<ph name="END_LINK_LINUX_OSS" />ની જેમ, Decentr OS વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા તૈયાર કરવામાં આવ્યું છે.</translation>
<translation id="5862307444128926510">Decentr માં સ્વાગત છે</translation>
<translation id="5883558403894052917">Decentrને આ આઇટમમાં માલવેર હોવાનું જાણવા મળ્યું છે:</translation>
<translation id="5895138241574237353">પુનઃપ્રારંભ કરો</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન</translation>
<translation id="5987687638152509985">સમન્વયનને પ્રારંભ કરવા માટે Decentr ને અપડેટ કરો</translation>
<translation id="6039377483953237732">Decentr OSનું વર્ઝન</translation>
<translation id="6055895534982063517">Decentrનું એક નવું વર્ઝન ઉપલબ્ધ છે અને તે પહેલાં કરતાંય વધુ ઝડપી છે.</translation>
<translation id="6063093106622310249">અને Decentrમાં ખોલો</translation>
<translation id="6072279588547424923"><ph name="EXTENSION_NAME" />ને Decentrમાં ઉમેરવામાં આવ્યું છે</translation>
<translation id="608006075545470555">આ બ્રાઉઝરમાં ઑફિસની પ્રોફાઇલ ઉમેરો</translation>
<translation id="608189560609172163">સાઇન ઇનમાં ભૂલ આવવાને કારણે Decentr તમારા ડેટાને સમન્વયિત કરી શક્યું નથી.</translation>
<translation id="6096348254544841612">Decentrને કસ્ટમાઇઝ અને નિયંત્રિત કરો. અપડેટ ઉપલબ્ધ છે.</translation>
<translation id="6120345080069858279">Decentr આ પાસવર્ડ તમારા Google એકાઉન્ટમાં સાચવશે. તમારે તેને યાદ રાખવો જરૂરી નથી.</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> જોખમી છે, તેથી Decentr એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="6134968993075716475">Safe Browsingની સુવિધા બંધ છે. Decentr તેને ચાલુ રાખવાનો સુઝાવ આપે છે.</translation>
<translation id="6145820983052037069">તમે અહીં એક Decentr પ્રોફાઇલથી બીજી Decentr પ્રોફાઇલ પર સ્વિચ કરી શકો છો</translation>
<translation id="6183079672144801177">ખાતરી કરો કે તમે તમારા <ph name="TARGET_DEVICE_NAME" /> પર Decentrમાં સાઇન ઇન કર્યું છે અને પછી ફરીથી મોકલવાનો પ્રયાસ કરો.</translation>
<translation id="6212496753309875659">આ કમ્પ્યુટર પર પહેલાંથી જ Decentrનું સૌથી તાજેતરનું વર્ઝન છે. જો સૉફ્ટવેર કાર્ય કરી રહ્યું નથી, તો કૃપા કરીને Decentrને અનઇન્સ્ટૉલ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="6219195342503754812">{0,plural, =0{Decentr હમણાં ફરીથી લૉન્ચ થશે}=1{Decentr 1 સેકન્ડમાં ફરીથી લૉન્ચ થશે}one{Decentr # સેકન્ડમાં ફરીથી લૉન્ચ થશે}other{Decentr # સેકન્ડમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="6241367896540709610">ફાઇલો ડાઉનલોડ કરવા માટે, Decentrને સ્ટોરેજના ઍક્સેસની પરવાનગીની જરૂર છે</translation>
<translation id="6248213926982192922">Decentr ને ડિફોલ્ટ બ્રાઉઝર બનાવો</translation>
<translation id="6266342355635466082">Decentr અપડેટ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="6268381023930128611">Decentrમાંથી સાઇન આઉટ કરીએ?</translation>
<translation id="6281746429495226318">તમારી Decentr પ્રોફાઇલને કસ્ટમાઇઝ કરો</translation>
<translation id="6290827346642914212">તમારી Decentr પ્રોફાઇલને નામ આપો</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> જોખમી હોઈ શકે છે, તેથી Decentr એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="6309712487085796862">Decentr તમારા કેમેરાનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="6333502561965082103">Decentr પર બીજી ક્રિયા ચાલુ છે. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો.</translation>
<translation id="6334986366598267305">હવે તમારા Google એકાઉન્ટ સાથે અને શેર કરેલ કમ્પ્યુટર પર Decentr નો ઉપયોગ કરવો વધુ સરળ છે.</translation>
<translation id="6373523479360886564">શું તમે ખરેખર તમે Decentr ને અનઇન્સ્ટૉલ કરવા માંગો છો?</translation>
<translation id="6403826409255603130">Decentr એ એક એવું વેબ બ્રાઉઝર છે જે પ્રકાશની ગતિએ વેબપૃષ્ઠો અને એપ્લિકેશંસને ચલાવે છે. તે ઝડપી, સ્થિર અને ઉપયોગમાં સરળ છે. Decentr માં નિર્મિત મૉલવેર અને ફિશીંગ સુરક્ષા સાથે વેબને વધુ સુરક્ષિત રૂપે બ્રાઉઝ કરો.</translation>
<translation id="6434250628340475518">Decentr OS સિસ્ટમ</translation>
<translation id="6455857529632101747">Decentr પ્રોફાઇલમાં આપનું સ્વાગત છે</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Decentr 1 સેકન્ડમાં ફરી શરૂ થશે}one{Decentr # સેકન્ડમાં ફરી શરૂ થશે}other{Decentr # સેકન્ડમાં ફરી શરૂ થશે}}</translation>
<translation id="6475912303565314141">જ્યારે તમે Decentr શરૂ કરો ત્યારે કયું પૃષ્ઠ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="6510925080656968729">Decentr ને અનઇન્સ્ટૉલ કરો</translation>
<translation id="6542839706527980775">દરેક પ્રોફાઇલ બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજી ઘણી બાબતો જેવી તેની પોતાની Decentr માહિતી ધરાવે છે</translation>
<translation id="6570579332384693436">જોડણીની ભૂલો સુધારવા માટે, Decentr તમે ટેક્સ્ટ ફીલ્ડમાં ટાઇપ કરો તે ટેક્સ્ટ Googleને મોકલે છે</translation>
<translation id="6598877126913850652">Decentrની નોટિફિકેશનની સેટિંગ પર જાઓ</translation>
<translation id="6613594504749178791">તમારા ફેરફારો તમે આગલી વખતે Decentr ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="665732753414869868">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Decentrને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="6676384891291319759">ઇંટરનેટ ઍક્સેસ કરો</translation>
<translation id="6709350901466051922">આ સાઇટ માટે Decentrને માઇક્રોફોનની પરવાનગીની જરૂર છે</translation>
<translation id="6717134281241384636">તમારી પ્રોફાઇલનો ઉપયોગ કરી શકાતો નથી કારણ કે તે Decentrના નવા વર્ઝન તરફથી છે.

કેટલીક સુવિધાઓ ઉપલબ્ધ થઈ શકે છે. કૃપા કરીને અલગ પ્રોફાઇલ ડિરેક્ટરીનો ઉલ્લેખ કરો અથવા Decentrના નવા વર્ઝનનો ઉપયોગ કરો.</translation>
<translation id="6734080038664603509">&amp;Decentr ને અપડેટ કરો</translation>
<translation id="6734291798041940871">Decentr, તમારા કમ્પ્યુટર પર તમામ વપરાશકર્તાઓ માટે પહેલાંથી ઇન્સ્ટૉલ કરેલ છે.</translation>
<translation id="673636774878526923">Decentr પરની તમારી વસ્તુઓને તમારા બધા ડિવાઇસ પર ઍક્સેસ કરવા માટે, સાઇન ઇન કરો અને પછી સિંક કરવાની સુવિધા ચાલુ કરો.</translation>
<translation id="6774082503108938489">તમારા માતાપિતાએ Decentr માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે. આ <ph name="EXTENSION_TYPE_PARAMETER" /> ચાલુ કરવાની મંજૂરી નથી.</translation>
<translation id="6847869444787758381">Decentr વડે તમે તમારા પાસવર્ડમાં ક્યારેક ચેડાં થાય તો તેના વિશે જાણકારી મેળવી શકો છો</translation>
<translation id="6857782730669500492">Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (Decentr પર કૉપિ કરેલું છે)</translation>
<translation id="6873893289264747459">Decentrને "<ph name="EXTENSION_NAME" />"માં માલવેર હોવાનું જાણવા મળ્યું છે</translation>
<translation id="6893813176749746474">Decentr અપડેટ કરવામાં આવ્યું હતું, પણ તમે તેનો 30 દિવસ સુધી ઉપયોગ કર્યો નથી.</translation>
<translation id="691026815377248078">જોડાણ કરવાનું ચાલુ રાખવા માટે, Decentrને બ્લૂટૂથના ઍક્સેસની 
 જરૂર છે. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">Decentr છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="6978145336957848883">નબળા પાસવર્ડનું અનુમાન કરવું સરળ હોય છે. Decentrને <ph name="BEGIN_LINK" />તમારા માટે સશક્ત પાસવર્ડ બનાવવા અને યાદ રાખવા<ph name="END_LINK" />ની મંજૂરી આપો.</translation>
<translation id="6990124437352146030">Decentrને આ સાઇટ માટે તમારા માઇક્રોફોનના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="705851970750939768">Decentr ને અપડેટ કરો</translation>
<translation id="7067091210845072982">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો Decentr તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Googleને છબીઓ મોકલવામાં આવે છે.</translation>
<translation id="7147279922647361552">Decentrની કેટલીક સૌથી મહત્ત્વપૂર્ણ પ્રાઇવસીની પસંદગીઓ કસ્ટમાઇઝ કરો</translation>
<translation id="718435575166326686">આ સાઇટ માટે Decentrને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="7196312274710523067">Decentr લૉન્ચ કરી શકાયું નથી. ફરી પ્રયાસ કરો.</translation>
<translation id="7197677400338048821">Decentr તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરો.</translation>
<translation id="7223968959479464213">કાર્ય વ્યવસ્થાપક - Decentr</translation>
<translation id="731644333568559921">&amp;Decentr OSને અપડેટ કરો</translation>
<translation id="731795002583552498">Decentr ને અપડેટ કરી રહ્યું છે</translation>
<translation id="7318036098707714271">તમારી પસંદગીઓ ફાઇલ દૂષિત અથવા અમાન્ય છે.

Decentr તમારા સેટિંગને રિકવર શકતું નથી.</translation>
<translation id="7337881442233988129">Decentr</translation>
<translation id="7339898014177206373">નવી વિંડો</translation>
<translation id="734373864078049451">તમારું વેબ, બુકમાર્ક્સ, અને અન્ય Decentr સામગ્રી અહીં રહે છે.</translation>
<translation id="7349591376906416160">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા Decentrને <ph name="ALTERNATIVE_BROWSER_NAME" /> ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="7448255348454382571">Decentr OS ફરી શરૂ કરો</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - Decentr Dev</translation>
<translation id="7451052299415159299">Decentrને આ સાઇટ માટે તમારા કૅમેરાના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="7483335560992089831">હાલમાં ચાલી રહ્યું છે તેના જેવું સમાન Decentr વર્ઝન ઇન્સ્ટૉલ કરી શકાતું નથી. કૃપા કરીને Decentrને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="753534427205733210">{0,plural, =1{Decentr 1 મિનિટમાં ફરીથી લૉન્ચ થશે}one{Decentr # મિનિટમાં ફરીથી લૉન્ચ થશે}other{Decentr # મિનિટમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="7549178288319965365">Decentr OS વિશે</translation>
<translation id="7561906087460245826">Decentrમાંથી પણ ડેટા કાઢી નાખો (<ph name="URL" />)</translation>
<translation id="7585853947355360626">જો આ પેજ પર સેટિંગ બતાવેલું ન હોય, તો તમારા <ph name="LINK_BEGIN" />
      Decentr OS સેટિંગ<ph name="LINK_END" />માં જુઓ</translation>
<translation id="761356813943268536">Decentr તમારા કેમેરા અને માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="7617377681829253106">Decentr હવે પહેલાંથી બહેતર બન્યું છે</translation>
<translation id="7686590090926151193">Decentr તમારું ડિફૉલ્ટ બ્રાઉઝર નથી</translation>
<translation id="7689606757190482937">તમારા બધા ડિવાઇસ પર Decentrને સિંક કરો અને મનગમતું બનાવો</translation>
<translation id="7729447699958282447">Decentr તમારા ડેટાને સમન્વયિત કરી શક્યું નથી કારણ કે તમારા ડોમેન માટે સમન્વયન ઉપલબ્ધ નથી.</translation>
<translation id="7745317241717453663">આ તમારા બ્રાઉઝિંગ ડેટાને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Decentr માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="7747138024166251722">ઇન્સ્ટૉલર અસ્થાયી ડિરેક્ટરી બનાવી શક્યું નથી. કૃપા કરીને ખાલી ડિસ્ક સ્પેસ માટે અને સૉફ્ટવેર ઇન્સ્ટૉલ કરવાની પરવાનગી માટે તપાસો.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - Decentr Canary</translation>
<translation id="7828947555739565424">આ એકાઉન્ટ સાથેની Decentr પ્રોફાઇલ પહેલેથી જ આ ડિવાઇસ પર અસ્તિત્વમાં છે</translation>
<translation id="7857220146454061152">Decentrની ભાવિ અપડેટ મેળવા માટે, તમારે OS X 10.11 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર OS X 10.10નો ઉપયોગ કરે છે.</translation>
<translation id="7867198900892795913">Decentr નવીનતમ વર્ઝન પર અપડેટ ન થઈ શક્યું, તેથી તમે નવી સુવિધાઓ અને સુરક્ષાના સુધારા ચૂકી રહ્યા છો.</translation>
<translation id="7898472181347242998">તમારું ડિવાઇસ અપ ટૂ ડેટ છે કે નહીં, તે જાણવા માટે <ph name="LINK_BEGIN" />Decentr OS સેટિંગ<ph name="LINK_END" /> પર જાઓ</translation>
<translation id="7937630085815544518">તમે Decentr માં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કર્યું હતું. ફરીથી સાઇન ઇન કરવા માટે કૃપા કરીને એ જ એકાઉન્ટનો ઉપયોગ કરો.</translation>
<translation id="7975919845073681630">આ Decentr નું દ્વિતીય ઇન્સ્ટૉલેશન છે અને આને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="8013436988911883588">એકવાર Decentrને ઍક્સેસ મળે, તે પછી વેબસાઇટ તમારી પાસે ઍક્સેસ માગી શકશે.</translation>
<translation id="8045118833343856403">નીચે જણાવેલા એકાઉન્ટ દ્વારા કોઈ Decentr પ્રોફાઇલમાં સાઇન ઇન કરવામાં આવ્યું નથી. જો તમે અન્ય પ્રોફાઇલમાં એકાઉન્ટનો ઉપયોગ કરવા માગતા હો, તો પહેલાં તે પ્રોફાઇલને કાઢી નાખો.</translation>
<translation id="8105840573057009683">આ સાઇટ માટે Decentrને સ્થાનની પરવાનગીની જરૂર છે</translation>
<translation id="81770708095080097">આ ફાઇલ જોખમી છે, તેથી Decentr એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="8248265253516264921">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો Decentr તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Googleને છબીઓ મોકલવામાં આવે છે. તમે આને કોઈપણ સમયે સેટિંગમાં જઈને બંધ કરી શકો છો.</translation>
<translation id="8266560134891435528">તમે સાઇન ઇન કરેલું ન હોવાને કારણે Decentr તમારા પાસવર્ડ ચેક કરી શકતું નથી</translation>
<translation id="8276522524898344151">Decentr પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="8290862415967981663">આ ફાઇલ જોખમી હોઈ શકે છે, તેથી Decentr એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="8330519371938183845">તમારા બધા ડિવાઇસ પર Decentrને સિંક કરો અને મનગમતું બનાવવા માટે સાઇન ઇન કરો</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" />, પહેલાં Decentr નો ઉપયોગ કરી રહ્યાં હતાં</translation>
<translation id="8417404458978023919">{0,plural, =1{એક દિવસની અંદર Decentrને ફરીથી લૉન્ચ કરો}one{# દિવસની અંદર Decentrને ફરીથી લૉન્ચ કરો}other{# દિવસની અંદર Decentrને ફરીથી લૉન્ચ કરો}}</translation>
<translation id="8453117565092476964">ઇન્સ્ટૉલર આર્કાઇવ ખરાબ અથવા અમાન્ય છે. કૃપા કરીને Decentr ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="8493179195440786826">Decentr જૂનું થઈ ગયું છે</translation>
<translation id="8550334526674375523">ઑફિસની આ પ્રોફાઇલ તમારી વ્યક્તિગત પ્રોફાઇલથી સાવ અલગ છે.</translation>
<translation id="8558383651099478961">તમારા માતાપિતાએ Decentr માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે. આ <ph name="EXTENSION_TYPE_PARAMETER" /> ઉમેરવાની મંજૂરી નથી.</translation>
<translation id="8568283329061645092">જ્યારે તમે તમારા Google એકાઉન્ટ વડે સાઇન ઇન કરો ત્યારે Decentr તમારા પાસવર્ડ ચેક કરી શકે છે</translation>
<translation id="8586442755830160949">કોપિરાઇટ <ph name="YEAR" /> The Decentr Authors. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="8619360774459241877">Decentr લૉન્ચ કરી રહ્યાં છીએ…</translation>
<translation id="8621669128220841554">અનુલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ રહ્યું. કૃપા કરીને Decentr ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="8697124171261953979">જ્યારે તમે Decentr શરૂ કરો અથવા ઑમ્નિબૉક્સ પરથી શોધ કરો ત્યારે કયું પૃષ્ઠ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="8704119203788522458">આ તમારું Decentr છે</translation>
<translation id="8796602469536043152">Decentrને આ સાઇટ માટે તમારા કૅમેરા અને માઇક્રોફોનના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="8803635938069941624">Decentr OS શરતો</translation>
<translation id="8821041990367117597">સાઇન ઇન વિગતો જૂની હોવાને કારણે Decentr તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="8862326446509486874">તમારી પાસે સિસ્ટમ-સ્તરનાં ઇન્સ્ટોલ માટે ઉચિત અધિકારો નથી. એડમિન તરીકે ઇન્સ્ટૉલરને ફરીથી ચલાવવનો પ્રયાસ કરો.</translation>
<translation id="8880203542552872219">જો એવું હોય, તો કૃપા કરીને Decentrમાં તમારા સાચવેલા પાસવર્ડમાં ફેરફાર કરો જેથી તે તમારા નવા પાસવર્ડ સાથે મેળ ખાય.</translation>
<translation id="8897323336392112261">જ્યારે તમે Decentr શરૂ કરો અથવા હોમ બટન ક્લિક કરો ત્યારે કયું પૃષ્ઠ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="8907580949721785412">Decentr પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="8941642502866065432">Decentr અપડેટ કરી શકતાં નથી</translation>
<translation id="8974095189086268230">Decentr OSએ વધારાનાં <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સ્રોત સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવ્યું છે.</translation>
<translation id="8986207147630327271">તમે આ બ્રાઉઝરમાં ઑફિસની પ્રોફાઇલ ઉમેરી રહ્યાં છો અને તમારા વ્યવસ્થાપકને માત્ર ઑફિસની પ્રોફાઇલનો નિયંત્રણ આપી રહ્યાં છો.</translation>
<translation id="9019929317751753759">Decentr ને સુરક્ષિત બનાવવા માટે, અમે નીચેના એક્સ્ટેન્શનને અક્ષમ કર્યું છે કે જે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યું હોઈ શકે છે.</translation>
<translation id="9089354809943900324">Decentr જૂનું થઈ ગયું છે</translation>
<translation id="9093206154853821181">{0,plural, =1{Decentr એક કલાકમાં ફરીથી લૉન્ચ થશે}one{Decentr # કલાકમાં ફરીથી લૉન્ચ થશે}other{Decentr # કલાકમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="91086099826398415">નવા Decentr &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="911206726377975832">તમારો બ્રાઉઝિંગ ડેટા પણ ડિલીટ કરી દઈએ?</translation>
<translation id="9158494823179993217">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા Decentrને વૈકલ્પિક બ્રાઉઝર ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="9185526690718004400">&amp;Decentr અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="9190841055450128916">Decentr (mDNS-In)</translation>
<translation id="9214764063801632699">Decentr OS સિસ્ટમ</translation>
<translation id="93478295209880648">Decentr યોગ્ય રીતે કાર્ય ન કરે તેવું બની શકે કારણ કે તે હવેથી Windows XP અથવા Windows Vista પર સમર્થિત નથી</translation>
<translation id="965162752251293939">કોણ Decentrનો ઉપયોગ કરે છે?</translation>
<translation id="985602178874221306">Decentr લેખકો</translation>
</translationbundle>