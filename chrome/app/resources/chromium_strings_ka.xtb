<translation id="7585853947355360626">თუ პარამეტრი ამ გვერდზე არ გამოჩნდება, ცადეთ მისი პოვნა <ph name="LINK_BEGIN" />Decentr OS-ის პარამეტრებში<ph name="LINK_END" /></translation>
<translation id="761356813943268536">Decentr იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="7617377681829253106">Decentr გაუმჯობესდა</translation>
<translation id="7686590090926151193">Decentr არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="7689606757190482937">მოახდინეთ Decentr-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7729447699958282447">Decentr-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან სინქრონიზაცია თქვენი დომენისთვის არ არის ხელმისაწვდომი.</translation>
<translation id="7745317241717453663">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> — Decentr Canary</translation>
<translation id="7828947555739565424">Decentr პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7857220146454061152">Decentr-ის მომავალი განახლებების მისაღებად დაგჭირდებათ OS X 10.11 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს OS X 10.10-ს.</translation>
<translation id="7867198900892795913">Decentr ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7898472181347242998">თქვენი მოწყობილობის განახლების სტატუსის სანახავად გადადით <ph name="LINK_BEGIN" />Decentr OS-ის პარამეტრებზე<ph name="LINK_END" /></translation>
<translation id="7937630085815544518">თქვენ შესული ხართ Decentr-ში როგორც <ph name="USER_EMAIL_ADDRESS" />. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="7975919845073681630">ეს Decentr-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="8013436988911883588">Decentr-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="8045118833343856403">მითითებული ანგარიშები არ არის შესული Decentr პროფილებში. თუ ანგარიშის სხვა პროფილში გამოყენება გსურთ, პირველ რიგში, წაშალეთ შესაბამისი პროფილი.</translation>
<translation id="8105840573057009683">Decentr საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="81770708095080097">Decentr-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8248265253516264921">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Decentr შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="8266560134891435528">Decentr ვერ ახერხებს თქვენი პაროლების შემოწმებას, რადგან შესული არ ხართ</translation>
<translation id="8276522524898344151">Decentr ცდილობს პაროლების კოპირებას.</translation>
<translation id="8290862415967981663">Decentr-მა დაბლოკა ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="8330519371938183845">შედით სისტემაში, რათა მოახდინოთ Decentr-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> ადრე იყენებდა Decentr-ს</translation>
<translation id="8417404458978023919">{0,plural, =1{ხელახლა გაუშვით Decentr დღის განმავლობაში}other{ხელახლა გაუშვით Decentr # დღის განმავლობაში}}</translation>
<translation id="8453117565092476964">ინსტალაციის პროგრამის არქივი დაზიანებულია ან არასწორია. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="8493179195440786826">Decentr მოძველდა</translation>
<translation id="8550334526674375523">სამსახურის ეს პროფილი თქვენი პირადი პროფილისგან სრულიად დამოუკიდებლად ფუნქციონირებს.</translation>
<translation id="8558383651099478961">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ Decentr-ისთვის. ეს <ph name="EXTENSION_TYPE_PARAMETER" /> ვერ დაემატება.</translation>
<translation id="8568283329061645092">პაროლების Decentr-ის მეშვეობით შესამოწმებლად შედით სისტემაში თქვენი Google ანგარიშით</translation>
<translation id="8586442755830160949">Copyright <ph name="YEAR" /> The Decentr Authors. ყველა უფლება დაცულია.</translation>
<translation id="8619360774459241877">მიმდინარეობს Decentr-ის გაშვება…</translation>
<translation id="8621669128220841554">ინსტალაცია ვერ განხორციელდა გაურკვეველი შეცდომის გამო. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="8697124171261953979">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას ან Omnibox-ში ძიების დროს.</translation>
<translation id="8704119203788522458">ეს არის თქვენი Decentr</translation>
<translation id="8796602469536043152">Decentr საჭიროებს თქვენს კამერასა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="8803635938069941624">Decentr OS ტერმინები</translation>
<translation id="8821041990367117597">Decentr-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან თქვენს ანგარიშზე შესვლის დეტალები მოძველდა.</translation>
<translation id="8862326446509486874">თქვენ არ გაქვთ შესაბამისი უფლებები სისტემის დონეზე ინსტალაციისთვის. სცადეთ ინსტალაციის პროგრამის ხელახლა გაშვება ადმინისტრატორის სტატუსით.</translation>
<translation id="8880203542552872219">ამ შემთხევაში ჩაასწორეთ Decentr-ში შენახული პაროლი ახლის მიხედვით.</translation>
<translation id="8897323336392112261">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას ან საწყისი გვერდის ღილაკზე დაწკაპუნებისას.</translation>
<translation id="8907580949721785412">Decentr ცდილობს პაროლების ჩვენებას. ჩაწერეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="8941642502866065432">Decentr-ის განახლება ვერ მოხერხდა</translation>
<translation id="8974095189086268230">Decentr OS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS" />ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="8986207147630327271">თქვენ აპირებთ, ამ ბრაუზერს სამსახურის პროფილი დაამატოთ, რითაც თქვენს ადმინისტრატორს კონტროლს მხოლოდ სამსახურის პროფილზე მიანიჭებთ.</translation>
<translation id="9019929317751753759">Decentr-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="9089354809943900324">Decentr მოძველდა</translation>
<translation id="9093206154853821181">{0,plural, =1{Decentr ხელახლა გაეშვება 1 საათში}other{Decentr ხელახლა გაეშვება # საათში}}</translation>
<translation id="91086099826398415">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="911206726377975832">ასევე წაშალოთ თქვენი დათვალიერების მონაცემები?</translation>
<translation id="9158494823179993217">თქვენი სისტემის ადმინისტრატორმა მოახდინა Decentr-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა ალტერნატიული ბრაუზერის გახსნა.</translation>
<translation id="9185526690718004400">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="9190841055450128916">Decentr (mDNS-In)</translation>
<translation id="9214764063801632699">Decentr OS სისტემა</translation>
<translation id="93478295209880648">Decentr-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი Windows XP-სა და Windows Vista-ზე</translation>
<translation id="965162752251293939">ვინ იყენებს Decentr-ს?</translation>
<translation id="985602178874221306">Decentr-ის ავტორები</translation>
