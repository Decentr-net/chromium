<translation id="7274695763216404502">ჩამაგრებულია! ისევ გამოიყენეთ სურათების ძიება ხელსაწყოთა ზოლიდან</translation>
<translation id="7288567540154601580">ჩანართები და გაფართოებები</translation>
<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{Decentr გირჩევთ, ამოშალოთ ის}other{Decentr გირჩევთ, ამოშალოთ ისინი}}</translation>
<translation id="7309928523159922338">რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Decentr-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="731795002583552498">მიმდინარეობს Decentr-ის განახლება</translation>
<translation id="7318036098707714271">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

Decentr ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="7339898014177206373">ახალი ფანჯარა</translation>
<translation id="734373864078049451">თქვენი ვები, სანიშნეები და Decentr-ის სხვა მასალა არის აქ.</translation>
<translation id="7349591376906416160">თქვენი სისტემის ადმინისტრატორმა მოახდინა Decentr-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME" />-ის გახსნა.</translation>
<translation id="7384121030444253939">ეს გაფართოება აღარ არის მხარდაჭერილი. Decentr გირჩევთ მის ამოშლას.</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> — Decentr Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7451052299415159299">Decentr საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7458892263350425044">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Decentr-ს წვდომა</translation>
<translation id="7461356015007898716">Decentr-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="7467949745582939695">გსურთ Decentr-ის ხელახლა გაშვება?</translation>
<translation id="7483335560992089831">შეუძლებელია იმავე Decentr-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Decentr და ხელახლა სცადეთ.</translation>
<translation id="751935028865900641">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Decentr-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Google ანგარიში, თუ მასში შესული ხართ Decentr-იდან.</translation>
<translation id="753534427205733210">{0,plural, =1{Decentr ხელახლა გაეშვება 1 წუთში}other{Decentr ხელახლა გაეშვება # წუთში}}</translation>
<translation id="7582945390259497898">Decentr-ს შეუძლია თქვენი ინტერესების პროგნოზირება. მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, Decentr-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ინსტალატორი</translation>
<translation id="7585391435984513350">ბოლო დროს არ ყოფილხართ. Decentr-მა ამოშალა <ph name="PERMISSION" /></translation>
<translation id="761356813943268536">Decentr იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="7617377681829253106">Decentr გაუმჯობესდა</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="7686590090926151193">Decentr არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="7689606757190482937">მოახდინეთ Decentr-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7699779824407626136">Decentr-ის განახლება</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME" />-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="7745317241717453663">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="7786760609782648049">ააჩქარეთ Decentr-ის მუშაობა</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> — Decentr Canary</translation>
<translation id="7803986347287457849">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Decentr იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="7828947555739565424">Decentr პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="7859018312476869945">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად Decentr თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="7867198900892795913">Decentr ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS" /> წამი</translation>
<translation id="7888981273428720788">Decentr-ის დაყენება ნაგულისხმევად</translation>
<translation id="7934340546140346950">Decentr ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="7937630085815544518">თქვენ შესული ხართ Decentr-ში როგორც <ph name="USER_EMAIL_ADDRESS" />. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="7975919845073681630">ეს Decentr-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="7997934263947464652">უცნობი წყაროებიდან მომავალ გაფართოებებს, აპებსა და თემებს შეუძლია თქვენი მოწყობილობის დაზიანება. Decentr გირჩევთ, ისინი მხოლოდ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-დან დააინსტალიროთ.</translation>
<translation id="8004582292198964060">ბრაუზერი</translation>
<translation id="8010081455002666927">ავტომატური ამოცნობა</translation>
<translation id="8013436988911883588">Decentr-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8054112667659782652">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="8077498902115777962">Decentr-ის აპების ფონურ რეჟიმში მუშაობის გათიშვა</translation>
<translation id="80790299200510644">სურათების ძიება</translation>
<translation id="8086881907087796310">ინსტალაცია ვერ მოხერხდა, რადგან თქვენი კომპიუტერი არ აკმაყოფილებს მინიმალურ მოთხოვნებს აპარატურის კუთხით.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Decentr for Testing</translation>
<translation id="8105840573057009683">Decentr საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="8118331347066725040">გამოხმაურება Lens-ით ძიების შესახებ</translation>
<translation id="8133124826068723441">DecentrOS-ის საშუალებით ვერ მოხერხდა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენს დომენზე სინქრონიზაცია მიუწვდომელია.</translation>
<translation id="813913629614996137">მიმდინარეობს ინიცირება…</translation>
<translation id="8166782796394721554">დამატებითი დაცვის ჩართვა Decentr-ის JavaScript-ისა და WebAssembly-ს ძრავაში</translation>
<translation id="81770708095080097">Decentr-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8177472873527554730">გვერდზე კონტენტი ვერ მოიძებნა</translation>
<translation id="8200109504272824693">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ Decentr-ის მონაცემები თქვენს ანგარიშში, <ph name="USER_EMAIL" /></translation>
<translation id="8221491193165283816">როგორც წესი, თქვენ ბლოკავთ შეტყობინებებს. ამ საიტისგან შეტყობინებების მისაღებად დააწკაპუნეთ აქ.</translation>
<translation id="8223363452568144035">თქვენი კამერა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Decentr-ს წვდომა</translation>
<translation id="8232193495299001329">Decentr ვერ ადასტურებს ამ გაფართოების წარმომავლობას და შესაძლოა, ის სახიფათო იყოს. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="8248265253516264921">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Decentr შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="8254601181414348851">გსურთ, შეხვიდეთ Decentr-ის ახალ პროფილში?</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Decentr გაგაფრთხილებთ<ph name="END_LINK" /> არაუსაფრთხო საიტებისა და ჩამოტვირთვების შესახებ</translation>
<translation id="8313851650939857356">გაშვების შეცდომა: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8318772038038596122">თქვენი ორგანიზაცია ხურავს Decentr-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება.</translation>
<translation id="8321888067342493336">სურათად შენახვა</translation>
<translation id="8330519371938183845">შედით სისტემაში, რათა მოახდინოთ Decentr-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> ადრე იყენებდა Decentr-ს</translation>
<translation id="8359544530202147897">განაახლეთ Decentr, რომ განაგრძოთ Decentr-ის მონაცემების გამოყენება თქვენს Google ანგარიშში, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8360718212975266891">Decentr-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8-ს.</translation>
<translation id="8362914115861174987">თარგმნა შემდეგ ენაზე:</translation>
<translation id="8370517070665726704">© <ph name="YEAR" />, Google LLC. ყველა უფლება დაცულია.</translation>
<translation id="8372327902843331129">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Decentr-ში. შესვლის შემდეგ ეს პაროლი შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="837460953767177950">დაგჭირდებათ Decentr-ის გადატვირთვა.</translation>
<translation id="8397248745433792218">Decentr გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" /></translation>
<translation id="8401454788024434101">ამ გაფართოების გამოქვეყნება გაუქმდა მისი დეველოპერის მიერ და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="8417404458978023919">{0,plural, =1{ხელახლა გაუშვით Decentr დღის განმავლობაში}other{ხელახლა გაუშვით Decentr # დღის განმავლობაში}}</translation>
<translation id="8438543370129609977">სურათით ძიების გამოყენებისას სერვერზე გაიგზავნება გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით. <ph name="LEARN_MORE" /></translation>
<translation id="8453117565092476964">ინსტალაციის პროგრამის არქივი დაზიანებულია ან არასწორია. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="8458614432758743027">Decentr-ის მუშაობისთვის საჭიროა Windows 10 ან უფრო ახალი ვერსია.</translation>
<translation id="8463672209299734063">არასავალდებულო: DecentrOS-ის ფუნქციებისა და წარმადობის გაუმჯობესების ხელშეწყობა დიაგნოსტიკური და გამოყენების მონაცემების Google-ისთვის ავტომატურად გაგზავნის მეშვეობით.</translation>
<translation id="8471947159125090285">თქვენს Google ანგარიშში Decentr მონაცემები რომ შეინახოთ და გამოიყენოთ ისინი, დაადასტურეთ ვინაობა</translation>
<translation id="8493179195440786826">Decentr მოძველდა</translation>
<translation id="8522801943730206384">პაროლების შემოწმებას Decentr შეძლებს მათი შენახვის შემდეგ</translation>
<translation id="8550334526674375523">სამსახურის ეს პროფილი თქვენი პირადი პროფილისგან სრულიად დამოუკიდებლად ფუნქციონირებს.</translation>
<translation id="8555465886620020932">სერვისის შეცდომა: <ph name="SERVICE_ERROR" /></translation>
<translation id="8556420416730706394">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის; დააწკაპუნეთ ჩამაგრების ღილაკს გვერდითი ზოლის ზედა ნაწილში</translation>
<translation id="856656450041460113">ენების სიაში ძიება</translation>
<translation id="8568283329061645092">პაროლების Decentr-ის მეშვეობით შესამოწმებლად შედით სისტემაში თქვენი Google ანგარიშით</translation>
<translation id="8576826849825683917">რამდენიმე ორგანიზაცია მართავს Decentr-ს</translation>
<translation id="8586442755830160949">Copyright <ph name="YEAR" /> The Decentr Authors. ყველა უფლება დაცულია.</translation>
<translation id="8601359445272098721">სიახლე! „ეკრანის თარგმნის“ ღილაკზე დაჭერით თქვენს ეკრანზე შეგიძლიათ, თარგმნოთ ტექსტი და სურათები</translation>
<translation id="8619360774459241877">მიმდინარეობს Decentr-ის გაშვება…</translation>
<translation id="8621669128220841554">ინსტალაცია ვერ განხორციელდა გაურკვეველი შეცდომის გამო. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="8648201657708811153">Decentr for Testing ვერ გახდება თქვენი ნაგულისხმევი ბრაუზერი.</translation>
<translation id="8697124171261953979">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას ან Omnibox-ში ძიების დროს.</translation>
<translation id="8704119203788522458">ეს არის თქვენი Decentr</translation>
<translation id="8719993436687031146">გსურთ, შეხვიდეთ Decentr-ში?</translation>
<translation id="878572486461146056">შეცდომა ინსტალაციისას: თქვენმა ქსელის ადმინისტრატორმა აამოქმედა ჯგუფური წესები, რომლებიც ზღუდავს ინსტალაციას: <ph name="INSTALL_ERROR" /></translation>
<translation id="8796602469536043152">Decentr საჭიროებს თქვენს კამერასა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="8818550178040858407">გსურთ, შეხვიდეთ Decentr-ში?</translation>
<translation id="8826492472752484139">დაწკაპუნებით აირჩიეთ „პაროლების მმართველი“</translation>
<translation id="8833697763442816810">DecentrOS სისტემა</translation>
<translation id="8852026904190808918">ეს ენა გამოიყენება მენიუს, პარამეტრების, გაფრთხილებებისა და სხვა ტექსტური კონტენტის Decentr-ში საჩვენებლად</translation>
<translation id="8862326446509486874">თქვენ არ გაქვთ შესაბამისი უფლებები სისტემის დონეზე ინსტალაციისთვის. სცადეთ ინსტალაციის პროგრამის ხელახლა გაშვება ადმინისტრატორის სტატუსით.</translation>
<translation id="8876044221123442390">Decentr პროფილის დამატება</translation>
<translation id="8880203542552872219">ამ შემთხევაში ჩაასწორეთ Decentr-ში შენახული პაროლი ახლის მიხედვით.</translation>
<translation id="8891709362986793894">თქვენი ორგანიზაცია მოითხოვს, რომ Decentr-ში შეხვიდეთ</translation>
<translation id="8907580949721785412">Decentr ცდილობს პაროლების ჩვენებას. ჩაწერეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="8931379085695076764">Decentr-ს შეუძლია თქვენი ინტერესების პროგნოზირება ბოლო რამდენიმე კვირის განმავლობაში თქვენ მიერ ვების დათვალიერების ისტორიის საფუძველზე. აღნიშნული ინფორმაცია დარჩება თქვენს მოწყობილობაზე.</translation>
<translation id="8941642502866065432">Decentr-ის განახლება ვერ მოხერხდა</translation>
<translation id="897581876605952338">Decentr Enterprise-ის ლოგო</translation>
<translation id="8986207147630327271">თქვენ აპირებთ, ამ ბრაუზერს სამსახურის პროფილი დაამატოთ, რითაც თქვენს ადმინისტრატორს კონტროლს მხოლოდ სამსახურის პროფილზე მიანიჭებთ.</translation>
<translation id="8988036198400390003">Decentr-ის პროფილების მართვა</translation>
<translation id="9019929317751753759">Decentr-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="9022552996538154597">შედით Decentr-ში</translation>
<translation id="904366664621834601">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან არქივის ფაილი შეიცავს სხვა ფაილებს, რომლებშიც, შესაძლოა, მავნე პროგრამა იმალებოდეს</translation>
<translation id="9062666675513499497">შედით Decentr-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="9078733879136747090">Decentr ავტომატურად დაიხურა</translation>
<translation id="9089354809943900324">Decentr მოძველდა</translation>
<translation id="9093206154853821181">{0,plural, =1{Decentr ხელახლა გაეშვება 1 საათში}other{Decentr ხელახლა გაეშვება # საათში}}</translation>
<translation id="9106236359747881194">მონიშნეთ ტექსტი მოსაძებნად</translation>
<translation id="9106612006984859720">Decentr-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8.1-ს.</translation>
<translation id="91086099826398415">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="911206726377975832">ასევე წაშალოთ თქვენი დათვალიერების მონაცემები?</translation>
<translation id="9148058034647219655">გასვლა</translation>
<translation id="9158494823179993217">თქვენი სისტემის ადმინისტრატორმა მოახდინა Decentr-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა ალტერნატიული ბრაუზერის გახსნა.</translation>
<translation id="9185526690718004400">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="9190841055450128916">Decentr (mDNS-In)</translation>
<translation id="924957577793602335">მოირგეთ Decentr</translation>
<translation id="93478295209880648">Decentr-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი Windows XP-სა და Windows Vista-ზე</translation>
<translation id="942598560705308788">Decentr-ის მიერ მართული სერტიფიკატები</translation>
<translation id="945522503751344254">შეფასების გაგზავნა</translation>
<translation id="965162752251293939">ვინ იყენებს Decentr-ს?</translation>
<translation id="967427899662692980">ისარგებლეთ Decentr-ის უსაფრთხოების ყველაზე ძლიერი ფუნქციებით</translation>
<translation id="983803489796659991">ინსტალაცია ვერ მოხერხდა, რადგან განახლების სერვერს არ აქვს ამ აპლიკაციის ჰეშ-მონაცემები.</translation>
<translation id="985498048907240953">Decentr-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="985602178874221306">Decentr-ის ავტორები</translation>
<translation id="989970834842471429">მონიშნეთ ნებისმიერი ტექსტი თუ სურათი, რისი მოძებნაც გსურთ სურათების ძიებით</translation>
<translation id="992780518932311116">თქვენი მდებარეობა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Decentr-ს წვდომა</translation>
</translationbundle>