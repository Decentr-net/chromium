<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="1098170124587656448">Decentr დაგიცავთ პერსონალურ მონაცემთა გაჟონვის შემთხვევებისგან, არასათანადო გაფართოებებისა და სხვა უსიამოვნებისგან</translation>
<translation id="1104942323762546749">Decentr ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="113122355610423240">Decentr თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="1131805035311359397"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1185134272377778587">Decentr-ის შესახებ</translation>
<translation id="1315551408014407711">შექმენით ახალი Decentr პროფილი</translation>
<translation id="1396446129537741364">Decentr ცდილობს პაროლების ჩვენებას.</translation>
<translation id="1414495520565016063">თქვენ შესული ხართ Decentr-ში!</translation>
<translation id="151962892725702025">Decentr OS-ის საშუალებით ვერ მოხერხდა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენს დომენზე სინქრონიზაცია მიუწვდომელია.</translation>
<translation id="1524282610922162960">Decentr ჩანართის გაზიარება</translation>
<translation id="1553461853655228091">Decentr საჭიროებს თქვენს კამერაზე წვდომის ნებართვას, თქვენი გარემოს 3-განზომილებიანი რუკის შექმნა რომ შეძლოს</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას}=1{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="1667812772085710766">Decentr-ის დახურვისას ის ავტომატურად გაასუფთავებს თქვენ მიერ მონახულებულ გვერდებთან დაკავშირებულ ქუქი-ჩანაწერებსა და საიტების მონაცემებს</translation>
<translation id="1708666629004767631">ხელმისაწვდომია Decentr-ის ახალი, უფრო დაცული ვერსია.</translation>
<translation id="1774152462503052664">დავრთოთ ნება Decentr-ს გაშვებული იყოს ფონურ რეჟიმში</translation>
<translation id="1779356040007214683">Decentr-ის უსაფრთხოების გაზრდის მიზნით, ჩვენ გავთიშეთ რამდენიმე გაფართოება, რომელიც არ არის ჩამოთვლილი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, დამატებულია თქვენი თანხმობის გარეშე.</translation>
<translation id="1808667845054772817">Decentr-ის ხელახალი ინსტალაცია</translation>
<translation id="185970820835152459">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Google ანგარიშები. თქვენი Google ანგარიშები გამოიყენება Decentr ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="1881322772814446296">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Decentr-ის პროფილზე. თქვენი Decentr-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME" />-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Google ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Decentr-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Decentr-ში შესვლის გარეშე</translation>
<translation id="1929939181775079593">Decentr არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="1966382378801805537">Decentr ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="1981611865800294956">ხელახლა გაშვება &amp;Decentr OS-ის გასაახლებლად</translation>
<translation id="2008474315282236005">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2020032459870799438"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს სხვა პაროლებს.</translation>
<translation id="2174178932569897599">Decentr-ის მორგება</translation>
<translation id="2185166961232948079">Decentr — ქსელში შესვლა — <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">თუ თქვენ გაზიარებული გაქვთ კომპიუტერი, თქვენი მეგობრები და ოჯახის წევრები შეძლებენ დამოუკიდებლად დათვალიერებას და Decentr-ის დაყენებას სურვილისამებრ.</translation>
<translation id="2294245788148774212">არასავალდებულო: Decentr OS-ის ფუნქციებისა და წარმადობის გაუმჯობესების ხელშეწყობა დიაგნოსტიკური და გამოყენების მონაცემების Google-ისთვის ავტომატურად გაგზავნის მეშვეობით.</translation>
<translation id="2343156876103232566">აქედან თქვენს Android ტელეფონზე ნომრის გასაგზავნად შედით Decentr-ში ორივე მოწყობილობაზე.</translation>
<translation id="2347108572062610441">ამ გაფართოებამ თქვენ მიერ Decentr-ის გაშვებისას ნაჩვენები გვერდი შეცვალა.</translation>
<translation id="2396765026452590966">გაფართოებამ „<ph name="EXTENSION_NAME" />“ თქვენ მიერ Decentr-ის გაშვებისას ნაჩვენები გვერდი შეცვალა.</translation>
<translation id="2401032172288869980">Decentr საჭიროებს კამერისა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2483889755041906834">Decentr-ში</translation>
<translation id="2485422356828889247">დეინსტალაცია</translation>
<translation id="2535480412977113886">Decentr OS-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან თქვენი ანგარიშის შესვლის დეტალები მოძველდა.</translation>
<translation id="2560420686485554789">ფაილების ჩამოსატვირთად Decentr საჭიროებს მეხსიერებაზე წვდომას</translation>
<translation id="2572494885440352020">Decentr-ის დამხმარე</translation>
<translation id="2577788541081224677">თქვენს Decentr კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, რომ სინქრონიზაცია ჩართოთ.</translation>
<translation id="2583187216237139145">ამ პროფილის გამოყენებისას შექმნილი Decentr მონაცემების (მაგ., შექმნილი სანიშნეების, ისტორიის, პაროლებისა და სხვა პარამეტრების) ამოშლა შეუძლია სამსახურის პროფილის ადმინისტრატორს. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">განახლების მისასადაგებლად, Decentr OS უნდა გადაიტვირთოს.</translation>
<translation id="2614883797045469742">ნაგულისხმევი პარამეტრები მისაღებია ადამიანთა უმეტესობისთვის, თუმცა Decentr-ის მორგება თქვენი სურვილისამებრ შეგიძლიათ</translation>
<translation id="2648074677641340862">ინსტალაციის დროს ოპერაციული სისტემის შეცდომა მოხდა. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="2661879430930417727">თუ საზიარო მოწყობილობა გაქვთ, თქვენს მეგობრებსა და ოჯახის წევრებს შეუძლიათ ვების დამოუკიდებლად დათვალიერება და Decentr-ის საკუთარი შეხედულებისამებრ დაყენება</translation>
<translation id="2711502716910134313">Decentr-ის ჩანართი</translation>
<translation id="2718390899429598676">დამატებითი უსაფრთხოებისთვის, Decentr თქვენს მონაცემებს დაშიფრავს.</translation>
<translation id="2770231113462710648">შეცვალეთ ნაგულისხმევი ბრაუზერი-ით:</translation>
<translation id="2799223571221894425">ხელახლა გაშვება</translation>
<translation id="2837693172913560447">ეს მოქმედება შექმნის ახალ Decentr პროფილს <ph name="USER_EMAIL_ADDRESS" />-ისთვის</translation>
<translation id="2847479871509788944">Decentr-იდან ამოღება...</translation>
<translation id="2885378588091291677">ამოცანების მმართველი</translation>
<translation id="2910007522516064972">Decentr-ის შ&amp;ესახებ</translation>
<translation id="2977470724722393594">Decentr განახლებულია</translation>
<translation id="2983934633046890458">Decentr ცდილობს პაროლების რედაქტირებას.</translation>
<translation id="3032706164202344641">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ მოგვიანებით.</translation>
<translation id="3032787606318309379">Decentr-ში დამატება…</translation>
<translation id="3068515742935458733">დაგვეხმარეთ Decentr-ის გაუმჯობესებაში: გამოგზავნეთ მოხსენებები შეცდომების და <ph name="UMA_LINK" />-ის შესახებ Google-ში</translation>
<translation id="3103660991484857065">ინსტალაციის პროგრამამ ვერ ამოიღო ფაილები არქივიდან. ხელახლა ჩამოტვირთეთ Decentr.</translation>
<translation id="3130323860337406239">Decentr იყენებს თქვენს მიკროფონს.</translation>
<translation id="3155163173539279776">Decentr-ის ხელახლა გაშვება</translation>
<translation id="3179665906251668410">ბმულის გახსნა Decentr-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="3185330573522821672">მოირგეთ თქვენი ახალი Decentr პროფილი</translation>
<translation id="3190315855212034486">ვაუ! Decentr-ში შეცდომაა. გადავტვირთოთ?</translation>
<translation id="3229526316128325841">Decentr ითხოვს თქვენი პაროლების ექსპორტირებას.</translation>
<translation id="3258596308407688501">Decentr ვერ ახერხებს თავის მონაცემთა დირექტორიაში წაკითხვას და ჩაწერის განხორციელებას:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">დაინსტალირებულია Decentr-ის ვერსია <ph name="PRODUCT_VERSION" /></translation>
<translation id="328888136576916638">Google API გასაღები გამოტოვებულია. Decentr-ის ზოგიერთი ფუნქცია გამორთული იქნება.</translation>
<translation id="3296368748942286671">ფონური პროგრამების გაშვების გაგრძელება, როდესაც Decentr იხურება</translation>
<translation id="331951419404882060">Decentr OS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="3349211344363550267">Decentr გირჩევთ, არ ჩამოტვირთოთ და არც გახსნათ ეს ფაილი</translation>
<translation id="3350761136195634146">ამ ანგარიშის მქონე Decentr პროფილი უკვე არსებობს</translation>
<translation id="3406848076815591792">გსურთ არსებულ Decentr პროფილზე გადართვა?</translation>
<translation id="3430503420100763906">Decentr პროფილები Decentr-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="347328004046849135">Decentr შეგატყობინებთ, როცა სისტემაში გატეხილი პაროლით შეხვალთ</translation>
<translation id="3474745554856756813">ეს მოქმედება წაშლის <ph name="ITEMS_COUNT" /> ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> გადართავს Decentr პროფილებს</translation>
<translation id="3509308970982693815">დახურეთ Decentr-ის ყველა ფანჯარა და ხელახლა სცადეთ.</translation>
<translation id="3575459661164320785">თქვენს კომპიუტერზე აღმოჩენილია საზიანო პროგრამული უზრუნველყოფა. Decentr-ს შეუძლია მისი ამოშლა, თქვენი პარამეტრების აღდგენა და გაფართოებების გათიშვა, რომ ბრაუზერმა კვლავ ნორმალურად იმუშაოს.</translation>
<translation id="3639635944603682591">ამ პიროვნების დათვალიერების მონაცემები წაიშლება ამ მოწყობილობიდან. მონაცემების აღსადგენად შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{ხელმისაწვდომია Decentr-ის განახლება, რომელიც მას მიესადაგება ხელახლა გაშვებისთანავე.}=1{ხელმისაწვდომია Decentr-ის განახლება, რომელიც მას მიესადაგება ხელახლა გაშვებისთანავე. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ხელმისაწვდომია Decentr-ის განახლება, რომელიც მას მიესადაგება ხელახლა გაშვებისთანავე. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="3651803019964686660"><ph name="ORIGIN" />-დან თქვენს Android ტელეფონზე ნომრის გასაგზავნად შედით Decentr-ში ორივე მოწყობილობაზე.</translation>
<translation id="3685209450716071127">Decentr ვერ ახერხებს პაროლების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას}=1{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="3713809861844741608">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="3728336900324680424">Decentr-ს ექნება წვდომა თქვენს Drive-ზე მისამართთა ზოლში შემოთავაზებების უზრუნველსაყოფად</translation>
<translation id="378917192836375108">Decentr საშუალებას გაძლევთ დააწკაპუნოთ ტელეფონის ნომერზე ინტერნეტში და დარეკოთ Skype-ით!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="388648406173476553">მოირგეთ და გააკონტროლეთ Decentr. საჭიროა თქვენი ყურადღება — დააწკაპუნეთ დეტალური ინფორმაციისთვის.</translation>
<translation id="3889543394854987837">Decentr ის გახსნისა და დათვალიერების დაწყებისათვის დააჭირეთ თქვენი სახელს.</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> უკვე შესულია ამ Decentr პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Decentr-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="3945058413678539331">Decentr ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="4036079820698952681">ხელი შეუწყვეთ Decentr-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> — ქსელში შესვლა — Decentr</translation>
<translation id="421369550622382712">აღმოაჩინეთ შესანიშნავი აპები, თამაშები, გაფართოებები და თემები Decentr-ისთვის.</translation>
<translation id="4216212958613226427">ეს ენა გამოიყენება Decentr-ის სამომხმარებლო ინტერფეისისთვის</translation>
<translation id="4230135487732243613">დავუკავშიროთ თქვენი Decentr მონაცემები ამ ანგარიშის?</translation>
<translation id="4264410486868823224"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის Decentr OS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="4271805377592243930">Decentr-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4285930937574705105">ინსტალაცია ვერ განხორციელდა განუსაზღვრელი შეცდომის გამო. თუ Decentr ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="4407044323746248786">მაინც გსურთ Decentr-იდან გასვლა?</translation>
<translation id="4415566066719264597">Decentr-ისთვის ფონურ რეჟიმში მუშაობის დაშვება</translation>
<translation id="4423735387467980091">Decentr-ის მორგება და კონტროლი</translation>
<translation id="452711251841752011">მოგესალმებით Decentr-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="4544142686420020088">Decentr-ის განახლება ვერ მოხერხდა შეფერხების გამო. <ph name="BEGIN_LINK" />შეასწორეთ Decentr-ის განახლებასთან დაკავშირებული პრობლემები და განუხორციელებელი განახლებები.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">გსურთ ახალ Decentr პროფილში გაგრძელება?</translation>
<translation id="4567424176335768812">თქვენ შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" />. ახლა შეგიძლიათ გახსნათ თქვენი სანიშნეები, ისტორია და სხვა პარამეტრები ყველა მოწყობილობიდან, რომელშიც შესული ხართ.</translation>
<translation id="459535195905078186">Decentr პროგრამები</translation>
<translation id="4665829708273112819">გაფრთხილება: Decentr ვერ შეუშლის ხელს გაფართოებებს დათვალიერების ისტორიის შენახვაში. ინკოგნიტო რეჟიმში ამ გაფართოების გასათიშად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="4677944499843243528">როგორც ჩანს, პროფილი გამოიყენება სხვა Decentr პროცესის მიერ (<ph name="PROCESS_ID" />) სხვა კომპიუტერში (<ph name="HOST_NAME" />). Decentr-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Decentr.</translation>
<translation id="469338717132742108">Decentr OS-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4708774505295300557">Decentr-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Decentr-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4746050847053251315">მაინც გსურთ Decentr-იდან გასვლა?</translation>
<translation id="4748217263233248895">Decentr-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="4750035648288509542">ყველაფერი თითქმის მზადაა! განახლების დასასრულებლად ხელახლა გაუშვით Decentr. ინკოგნიტო ფანჯრები ხელახლა არ გაიხსნება.</translation>
<translation id="4788777615168560705">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში ან <ph name="BEGIN_LINK" />შეამოწმეთ პაროლები თქვენს Google ანგარიშში<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Google Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Google-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="4888717733111232871">Decentr-ის შემავალი წესი დაუშვას mDNS მოძრაობა.</translation>
<translation id="4893347770495441059">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="4943838377383847465">Decentr ფონურ რეჟიმშია.</translation>
<translation id="4987820182225656817">სტუმრებს შეუძლიათ Decentr-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="4994636714258228724">საკუთარი თავის დამატება Decentr-ში</translation>
<translation id="5224391634244552924">შენახული პაროლები არ არის. პაროლების შემოწმებას Decentr შეძლებს მათი შენახვის შემდეგ.</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" /> უკვე შესულია ამ Decentr პროფილში. ეს მოქმედება შექმნის ახალ Decentr პროფილს <ph name="USER_EMAIL_ADDRESS" />-ისთვის</translation>
<translation id="5277894862589591112">ცვლილებების მისასადაგებლად ხელახლა გაუშვით Decentr</translation>
<translation id="5358375970380395591">მართული ანგარიშით შედიხართ სისტემაში და ადმინისტრატორს თქვენს Decentr-ის პროფილზე კონტროლს აძლევთ. თქვენი Decentr ის მონაცემები როგორიცაა თქვენი აპლიკაციები, სანიშნები, ისტორიები, პაროლები, და სხვა პარამეტრები მუდმივად მიბმული გახდება <ph name="USER_NAME" />-თან. ამ მონაცემების წაშლას Google ანგარიშის საინფორმაციო დაფის გზით შეძლებთ, მაგრამ შეუძლებელი იქნება ამ მონაცემების სხვა ანგარიშთან გაერთიანება. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">მიმდინარეობს Decentr-ის განახლება (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Decentr-ში შესვლის დაშვება</translation>
<translation id="5398878173008909840">ხელმისაწვდომია Decentr-ის ახალი ვერსია.</translation>
<translation id="5416696090975899932">Decentr წინასწარ ვერ გიჩვენებთ ამოსაბეჭდ ვერსიას, ვინაიდან მას აკლია ჩაშენებული PDF მნახველი.</translation>
<translation id="5427571867875391349">დააყენეთ Decentr ნაგულისხმევ ბრაუზერად</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> — Decentr Beta</translation>
<translation id="5479196819031988440">Decentr OS ვერ ხსნის ამ გვერდს.</translation>
<translation id="5480860683791598150">Decentr საჭიროებს თქვენს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის გასაზიარებლად</translation>
<translation id="549669000822060376">დაელოდეთ, სანამ Decentr დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="5496810170689441661">Decentr ცდილობს პაროლების რედაქტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="5527463683072221100">PDF-ების გახსნა Decentr-ში</translation>
<translation id="5623402015214259806">{0,plural, =0{ხელმისაწვდომია Decentr-ის განახლება}=1{ხელმისაწვდომია Decentr-ის განახლება}other{უკვე # დღეა, რაც ხელმისაწვდომია Decentr-ის განახლება}}</translation>
<translation id="5634636535844844681">Decentr-ის მუშაობისთვის საჭიროა Windows 7 ან უფრო ახალი ვერსია.</translation>
<translation id="5653831366781983928">გთხოვთ, ახლავე გადატვირთოთ Decentr</translation>
<translation id="5698481217667032250">Decentr-ის ამ ენაზე ჩვენება</translation>
