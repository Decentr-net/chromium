<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1026101648481255140">ინსტალაციის გაგრძელება</translation>
<translation id="1029669172902658969">ხელახლა გაშვება &amp;DecentrOS-ის გასაახლებლად</translation>
<translation id="1040916596585577953">Decentr გირჩევთ, შეამოწმოთ ეს გაფართოება</translation>
<translation id="1042552502243217427">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Decentr გამოიყენებს Google-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Google-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="1083934481477628225">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ Decentr-ისთვის</translation>
<translation id="1104942323762546749">Decentr ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="112640046208448578">მოახდინეთ საგნების თუ ადგილების იდენტიფიცირება, დააკოპირეთ ან თარგმნეთ ტექსტი. სურათების ძიების გამოყენებისას გვერდის ეკრანის ანაბეჭდი იგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Decentr თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="1131805035311359397"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1153368717515616349">დაწკაპუნებით აირჩიეთ Decentr-ის მენიუ</translation>
<translation id="1157985233335035034">ბოლოდროინდელი ენები</translation>
<translation id="1184145431117212167">ინსტალაცია ვერ მოხერხდა, რადგან Windows-ის თქვენი ვერსია არ არის მხარდაჭერილი.</translation>
<translation id="1185134272377778587">Decentr-ის შესახებ</translation>
<translation id="1203500561924088507">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="1262876892872089030">სანამ ეს ჩანართი უმოქმედო იყო, Decentr-ის სისწრაფის შესანარჩუნებლად მეხსიერება გათავისუფლდა. სურვილისამებრ, შეგიძლიათ აირჩიოთ, რომ ეს საიტი ყოველთვის გამოირიცხოს უმოქმედოთა რიგებიდან.</translation>
<translation id="1265577313130862557">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი სახიფათოა</translation>
<translation id="126567311906253476">Google სერვისებში, მაგალითად, Gmail-სა თუ YouTube-ში <ph name="USER_EMAIL" />-ით შესვლისას შეგიძლიათ Decentr-შიც იმავე ანგარიშით შეხვიდეთ</translation>
<translation id="1290883685122687410">დაყენების შეცდომა: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">შექმენით ახალი Decentr პროფილი</translation>
<translation id="1324107359134968521">Decentr საჭიროებს Bluetooth-ს, რომ აღმოაჩინოს 
 Bluetooth მოწყობილობები. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">ენის ამოცნობა</translation>
<translation id="1342274909142618978">ასევე, წაიშალოს მონაცემები Decentr-იდან (<ph name="URL" />)</translation>
<translation id="1345251407431278948">ჩამაგრებულია! სურათების ძიებაზე წვდომა შეგიძლიათ ხელსაწყოთა ზოლში ღილაკით „ახალი“</translation>
<translation id="1356661055722410047">სიახლე! თქვენს ეკრანზე შეგიძლიათ, თარგმნოთ ტექსტი და სურათები</translation>
<translation id="1383876407941801731">ძიება</translation>
<translation id="1414495520565016063">თქვენ შესული ხართ Decentr-ში!</translation>
<translation id="1465192221147974788">თქვენი ფანჯრის გასაზიარებლად დაუშვით ეკრანის ჩაწერა Decentr-ისთვის სისტემის პარამეტრებში.</translation>
<translation id="1478370723027452770">დახმარების მიღება Decentr for Testing-თან დაკავშირებით</translation>
<translation id="1497802159252041924">შეცდომა ინსტალაციისას: <ph name="INSTALL_ERROR" /></translation>
<translation id="1524282610922162960">Decentr ჩანართის გაზიარება</translation>
<translation id="1547469039832541117">დაასრულებს მონიშნულ ამოცანას.</translation>
<translation id="1553461853655228091">Decentr საჭიროებს თქვენს კამერაზე წვდომის ნებართვას, თქვენი გარემოს 3-განზომილებიანი რუკის შექმნა რომ შეძლოს</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{ეს გაფართოება აღარ არის მხარდაჭერილი. Decentr გირჩევთ მის ამოშლას.}other{ეს გაფართოებები აღარ არის მხარდაჭერილი. Decentr გირჩევთ, ამოშალოთ ისინი.}}</translation>
<translation id="1574377791422810894">Decentr-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="1591808205441691831">Decentr საჭიროებს თქვენი ვინაობის დადასტურებას, სანამ მონაცემები Google ანგარიშში შეინახება და მოწყობილობებში გამოიყენება. გამოსვლის შემთხვევაში ეს მონაცემები დარჩება ამ მოწყობილობაში.</translation>
<translation id="1594928384848033697">Decentr-ს სურს თქვენი პაროლების მმართველის მონაცემების წაშლა. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას}=1{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს Decentr-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="1625909126243026060">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Decentr-ში</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1709772298389099340">უზრუნველყოფს მაღალ პრივილეგიებს <ph name="BROWSER_NAME" />-ისთვის.</translation>
<translation id="1715127912119967311">ამ ფუნქციების გაუმჯობესების მიზნით, თქვენს მათთან ურთიერთქმედებას Decentr გაუგზავნის Google-ს. აღნიშნული მონაცემების წაკითხვა, დამუშავება და ანოტირება, შესაძლოა, განხორციელდეს ადამიანი მიმომხილველების მიერ.</translation>
<translation id="1722488837206509557">ამის საშუალებით თქვენ აირჩევთ ხელმისაწვდომი მოწყობილობებიდან და მათზე კონტენტს აჩვენებთ.</translation>
<translation id="1733725117201708356">Decentr მალე წაშლის დათვალიერების მონაცემებს</translation>
<translation id="1736443181683099871">Decentr შეეცდება, გადაიტანოს ნავიგაცია HTTPS-ზე</translation>
<translation id="1736662517232558588">Decentr-ის მონაცემები გასუფთავდა</translation>
<translation id="1745121272106313518">Decentr გაეშვება <ph name="REMAINING_TIME" />-ში</translation>
<translation id="1749104137266986751">როცა HTTPS მიუწვდომელია, Decentr გამოიყენებს დაუცველ კავშირს თქვენი გაფრთხილების გარეშე</translation>
<translation id="1774152462503052664">დავრთოთ ნება Decentr-ს გაშვებული იყოს ფონურ რეჟიმში</translation>
<translation id="1779356040007214683">Decentr-ის უსაფრთხოების გაზრდის მიზნით, ჩვენ გავთიშეთ რამდენიმე გაფართოება, რომელიც არ არის ჩამოთვლილი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, დამატებულია თქვენი თანხმობის გარეშე.</translation>
<translation id="1808667845054772817">Decentr-ის ხელახალი ინსტალაცია</translation>
<translation id="1820835682567584003">Decentr ცდილობს შემდეგს: <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1838374766361614909">ძიების გასუფთავება</translation>
<translation id="18552579716432081">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Google ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK" />გამოდით Decentr-იდან<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Google ანგარიშები. თქვენი Google ანგარიშები გამოიყენება Decentr ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="1863308913976887472">საიტებს Decentr-ის მეშვეობით შეუძლია თქვენს ინტერესებთან დაკავშირებული ინფორმაციის შენახვა. მაგალითად, თუ მარათონისთვის ფეხსაცმლის საყიდლად რომელიმე საიტს მოინახულებთ, აღნიშნულმა საიტმა შეიძლება განსაზღვროს, რომ მარათონებში მონაწილეობა გაინტერესებთ. მოგვიანებით, თუ განსხვავებულ საიტს მოინახულებთ, მაგალითად, რბოლაში მონაწილეობის მისაღებად რეგისტრაციისთვის, ამ საიტმა შეიძლება სპორტული ფეხსაცმლის რეკლამა გაჩვენოთ თქვენი ინტერესების საფუძველზე.</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="1881322772814446296">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Decentr-ის პროფილზე. თქვენი Decentr-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME" />-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Google ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Decentr-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Decentr დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">Decentr-ის განმაახლებელი სერვისი</translation>
<translation id="1911763535808217981">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Decentr-ში შესვლის გარეშე</translation>
<translation id="1916451563296275579">ამ აპების მონაცემების Decentr-იდან ამოშლა</translation>
<translation id="1929939181775079593">Decentr არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="1933341829955786215">თქვენი ორგანიზაცია, <ph name="MANAGER" />, მოითხოვს, რომ Decentr-ში შეხვიდეთ</translation>
<translation id="193439633299369377">განახლების მისასადაგებლად DecentrOS უნდა გადაიტვირთოს.</translation>
<translation id="1951406923938785464">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE" /> წუთი</translation>
<translation id="1966382378801805537">Decentr ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="1990262977744080398">შეიტყვეთ, რატომ ბლოკავს Decentr ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="1999715455684970349">იზრუნებს, რომ თქვენი Decentr-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, Decentr-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე Decentr-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="2008474315282236005">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Decentr-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2020032459870799438"><ph name="BEGIN_LINK" />შედით Decentr-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს სხვა პაროლებს.</translation>
<translation id="2049376729098081731">აირჩიეთ, დაერთოს თუ არა Decentr ისტორია, Google სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="2054039611381840095">მომავალში Decentr-ის განახლებების მისაღებად დაგჭირდებათ macOS 12 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 11-ს.</translation>
<translation id="2086476982681781442">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="2088953378266246249">ინფორმაცია Decentr-ის მიერ თავისი ძირეული სერტიფიკატების მართვის შესახებ</translation>
<translation id="2099452623287920103">თქვენი პაროლები და Decentr-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Google ანგარიშში, ამოიშლება ამ მოწყობილობიდან. Decentr-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Decentr არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Decentr არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
<translation id="2126108037660393668">ჩამოტვირთული ფაილის დადასტურება ვერ მოხერხდა.</translation>
<translation id="2137162749895930932">თარგმნის ეკრანის დახურვა</translation>
<translation id="215352261310130060">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს საიტი არ იყენებს დაცულ კავშირს, ამიტომ ფაილი, შესაძლოა, მოდიფიცირებული იყოს</translation>
<translation id="2157600032285353789">Decentr-ის მენიუდან შეგიძლიათ სანიშნეების, წაკითხვის რეჟიმისა და სხვა ერთეულების გახსნა</translation>
<translation id="2174178932569897599">Decentr-ის მორგება</translation>
<translation id="2174917724755363426">ინსტალაცია არ დასრულებულა. ნამდვილად გსურთ გაუქმება?</translation>
<translation id="2185166961232948079">Decentr — ქსელში შესვლა — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">შეცდომა განახლების შემოწმებისასr: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">ანგარიშის ამოშლა Decentr-იდან</translation>
<translation id="2210682093923538346">სახიფათო საიტი Decentr-მა ამოშალა შეტყობინებები.</translation>
<translation id="2236949375853147973">ჩემი აქტივობა</translation>
<translation id="2238130810669087193">შედით Decentr-ში, რომ მიიღოთ მისამართები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს მისამართი შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="2240214816234246077">ბოლო დროს არ ყოფილხართ. Decentr-მა ამოშალა <ph name="PERMISSION_1" /> და <ph name="PERMISSION_2" /></translation>
<translation id="2241627712206172106">თუ თქვენ გაზიარებული გაქვთ კომპიუტერი, თქვენი მეგობრები და ოჯახის წევრები შეძლებენ დამოუკიდებლად დათვალიერებას და Decentr-ის დაყენებას სურვილისამებრ.</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Decentr გირჩევთ, დააპაუზოთ ჩანართი, რომელიც ანელებს თქვენი ბრაუზერის მუშაობას}other{Decentr გირჩევთ, დააპაუზოთ ჩანართები, რომლებიც ანელებს თქვენი ბრაუზერის მუშაობას}}</translation>
<translation id="2313870531055795960">შეამოწმებს URL-ების თანხვედრას Decentr-ში შენახულ არაუსაფრთხო საიტების სიასთან. საიტის მიერ პაროლის მოპარვის მცდელობის ან თქვენ მიერ საზიანო ფაილის ჩამოტვირთვის შემთხვევაში Decentr-ის მიერ Safe Browsing-ს გაეგზავნება URL-ები და შესაბამისი გვერდის კონტენტის გარკვეული ნაწილი.</translation>
<translation id="2343156876103232566">აქედან თქვენს Android ტელეფონზე ნომრის გასაგზავნად შედით Decentr-ში ორივე მოწყობილობაზე.</translation>
<translation id="2359808026110333948">გაგრძელება</translation>
<translation id="2361918034042471035">„<ph name="EXTENSION_NAME" />“ გაფართოების გამოსაყენებლად შედით Decentr-ში</translation>
<translation id="236943522426971115">Decentr-ის აპების ფონურ რეჟიმში მუშაობის გათიშვა</translation>
<translation id="2374216753258219393">ეს გაფართოება რომ გამოიყენოთ <ph name="USER_EMAIL_ADDRESS" /> ანგარიშით, შედით Decentr-ში.</translation>
<translation id="2384373936468275798">DecentrOS-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან თქვენი ანგარიშის შესვლის დეტალები მოძველდა.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{1 HID მოწყობილობაზე წვდომა ხორციელდებოდა ერთი ან რამდენიმე Decentr გაფართოების მიერ}=1{1 HID მოწყობილობაზე წვდომა ხორციელდება ერთი ან რამდენიმე Decentr გაფართოების მიერ}other{# HID მოწყობილობაზე წვდომა ხორციელდება ერთი ან რამდენიმე Decentr გაფართოების მიერ}}</translation>
<translation id="2401032172288869980">Decentr საჭიროებს კამერისა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2403703063067034158">გაშვების შეცდომა: გაშვების სხვა პროცესი მიმდინარეობს, მოგვიანებით ცადეთ.</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Decentr-ში არსებული ხელსაწყოები<ph name="END_LINK" /> დაგეხმარებათ, უსაფრთხოდ დაათვალიეროთ ვები და შეინარჩუნოთ კონტროლი</translation>
<translation id="2451727308784734061">ისარგებლეთ მალსახმობით, პაროლების მმართველზე სწრაფად რომ გადახვიდეთ. მალსახმობის გადატანა შეგიძლიათ თქვენი კომპიუტერის მთავარ ეკრანზე ან აპების გამშვებში.</translation>
<translation id="2478295928299953161">Decentr მალე დაიხურება</translation>
<translation id="2483889755041906834">Decentr-ში</translation>
<translation id="2485422356828889247">დეინსტალაცია</translation>
<translation id="2513154137948333830">საჭიროა გადატვირთვა: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">მონიშნეთ ტექსტი სურათების ძიებით</translation>
<translation id="2554739539410784893">Decentr ცდილობს არსებული პაროლების ჩანაცვლებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="2560420686485554789">ფაილების ჩამოსატვირთად Decentr საჭიროებს მეხსიერებაზე წვდომას</translation>
<translation id="2572494885440352020">Decentr-ის დამხმარე</translation>
<translation id="2575822587468774919">აირჩიეთ ის, რისი მოძებნაც გსურთ სურათების ძიებით</translation>
<translation id="2576118232315942160">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Decentr-ში</translation>
<translation id="2583187216237139145">ამ პროფილის გამოყენებისას შექმნილი Decentr მონაცემების (მაგ., შექმნილი სანიშნეების, ისტორიის, პაროლებისა და სხვა პარამეტრების) ამოშლა შეუძლია სამსახურის პროფილის ადმინისტრატორს. <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">Decentr-ის გამოყენების გაგრძელება</translation>
<translation id="259935314519650377">ჩამოტვირთული ინსტალატორის ქეშირება ვერ მოხერხდა. შეცდომა: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">სისტემა</translation>
<translation id="2629740064077610681">თქვენს ორგანიზაციას შეუძლია თქვენ მიერ ვების დათვალიერების მონაცემების (მაგალითად, თქვენი სანიშნეების, ისტორიისა და პაროლების) ნახვა და მართვა. ის ვერ შეძლებს თქვენი დათვალიერების მონაცემების ნახვას Decentr-ის სხვა პროფილებში.</translation>
<translation id="2635452620547538388">დაადასტურეთ ვინაობა, რომ გამოიყენოთ და შეინახოთ თქვენი Decentr-ის მონაცემები თქვენს ანგარიშში, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="264613044588233783">Decentr უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს (რეკომენდებული)</translation>
<translation id="2648074677641340862">ინსტალაციის დროს ოპერაციული სისტემის შეცდომა მოხდა. ხელახლა ჩამოტვირთეთ Decentr.</translation>
