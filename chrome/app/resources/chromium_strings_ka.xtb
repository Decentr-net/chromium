<translation id="6174920971222007286">ეს ფაილი, შესაძლოა, სახიფათო იყოს<ph name="LINE_BREAK" />tomi-ს შეუძლია, თქვენ ნაცვლად შეამოწმოს ეს ჩამოტვირთვა, თუ პაროლს მიუთითებთ. ფაილის შესახებ ინფორმაცია ეგზავნება tomi Safe Browsing-ს, თუმცა ფაილების შიგთავსი და პაროლი რჩება თქვენს მოწყობილობაზე.</translation>
<translation id="6182736845697986886">ინსტალაცია ვერ მოხერხდა განახლების სერვერის შიდა შეცდომის გამო.</translation>
<translation id="6183079672144801177">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ tomi-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="6212496753309875659">ამ კომპიუტერს უკვე აქვს tomi.-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ tomi-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="6219195342503754812">{0,plural, =0{tomi ახლა ხელახლა გაეშვება}=1{tomi ხელახლა გაეშვება 1 წამში}other{tomi ხელახლა გაეშვება # წამში}}</translation>
<translation id="6241367896540709610">ფაილების ჩამოსატვირთად tomi საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6245734527075554892">შეამოწმებს URL-ების თანხვედრას tomi-ში შენახულ არაუსაფრთხო საიტების სიასთან</translation>
<translation id="6248213926982192922">tomi გახდეს ნაგულისხმევი ბრაუზერი</translation>
<translation id="6266342355635466082">tomi ვერ ახერხებს განახლებების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="6268381023930128611">გსურთ tomi-იდან გამოსვლა?</translation>
<translation id="6270547683008298381">ეს ჩანართები დამატებით რესურსებს მოიხმარს. ეფექტურობის გაზრდის მიზნით, ნება დართეთ tomi-ს, ჩანართები უმოქმედო რეჟიმში გადაიტანოს.</translation>
<translation id="6281746429495226318">თქვენი tomi პროფილის მორგება</translation>
<translation id="6290827346642914212">დაასათაურეთ თქვენი tomi პროფილი</translation>
<translation id="6294831894865512704">გაფართოების გამოსაყენებლად შედით tomi-ში</translation>
<translation id="6295779123002464101">tomi-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6309712487085796862">tomi იყენებს თქვენს კამერას.</translation>
<translation id="6327105987658262776">განახლებები ხელმისაწვდომი არ არის.</translation>
<translation id="6333502561965082103">tomi-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="6334986366598267305">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა tomi ანგარიშით tomi-ის გამოყენება.</translation>
<translation id="633626832589656416">tomi-ს შეუძლია, თქვენი ჩანართები უმოქმედო რეჟიმში გადაიტანოს, რათა გააუმჯობესოს თქვენი დათვალიერების გამოცდილება და უზრუნველყოს სისწრაფე.</translation>
<translation id="6347933965114150440">tomi-ის მალსახმობი</translation>
<translation id="6366160072964553914">tomi-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="6373523479360886564">ნამდვილად გსურთ მოახდინოთ tomi-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6384011394608460044"><ph name="BEGIN_BOLD" />ამ მონაცემთა გამოყენების წესი:<ph name="END_BOLD" /> tomi-ს შეუძლია თქვენი ინტერესების პროგნოზირება. მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, tomi-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით.</translation>
<translation id="6400112897226594999">tomi-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="6403826409255603130">tomi არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ tomi-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="6442900851116057561">გადატვირთეთ tomiOS</translation>
<translation id="6443470774889161065">tomi წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="645458117210240797">გამორთული • tomi ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="6455857529632101747">მოგესალმებათ tomi პროფილები</translation>
<translation id="6466344609055215035">ანგარიშის ამოშლა tomi-იდან</translation>
<translation id="6475912303565314141">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება tomi-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="6510925080656968729">tomi-ის დეინსტალაცია</translation>
<translation id="651535675648445253">მალსახმობები იხსნება tomi-ში</translation>
<translation id="6524389414524528185">როცა შესული ხართ, tomi-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი tomi ანგარიშიდან. ამის შეცვლა შეგიძლიათ ნებისმიერ დროს, მდებარეობის პარამეტრებიდან.</translation>
<translation id="6539122709674868420">თქვენი ორგანიზაცია ხურავს tomi-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="6542839706527980775">თითოეულ პროფილში ინახება საკუთარი tomi ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6563921047760808519">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს tomi თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="656935081669708576">ახლა შეგიძლიათ გადართვა, პაროლები სხვა tomi პროფილიდან რომ ნახოთ</translation>
<translation id="6570579332384693436">მართლწერის შეცდომების გასასწორებლად, tomi თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს tomi-ს უგზავნის</translation>
<translation id="6598877126913850652">tomi-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6613594504749178791">თქვენი ცვლილებები გააქტიურდება tomi-ის შემდეგი გაშვებისას.</translation>
<translation id="665732753414869868">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად tomi საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6663852025006259149">საიტები, სავარაუდოდ, მოლოდინისამებრ იმუშავებს, თუმცა ისინი არ დაგიმახსოვრებთ, როცა tomi-ის ყველა ფანჯარას დახურავთ</translation>
<translation id="6669284030132180248">თუ თქვენს სანიშნეებს tomi ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს tomi-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="668175097507315160">tomiOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="6692797197837897398">tomi გაძლევთ მეტ კონტროლს თქვენთვის ხილულ რეკლამაზე. ის, ასევე, ზღუდავს იმას, თუ რომელ საიტებს შეუძლია თქვენ შესახებ ინფორმაციის მიღება, როცა მათ მიერ თქვენთვის ნაჩვენებია პერსონალიზებული რეკლამა.</translation>
<translation id="6709350901466051922">tomi საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="6717134281241384636">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის tomi-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ tomi-ის ახალი ვერსია.</translation>
<translation id="6729124504294600478">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ tomi როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ tomi სერვისებს</translation>
<translation id="6734291798041940871">tomi უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="673636774878526923">თქვენს tomi კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, შემდეგ კი ჩართეთ სინქრონიზაცია.</translation>
<translation id="674245979920622322">ბოლო დროს არ ყოფილხართ. tomi-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" /></translation>
<translation id="67706546131546258">tomi გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6779406956731413166">tomiOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS" />ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6847869444787758381">tomi გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME" /> დაშვებულთა სიაშია.</translation>
<translation id="6857782730669500492">tomi — <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">tomi-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME" />“ შეიცავს მავნე პროგრამას</translation>
<translation id="6929417474050522668">როცა ცდები ჩართულია, რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, tomi-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="6940431691900807093">მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, tomi-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით. tomi-ს შეუძლია 3-მდე ინტერესის გაზიარება.</translation>
