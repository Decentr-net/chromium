<translation id="3667616615096815454">ინსტალაცია ვერ მოხერხდა, რადგან აპლიკაცია სერვერისთვის ცნობილი არ არის.</translation>
<translation id="3685209450716071127">Decentr ვერ ახერხებს პაროლების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას}=1{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Decentr-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="3713809861844741608">ბმულის გახსნა Decentr-ის ახალ ჩა&amp;ნართში</translation>
<translation id="3728124580182886854">მიაბით ერთმანეთს Decentr და სხვა Google სერვისები პერსონალიზებისა და სხვა მიზნით</translation>
<translation id="3788675262216168505">Decentr-ის პროფილების მართვა</translation>
<translation id="3790262771324122253">შეიტყვეთ, რატომ ბლოკავს Decentr ზოგიერთ ჩამოტვირთვას</translation>
<translation id="379589255253486813">Decentr გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="3802055581630249637">Decentr წინასწარ ჩატვირთავს გვერდებს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="3830894615770080216">DecentrOS სისტემა</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="3885770153807205175">ენის ამომრჩევი</translation>
<translation id="388648406173476553">მოირგეთ და გააკონტროლეთ Decentr. საჭიროა თქვენი ყურადღება — დააწკაპუნეთ დეტალური ინფორმაციისთვის.</translation>
<translation id="3889543394854987837">Decentr ის გახსნისა და დათვალიერების დაწყებისათვის დააჭირეთ თქვენი სახელს.</translation>
<translation id="3892148308691398805">ტექსტის კოპირება</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> უკვე შესულია ამ Decentr პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Decentr-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="3909353120217047026">ეს გაფართოება არღვევს Decentr Web Store-ის წესებს და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის Decentr-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="3941890832296813527">შეცდომა ინსტალაციისას: ინსტალატორის ფაილის სახელი არასწორი ან მხარდაუჭერელია.</translation>
<translation id="3945058413678539331">Decentr ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="3954172517175569325">ამ მოწყობილობიდან ამოიშლება თქვენი პაროლები, გადახდის მეთოდები და მისამართები, რომლებიც შეინახეთ თქვენს Google ანგარიშში. Decentr-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="3962647064319009959">შეიტყვეთ, როგორ ზრუნავს Decentr თქვენს უსაფრთხოებაზე</translation>
<translation id="3975724895399328945">Decentr for Testing-ის შ&amp;ესახებ</translation>
<translation id="3997429360543082038">DecentrOS-ის შესახებ</translation>
<translation id="4019629340646866719">DecentrOS და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო <ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="4022972681110646219">ეკრანის თარგმნა</translation>
<translation id="4023601594785368013">ორიგინალის ენა: <ph name="LANGUAGE" /></translation>
<translation id="4036079820698952681">ხელი შეუწყვეთ Decentr-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="4055805654398742145">პ&amp;აროლების მმართველი</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს Decentr-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს Decentr-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}}</translation>
<translation id="4118474109249235144">Decentr-ის ინკოგნიტო რეჟიმი</translation>
<translation id="4122186850977583290">Decentr-ის შესახებ ინფორმაციის გვერდზე გადასვლა</translation>
<translation id="4148957013307229264">ინსტალაცია…</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> — ქსელში შესვლა — Decentr</translation>
<translation id="421369550622382712">აღმოაჩინეთ შესანიშნავი აპები, თამაშები, გაფართოებები და თემები Decentr-ისთვის.</translation>
<translation id="4217080900579554343">ამ გაფართოების და სხვა ერთეულების თქვენს კომპიუტერზე მისაღებად შედით Decentr-ში</translation>
<translation id="4217972271355023382">ონლაინ უსაფრთხოების დასაცავად, თქვენი მშობლის არჩევანით, გადართეთ Decentr პროფილზე, რომელშიც უკვე შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">მიმდინარეობს გაუქმება…</translation>
<translation id="4224210481850767180">ინსტალაცია გაუქმდა.</translation>
<translation id="4230135487732243613">დავუკავშიროთ თქვენი Decentr მონაცემები ამ ანგარიშის?</translation>
<translation id="4251772536351901305">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Google-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Decentr-ის გაფრთხილებები.</translation>
<translation id="4269093074552541569">Decentr-იდან გასვლა</translation>
<translation id="4271805377592243930">Decentr-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4281844954008187215">მომსახურების პირობები</translation>
<translation id="4285930937574705105">ინსტალაცია ვერ განხორციელდა განუსაზღვრელი შეცდომის გამო. თუ Decentr ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="4304713468139749426">პაროლების მმართველი</translation>
<translation id="4334294535648607276">ჩამოტვირთვა დასრულდა.</translation>
<translation id="439358628917130594"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის DecentrOS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="4407044323746248786">მაინც გსურთ Decentr-იდან გასვლა?</translation>
<translation id="4413205837991854510">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="4415566066719264597">Decentr-ისთვის ფონურ რეჟიმში მუშაობის დაშვება</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Decentr გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}other{Decentr გირჩევთ მათ ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">Decentr-ის მორგება და კონტროლი</translation>
<translation id="4427306783828095590">გაძლიერებული დაცვა გთავაზობთ ფიშინგისა და მავნე პროგრამებისგან დაცვის მეტ საშუალებას</translation>
<translation id="4434353761996769206">ინსტალატორის შეცდომა: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614"><ph name="MANAGER" /> მართავს Decentr-ს</translation>
<translation id="444069871276811466">Decentr პროფილის დამატება</translation>
<translation id="4447409407328223819">Decentr for Testing-ის შესახებ</translation>
<translation id="4470974262661801543">თქვენს Google ანგარიშში Decentr-ის მონაცემები რომ გამოიყენოთ და შეინახოთ, შეიყვანეთ თქვენი საიდუმლო ფრაზა</translation>
<translation id="4493028449971051158">გაშვების შეცდომა: ინსტალატორი გაუშვით, როგორც ადმინისტრატორმა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="4510853178268397146">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. Decentr გირჩევთ მის ამოშლას.</translation>
<translation id="452711251841752011">მოგესალმებით Decentr-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="4531137820806573936">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის Decentr საჭრიროებს ნებართვას</translation>
<translation id="4534145890176164066">Decentr ფორმებს უკეთ აღიქვამს და უფრო სწრაფად შეუძლია მათი შევსება</translation>
<translation id="4536805923587466102">თქვენ უკვე შესული ხართ Decentr-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4548534452171747496">Decentr წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK" /></translation>
<translation id="4567424176335768812">თქვენ შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" />. ახლა შეგიძლიათ გახსნათ თქვენი სანიშნეები, ისტორია და სხვა პარამეტრები ყველა მოწყობილობიდან, რომელშიც შესული ხართ.</translation>
<translation id="4570813286784708942">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="459535195905078186">Decentr პროგრამები</translation>
<translation id="4598116752460667024">სიიდან ნებისმიერი პროცესის მოძიება.</translation>
<translation id="4613863813562375431">DecentrOS-ის ვერსია</translation>
<translation id="4621240073146040695">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Decentr.</translation>
<translation id="4665829708273112819">გაფრთხილება: Decentr ვერ შეუშლის ხელს გაფართოებებს დათვალიერების ისტორიის შენახვაში. ინკოგნიტო რეჟიმში ამ გაფართოების გასათიშად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="4673151026126227699">თუ Decentr-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="4677944499843243528">როგორც ჩანს, პროფილი გამოიყენება სხვა Decentr პროცესის მიერ (<ph name="PROCESS_ID" />) სხვა კომპიუტერში (<ph name="HOST_NAME" />). Decentr-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Decentr.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="469259825538636168">თქვენი Decentr-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="4708193446201257833">როცა შესული ხართ, Decentr-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. <ph name="SHORTCUT" /> შეცვლის თქვენი Google სერვისების პარამეტრებს.</translation>
<translation id="4708774505295300557">Decentr-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Decentr-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="4746050847053251315">მაინც გსურთ Decentr-იდან გასვლა?</translation>
<translation id="4748217263233248895">Decentr-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="4788777615168560705">Decentr ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში ან <ph name="BEGIN_LINK" />შეამოწმეთ პაროლები თქვენს Google ანგარიშში<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Google Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Google-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="4814736265800133385">Decentr-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="4888717733111232871">Decentr-ის შემავალი წესი დაუშვას mDNS მოძრაობა.</translation>
<translation id="4893347770495441059">ხელახლა გაშვება &amp;Decentr-ის გასაახლებლად</translation>
<translation id="4918844574251943176">სურათი დაკოპირდა</translation>
<translation id="4943838377383847465">Decentr ფონურ რეჟიმშია.</translation>
<translation id="494490797786467921">დააწკაპუნეთ Decentr-ის შესვლის დიალოგის დასახურად</translation>
<translation id="4950660488495335294">Decentr პროფილები Decentr-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="4987820182225656817">სტუმრებს შეუძლიათ Decentr-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="4994636714258228724">საკუთარი თავის დამატება Decentr-ში</translation>
<translation id="5123973130450702873">Decentr-ს სჭირდება ნებართვა თქვენი ხელების მოძრაობაზე თვალის მისადევნებლად</translation>
<translation id="5174969993834422967">როგორც წესი, თქვენ ბლოკავთ შეტყობინებებს. ამ საიტისგან შეტყობინებების მისაღებად დააწკაპუნეთ მდებარეობის ზოლის მარჯვენა კუთხეში მდებარე ხატულას.</translation>
<translation id="5187123684706427865">Decentr ანგარიში საჭიროებს ხელახლა ავტორიზაციას</translation>
<translation id="5224391634244552924">შენახული პაროლები არ არის. პაროლების შემოწმებას Decentr შეძლებს მათი შენახვის შემდეგ.</translation>
<translation id="5231355151045086930">Decentr-იდან გამოსვლა</translation>
<translation id="5234764350956374838">გაუქმება</translation>
<translation id="5277894862589591112">ცვლილებების მისასადაგებლად ხელახლა გაუშვით Decentr</translation>
<translation id="5286907366254680517">ამოცნობილია</translation>
<translation id="5294316920224716406">ვების ინკოგნიტო რეჟიმში დათვალიერებისას Decentr გაგაფრთხილებთ საიტის დაუცველი კავშირის გამოყენებით ჩატვირთვამდე</translation>
<translation id="5296845517486664001">როცა ცდები ჩართულია და თუ Decentr შემთხვევითობის პრინციპით მიგაღებინებთ მონაწილეობას მიმდინარე ცდაში, თქვენ მიერ ვების დათვალიერების ისტორია აისახება თქვენთვის ხილულ რეკლამასა და თქვენს ინტერესებზე, ქვემოთ პროგნოზირებულის შესაბამისად. თქვენი კონფიდენციალურობის დაცვის მიზნით, Decentr წაშლის თქვენს ინტერესებს ყოველთვიურად რიგითობის მიხედვით.</translation>
<translation id="5313228254328109263">Decentr-ის განმაახლებელი შიდა სერვისი</translation>
<translation id="5352264705793813212">Decentr-მა თქვენთვის იპოვა უსაფრთხოებასთან დაკავშირებული რეკომენდაციები</translation>
<translation id="5352361688875342522">სხვა Decentr პროფილები</translation>
<translation id="5358375970380395591">მართული ანგარიშით შედიხართ სისტემაში და ადმინისტრატორს თქვენს Decentr-ის პროფილზე კონტროლს აძლევთ. თქვენი Decentr ის მონაცემები როგორიცაა თქვენი აპლიკაციები, სანიშნები, ისტორიები, პაროლები, და სხვა პარამეტრები მუდმივად მიბმული გახდება <ph name="USER_NAME" />-თან. ამ მონაცემების წაშლას Google ანგარიშის საინფორმაციო დაფის გზით შეძლებთ, მაგრამ შეუძლებელი იქნება ამ მონაცემების სხვა ანგარიშთან გაერთიანება. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">დამატებითი კოდი: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">პერსონალიზაციით რომ ისარგებლოთ, დაურთეთ Decentr ვებსა და აპებში აქტივობას</translation>
<translation id="5383439451358640070">შეიტყვეთ, რატომ ბლოკავს Decentr ზოგიერთ ფაილს</translation>
<translation id="5386450000063123300">მიმდინარეობს Decentr-ის განახლება (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Decentr-ში შესვლის დაშვება</translation>
<translation id="5405650547142096840">Decentr-იდან ამოღება</translation>
<translation id="5427571867875391349">დააყენეთ Decentr ნაგულისხმევ ბრაუზერად</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> — Decentr Beta</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Decentr გირჩევთ, დააპაუზოთ ჩანართი, რომელიც ანელებს თქვენი ბრაუზერის მუშაობას}other{Decentr გირჩევთ, დააპაუზოთ ჩანართები, რომლებიც ანელებს თქვენი ბრაუზერის მუშაობას}}</translation>
<translation id="5473971139929175403">Decentr-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი ამ Linux დისტრიბუტივზე</translation>
<translation id="5475924890392386523">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ფაილს შეუძლია თქვენი პირადი და სოციალური ქსელების ანგარიშების დაზიანება.</translation>
<translation id="5480860683791598150">Decentr საჭიროებს თქვენს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის გასაზიარებლად</translation>
<translation id="5487574057737591516">თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. თუ Decentr შეცდომით გამოიცნობს თქვენს ინტერესს, ან რომელიმე ტიპის რეკლამის ნახვას არ მოისურვებთ, ინტერესის წაშლის საშუალება გექნებათ.</translation>
<translation id="549669000822060376">დაელოდეთ, სანამ Decentr დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="5496810170689441661">Decentr ცდილობს პაროლების რედაქტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="5527463683072221100">PDF-ების გახსნა Decentr-ში</translation>
<translation id="5579324208890605088">გაშვების შეცდომა: გაუშვით ინსტალატორი, როგორც რიგითმა მომხმარებელმა და არა — ადმინისტრატორმა.</translation>
<translation id="5596627076506792578">დამატებითი ვარიანტები</translation>
<translation id="5605834417512968703">აირჩიეთ ის, რისი მოძებნაც გსურთ სურათების ძიებით ან სურათების ძიებიდან გასასვლელად დააჭირეთ Escape კლავიშს</translation>
<translation id="5618818588972826921">მონიშნეთ ნებისმიერი ტექსტი თუ სურათი, რომლის მოძებნაც გსურთ სურათების ძიებით ან დააჭირეთ Escape ღილაკს, რომ გახვიდეთ სურათების ძიებიდან</translation>
<translation id="5623402015214259806">{0,plural, =0{ხელმისაწვდომია Decentr-ის განახლება}=1{ხელმისაწვდომია Decentr-ის განახლება}other{უკვე # დღეა, რაც ხელმისაწვდომია Decentr-ის განახლება}}</translation>
<translation id="5643865575100044307">Decentr-ის დახურვისას თქვენი მოწყობილობიდან საიტების მონაცემების ყოველთვის წაშლა</translation>
<translation id="5653831366781983928">გთხოვთ, ახლავე გადატვირთოთ Decentr</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Decentr-ის ამ ენაზე ჩვენება</translation>
<translation id="569897634095159764">ინტერნეტთან დაკავშირება ვერ ხერხდება. პროქსი-სერვერი საჭიროებს ავტორიზაციას.</translation>
<translation id="5761096224651992291">ბოლო დროს არ ყოფილხართ. Decentr-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და <ph name="PERMISSION_3" /></translation>
<translation id="5768371961535086509">Decentr გაასუფთავებს მეხსიერებას უმოქმედო ჩანართებიდან. აქტიურ ჩანართებსა და სხვა აპებს კომპიუტერის მეტი რესურსის გამოყენების საშუალება მიეცემა, რაც დააჩქარებს Decentr-საც. თქვენი არააქტიური ჩანართები ავტომატურად გააქტიურდება, როცა მათ დაუბრუნდებით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მეხსიერების დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">საიდუმლო ფრაზის დავიწყების ან ამ პარამეტრის შეცვლის სურვილის შემთხვევაში, ცადეთ Decentr მონაცემების <ph name="SETTINGS_LINK" /> თქვენს ანგარიშში</translation>
<translation id="5800158606660203929">მოირგეთ და მართეთ Decentr. დააყენეთ Decentr ნაგულისხმევად.</translation>
<translation id="5809516625706423866">ინტერნეტთან დაკავშირება ვერ ხერხდება. HTTP 401 — არ არის ავტორიზაცია. შეამოწმეთ პროქსი-სერვერის კონფიგურაცია.</translation>
<translation id="5821520528363214608">Decentr-ის მონაცემების თქვენს Google ანგარიშში გამოყენებისა და შენახვისთვის განაახლეთ Decentr</translation>
<translation id="5862307444128926510">მოგესალმებათ Decentr!</translation>
<translation id="5871205389137001634">დააწკაპუნეთ სურათების ძიებიდან გასასვლელად</translation>
<translation id="5883558403894052917">Decentr-მა აღმოაჩინა, რომ შემდეგი ერთეულები შეიცავს მავნე პროგრამას:</translation>
<translation id="5889361821821684993">Decentr რეგულარულად ამოწმებს, არის თუ არა თქვენს ბრაუზერში ყველაზე უსაფრთხო პარამეტრები. გაცნობებთ, თუ რაიმეს შემოწმება იქნება საჭირო.</translation>
<translation id="5895138241574237353">გადატვირთვა</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — ქსელში შესვლა</translation>
<translation id="5924017743176219022">მიმდინარეობს ინტერნეტთან დაკავშირება...</translation>
<translation id="5941711191222866238">ჩაკეცვა</translation>
<translation id="5949225980829865667">ამ სანიშნისა და სხვა კონტენტის თქვენს მოწყობილობაში მისაღებად შედით Decentr-ში</translation>
<translation id="5972142260211327093">თუ Decentr შემთხვევითობის პრინციპით მიგაღებინებთ მონაწილეობას მიმდინარე ცდაში, თქვენ მიერ ვების დათვალიერების ისტორია აისახება თქვენთვის ხილულ რეკლამასა და თქვენს ინტერესებზე, ქვემოთ პროგნოზირებულის შესაბამისად. თქვენი კონფიდენციალურობის დაცვის მიზნით, Decentr წაშლის თქვენს ინტერესებს ყოველთვიურად რიგითობის მიხედვით. ინტერესები გაახლდება, თუ რომელიმე მათგანს არ წაშლით.</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს Decentr-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს Decentr-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება.}}</translation>
<translation id="5987687638152509985">სინქრონიზაციის დასაწყებად, განაახლეთ Decentr</translation>
<translation id="5988505247484123880">თქვენ მიერ მონახულებული საიტები, როგორც წესი, ინახავს თქვენს ინტერესებს ფუნქციების თქვენზე მორგების მიზნით. საიტებს Decentr-ის მეშვეობითაც შეუძლია თქვენს ინტერესებთან დაკავშირებული ინფორმაციის შენახვა.</translation>
<translation id="6003112304606738118">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="HOURS" /> საათი</translation>
<translation id="6019451407441383358">Decentr-ის მენიუდან, რომელიც მოცემულია ზედა მარჯვენა ნაწილში, შეგიძლიათ სანიშნეების, წაკითხვის რეჟიმისა და სხვა ერთეულების გახსნა</translation>
<translation id="6040143037577758943">დახურვა</translation>
<translation id="6058380562449900225">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Decentr-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="6063093106622310249">Decentr-ში &amp;გახსნა</translation>
<translation id="6069027071882229820">სურათად კოპირება</translation>
<translation id="6072279588547424923"><ph name="EXTENSION_NAME" /> დაემატა Decentr-ს</translation>
<translation id="6072463441809498330">ააჩქარეთ Decentr-ის მუშაობა</translation>
<translation id="608006075545470555">დაამატეთ სამსახურის პროფილი ამ ბრაუზერს</translation>
<translation id="6096348254544841612">მოირგეთ და გააკონტროლეთ Decentr. ხელმისაწვდომია განახლება.</translation>
<translation id="6107893135096467929">ჩართული • Decentr ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="6119438414301547735">გაფართოებისთვის Decentr-ის ხელსაწყოთა ზოლში წვდომის მოთხოვნების ჩვენების დაშვება</translation>
<translation id="6129621093834146363">Decentr-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="6132897690380286411">Decentr მალე დაიხურება, ხოლო მონაცემები წაიშლება</translation>
<translation id="6145820983052037069">აქ შეგიძლიათ Decentr პროფილებს შორის გადართვა</translation>
<translation id="615103374448673771">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Decentr-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="6165508094623778733">შეიტყვეთ მეტი</translation>
<translation id="6173308241973263798">გაასუფთავეთ Decentr-ის მონაცემები თქვენს ანგარიშში</translation>
<translation id="6174920971222007286">ეს ფაილი, შესაძლოა, სახიფათო იყოს<ph name="LINE_BREAK" />Decentr-ს შეუძლია, თქვენ ნაცვლად შეამოწმოს ეს ჩამოტვირთვა, თუ პაროლს მიუთითებთ. ფაილის შესახებ ინფორმაცია ეგზავნება Google Safe Browsing-ს, თუმცა ფაილების შიგთავსი და პაროლი რჩება თქვენს მოწყობილობაზე.</translation>
<translation id="6182736845697986886">ინსტალაცია ვერ მოხერხდა განახლების სერვერის შიდა შეცდომის გამო.</translation>
<translation id="6183079672144801177">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ Decentr-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="6212496753309875659">ამ კომპიუტერს უკვე აქვს Decentr.-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ Decentr-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="6219195342503754812">{0,plural, =0{Decentr ახლა ხელახლა გაეშვება}=1{Decentr ხელახლა გაეშვება 1 წამში}other{Decentr ხელახლა გაეშვება # წამში}}</translation>
<translation id="6241367896540709610">ფაილების ჩამოსატვირთად Decentr საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6245734527075554892">შეამოწმებს URL-ების თანხვედრას Decentr-ში შენახულ არაუსაფრთხო საიტების სიასთან</translation>
<translation id="6248213926982192922">Decentr გახდეს ნაგულისხმევი ბრაუზერი</translation>
<translation id="6268381023930128611">გსურთ Decentr-იდან გამოსვლა?</translation>
<translation id="6270547683008298381">ეს ჩანართები დამატებით რესურსებს მოიხმარს. ეფექტურობის გაზრდის მიზნით, ნება დართეთ Decentr-ს, ჩანართები უმოქმედო რეჟიმში გადაიტანოს.</translation>
<translation id="6281746429495226318">თქვენი Decentr პროფილის მორგება</translation>
<translation id="6290827346642914212">დაასათაურეთ თქვენი Decentr პროფილი</translation>
<translation id="6294831894865512704">გაფართოების გამოსაყენებლად შედით Decentr-ში</translation>
<translation id="6295779123002464101">Decentr-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6309712487085796862">Decentr იყენებს თქვენს კამერას.</translation>
<translation id="6327105987658262776">განახლებები ხელმისაწვდომი არ არის.</translation>
<translation id="6333502561965082103">Decentr-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="6334986366598267305">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა Google ანგარიშით Decentr-ის გამოყენება.</translation>
<translation id="6347933965114150440">Decentr-ის მალსახმობი</translation>
<translation id="6366160072964553914">Decentr-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="6373523479360886564">ნამდვილად გსურთ მოახდინოთ Decentr-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6390800440335263989">გასაგრძელებლად შედით Decentr-ში ანგარიშით <ph name="EMAIL" />. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="6400112897226594999">Decentr-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="6403826409255603130">Decentr არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Decentr-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="6442900851116057561">გადატვირთეთ DecentrOS</translation>
<translation id="6443470774889161065">Decentr წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="645458117210240797">გამორთული • Decentr ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="6455857529632101747">მოგესალმებათ Decentr პროფილები</translation>
<translation id="6466344609055215035">ანგარიშის ამოშლა Decentr-იდან</translation>
<translation id="6475912303565314141">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Decentr-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="6510925080656968729">Decentr-ის დეინსტალაცია</translation>
<translation id="651535675648445253">მალსახმობები იხსნება Decentr-ში</translation>
<translation id="6524389414524528185">როცა შესული ხართ, Decentr-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. ამის შეცვლა შეგიძლიათ ნებისმიერ დროს, მდებარეობის პარამეტრებიდან.</translation>
<translation id="6539122709674868420">თქვენი ორგანიზაცია ხურავს Decentr-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="6542839706527980775">თითოეულ პროფილში ინახება საკუთარი Decentr ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6563921047760808519">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს Decentr თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="6564039629497156115">ამ პარამეტრის ცვლილება ამოქმედდება Decentr-ის გადატვირთვისთანავე.</translation>
<translation id="656935081669708576">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Decentr პროფილიდან რომ ნახოთ</translation>
<translation id="6570579332384693436">მართლწერის შეცდომების გასასწორებლად, Decentr თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Google-ს უგზავნის</translation>
<translation id="6598877126913850652">Decentr-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="6613594504749178791">თქვენი ცვლილებები გააქტიურდება Decentr-ის შემდეგი გაშვებისას.</translation>
<translation id="665732753414869868">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Decentr საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6669284030132180248">თუ თქვენს სანიშნეებს Google ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Decentr-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="668175097507315160">DecentrOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="6692797197837897398">Decentr გაძლევთ მეტ კონტროლს თქვენთვის ხილულ რეკლამაზე. ის, ასევე, ზღუდავს იმას, თუ რომელ საიტებს შეუძლია თქვენ შესახებ ინფორმაციის მიღება, როცა მათ მიერ თქვენთვის ნაჩვენებია პერსონალიზებული რეკლამა.</translation>
<translation id="6709350901466051922">Decentr საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="6717134281241384636">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Decentr-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Decentr-ის ახალი ვერსია.</translation>
<translation id="6729124504294600478">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Decentr როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Google სერვისებს</translation>
<translation id="6734291798041940871">Decentr უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="674245979920622322">ბოლო დროს არ ყოფილხართ. Decentr-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" /></translation>
<translation id="67706546131546258">Decentr გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6779406956731413166">DecentrOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS" />ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">თარგმნა</translation>
<translation id="6847869444787758381">Decentr გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME" /> დაშვებულთა სიაშია.</translation>
<translation id="6857782730669500492">Decentr — <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">Decentr-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME" />“ შეიცავს მავნე პროგრამას</translation>
<translation id="6896758677409633944">კოპირება</translation>
<translation id="6901631050894301805">დააყენეთ Decentr ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის თქვენს ამოცანათა ზოლში</translation>
<translation id="6929417474050522668">როცა ცდები ჩართულია, რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Decentr-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="6940431691900807093">მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, Decentr-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით. Decentr-ს შეუძლია 3-მდე ინტერესის გაზიარება.</translation>
<translation id="6964305034639999644">ბმულის გახსნა Decentr-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="6965382102122355670">კარგი</translation>
<translation id="6978145336957848883">სუსტი პაროლები ადვილი გამოსაცნობია, ამიტომ მიეცით საშუალება Decentr-ს, <ph name="BEGIN_LINK" />თქვენთვის შექმნას და დაიმახსოვროს ძლიერი პაროლები<ph name="END_LINK" />.</translation>
