<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="1029669172902658969">Atkārtoti palaist, lai atjauninātu &amp;Decentr OS</translation>
<translation id="1040916596585577953">Decentr komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="1042552502243217427">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks Decentr izmanto Decentr serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču Decentr uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="1083934481477628225">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Decentr.</translation>
<translation id="1098170124587656448">Decentr var palīdzēt aizsargāt jūs pret datu noplūdi, ļaunprātīgiem paplašinājumiem un citiem apdraudējumiem.</translation>
<translation id="1104942323762546749">Pārlūkā Decentr tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="113122355610423240">Jūsu noklusējuma pārlūks ir Decentr.</translation>
<translation id="1131805035311359397">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Decentr<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Noklikšķiniet uz Decentr izvēlnes</translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="1185134272377778587">Par Decentr</translation>
<translation id="1188705220418984327">Lai kopīgotu logu, sistēmas preferencēs atļaujiet ekrāna ierakstīšanu pārlūkā Decentr.</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="1262876892872089030">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka Decentr ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="1265577313130862557">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="126567311906253476">Ja pierakstāties Decentr pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL" />, varat automātiski pierakstīties pārlūkā Decentr ar to pašu kontu.</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Jaunā Decentr profila iestatīšana</translation>
<translation id="1324107359134968521">Pārlūkam Decentr ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1342274909142618978">Dzēst arī datus no pārlūka Decentr (<ph name="URL" />)</translation>
<translation id="1414495520565016063">Esat pierakstījies operētājsistēmā Decentr!</translation>
<translation id="1478370723027452770">Saņemt palīdzību saistībā ar Decentr for Testing</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR" /></translation>
<translation id="1524282610922162960">Decentr cilnes kopīgošana</translation>
<translation id="1553461853655228091">Pārlūkam Decentr ir nepieciešama atļauja piekļūt jūsu kamerai, lai varētu izveidot jūsu apkārtnes 3D karti</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Šis paplašinājums vairs netiek atbalstīts. Decentr iesaka to noņemt.}zero{Šie paplašinājumi vairs netiek atbalstīti. Decentr iesaka tos noņemt.}one{Šie paplašinājumi vairs netiek atbalstīti. Decentr iesaka tos noņemt.}other{Šie paplašinājumi vairs netiek atbalstīti. Decentr iesaka tos noņemt.}}</translation>
<translation id="1574377791422810894">Decentr drošības rīki</translation>
<translation id="1591808205441691831">Pārlūkā Decentr ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Decentr kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties, šie dati paliks šajā ierīcē.</translation>
<translation id="1594928384848033697">Decentr pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Decentr.}=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Decentr. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Decentr. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Decentr. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Decentr. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="1625909126243026060">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā Decentr.</translation>
<translation id="1632539827495546968">Ja vēlaties šo kontu izmantot tikai vienu reizi, varat lietot <ph name="GUEST_LINK_BEGIN" />viesa režīmu<ph name="GUEST_LINK_END" /> pārlūkā Decentr. Ja vēlaties pievienot kontu kādam citam, <ph name="LINK_BEGIN" />pievienojiet jaunu personu<ph name="LINK_END" /> savai ierīcei (<ph name="DEVICE_TYPE" />).

Uz šo kontu var attiekties atļaujas, ko esat jau piešķīris vietnēm un lietotnēm. Varat pārvaldīt savus Decentr kontus sadaļā <ph name="SETTINGS_LINK_BEGIN" />Iestatījumi<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1715127912119967311">Lai palīdzētu uzlabot šīs funkcijas, pārlūks Decentr nosūta Decentr serveriem datus par jūsu mijiedarbību ar tām. Šos datus var lasīt, apstrādāt un anotēt pārskatītāji.</translation>
<translation id="1722488837206509557">Tādējādi varēsiet atlasīt kādu no pieejamām ierīcēm un parādīt tajā saturu.</translation>
<translation id="17264556997921157">Varat skatīt un noņemt interešu tēmas, kas vietnēs tiek izmantotas reklāmu rādīšanai. Pārlūkā Decentr tiek aptuveni noteiktas jūsu intereses, ņemot vērā neseno pārlūkošanas vēsturi.</translation>
<translation id="1733725117201708356">Pārlūkā Decentr drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="1736443181683099871">Pārlūkā Decentr tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="1745121272106313518">Pārlūks Decentr tiks restartēts pēc: <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Ja HTTPS nav pieejams, pārlūkā Decentr bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="1774152462503052664">Ļaut Decentr darboties fonā</translation>
<translation id="1779356040007214683">Lai uzlabotu Decentr drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="1808667845054772817">Pārinstalēt Decentr</translation>
<translation id="1820835682567584003">Decentr mēģina <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="18552579716432081">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos Decentr kontā, <ph name="BEGIN_LINK" />izrakstieties no Decentr<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">Varat pārvaldīt Decentr kontus, kuros esat pierakstījies. Jūsu Decentr konti tiek izmantoti pārlūkā Decentr, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE" /> ierīcei. <ph name="LINK_BEGIN" />Uzziniet vairāk<ph name="LINK_END" />.</translation>
<translation id="1863308913976887472">Vietnes pārlūkā Decentr var glabāt informāciju par jūsu interesēm. Piemēram, ja apmeklējat kādu vietni, lai iegādātos apavus maratona skriešanai, vietne var noteikt, ka interesējaties par maratonu skriešanu. Ja vēlāk apmeklēsiet citu vietni, lai reģistrētos sacensībām, šajā vietnē var tikt rādīta skriešanas apavu reklāma, pamatojoties uz jūsu interesēm.</translation>
<translation id="1881322772814446296">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Decentr dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Decentr kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu Decentr datus. <ph name="LEARN_MORE" /></translation>
<translation id="1906696617298807388">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Decentr nosūta ierakstīto tekstu Decentr diskam, lai iegūtu vienumu ieteikumus. Inkognito režīmā šis iestatījums ir izslēgts.</translation>
<translation id="1911763535808217981">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Decentr vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Decentr.</translation>
<translation id="1929939181775079593">Decentr nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="193439633299369377">Decentr OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="1951406923938785464">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE" /> minūte(-es).</translation>
<translation id="1966382378801805537">Decentr nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="1990262977744080398">Uzzināt, kāpēc pārlūkā Decentr daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="2008474315282236005">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Decentr kā <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="2020032459870799438">Lai pārbaudītu, vai jūsu pārējās paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Decentr<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">Izvēlieties, vai iekļaut Decentr vēsturi, lai iegūtu personalizētākas iespējas Decentr pakalpojumos.</translation>
<translation id="2086476982681781442">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="2088953378266246249">Informācija par to, kā Decentr pārvalda savus saknes sertifikātus</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Decentr nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Decentr nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Decentr nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Decentr nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="215352261310130060">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="2157600032285353789">Varat atvērt grāmatzīmes, lasīšanas režīmu un citas iespējas, izmantojot Decentr izvēlni.</translation>
<translation id="2174178932569897599">Pielāgot pārlūkprogrammu Decentr</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="2185166961232948079">Decentr — pierakstīšanās tīklā — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Noņemt kontu no pārlūka Decentr</translation>
<translation id="2210682093923538346">Bīstama vietne. Pārlūkā Decentr tika noņemti paziņojumi.</translation>
<translation id="2240214816234246077">Pēdējā laikā neesat apmeklējis šo vietni. Pārlūkā Decentr tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /></translation>
<translation id="2241627712206172106">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Decentr atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="2313870531055795960">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Decentr. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Decentr var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2329088755516916767">Ja šis iestatījums ir ieslēgts, pārlūkā Decentr tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu.</translation>
<translation id="2343156876103232566">Lai nosūtītu numuru no šejienes uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Decentr.</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="2361918034042471035">Paplašinājums “<ph name="EXTENSION_NAME" />” pieprasa, lai jūs pierakstītos pārlūkā Decentr</translation>
<translation id="2374216753258219393">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS" />, pierakstieties pārlūkā Decentr.</translation>
<translation id="2384373936468275798">Decentr OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Vismaz viens Decentr paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens Decentr paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens Decentr paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens Decentr paplašinājums piekļūst # HID ierīcei}other{Vismaz viens Decentr paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="2401032172288869980">Pārlūkam Decentr ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2440750600860946460">Izmantojot <ph name="BEGIN_LINK" />Decentr rīkus<ph name="END_LINK" />, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt Decentr paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="2478295928299953161">Decentr drīz tiks aizvērts</translation>
<translation id="2483889755041906834">Pārlūkā Decentr</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2554739539410784893">Pārlūkā Decentr tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="2560420686485554789">Pārlūkam Decentr ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="2572494885440352020">Decentr palīgs</translation>
<translation id="2576118232315942160">Pierakstieties pārlūkā Decentr, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2583187216237139145">Darba profila administrators var noņemt šī profila lietošanas laikā ģenerētos Decentr datus (piemēram, grāmatzīmes, vēsturi, paroles un citus iestatījumus). <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">Turpināt lietot Decentr</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="264613044588233783">Decentr darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā (ieteicams)</translation>
<translation id="2648074677641340862">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet Decentr vēlreiz.</translation>
<translation id="2661879430930417727">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Decentr atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="268602741124540128">Laipni lūdzam pārlūkā Decentr, <ph name="ACCOUNT_FIRST_NAME" />!</translation>
<translation id="2711502716910134313">Decentr cilne</translation>
<translation id="2718390899429598676">Papildu drošības nolūkos Decentr šifrēs jūsu datus.</translation>
<translation id="2721354645805494590">Lai noņemtu savu Decentr kontu no pārlūka Decentr, izrakstieties.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2770231113462710648">Mainīt noklusējuma pārlūkprogrammu uz:</translation>
<translation id="2785438272836277133">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka Decentr, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="2837693172913560447">Tādējādi tiks izveidots jauns Decentr profils lietotājam <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="2847479871509788944">Noņemšana no pārlūka Decentr...</translation>
<translation id="2850691299438350830">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā Decentr. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās Decentr lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="2910007522516064972">Par &amp;Decentr</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="2928420929544864228">Instalēšana pabeigta.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="2970426615109535079">Pārlūku Decentr pārvalda jūsu organizācija</translation>
<translation id="2977470724722393594">Decentr ir atjaunināts</translation>
<translation id="2977506796191543575">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Decentr var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2987208172821108655">Lai uzlabotu jūsu pārlūkošanas pieredzi un atbrīvotu resursus, Decentr var padarīt šīs cilnes neaktīvas.</translation>
<translation id="3013473503895162900">Atveriet vietrādi <ph name="URL" /> jaunā cilnē pārlūkā Decentr.</translation>
<translation id="3032706164202344641">Pārlūkprogrammā Decentr nevar pārbaudīt jūsu paroles. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="3032787606318309379">Notiek pievienošana pārlūkam Decentr...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3068187312562070417">Citi Decentr profili</translation>
<translation id="3068515742935458733">Palīdzēt uzlabot Decentr, nosūtot Decentr serveriem avāriju pārskatus un <ph name="UMA_LINK" /></translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Vismaz viens Decentr paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens Decentr paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens Decentr paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens Decentr paplašinājums piekļūst # USB ierīcei}other{Vismaz viens Decentr paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="3101560983689755071">Pārlūkošanas vēsture ietekmē to, kādas reklāmas jums tiek rādītas, un tālāk redzamās aptuveni noteiktās intereses. Lai aizsargātu jūsu konfidencialitāti, Decentr automātiski katru mēnesi pakāpeniski dzēš jūsu intereses. Intereses var tikt atjaunotas, ja vien nenoņemat tās.</translation>
<translation id="3103660991484857065">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet Decentr vēlreiz.</translation>
<translation id="3130323860337406239">Pārlūkā Decentr tiek izmantots jūsu mikrofons.</translation>
<translation id="3144188012276422546">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Decentr padarīt to neaktīvu.</translation>
<translation id="3155163173539279776">Restartēt Decentr</translation>
<translation id="3179665906251668410">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="3185330573522821672">Pielāgojiet savu jauno Decentr profilu.</translation>
<translation id="3190315855212034486">Eh! Decentr ir avarējis. Vai restartēt to tūlīt?</translation>
<translation id="3224847870593914902">Lai noņemtu savu Decentr kontu no pārlūka Decentr, lapā “Iestatījumi” izrakstieties no pārlūka Decentr.</translation>
<translation id="3258596308407688501">Decentr nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3268051428841342958">V8 ir Decentr JavaScript un WebAssembly programma, kas tiek izmantota vietnes veiktspējas uzlabošanai</translation>
<translation id="3283186697780795848">Ir instalēta Decentr versija <ph name="PRODUCT_VERSION" /></translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="328888136576916638">Trūkst Decentr API atslēgu. Tiks atspējotas dažas Decentr funkcijas.</translation>
<translation id="3296368748942286671">Turpināt lietotņu izpildi fonā, kad Decentr ir aizvērts</translation>
<translation id="3300643253493387004">Kamēr iestatām piekļuvi kontam, varat turpināt izmantot pārlūku Decentr. Iespējams, nevarēsiet piekļūt dažiem resursiem, kamēr iestatīšana nebūs pabeigta.</translation>
<translation id="3313189106987092621">Pārlūkā Decentr tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="3316771292331273802">Aizverot visus Decentr logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Decentr konta, ja esat pierakstījies pārlūkā Decentr. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3350761136195634146">Decentr profils ar šādu kontu jau pastāv</translation>
<translation id="3387527074123400161">Decentr OS</translation>
<translation id="3406848076815591792">Vai pāriet uz esošo Decentr profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="3430503420100763906">Izmantojot Decentr profilus, varat nodalīt visu savu Decentr saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="347328004046849135">Ja pierakstīsieties ar uzlauztu paroli, pārlūkprogrammā Decentr tiks parādīts paziņojums</translation>
<translation id="3474745554856756813">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT" /> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Decentr kā <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Lai pārslēgtos starp Decentr profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT" />.</translation>
<translation id="3509308970982693815">Aizveriet visus Decentr logus un mēģiniet vēlreiz.</translation>
<translation id="3530103706039034513">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Decentr savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3533435340678213462">Lai aizsargātu jūsu konfidencialitāti, mēs automātiski dzēšam intereses, kas ir glabātas ilgāk par četrām nedēļām. Intereses var tikt atkārtoti pievienotas sarakstam, kad turpināsiet pārlūkošanu. Varat arī noņemt intereses, ja nevēlaties, lai Decentr tās apsvērtu.</translation>
<translation id="3567254597502212821">Jūsu pārlūkošanas vēsture, kurā tiek reģistrētas vietnes, ko šajā ierīcē apmeklējat ar pārlūku Decentr.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā Decentr kā lietotājs <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Pieejams Decentr atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}=1{Pieejams Decentr atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Pieejams Decentr atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Pieejams Decentr atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Pieejams Decentr atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3651803019964686660">Lai nosūtītu numuru no vietnes <ph name="ORIGIN" /> uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Decentr.</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="3669334504579945026">Lai kopīgotu ekrānu, sistēmas preferencēs atļaujiet ekrāna ierakstīšanu pārlūkā Decentr.</translation>
<translation id="3685209450716071127">Pārlūkprogrammā Decentr nevar pārbaudīt jūsu paroles. Pārbaudiet interneta savienojumu.</translation>
<translation id="3702352323269013324">Uzziniet vairāk par reklāmu personalizēšanu pārlūkā Decentr</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Decentr.}=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Decentr. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Decentr. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Decentr. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Decentr. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3713809861844741608">Atvērt saiti jaunā Decentr &amp;cilnē</translation>
<translation id="3728124580182886854">Saistiet pārlūku Decentr un citus Decentr pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3788675262216168505">Pārvaldīt Decentr profilus</translation>
<translation id="3790262771324122253">Uzziniet, kāpēc Decentr bloķē noteiktas lejupielādes</translation>
<translation id="379589255253486813">Ja kaut kas būs jāpārskata, saņemsiet Decentr paziņojumu</translation>
<translation id="3802055581630249637">Pārlūkā Decentr tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3830894615770080216">Decentr OS sistēma</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> — Decentr</translation>
<translation id="386822487697155367">Saņemt palīdzību saistībā ar Decentr OS</translation>
<translation id="3871664619793219264">Piekļūstiet savam Decentr saturam no konta <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="388648406173476553">Pielāgojiet un kontrolējiet pārlūkprogrammu Decentr. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="3889543394854987837">Noklikšķiniet uz sava vārda, lai atvērtu Decentr un sāktu pārlūkošanu.</translation>
<translation id="390528597099634151">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Decentr profilā. Lai atdalītu pārlūkošanu, pārlūkā Decentr varat sev izveidot atsevišķu profilu.</translation>
<translation id="3909353120217047026">Šis paplašinājums pārkāpj Decentr interneta veikala politiku, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Decentr, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="391789666908693569">Jūsu kontu pārvalda <ph name="MANAGER_NAME" />. Administrators var skatīt un rediģēt šo Decentr profilu un tā datus, piemēram, grāmatzīmes, vēsturi un paroles.</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="3945058413678539331">Decentr mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="3962647064319009959">Uzziniet, kā Decentr rūpējas par jūsu drošību</translation>
<translation id="3975724895399328945">Par Decentr for Testing</translation>
<translation id="3997429360543082038">Par Decentr OS</translation>
<translation id="4019629340646866719">Decentr OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS" />Linux izstrādes vides<ph name="END_LINK_LINUX_OSS" /> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4036079820698952681">Palīdziet uzlabot pārlūku Decentr, ziņojot par <ph name="BEGIN_LINK" />pašreizējiem iestatījumiem<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="4118474109249235144">Decentr inkognito režīms</translation>
<translation id="4122186850977583290">Pāriet uz lapu “Par Decentr”</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="4149336151887611710">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus jūsu darba profilā, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus personīgajos Decentr profilos.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā — Decentr</translation>
<translation id="421369550622382712">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā Decentr.</translation>
<translation id="4216212958613226427">Šī valoda tiek izmantota, lai attēlotu Decentr lietotāja saskarni</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="4230135487732243613">Vai saistīt Decentr datus ar šo kontu?</translation>
<translation id="4251772536351901305">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja Decentr par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist Decentr brīdinājumus.</translation>
<translation id="4269093074552541569">Izrakstīties no pārlūka Decentr</translation>
<translation id="4271805377592243930">Saņemt palīdzību par Decentr</translation>
<translation id="4281844954008187215">Decentr pakalpojumu noteikumi</translation>
<translation id="4285930937574705105">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja Decentr šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334294535648607276">Lejupielāde pabeigta.</translation>
<translation id="439358628917130594"><ph name="MANAGER" /> pieprasa, lai pirms šīs ierīces lietošanas jūs izlasītu tālāk sniegtos pakalpojumu sniegšanas noteikumus un piekristu tiem. Šie noteikumi nepaplašina, nepārveido un neierobežo operētājsistēmas Decentr OS noteikumus.</translation>
<translation id="4407044323746248786">Vai tik un tā aizvērt pārlūku Decentr?</translation>
<translation id="4415566066719264597">Ļaut pārlūkam Decentr darboties fonā</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Decentr iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}zero{Decentr iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}one{Decentr iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}other{Decentr iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}}</translation>
<translation id="4423735387467980091">Pielāgot un kontrolēt Decentr</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614">Pārlūku Decentr pārvalda organizācija “<ph name="MANAGER" />”</translation>
<translation id="4447409407328223819">Par Decentr for Testing</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="4510853178268397146">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. Decentr iesaka to noņemt.</translation>
<translation id="452711251841752011">Laipni lūdzam pārlūkā Decentr (tika atvērts jauns pārlūka logs)!</translation>
<translation id="4531137820806573936">Pārlūkam Decentr ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="4536805923587466102">Ar kontu <ph name="USER_EMAIL_ADDRESS" /> jau esat pierakstījies citā Decentr profilā</translation>
<translation id="4544142686420020088">Pārlūkprogramma Decentr netika atjaunināta. Radās problēma. <ph name="BEGIN_LINK" />Novērsiet Decentr atjaunināšanas problēmas.<ph name="END_LINK" /></translation>
<translation id="4545268686623374213">Lai uzlabotu un paātrinātu pārlūkošanu, pārlūkā Decentr var padarīt šo cilni neaktīvu.</translation>
<translation id="454579500955453258">Vai turpināt jaunā Decentr profilā?</translation>
<translation id="4567424176335768812">Jūs esat pierakstījies kā <ph name="USER_EMAIL_ADDRESS" />. Tagad varat piekļūt savām grāmatzīmēm, vēsturei un citiem iestatījumiem visās ierīcēs, kurās esat pierakstījies.</translation>
<translation id="4570813286784708942">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="459535195905078186">Decentr lietotnes</translation>
<translation id="4613863813562375431">Decentr OS versija</translation>
<translation id="4617285639650863674">Lai kopīgotu ekrānu, sistēmas preferencēs atļaujiet ekrāna ierakstīšanu pārlūkā Decentr.</translation>
<translation id="4621240073146040695">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku Decentr.</translation>
<translation id="4665829708273112819">Brīdinājums! Decentr nevar novērst to, ka paplašinājumi ieraksta jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, noņemiet šīs opcijas atlasi.</translation>
<translation id="4673151026126227699">Ja kopīgojat arī Decentr lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="4677944499843243528">Šķiet, ka profils tiek izmantots citā Decentr procesā (<ph name="PROCESS_ID" />) citā datorā (<ph name="HOST_NAME" />). Lai profils netiktu bojāts, pārlūkā Decentr tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku Decentr.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="469259825538636168">Noteikti jūsu Decentr dati vēl nav saglabāti jūsu Decentr kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="4708193446201257833">Kamēr esat pierakstījies, pārlūkā Decentr varat izmantot savas paroles un citu saturu no Decentr konta. <ph name="SHORTCUT" /> var mainīt jūsu Decentr pakalpojumu iestatījumus.</translation>
<translation id="4708774505295300557">Kāds iepriekš pierakstījās pārlūkā Decentr šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST" />. Lūdzu, izveidojiet jaunu Decentr lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="4746050847053251315">Vai tik un tā aizvērt pārlūku Decentr?</translation>
<translation id="4748217263233248895">Tikko tika piemērots īpašs Decentr drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="4765210420921718862">Ja pārdomāsiet, jebkurā laikā varēsiet atbilstoši mainīt Decentr iestatījumus. Izmēģinājuma laikā reklāmu rādīšanai tiek izmantotas arī pašreizējās metodes, tāpēc izmaiņas nebūs pamanāmas uzreiz.</translation>
<translation id="4788777615168560705">Pārlūkprogrammā Decentr nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām vai <ph name="BEGIN_LINK" />pārbaudiet paroles savā Decentr kontā<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Decentr meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Decentr serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="4814736265800133385">Izmantot Decentr, nepierakstoties kontā</translation>
<translation id="4888717733111232871">Ienākošo savienojumu kārtula pārlūkam Decentr, lai atļautu mDNS datplūsmu.</translation>
<translation id="4893347770495441059">Atkārtoti palaist, lai atjauninātu &amp;Decentr</translation>
<translation id="4942295735032723435">Lai saņemtu turpmākus Decentr atjauninājumus, nepieciešama operētājsistēma macOS 11 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 10.15.</translation>
<translation id="4943838377383847465">Decentr darbojas fona režīmā.</translation>
<translation id="494490797786467921">Noklikšķiniet, lai aizvērtu Decentr pierakstīšanās dialoglodziņu</translation>
<translation id="4987820182225656817">Viesi var izmantot Decentr, neatstājot nekādas pēdas.</translation>
<translation id="4994636714258228724">Pievienot savu kontu pārlūkā Decentr</translation>
<translation id="5114678101347489141">Decentr pēta jaunas funkcijas, kas ļauj vietnēm nodrošināt tādas pašas pārlūkošanas iespējas, izmantojot mazāk informācijas.</translation>
<translation id="5187123684706427865">Decentr kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="5224391634244552924">Nav saglabātu paroļu. Pārlūkprogrammā Decentr var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="5231355151045086930">Izrakstīšanās no Decentr</translation>
<translation id="5252179775517634216">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Decentr profilā. Tādējādi tiks izveidots jauns Decentr profils lietotājam <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5277894862589591112">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Decentr.</translation>
<translation id="5294316920224716406">Ja veicat pārlūkošanu inkognito režīmā, pārlūkā Decentr tiks parādīts brīdinājums pirms vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="5296845517486664001">Ja izmēģināšana ir ieslēgta un jūs esat iesaistīts aktīvā izmēģinājumā pārlūkā Decentr, jūsu pārlūkošanas vēsture ietekmē to, kādas reklāmas jums tiek rādītas, un tālāk redzamās aptuveni noteiktās intereses. Lai aizsargātu jūsu konfidencialitāti, Decentr katru mēnesi pakāpeniski dzēš jūsu intereses.</translation>
<translation id="5310474266708705970">Pierakstīties pārlūkā Decentr ar kontu <ph name="USER_EMAIL" /></translation>
<translation id="5352264705793813212">Pārlūkā Decentr tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="5352361688875342522">Citi Decentr profili</translation>
<translation id="5358375970380395591">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Decentr dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Decentr kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Lai izmantotu personalizēšanu, iekļaujiet pārlūku Decentr iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="5383439451358640070">Uzzināt, kāpēc pārlūkā Decentr daži faili tiek bloķēti</translation>
<translation id="5386450000063123300">Notiek Decentr atjaunināšana (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Atļaut pierakstīties pārlūkā Decentr</translation>
<translation id="5405650547142096840">Noņemt no pārlūka Decentr</translation>
<translation id="5427571867875391349">Iestatīt Decentr kā noklusējuma pārlūku</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> — Decentr beta versija</translation>
<translation id="5473971139929175403">Iespējams, pārlūks Decentr nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="5475924890392386523">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="5480860683791598150">Pārlūkam Decentr ir nepieciešama piekļuve jūsu atrašanās vietas datiem, lai varētu tos kopīgot ar šo vietni.</translation>
<translation id="5487574057737591516">Lai aizsargātu jūsu konfidencialitāti, mēs automātiski dzēšam intereses, kas ir glabātas ilgāk par četrām nedēļām. Intereses var tikt atkārtoti pievienotas sarakstam, kad turpināsiet pārlūkošanu. Ja intereses pārlūkā Decentr nav noteiktas pareizi vai nevēlaties skatīt konkrētas reklāmas, varat noņemt interesi.</translation>
<translation id="549669000822060376">Lūdzu, uzgaidiet, kamēr Decentr instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="5496810170689441661">Decentr mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="5527463683072221100">Atvērt PDF failus pārlūkā Decentr</translation>
<translation id="5623402015214259806">{0,plural, =0{Ir pieejams Decentr atjauninājums}=1{Ir pieejams Decentr atjauninājums}zero{Decentr atjauninājums ir pieejams jau # dienu}one{Decentr atjauninājums ir pieejams jau # dienu}other{Decentr atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="5643865575100044307">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks Decentr</translation>
<translation id="5653831366781983928">Lūdzu, nekavējoties restartējiet pārlūku Decentr</translation>
<translation id="5690427481109656848">Decentr LLC</translation>
<translation id="5698481217667032250">Rādīt Decentr šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="5761096224651992291">Pēdējā laikā neesat apmeklējis šo vietni. Pārlūkā Decentr tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> un <ph name="PERMISSION_3" /></translation>
<translation id="5800158606660203929">Pielāgojiet un kontrolējiet pārlūku Decentr. Iestatiet Decentr kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="5862307444128926510">Laipni lūdzam pārlūkā Decentr!</translation>
<translation id="5883558403894052917">Pārlūkā Decentr tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="5889361821821684993">Decentr regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="5929318705173562984">Lai uzlabotu pārlūkošanu un atbrīvotu resursus, pārlūkā Decentr var padarīt šo cilni neaktīvu.</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="5972142260211327093">Ja esat iesaistīts aktīvā izmēģinājumā pārlūkā Decentr, jūsu pārlūkošanas vēsture ietekmē to, kādas reklāmas jums tiek rādītas, un tālāk redzamās aptuveni noteiktās intereses. Lai aizsargātu jūsu konfidencialitāti, Decentr katru mēnesi pakāpeniski dzēš jūsu intereses. Intereses tiek atjaunotas, ja vien nenoņemat tās.</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku Decentr, ja tas nav izmantots # minūtes.}}</translation>
<translation id="5987687638152509985">Lai sāktu sinhronizēšanu, atjauniniet Decentr.</translation>
<translation id="5988505247484123880">Bieži vien jūsu apmeklētajās vietnēs tiek saglabāta informācija par jūs interesējošām lietām, lai personalizētu jūsu pieredzi. Vietnes var arī glabāt informāciju par jūsu interesēm pārlūkā Decentr.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS" /> stunda(-as).</translation>
<translation id="6019451407441383358">Varat atvērt grāmatzīmes, lasīšanas režīmu un citas iespējas, izmantojot Decentr izvēlni, kas atrodas augšējā labajā stūrī.</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="6058380562449900225">Lai aizsargātu savus datus, ļaujiet pārlūkā Decentr atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="6063093106622310249">&amp;Atvērt pārlūkā Decentr</translation>
<translation id="6072279588547424923">Paplašinājums <ph name="EXTENSION_NAME" /> ir pievienots pārlūkam Decentr</translation>
<translation id="6072463441809498330">Pārlūka Decentr darbības paātrināšana</translation>
<translation id="608006075545470555">Darba profila pievienošana šai pārlūkprogrammai</translation>
<translation id="6096348254544841612">Pielāgojiet un pārvaldiet pārlūku Decentr. Ir pieejams atjauninājums.</translation>
<translation id="6102072151902574948">Ja šis iestatījums ir ieslēgts, pārlūkā Decentr tiek taupīta akumulatora jauda, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu.</translation>
<translation id="6107893135096467929">Ieslēgts • Decentr nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="6119438414301547735">Atļaut paplašinājumam rādīt piekļuves pieprasījumus Decentr rīkjoslā</translation>
<translation id="6120345080069858279">Pārlūks Decentr saglabās šo paroli jūsu Decentr kontā. To nav nepieciešams iegaumēt.</translation>
<translation id="6129621093834146363">Fails <ph name="FILE_NAME" /> ir bīstams, tādēļ Decentr to bloķēja.</translation>
<translation id="6132897690380286411">Decentr drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="6134968993075716475">Droša pārlūkošana ir izslēgta. Pārlūkā Decentr tiek ieteikts to ieslēgt.</translation>
<translation id="6145820983052037069">Šeit varat pārslēgties starp Decentr profiliem.</translation>
<translation id="615103374448673771">Ja atļaujat sīkfailus, pārlūks Decentr var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6174920971222007286">Šis fails var būt bīstams.<ph name="LINE_BREAK" />Decentr var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “Decentr droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="6183079672144801177">Ierīcē <ph name="TARGET_DEVICE_NAME" /> pierakstieties pārlūkā Decentr un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="6212496753309875659">Šim datoram jau ir jaunākā Decentr versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku Decentr un mēģiniet vēlreiz.</translation>
<translation id="6219195342503754812">{0,plural, =0{Pārlūks Decentr tūlīt tiks restartēts}=1{Pārlūks Decentr pēc 1 sekundes tiks restartēts}zero{Pārlūks Decentr pēc # sekundēm tiks restartēts}one{Pārlūks Decentr pēc # sekundes tiks restartēts}other{Pārlūks Decentr pēc # sekundēm tiks restartēts}}</translation>
<translation id="6241367896540709610">Pārlūkam Decentr ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="6245734527075554892">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Decentr.</translation>
<translation id="6248213926982192922">Padarīt Decentr par noklusējuma pārlūku</translation>
<translation id="6266342355635466082">Pārlūkprogrammā Decentr nevar pārbaudīt atjauninājumu pieejamību. Pārbaudiet interneta savienojumu.</translation>
<translation id="6268381023930128611">Vai izrakstīties no Decentr?</translation>
<translation id="6270547683008298381">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Decentr padarīt tās neaktīvas.</translation>
<translation id="6281746429495226318">Pielāgot Decentr profilu</translation>
<translation id="6290827346642914212">Decentr profila nosaukšana</translation>
<translation id="6294831894865512704">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā Decentr</translation>
<translation id="6295779123002464101">Fails <ph name="FILE_NAME" /> var būt bīstams, tādēļ Decentr to bloķēja.</translation>
<translation id="6309712487085796862">Decentr saitē tiek izmantota kamera.</translation>
<translation id="6327105987658262776">Atjauninājums nav pieejams.</translation>
<translation id="6333502561965082103">Tiek veikta cita darbība pārlūkā Decentr. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="6334986366598267305">Tagad pārlūkā Decentr ir vieglāk izmantot Decentr kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="633626832589656416">Lai uzlabotu jūsu pārlūkošanas pieredzi un paātrinātu darbu, Decentr var padarīt šīs cilnes neaktīvas.</translation>
<translation id="6347933965114150440">Decentr saīsne</translation>
<translation id="6366160072964553914">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="6373523479360886564">Vai tiešām vēlaties atinstalēt pārlūku Decentr?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6384011394608460044"><ph name="BEGIN_BOLD" />Kā mēs izmantojam šos datus:<ph name="END_BOLD" /> pārlūkā Decentr var aptuveni noteikt jūsu intereses. Vēlāk kāda jūsu apmeklēta vietne var pieprasīt pārlūkam Decentr atļauju skatīt jūsu intereses, lai personalizētu jums rādāmās reklāmas.</translation>
<translation id="6400112897226594999">Decentr logotips datora ekrānā.</translation>
<translation id="6403826409255603130">Decentr ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā Decentr.</translation>
<translation id="6442900851116057561">Decentr OS restartēšana</translation>
<translation id="6443470774889161065">Pārlūkā Decentr tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="645458117210240797">Izslēgts • Decentr nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="6455857529632101747">Laipni lūdzam Decentr profilos!</translation>
<translation id="6466344609055215035">Noņemt kontu no pārlūka Decentr</translation>
<translation id="6475912303565314141">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Decentr.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="6510925080656968729">Atinstalēt Decentr</translation>
<translation id="651535675648445253">Saīsnes tiek atvērtas pārlūkā Decentr</translation>
<translation id="6524389414524528185">Kamēr esat pierakstījies, pārlūkā Decentr varat izmantot savas paroles un citu saturu no Decentr konta. Iestatījumos varat jebkurā brīdī to mainīt.</translation>
<translation id="6539122709674868420">Jūsu organizācija aizver pārlūku Decentr, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="6542839706527980775">Katrā profilā tiek glabāta attiecīgā Decentr profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6563921047760808519">Uzziniet vairāk par to, <ph name="BEGIN_LINK" />kā pārlūkā Decentr tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK" />.</translation>
<translation id="656935081669708576">Varat pārslēgties, lai skatītu paroles no cita Decentr profila.</translation>
<translation id="6570579332384693436">Lai izlabotu pareizrakstības kļūdas, Decentr nosūta teksta laukos ievadīto tekstu Decentr serveriem.</translation>
<translation id="6598877126913850652">Pāriet uz Decentr paziņojumu iestatījumiem</translation>
<translation id="6613594504749178791">Izmaiņas stāsies spēkā, kad restartēsiet Decentr.</translation>
<translation id="665732753414869868">Pārlūkam Decentr ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="6663852025006259149">Vietnes, visticamāk, darbosies pienācīgi, taču nesaglabās jūsu datus, kad aizvērsiet visus Decentr logus.</translation>
<translation id="6669284030132180248">Ja saglabāsiet grāmatzīmes arī Decentr kontā, varēsiet izsekot produktu cenām pārlūkā Decentr un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="668175097507315160">Decentr OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="6692797197837897398">Decentr nodrošina lielāku kontroli pār jums rādītajām reklāmām un ierobežo informāciju, ko vietnes var uzzināt par jums, kad tās rāda jums personalizētas reklāmas.</translation>
<translation id="6709350901466051922">Pārlūkam Decentr ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6717134281241384636">Jūsu profilu nevar izmantot, jo tas ir no jaunākas Decentr versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku Decentr versiju.</translation>
<translation id="6729124504294600478">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku Decentr iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie Decentr pakalpojumi”.</translation>
<translation id="6734291798041940871">Pārlūks Decentr jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="673636774878526923">Lai piekļūtu savam Decentr saturam visās jūsu ierīcēs, pierakstieties un pēc tam ieslēdziet sinhronizāciju.</translation>
<translation id="674245979920622322">Pēdējā laikā neesat apmeklējis šo vietni. Pārlūkā Decentr tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> (un vēl <ph name="COUNT" /> atļaujas)</translation>
<translation id="67706546131546258">Decentr iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="6779406956731413166">Decentr OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6847869444787758381">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā Decentr saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME" /> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="6857782730669500492">Decentr — <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">Pārlūkā Decentr tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME" />” satur ļaunprātīgu programmatūru.</translation>
<translation id="6929417474050522668">Kad izmēģināšana ir ieslēgta, reklāmu izvērtēšana ļauj jūsu apmeklētajām vietnēm pieprasīt informāciju no Decentr, lai efektīvāk novērtētu vietnēs rādīto reklāmu veiktspēju. Reklāmu izvērtēšana ierobežo starpvietņu izsekošanu, pārsūtot starp vietnēm pēc iespējas mazāk informācijas.</translation>
<translation id="6940431691900807093">Vēlāk kāda jūsu apmeklēta vietne var pieprasīt pārlūkam Decentr atļauju skatīt jūsu intereses, lai personalizētu jums rādāmās reklāmas. Pārlūks Decentr var kopīgot līdz trim interesēm.</translation>
<translation id="6964305034639999644">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="6978145336957848883">Nedrošas paroles ir viegli uzminēt. Pārlūkā Decentr <ph name="BEGIN_LINK" />var automātiski veidot un iegaumēt drošas paroles jūsu kontiem<ph name="END_LINK" />.</translation>
<translation id="6981396265751285733">Ja šis iestatījums ir ieslēgts, pārlūkā Decentr neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots Decentr darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat.</translation>
<translation id="6985329841647292029">Decentr OS noteikumi</translation>
<translation id="6990124437352146030">Pārlūkam Decentr ir nepieciešama atļauja piekļūt jūsu mikrofonam šajā vietnē.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">Instalēšana apturēta.</translation>
<translation id="7045244423563602563">Pielāgojiet pārlūku Decentr savām vajadzībām</translation>
<translation id="705851970750939768">Atjaunināt Decentr</translation>
<translation id="7067091210845072982">Ja attēlam nav vērtīga apraksta, pārlūks Decentr mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Decentr.</translation>
<translation id="7141270731789036260">Pielāgot versiju Decentr for Testing</translation>
<translation id="7163519456498498587">Noņemt paplašinājumu <ph name="EXTENSION_NAME" /> no pārlūka Decentr</translation>
<translation id="7173822816570314652">Jūsu organizācija dzēš Decentr datus, ja šis pārlūks <ph name="TIMEOUT_DURATION" /> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="718435575166326686">Pārlūkam Decentr ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="7196312274710523067">Neizdevās palaist Decentr. Mēģiniet vēlreiz.</translation>
<translation id="7197677400338048821">Pārlūkprogrammā Decentr nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām.</translation>
<translation id="7213407614656404070">Izmantojiet Decentr ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="7223968959479464213">Uzdevumu pārvaldnieks — Decentr</translation>
<translation id="7246575524853130370">Jūsu intereses, kas aptuveni noteiktas pārlūkā Decentr</translation>
<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{Decentr iesaka to noņemt.}zero{Decentr iesaka tos noņemt.}one{Decentr iesaka tos noņemt.}other{Decentr iesaka tos noņemt.}}</translation>
<translation id="7309928523159922338">Reklāmu izvērtēšana ļauj jūsu apmeklētajām vietnēm pieprasīt informāciju no Decentr, lai efektīvāk novērtētu vietnēs rādīto reklāmu veiktspēju. Reklāmu izvērtēšana ierobežo starpvietņu izsekošanu, pārsūtot starp vietnēm pēc iespējas mazāk informācijas.</translation>
<translation id="731795002583552498">Notiek Decentr atjaunināšana</translation>
<translation id="7318036098707714271">Jūsu preferenču fails ir bojāts vai nederīgs. Decentr nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7339898014177206373">Jauns logs</translation>
<translation id="734373864078049451">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits Decentr saturs.</translation>
<translation id="7349591376906416160">Jūsu sistēmas administrators ir konfigurējis Decentr atvērt <ph name="ALTERNATIVE_BROWSER_NAME" />, lai piekļūtu <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7355355292030546812">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem, tostarp kontam <ph name="USER_EMAIL" /></translation>
<translation id="7384121030444253939">Šis paplašinājums vairs netiek atbalstīts. Decentr iesaka to noņemt.</translation>
<translation id="7398989605938454041">Izmantojot Decentr profilus, varat nodalīt visu savu Decentr saturu. Tādējādi tiek atvieglota darba un izklaides satura nodalīšana.</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> — Decentr izstrādātāju versija</translation>
<translation id="7451052299415159299">Pārlūkam Decentr ir nepieciešama atļauja piekļūt jūsu kamerai šajā vietnē.</translation>
<translation id="7458892263350425044">Lai izmantotu mikrofonu, piešķiriet pārlūkam Decentr piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="7461356015007898716">Lai saņemtu turpmākus Decentr atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="7467949745582939695">Vai atkārtoti palaist Decentr?</translation>
<translation id="7483335560992089831">Nevar instalēt to pašu Decentr versiju, kas jau šobrīd darbojas. Aizveriet Decentr un mēģiniet vēlreiz.</translation>
<translation id="751935028865900641">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus Decentr logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Decentr konta, ja esat pierakstījies pārlūkā Decentr.</translation>
<translation id="753534427205733210">{0,plural, =1{Pārlūks Decentr pēc 1 minūtes tiks restartēts}zero{Pārlūks Decentr pēc # minūtēm tiks restartēts}one{Pārlūks Decentr pēc # minūtes tiks restartēts}other{Pārlūks Decentr pēc # minūtēm tiks restartēts}}</translation>
<translation id="7553334751796114046">Lai kopīgotu logu, sistēmas preferencēs atļaujiet ekrāna ierakstīšanu pārlūkā Decentr.</translation>
<translation id="7582945390259497898">Pārlūkā Decentr var aptuveni noteikt jūsu intereses. Vēlāk kāda jūsu apmeklēta vietne var pieprasīt pārlūkam Decentr atļauju skatīt jūsu intereses, lai personalizētu jums rādāmās reklāmas.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> instalēšanas programma</translation>
<translation id="7585391435984513350">Pēdējā laikā neesat apmeklējis šo vietni. Pārlūkā Decentr tika noņemta šāda atļauja: <ph name="PERMISSION" /></translation>
<translation id="761356813943268536">Pārlūkā Decentr tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="7617377681829253106">Pārlūkā Decentr ir veikti uzlabojumi</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="7682213815243802460">Decentr iestatījumos varat uzzināt vairāk par šīm funkcijām.</translation>
<translation id="7686590090926151193">Decentr nav jūsu noklusējuma pārlūks.</translation>
<translation id="7689606757190482937">Decentr sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="7699779824407626136">Decentr atjauninājums</translation>
<translation id="7745317241717453663">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Decentr kā <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="7786760609782648049">Pārlūka Decentr darbības paātrināšana</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> — Decentr Canary</translation>
<translation id="7803986347287457849">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. Decentr izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7828947555739565424">Šajā ierīcē jau pastāv Decentr profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē dators.</translation>
<translation id="7859018312476869945">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Decentr nosūta ierakstīto tekstu jūsu noklusējuma meklētājprogrammai, lai iegūtu labākus ieteikumus. Inkognito režīmā šis iestatījums ir izslēgts.</translation>
<translation id="7867198900892795913">Nevarēja atjaunināt uz jaunāko Decentr versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS" /> sekunde(-es).</translation>
<translation id="7877292582355102282"><ph name="BEGIN_BOLD" />Kā varat pārvaldīt savus datus:<ph name="END_BOLD" /> lai aizsargātu jūsu konfidencialitāti, mēs automātiski dzēšam intereses, kas ir glabātas ilgāk par četrām nedēļām. Intereses var tikt atkārtoti pievienotas sarakstam, kad turpināsiet pārlūkošanu. Varat arī noņemt intereses, ja nevēlaties, lai Decentr tās apsvērtu.</translation>
<translation id="7888981273428720788">Iestatīt Decentr kā noklusējuma pārlūku</translation>
<translation id="7934340546140346950">Pārlūkā Decentr nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="7937630085815544518">Operētājsistēmā Decentr iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS" />. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="7975919845073681630">Šī ir Decentr papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="7997934263947464652">No nezināmiem avotiem iegūti paplašinājumi, lietotnes un motīvi var kaitēt ierīcei. Decentr komanda iesaka instalēt tos tikai no veikala <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="8013436988911883588">Tiklīdz pārlūkam Decentr tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Decentr for Testing</translation>
<translation id="8105840573057009683">Pārlūkam Decentr ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="8133124826068723441">Decentr OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="8166782796394721554">Ieslēdziet papildu aizsardzību Decentr JavaScript un WebAssembly programmā</translation>
<translation id="81770708095080097">Šis fails ir bīstams, tāpēc Decentr to bloķēja.</translation>
<translation id="8223363452568144035">Lai izmantotu kameru, piešķiriet pārlūkam Decentr piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="8232193495299001329">Decentr nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Decentr, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="8248265253516264921">Ja attēlam nav vērtīga apraksta, pārlūks Decentr mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Decentr. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="8254601181414348851">Vai pierakstīties pārlūkā Decentr, izmantojot jaunu profilu?</translation>
<translation id="8266560134891435528">Pārlūkprogrammā Decentr nevar pārbaudīt jūsu paroles, jo jūs neesat pierakstījies.</translation>
<translation id="8286943863733751221">Pārlūkā <ph name="BEGIN_LINK" />Decentr tiek rādīti brīdinājumi<ph name="END_LINK" /> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="8318772038038596122">Jūsu organizācija aizver pārlūku Decentr, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots.</translation>
<translation id="8330519371938183845">Pierakstieties, lai sinhronizētu un personalizētu pārlūku Decentr visās savās ierīcēs.</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> iepriekš izmantoja Decentr</translation>
<translation id="8357820681460164151">Lai piekļūtu savam Decentr saturam visās savās ierīcēs, pierakstieties un pēc tam ieslēdziet sinhronizāciju.</translation>
<translation id="8360718212975266891">Lai saņemtu turpmākus Decentr atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8370517070665726704">Autortiesības: <ph name="YEAR" /> Decentr LLC. Visas tiesības paturētas.</translation>
<translation id="8372327902843331129">Pierakstieties pārlūkā Decentr, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu Decentr kontā pēc pierakstīšanās.</translation>
<translation id="837460953767177950">Pēc tam jums būs jārestartē pārlūks Decentr.</translation>
<translation id="8397248745433792218">Decentr iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.</translation>
<translation id="8401454788024434101">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka Decentr, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="8417404458978023919">{0,plural, =1{Restartējiet pārlūku Decentr vienas dienas laikā}zero{Restartējiet pārlūku Decentr # dienu laikā}one{Restartējiet pārlūku Decentr # dienas laikā}other{Restartējiet pārlūku Decentr # dienu laikā}}</translation>
<translation id="8453117565092476964">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet Decentr vēlreiz.</translation>
<translation id="8458614432758743027">Pārlūka Decentr izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="8463672209299734063">Neobligāti: palīdziet uzlabot Decentr OS funkcijas un veiktspēju, automātiski nosūtot Decentr serveriem diagnostikas un lietojuma datus.</translation>
<translation id="8493179195440786826">Decentr versija ir novecojusi</translation>
<translation id="8522801943730206384">Pārlūkprogrammā Decentr var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8550334526674375523">Šis darba profils ir pilnīgi nesaistīts ar jūsu personīgo profilu.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8568283329061645092">Pārlūkprogrammā Decentr var pārbaudīt jūsu paroles, ja esat pierakstījies savā Decentr kontā.</translation>
<translation id="8576826849825683917">Pārlūku Decentr pārvalda vairākas organizācijas</translation>
<translation id="8586442755830160949">Autortiesības <ph name="YEAR" /> Decentr autori. Visas tiesības paturētas.</translation>
<translation id="8608079656141766906"><ph name="BEGIN_BOLD" />Kā mēs izmantojam šos datus:<ph name="END_BOLD" /> vietnes pārlūkā Decentr var glabāt informāciju par jūsu interesēm. Piemēram, ja apmeklējat kādu vietni, lai iegādātos apavus maratona skriešanai, vietne var noteikt, ka interesējaties par maratonu skriešanu. Ja vēlāk apmeklēsiet citu vietni, lai reģistrētos sacensībām, šajā vietnē var tikt rādīta skriešanas apavu reklāma, pamatojoties uz jūsu interesēm.</translation>
<translation id="8619360774459241877">Notiek Decentr palaišana...</translation>
<translation id="8621669128220841554">Instalēšana neizdevās nenoteiktas kļūdas dēļ. Lejupielādējiet pārlūku Decentr vēlreiz.</translation>
<translation id="8648201657708811153">Decentr for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="8697124171261953979">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Decentr vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="8704119203788522458">Šis ir jūsu Decentr</translation>
<translation id="8719993436687031146">Vai pierakstīties pārlūkā Decentr?</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR" />.</translation>
<translation id="8796602469536043152">Pārlūkam Decentr ir nepieciešama atļauja piekļūt jūsu kamerai un mikrofonam šajā vietnē.</translation>
<translation id="8818550178040858407">Vai pierakstīties pārlūkā Decentr?</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="8833697763442816810">Decentr OS sistēma</translation>
<translation id="8846118132221683440"><ph name="BEGIN_BOLD" />Kādi dati tiek izmantoti:<ph name="END_BOLD" /> jūsu pārlūkošanas vēsture, kurā tiek reģistrētas vietnes, ko šajā ierīcē apmeklējat ar pārlūku Decentr.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="8880203542552872219">Ja tā ir, lūdzu, rediģējiet saglabāto paroli pārlūkprogrammā Decentr, lai tā atbilstu jūsu jaunajai parolei.</translation>
<translation id="8907580949721785412">Decentr mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="8931379085695076764">Decentr var aptuveni noteikt jūsu intereses, balstoties uz jūsu pēdējo nedēļu pārlūkošanas vēsturi. Šī informācija tiek glabāta jūsu ierīcē.</translation>
<translation id="8941642502866065432">Nevar atjaunināt Decentr</translation>
<translation id="897581876605952338">Decentr Enterprise logotips</translation>
<translation id="8986207147630327271">Jūs pievienosiet šai pārlūkprogrammai darba profilu un piešķirsiet administratoram kontroli tikai pār darba profilu.</translation>
<translation id="8988036198400390003">Pārvaldīt Decentr profilus</translation>
<translation id="9019929317751753759">Lai uzlabotu Decentr drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="9022552996538154597">Pierakstieties pārlūkā Decentr</translation>
<translation id="904366664621834601">Pārlūkā Decentr šī lejupielāde tika bloķēta, jo šajā arhīva failā ir ietverti citi faili, kas, iespējams, slēpj ļaunprātīgu programmatūru</translation>
<translation id="9062666675513499497">Automātiska pierakstīšanās pārlūkā Decentr, kad pierakstāties citos Decentr pakalpojumos</translation>
<translation id="907832235989677238">Pierakstieties pārlūkā Decentr. Ja vēlaties pierakstīties kontā tikai vienreiz, varat <ph name="GUEST_LINK_BEGIN" />izmantot ierīci viesa režīmā<ph name="GUEST_LINK_END" />.</translation>
<translation id="9078733879136747090">Pārlūks Decentr tika automātiski aizvērts</translation>
<translation id="9089354809943900324">Decentr versija ir novecojusi.</translation>
<translation id="9093206154853821181">{0,plural, =1{Pārlūks Decentr pēc stundas tiks restartēts}zero{Pārlūks Decentr pēc # stundām tiks restartēts}one{Pārlūks Decentr pēc # stundas tiks restartēts}other{Pārlūks Decentr pēc # stundām tiks restartēts}}</translation>
<translation id="9106612006984859720">Lai saņemtu turpmākus Decentr atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.1.</translation>
<translation id="91086099826398415">Atvērt saiti jaunā Decentr &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9144490074902256427">Izmēģinājuma laikā varat skatīt un noņemt interešu tēmas, kas vietnēs tika izmantotas reklāmu rādīšanai. Pārlūkā Decentr tiek aptuveni noteiktas jūsu intereses, ņemot vērā neseno pārlūkošanas vēsturi.</translation>
<translation id="9158494823179993217">Sistēmas administrators ir konfigurējis Decentr, lai vietne <ph name="TARGET_URL_HOSTNAME" /> tiktu atvērta papildu pārlūkā.</translation>
<translation id="9185526690718004400">Atkārtoti palaist, lai atjauninātu &amp;Decentr</translation>
<translation id="9190841055450128916">Decentr (mDNS ienākošie savienojumi)</translation>
<translation id="924957577793602335">Pielāgojiet pārlūku Decentr savām vajadzībām</translation>
<translation id="93478295209880648">Iespējams, Decentr nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="942598560705308788">Decentr pārvaldītie sertifikāti</translation>
<translation id="965162752251293939">Kas izmanto pārlūku Decentr?</translation>
<translation id="967427899662692980">Visaugstākais Decentr drošības līmenis</translation>
<translation id="983803489796659991">Instalēšana neizdevās, jo atjauninājumu serverim nav nekādu jaukšanas datu lietojumprogrammai.</translation>
<translation id="985498048907240953">Izmantot Decentr, nepierakstoties kontā</translation>
<translation id="985602178874221306">Decentr autori</translation>
<translation id="992780518932311116">Lai izmantotu atrašanās vietas datus, piešķiriet pārlūkam Decentr piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
</translationbundle>