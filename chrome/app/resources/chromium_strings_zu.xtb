<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="1029669172902658969">Qalisa kabusha ukuze ubuyekeze i-&amp;DecentrOS</translation>
<translation id="1040916596585577953">I-Decentr incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="1042552502243217427">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Decentr isebenzisa amaseva e-Google. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-Google ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="1083934481477628225">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-Decentr</translation>
<translation id="1098170124587656448">I-Decentr ingasiza ukukugcina uphephile kusukela ekuphulweni kwedatha, kuzandiso ezimbi, nokuningi</translation>
<translation id="1104942323762546749">I-Decentr ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="113122355610423240">I-Decentr iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="1131805035311359397">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Decentr<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Chofoza imenyu ye-Decentr</translation>
<translation id="1185134272377778587">Mayelana ne-Decentr</translation>
<translation id="1188705220418984327">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweDecentr Kokuncanyelwayo Kwesistimu.</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1262876892872089030">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-Decentr ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="1265577313130862557">I-Decentr ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="126567311906253476">Uma ungena ngemvume kumasevisi eGoogle efana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kuDecentr nge-akhawunti efanayo</translation>
<translation id="1315551408014407711">Setha iphrofayela yakho entsha ye-Decentr</translation>
<translation id="1342274909142618978">Futhi sula idatha ku-Decentr (<ph name="URL" />)</translation>
<translation id="1414495520565016063">Ungene ngemvume ku-Decentr!</translation>
<translation id="1478370723027452770">Thola usizo nge-Chrome Yokuhlola</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR" /></translation>
<translation id="1524282610922162960">Yabelana ngethebhu ye-Decentr</translation>
<translation id="1553461853655228091">I-Decentr idinga imvume yokufinyelela kwikhamera yakho ukudala imephu engu-3D yendawo yakho ekuzungezile</translation>
<translation id="1574377791422810894">Amathuluzi okuphepha e-Decentr</translation>
<translation id="1591808205441691831">I-Decentr idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe ku-Google Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume, le datha izohlala kule divayisi.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="1625909126243026060">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-Decentr</translation>
<translation id="1632539827495546968">Uma ufuna ukusebenzisa le akhawunti kanye kuphela, ungasebenzisa <ph name="GUEST_LINK_BEGIN" />Imodi Yesivakashi<ph name="GUEST_LINK_END" /> kwibhrawuza ye-Decentr. Uma ufuna ukwengeza i-akhawunti yothile, <ph name="LINK_BEGIN" />engeza umuntu omusha<ph name="LINK_END" /> ku-<ph name="DEVICE_TYPE" /> yakho.

Izimvume ozinikezile kakade amawebhusayithi nama-app zingase zisebenze kule akhawunti. Ungakwazi nokuphatha ama-Google Account wakho kokuthi <ph name="SETTINGS_LINK_BEGIN" />Amasethingi<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1708666629004767631">Kukhona inguqulo entsha, ephephile ye-Decentr etholakalayo.</translation>
<translation id="1715127912119967311">Ukusiza ukuthuthukisa lezi zici, i-Decentr ithumela ukusebenzisana kwakho nazo ku-Google. Le datha ingase ifundwe, icutshungulwe, futhi ichazwe ababuyekezi abangabantu.</translation>
<translation id="17264556997921157">Ungabona futhi ususe izihloko zesayithi ongaba nentshisekelo kuzo ezisetshenziswa ukukubonisa izikhangiso. I-Decentr izolinganisa ongaba nentshisekelo kukho ngokusekelwe kumlando wakho wakamuva wokubhrawuza.</translation>
<translation id="1733725117201708356">I-Decentr izosula idatha yokubhrawuza maduze</translation>
<translation id="1736443181683099871">I-Decentr izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="1745121272106313518">I-Decentr izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Uma i-HTTPS ingatholakali, i-Decentr izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="1774152462503052664">Vumela i-Decentr ukuthi isebenze ngemuva</translation>
<translation id="1779356040007214683">Ukuze senze i-Decentr ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="1804128559285178512">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi kusukela kuGoogle Account yakho kuDecentr</translation>
<translation id="1808667845054772817">Phinda ufake i-Decentr</translation>
<translation id="1820835682567584003">I-Decentr izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="18552579716432081">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-Google Account yakho, <ph name="BEGIN_LINK" />phuma ngemvume ku-Decentr<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">Ungaphatha ama-akhawunti we-Google wakho angene ngemvume. Ama-akhawunti wakho we-Google asetshenziselwe i-browser ye-Decentr, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">Amasayithi angagcina ulwazi nge-Decentr mayelana nezintshisekelo zakho. Ngokwesibonelo, uma uvakashela isayithi ukuze uthenge izicathulo zomjaho webanga elide, isayithi lingachaza intshisekelo yakho njengokugijima umjaho. Kamuva, uma uvakashela isayithi elihlukile ukuze ubhalisele umjaho, lelo sayithi lingakubonisa isikhangiso sezicathulo zokugijima ezisekelwe kuzintshisekelo zakho.</translation>
<translation id="1881322772814446296">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-Decentr. Idatha yakho ye-Decentr, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Decentr ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="1903204122890929795">Ukuze usebenzise lesi sandiso njengo-<ph name="USER_EMAIL_ADDRESS" />, ngena ngemvume kuDecentr.\nUzokwazi futhi ukusebenzisa nokulondoloza amaphasiwedi akho nokunye okwengeziwe kuGoogle Account yakho.</translation>
<translation id="1906696617298807388">Uma uthayipha ibha yekheli noma ibhokisi losesho, i-Decentr ithumela lokho okuthayiphayo ku-Google Drive ukuze ithole iziphakamiso zezinto. Lokhu kuvaliwe ku-Incognito.</translation>
<translation id="1911763535808217981">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Google njenge-Gmail ngaphandle kokungena ngemvume ku-Decentr</translation>
<translation id="1929939181775079593">I-Decentr ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="193439633299369377">I-DecentrOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="1951406923938785464">I-Decentr ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="1966382378801805537">I-Decentr ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="2008474315282236005">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Decentr njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2020032459870799438">Ukuze uhlole uma ngabe amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Decentr<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">Khetha ukuthi ufake phakathi umlando we-Decentr ukuze uthole umuzwa womuntu siqu kumasevisi e-Decentr</translation>
<translation id="2065461321550902389">Ukuze ulondoloze futhi usebenzise amaphasiwedi nokunye okwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume ku-Decentr. Le phasiwedi izolondolozwa ku-Google Account yakho ngemva kokungena ngemvume.</translation>
<translation id="2086476982681781442">I-Decentr ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="2088953378266246249">Ulwazi olumayelana nendlela i-Decentr ephatha ngayo izitifiketi zayo zempande</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Decentr ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Decentr ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Decentr ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="215352261310130060">I-Decentr ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2157600032285353789">Ungavula amabhukhimakhi, imodi yokufunda, nokuningi kusukela kumenyu ye-Decentr</translation>
<translation id="2174178932569897599">Yenza i-Decentr ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="2185166961232948079">I-Decentr - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2210682093923538346">Isayithi eyingozi. I-Decentr isuse izaziso.</translation>
<translation id="2240214816234246077">Awukavakashi kamuva nje. I-Decentr isuse i-<ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /></translation>
<translation id="2241627712206172106">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo nje.</translation>
<translation id="2313870531055795960">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Decentr. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Decentr ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2329088755516916767">Uma ivuliwe, i-Decentr ilayisha kuqala amakhasi okwenza ukubhrawuza nokusesha kusheshe.</translation>
<translation id="2343156876103232566">Ukuze uthumele inombolo kusukela lapha kufoni yakho ye-Android, ngena ngemvume ku-Decentr kuwo womabili amadivayisi.</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="2384373936468275798">I-DecentrOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-Decentr esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-Decentr esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Decentr esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Decentr esisodwa noma eziningi}}</translation>
<translation id="2401032172288869980">I-Decentr idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Ngamathuluzi avela ku-Decentr<ph name="END_LINK" />, ungabhrawuza ngokuphepha bese uhlala ulawula</translation>
<translation id="2451727308784734061">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha Kusiphathi Sephasiwedi. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="2478295928299953161">I-Decentr izovala maduzane</translation>
<translation id="2483889755041906834">Ku-Decentr</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="2513154137948333830">Ukuqalisa kuyadingeka: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2554739539410784893">I-Decentr izama ukufaka amaphasiwedi akhona esikhundleni. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="2560420686485554789">I-Decentr idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="2572494885440352020">Isisizi se-Decentr</translation>
<translation id="2583187216237139145">Noma iyiphi idatha ye-Decentr ekhiqizwa ngesikhathi sokusetshenziswa kwale phrofayela (efana nokudalwa kwamabhukhimakhi, umlando, amaphasiwedi, namanye amasethingi) ingasuswa umlawuli wephrofayela yomsebenzi. <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">Qhubeka usebenzisa i-Decentr</translation>
<translation id="259935314519650377">Yehlulekile ukufaka enqolobaneni isifaki esidawunilodiwe. Iphutha: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="264613044588233783">I-Decentr iyashesha ukuqalisa futhi izathi ezisebenzisa i-JavaScript kufanele zisebenze njengoba ziklanyiwe (okunconywayo)</translation>
<translation id="2648074677641340862">Iphutha le sistimu yokusebenza livele ngesikhathi sokufaka. Sicela uphinde ulande i-Decentr.</translation>
<translation id="2661879430930417727">Uma wabelana ngedivayisi, abangane nomndeni bangaphequlula ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo</translation>
<translation id="268602741124540128">Siyakwamukela ku-Decentr, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="2711502716910134313">Ithebhu le-Decentr</translation>
<translation id="2718390899429598676">Ngokuvikela okungeziwe, i-Decentr izobethela idatha yakho.</translation>
<translation id="2721354645805494590">Ukuze ususe i-Google Account yakho ku-Decentr, phuma ngemvume</translation>
<translation id="2738871930057338499">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 403 Yenqatshelwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="2770231113462710648">Guqula isiphequluli esizenzakalelayo sibe yi-:</translation>
<translation id="2785438272836277133">Lesi sandiso sinohlelo olungayilungele ikhompyutha futhi asiphephile. Sisuse ku-Decentr ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
<translation id="2837693172913560447">Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS" /> iphrofayela entsha ye-Decentr</translation>
<translation id="2846251086934905009">Iphutha lokufaka: Isifaki asiqedanga. Ukufakwa kukhanseliwe.</translation>
<translation id="2847479871509788944">Susa kusuka  ku-Decentr...</translation>
<translation id="2850691299438350830">Kukugcina uphephile ku-Decentr futhi kungase kusetshenziswe ukuthuthukisa ukuvikeleka kwakho kwamanye ama-app we-Google lapho ungene ngemvume</translation>
<translation id="2885378588091291677">Isiphathi somsebenzi</translation>
<translation id="2910007522516064972">Mayelana ne-&amp;Decentr</translation>
<translation id="2915996080311180594">Qala Kabusha Ngemuva Kwesikhathi</translation>
<translation id="2928420929544864228">Ukufaka kuqedile.</translation>
<translation id="2945997411976714835">Iphutha lokufaka: Inqubo yesifaki yehlulekile ukuqala.</translation>
<translation id="2977470724722393594">I-Decentr isesikhathini samanje</translation>
<translation id="2977506796191543575">Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Decentr ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile</translation>
<translation id="3013473503895162900">Vula i-<ph name="URL" /> kuthebhu entsha ku-Decentr.</translation>
<translation id="3032706164202344641">I-Decentr ayikwazi ukuhlola iphasiwedi yakho. Zama futhi emuva kwesikhathi.</translation>
<translation id="3032787606318309379">Ingeza ku-Decentr...</translation>
<translation id="3038232873781883849">Ilinde ukufaka...</translation>
<translation id="3068187312562070417">Amanye amaphrofayela e-Decentr</translation>
<translation id="3068515742935458733">Siza ukwenza i-Decentr ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK" /> ku-Decentr</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-USB ibifinyelelwa yisandiso se-Decentr esisodwa noma eziningi}=1{Idivayisi e-1 ye-USB ifinyelelwa yisandiso se-Decentr esisodwa noma eziningi}one{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-Decentr esisodwa noma eziningi}other{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-Decentr esisodwa noma eziningi}}</translation>
<translation id="3101560983689755071">Umlando wakho wokubhrawuza uthinta izikhangiso ozibonayo kanye nezinto ozishisakalelayo njengoba kulinganiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-Decentr isula ngokuzenzakalelayo izintshisekelo zakho njalo ngenyanga. Izintshisekelo zingavuseleleka ngaphandle kwalapho uma uzisusa.</translation>
<translation id="3103660991484857065">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-Decentr futhi.</translation>
<translation id="3130323860337406239">I-Decentr isebenzisa imakrofoni yakho.</translation>
<translation id="3155163173539279776">Phinda uqalise i-Decentr</translation>
<translation id="3179665906251668410">Vula isixhumanisi kuwindi le-Decentr Inco&amp;gnito</translation>
<translation id="3185330573522821672">Yenza ngendlela oyifisayo iphrofayela yakho entsha ye-Decentr</translation>
<translation id="3190315855212034486">Eshu! I-Decentr iphahlazekile. Qalisa kabusha manje?</translation>
<translation id="3224847870593914902">Ukuze ususe i-Google Account yakho ku-Decentr, phuma ngemvume ku-Decentr ekhasini Lamasethingi</translation>
<translation id="3258596308407688501">I-Decentr ayikwazi ukufunda nokubhala umkhombandlela wayo wedatha:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3268051428841342958">I-V8 iyi-JavaScript ye-Decentr futhi injini ye-WebAssembly isetshenziswe ukuthuthukisa ukusebenza kwesayithi</translation>
<translation id="3283186697780795848">Inguqulo ye-Decentr engu-<ph name="PRODUCT_VERSION" /> ifakiwe</translation>
<translation id="3286538390144397061">Qala kabusha manje</translation>
<translation id="328888136576916638">Okhiye be-Google API abekho. Okunye ukusebenza kwe-Decentr kuzokhutshazwa.</translation>
<translation id="3296368748942286671">Qhubeka usebenzise izinhlelo zokusebenza ezingemuva uma i-Decentr ivaliwe</translation>
<translation id="3313189106987092621">I-Decentr izokuxwayisa ngaphambi kokulayisha noma iyiphi isayithi isebenzisa uxhumo olungavikelekile</translation>
<translation id="3316771292331273802">Uzophuma ngemvume emasayithini amaningi uma uvala wonke amawindi e-Decentr, ngaphandle kwe-Google Account yakho uma ungene ngemvume ku-Decentr. Ukuvumela amasayithi akukhumbule, <ph name="SETTINGS_LINK" />.</translation>
<translation id="333055255088403283">Isandiso esithi \"<ph name="EXTENSION_NAME" />"\ sifuna ukuthi ungene ngemvume kuDecentr</translation>
<translation id="3350761136195634146">Iphrofayela ye-Decentr enale akhawunti isikhona kakade</translation>
<translation id="3387527074123400161">I-DecentrOS</translation>
<translation id="3406848076815591792">Shintshela kwiphrofayela le-Decentr elikhona kakade?</translation>
<translation id="3412460710772753638">Kokuthi Isiphathi Sephasiwedi kule divayisi</translation>
<translation id="3430503420100763906">Ngamaphrofayela we-Decentr ungahlukanisa zonke izinto zakho ze-Decentr. Dala amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="347328004046849135">I-Decentr izokwazisa uma ungena ngemvume ngephasiwedi eyonakalisiwe</translation>
<translation id="3474745554856756813">Lokhu kuzobuyekeza izinto ezingu-<ph name="ITEMS_COUNT" /> kusuka kule divayisi. Ukuze ubuyise idatha yakho, ngena ngemvume ku-<ph name="USER_EMAIL" /> njengo.</translation>
<translation id="3497319089134299931">I-<ph name="SHORTCUT" /> ingashintsha phakathi kwamaphrofayela we-Decentr</translation>
<translation id="3509308970982693815">Sicela uvale wonke amawindi we-Decentr uphinde uzame futhi.</translation>
<translation id="3530103706039034513">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume.  Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume ku-Decentr kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="3533435340678213462">Ukuze sivikele ubumfihlo bakho, sisula ngokuzenzakalelayo izintshisekelo zakho ezindala kunamaviki ama-4. Njengoba uqhubeka nokubhrawuza, intshisekelo ingase ivele ohlwini futhi. Noma ungasusa izithakazelo ongafuni ukuthi i-Decentr izicabangele.</translation>
<translation id="3567254597502212821">Umlando wakho wokubhrawuza, irekhodi lamasayithi owavakashele usebenzisa i-Decentr kule divayisi.</translation>
<translation id="3639635944603682591">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-Decentr njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Isibuyekezo esisha se-Decentr siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-Decentr siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-Decentr siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-Decentr siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3651803019964686660">Ukuze uthumele inombolo kusukela ku-<ph name="ORIGIN" /> kufoni yakho ye-Android, ngena ngemvume ku-Decentr kuwo womabili amadivayisi.</translation>
<translation id="3667616615096815454">Ayikwazi ukufaka, uhlelo lokusebenza alwaziwa kuseva.</translation>
<translation id="3669334504579945026">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kweDecentr Kokuncanyelwayo Kwesistimu.</translation>
<translation id="3685209450716071127">I-Decentr ayikwazi ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="3702352323269013324">Funda kabanzi mayelana nokwenza izikhangiso zibe ngezakho ku-Decentr</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Umlawuli wakho ucela ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe lesi sibuyekezo}=1{Umlawuli wakho ucela ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe lesi sibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho ucela ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho ucela ukuthi uqalise kabusha i-Decentr ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3713809861844741608">Vula isixhumanisi ku&amp;thebhu elisha le-Decentr</translation>
<translation id="3728124580182886854">Linka i-Decentr namanye amasevisi e-Google ngokwenza ngokomuntu ngamunye nangezinye izinjongo</translation>
<translation id="3788675262216168505">Phatha Amaphrofayela e-Decentr</translation>
<translation id="378917192836375108">I-Decentr ikuvumela ukuthi uchofoze inombolo yefoni kuwebhu uphinde uyishayele nge-Skype!</translation>
<translation id="3790262771324122253">Funda ukuthi kungani i-Decentr ivimbela ukudawuniloda okuthile</translation>
<translation id="379589255253486813">I-Decentr izokwazisa uma kukhona okudinga isibuyekezo sakho</translation>
<translation id="3802055581630249637">I-Decentr ilayisha kusengaphambili amakhasi okungenzeka uwavakashele, ukuze alayishe ngokushesha lapho uwavakashela</translation>
<translation id="3830894615770080216">Isistimu ye-DecentrOS</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="386822487697155367">Thola usizo nge-DecentrOS</translation>
<translation id="3871664619793219264">Thola ibhrawuza yakho ye-Decentr kusukela ku-<ph name="ACCOUNT_EMAIL" /></translation>
<translation id="388648406173476553">Yenza ngokwezifiso uphinde ulawule i-Decentr. Okuthile kudinga ukuthi ukunake - chofoza ngemininingwane.</translation>
<translation id="3889543394854987837">Chofoza igama lakho ukuze uvule i-Decentr uphinde uqale ukudlulisa amehlo.</translation>
<translation id="390528597099634151">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-Decentr. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-Decentr ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="3909353120217047026">Lesi sandiso sephula inqubomgomo Yesitolo sewebu se-Chrome, futhi kungenzeka singabi esiphephile. Sisuse ku-Decentr ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="391789666908693569">I-akhawunti yakho iphethwe i-<ph name="MANAGER_NAME" />. Umlawuli wakho angabona futhi ahlele le phrofayela yebhrawuza ye-Decentr nedatha yayo efana namabhukhimakhi, umlando, namaphasiwedi.</translation>
<translation id="3941890832296813527">Iphutha lokufaka: Igama lefayela lesifaki alivumelekile noma alisekelwe.</translation>
<translation id="3945058413678539331">I-Decentr izama ukukopisha amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="3962647064319009959">Funda ukuthi i-Decentr ikugcina kanjani uphephile</translation>
<translation id="3975724895399328945">Mayelana ne-&amp;Decentr Yokuhlola</translation>
<translation id="3997429360543082038">Mayelana ne-DecentrOS</translation>
<translation id="4019629340646866719">I-DecentrOS yenziwe ukuthi isebenze ngesofthiwe yomthombo ovulekile owengeziwe<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" />, njengoba kunjalo ngendawo yokuthuthukiswa kwe-<ph name="BEGIN_LINK_LINUX_OSS" />Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4036079820698952681">Siza i-Decentr ibengcono ngokubika <ph name="BEGIN_LINK" />izilungiselelo zamanje<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="4055805654398742145">Umphathi Wephasiwedi</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Inhlangano yakho ivala i-Decentr ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}one{Inhlangano yakho ivala i-Decentr ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}other{Inhlangano yakho ivala i-Decentr ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}}</translation>
<translation id="4118474109249235144">I-Decentr Incognito</translation>
<translation id="4122186850977583290">Iya ekhasini elithi Mayelana neDecentr</translation>
<translation id="4148957013307229264">Iyafaka...</translation>
<translation id="4149336151887611710">Inhlangano yakho ingabona iphinde iphathe idatha yopheqululo kuphrofayela yakho yomsebenzi, efana namabhukhimakhi, umlando, namaphasiwedi akho. Ayikwazi ukubona idatha yopheqululo kumaphrofayela omuntu siqu e-Decentr.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokungena ngemvume - i-Decentr</translation>
<translation id="421369550622382712">Thola izinhlelo zokusebenza ezinhle, amageyimu, izandiso, namatimu we-Decentr.</translation>
<translation id="4216212958613226427">Lolu limi lusetshenziselwa ukubonisa i-Decentr UI</translation>
<translation id="4222932583846282852">Iyakhansela...</translation>
<translation id="4230135487732243613">Xhumanisa idatha yakho ye-Decentr kule akhawunti?</translation>
<translation id="4251772536351901305">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-Google ebingazi ngawo ngaphambili, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izixwayiso ze-Decentr.</translation>
<translation id="4269093074552541569">Phuma Ngemvume ku-Decentr</translation>
<translation id="4271805377592243930">Thola usizo nge-Decentr</translation>
<translation id="4281844954008187215">Imigomo yesevisi</translation>
<translation id="4285930937574705105">Ukufaka kuhlulekile ngenxa yephutha elingacacisiwe. Uma ngabe i-Decentr iyasebenza manje, sicela uyivale uphinde uzame futhi.</translation>
<translation id="4304713468139749426">Isiphathi sephasiwedi</translation>
<translation id="4334294535648607276">Ukulanda kuqedile.</translation>
<translation id="439358628917130594">I-<ph name="MANAGER" /> idinga ukuthi ufunde uphinde wamukele Imigomo Yesevisi elandelayo ngaphambi kokusebenzisa le divayisi. Le migomo ayinwebi, iguqule noma ikhawulele Imigomo ye-DecentrOS.</translation>
<translation id="4407044323746248786">Phuma ku-Decentr noma kunjalo?</translation>
<translation id="4415566066719264597">Vumela i-Decentr isebenze ngemuva</translation>
<translation id="4423735387467980091">Yenza ngokwezifiso uphinde ulawule i-Decentr</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
<translation id="4447409407328223819">Mayelana ne-Chrome Yokuhlola</translation>
<translation id="4501471624619070934">Ukufaka kuhlulekile ngoba ukufinyelela kukhawulelwe kuleli zwe.</translation>
<translation id="4510853178268397146">Lesi sandiso asikashicileli izindlela zangasese zokuziphatha, njengokuthi siyiqoqa futhi siyisebenzise kanjani idatha. I-Decentr incoma ukuthi usisuse.</translation>
<translation id="452711251841752011">Siyakwamukela ku-Decentr; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="4531137820806573936">I-Decentr idinga imvume yokumepha indawo ekuzungezile futhi ilandelele izandla zakho</translation>
<translation id="4536805923587466102">Usuvele ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" /> kwenye iphrofayela ye-Decentr</translation>
<translation id="4544142686420020088">I-Decentr ayibuyekezekanga, kunokuthile okungahambanga kahle. <ph name="BEGIN_LINK" />Lungisa izinkinga zokubuyekaza kwe-Decentr nezibuyekezo ezihlulekile.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Qhubeka kuphrofayela entsha ye-Decentr?</translation>
<translation id="4567424176335768812">Ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" />. Manje ungakwazi ukufinyelela amabhukhimakhi, umlando, nezinye izilungiselelo kuwo wonke amadivayisi wakho ongene kuwo ngemvume.</translation>
<translation id="4570813286784708942">I-Decentr ivimbele lokhu kudawuniloda ngoba uvale Ukuphequlula Okuphephile futhi ifayela alikwazi ukuqinisekiswa</translation>
<translation id="4594305310729380060">Kusiphathi Sephasiwedi kule divayisi</translation>
<translation id="459535195905078186">Izinhlelo zokusebenza ze-Decentr</translation>
<translation id="4613863813562375431">Uhlobo lwe-DecentrOS</translation>
<translation id="4617285639650863674">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kwe-Decentr Kokuncanyelwayo Kwesistimu</translation>
<translation id="4621240073146040695">Icishe isesikhathini! Qalisa kabusha i-Decentr ukuze uqedele ukubuyekeza.</translation>
<translation id="4665829708273112819">Isexwayiso: I-Decentr ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="4673151026126227699">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-Decentr, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="4677944499843243528">Iphrofayela ibukeka isetshenziswa enye inqubo ye-Decentr (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />). I-Decentr ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-Decentr.</translation>
<translation id="4680828127924988555">Khansela Ukufaka</translation>
<translation id="469259825538636168">Enye idatha yakho yeDecentr ayikalondolozwa kuGoogle Account. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="4708774505295300557">Umuntu othile ungene ngemvume ngaphambilini ku-Decentr kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-Decentr ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="4724676981607797757">Ukufaka kuhlulekile ngenxa yephutha lephrothokholi engasekelwe.</translation>
<translation id="4746050847053251315">Phuma ku-Decentr noma kunjalo?</translation>
<translation id="4748217263233248895">Isibuyekezo esibalulekile sokuvikela se-Decentr sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="4765210420921718862">Ungashintsha umqondo wakho noma kunini kumasethingi we-Decentr. Izivivinyo zisebenza eduze kwendlela yamanje yokulethwa kwezikhangiso, ngakho ngeke ubone izinguquko ngokushesha.</translation>
<translation id="4788777615168560705">I-Decentr ayikwazi ukuhlola iphasiwedi yakho. Zama futhi ngemva kwamahora angu-24 noma <ph name="BEGIN_LINK" />hlola amaphasiwedi ku-akhawunti yakho ye-Google<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-Google. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-Google. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="4814736265800133385">Sebenzisa i-Decentr ngaphandle kwe-akhawunti</translation>
<translation id="4888717733111232871">Umyalo obambeke ngaphakathi we-Decentr wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="4893347770495441059">Qalisa kabusha ukuze Ubuyekeze i-&amp;Decentr</translation>
<translation id="4942295735032723435">Ukuze uthole izibuyekezo zesikhathi esizayo ze-Decentr, uzodinga i-macOS 11 noma eyakamuva. Le khompyutha isebenzisa i-macOS 10.15.</translation>
<translation id="4943838377383847465">I-Decentr kumodi yasemuva.</translation>
<translation id="4987820182225656817">Izihambeli zingasebenzisa i-Decentr ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="4994636714258228724">Zingeze ngokwakho ku-Decentr</translation>
<translation id="5114678101347489141">I-Decentr ihlola izakhi ezintsha ezivumela amasayithi ukuthi alethe ukuzizwisa kokubhrawuza okufanayo kusetshenziswa ulwazi lwakho oluncane</translation>
<translation id="5224391634244552924">Awekho amaphasiwedi alondoloziwe. I-Decentr ingahlola amaphasiwedi akho lapho uwalondoloza khona.</translation>
<translation id="5231355151045086930">Phuma ngemvume ku-Decentr</translation>
<translation id="5252179775517634216">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-Decentr. Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS" /> iphrofayela entsha ye-Decentr</translation>
<translation id="5277894862589591112">Ukuze ufake izinguquko zakho, qalisa kabusha i-Decentr</translation>
<translation id="5294316920224716406">Uma ubhrawuza ngemodi ye-Incognito, i-Decentr izokuxwayisa ngaphambi kokulayisha isayithi isebenzisa uxhumo olungavikelekile.</translation>
<translation id="5296845517486664001">Uma izivivinyo zivuliwe futhi i-Decentr ikubeke ngokungahleliwe ekuzameni okusebenzayo, umlando wakho wokubhrawuza uthinta izikhangiso ozibonayo kanye nezinto ozithakaselayo njengoba kusikiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-Decentr isula izintshisekelo zakho njalo ngenyanga.</translation>
<translation id="5352264705793813212">I-Decentr ithole izincomo ezithile zokuphepha zokubuyekeza kwakho</translation>
<translation id="5352361688875342522">Amanye Amaphrofayela e-Decentr</translation>
<translation id="5358375970380395591">Ungena ngemvume nge-akhawunti ephethwe futhi unikeza umlawuli wayo ukulawula okungaphezulu kwephrofayela yakho ye-Decentr. Idatha yakho ye-Decentr, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshezelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Ikhodi eyengeziwe: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Ukuze uthole ukwenza ngokomuntu ngamunye, okufaka i-Decentr Kumsebenzi Wewebhu nowe-App</translation>
<translation id="5383439451358640070">Funda ukuthi kungani i-Decentr ivimba amanye amafayela</translation>
<translation id="5386450000063123300">Ibuyekeza i-Decentr (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Vumela ukungena ngemvume kwe-Decentr</translation>
<translation id="5398878173008909840">Kukhona inguqulo entsha ye-Decentr etholakalayo.</translation>
<translation id="5405650547142096840">Susa kusuka  ku-Decentr</translation>
<translation id="5427571867875391349">Setha i-Decentr njengesiphequluli sakho esizenzakalelayo</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Decentr Beta</translation>
<translation id="5473971139929175403">I-Decentr kungenzeka ingasebenzi ngokufanelekile ngoba ayisasekelwa kule sistimu yokusatshalaliswa kwe-Linux</translation>
<translation id="5475924890392386523">I-Decentr ivimbele lokhu kudawuniloda ngoba ifayela lingalimaza ama-akhawunti wakho omuntu siqu nawenethiwekhi yokuxhumana nomphakathi</translation>
<translation id="5480860683791598150">I-Decentr idinga ukufinyelela kundawo yakho ukuze yabelane ngendawo yakho naleli sayithi</translation>
<translation id="5487574057737591516">Ukuze sivikele ubumfihlo bakho, sisula ngokuzenzakalelayo izintshisekelo zakho ezindala kunamaviki ama-4. Njengoba uqhubeka nokubhrawuza, intshisekelo ingase ivele ohlwini futhi. Futhi uma i-Decentr ikuthola kungalungile noma ungafuni ukubona izikhangiso ezithile, ungayisusa intshisekelo.</translation>
<translation id="549669000822060376">Sicela ulinde ngenkathi i-Decentr ifaka izibuyekezo zesistimu zakamuva.</translation>
<translation id="5496810170689441661">I-Decentr izama ukuhlela amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="5527463683072221100">Vula ama-PDF ku-Decentr</translation>
<translation id="5623402015214259806">{0,plural, =0{Isibuyekezo se-Decentr siyatholakala}=1{Isibuyekezo se-Decentr siyatholakala}one{Isibuyekezo se-Decentr sitholakala ngezinsuku ezingu-#}other{Isibuyekezo se-Decentr sitholakala ngezinsuku ezingu-#}}</translation>
<translation id="5643865575100044307">Yisule njalo idatha yesayithi kudivayisi yakho lapho uvala i-Decentr</translation>
<translation id="5653831366781983928">Sicela uqalise kabusha i-Decentr manje</translation>
<translation id="5690427481109656848">I-Google LLC</translation>
<translation id="5698481217667032250">Veza i-Decentr ngalolu limi</translation>
<translation id="569897634095159764">Ayikwazi ukuxhuma ku-inthanethi Iseva elibamba idinga ukufakazela ubuqiniso.</translation>
<translation id="5761096224651992291">Awukavakashi kamuva nje. I-Decentr isuse i-<ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /></translation>
<translation id="5800158606660203929">Yenza ngokwezifiso uphinde ulawule i-Decentr. Setha i-Decentr njengokwakho okuzenzakalelayo.</translation>
<translation id="5809516625706423866">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 401 Ayigunyaziwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="5862307444128926510">Siyakwamukela ku-Decentr</translation>
<translation id="5883558403894052917">I-Decentr ithole ukuthi lezi zinto zinohlelo olungayilungele ikhompyutha</translation>
<translation id="5889361821821684993">I-Decentr ihlale ihlola ukuze iqinisekise ukuthi ibhrawuza inamasethingi aphephe kakhulu. Sizokwazisa uma kukhona okudinga ukubuyekezwa.</translation>
<translation id="5895138241574237353">Qalisa kabusha</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokugena ngemvume</translation>
<translation id="5924017743176219022">Ixhuma Ku-inthanethi...</translation>
<translation id="5941711191222866238">Nciphisa</translation>
<translation id="5972142260211327093">Uma i-Decentr ikubeke ngokungahleliwe esivivinyweni esisebenzayo, umlando wakho wokuphequlula uthinta izikhangiso ozibonayo kanye nezinto ozithakaselayo njengoba kusikiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-Decentr isula izintshisekelo zakho njalo ngenyanga. Izintshisekelo ziyavuseleleka ngaphandle kwalapho uma uzisusa.</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{Inhlangano yakho ivala i-Decentr ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1.}one{Inhlangano yakho ivala i-Decentr ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}other{Inhlangano yakho ivala i-Decentr ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}}</translation>
<translation id="5987687638152509985">Buyekeza i-Decentr ukuze uqale ukuvumelanisa</translation>
<translation id="5988505247484123880">Kujwayelekile ukuthi amasayithi owavakashelayo akhumbule izinto onentshisekelo kuzo, enze ukuzizwela kube ngokwezifiso. Amasayithi angagcina nolwazi nge-Decentr mayelana nezintshisekelo zakho.</translation>
<translation id="6003112304606738118">Iyadawuniloda... Kusele amahora angu-<ph name="HOURS" /></translation>
<translation id="6019451407441383358">Ungavula amabhukhimakhi, imodi yokufunda, nokuningi kusukela kumenyu ye-Decentr ngaphezulu ngakwesokudla</translation>
<translation id="6040143037577758943">Vala</translation>
<translation id="6055895534982063517">Kukhona inguqulo entsha ye-Decentr etholakalayo, futhi ishesha kakhulu kunakuqala.</translation>
<translation id="6058380562449900225">Ukuvikela idatha lakho vumela i-Decentr isuse izimvume kumasayithi ongakawavakasheli muva nje. Ayizimisi izaziso.</translation>
<translation id="6063093106622310249">&amp;Vula ku-Decentr</translation>
<translation id="6072279588547424923">I-<ph name="EXTENSION_NAME" /> ingezwe ku-Decentr</translation>
<translation id="6072463441809498330">Yenza i-Decentr Isheshe</translation>
<translation id="608006075545470555">Engeza Iphrofayela Yomsebenzi kulesi siphequluli</translation>
<translation id="6096348254544841612">Enza ngendlela oyifisayo uphinde ulawule i-Decentr. Isibuyekezo siyatholakala.</translation>
<translation id="6102072151902574948">Uma ivuliwe, i-Decentr igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ozimele wevidiyo.</translation>
<translation id="6107893135096467929">Kuvuliwe • I-Decentr ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="6119438414301547735">Vumela isandiso ukuze ubonise izicelo zokufinyelela kubha yamathuluzi ye-Decentr</translation>
<translation id="6120345080069858279">I-Decentr izolondoloza le phasiwedi ku-akhawunti yakho ye-Google. Ngeke kudingeke ukuthi uyikhumbule.</translation>
<translation id="6129621093834146363">I-<ph name="FILE_NAME" /> iyingozi, ngakho-ke i-Decentr iyivimbile.</translation>
<translation id="6132897690380286411">I-Decentr izovala maduzane futhi isule idatha</translation>
<translation id="6134968993075716475">Ukuphequlula Okuphephile kuvaliwe. i-Decentr incoma ukuba kuvulwe.</translation>
<translation id="6145820983052037069">Ungashintsha phakathi kwamaphrofayela we-Decentr lapha</translation>
<translation id="615103374448673771">Uma uvumela amakhukhi, i-Decentr ingase iwasebenzise lapho ilayisha kusengaphambili</translation>
<translation id="6174920971222007286">Leli fayela kungenzeka libe nobungozi<ph name="LINE_BREAK" />I-Decentr ingakuhlolela lokhu okudawunilodwayo uma unikeza iphasiwedi. Ulwazi mayelana nefayela luthunyelwa kokuthi Ukuphequlula ngokuphephile kwe-Google, kodwa okuqukethwe kufayela kanye nephasiwedi kusala kudivayisi yakho.</translation>
<translation id="6182736845697986886">Ukufaka kuhlulekile ngenxa yephutha langaphakathi leseva yokubuyekeza.</translation>
<translation id="6183079672144801177">Yenza isiqinisekiso sokuthi ungene ngemvume ku-Decentr ku-<ph name="TARGET_DEVICE_NAME" /> yakho bese uzama ukuthumela futhi.</translation>
<translation id="6212496753309875659">Le khompyutha isivele inenguqulo yakamuva kakhulu ye-Decentr. Uma isofthiwe ingasebenzi, sicela ukhiphe i-Decentr uphinde uzame futhi.</translation>
<translation id="6219195342503754812">{0,plural, =0{I-Decentr izoqalisa kabusha manje}=1{I-Decentr izoqalisa kabusha kusekhondi elingu-1}one{I-Decentr izoqalisa kabusha kumasekhondi angu-#}other{I-Decentr izoqalisa kabusha kumasekhondi angu-#}}</translation>
<translation id="6241367896540709610">I-Decentr idinga imvume yokufinyelela kusitoreji ukuze idawunilode amafayela</translation>
<translation id="6245734527075554892">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Decentr</translation>
<translation id="6248213926982192922">Yenza i-Decentr ibe yisiphequluli esizenzakalelayo</translation>
<translation id="6266342355635466082">I-Decentr ayikwazi ukuhlola izibuyekezo. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="6268381023930128611">Phuma ku-Decentr?</translation>
<translation id="6281746429495226318">Yenza ngokwezifiso iphrofayela yakho ye-Decentr</translation>
<translation id="6290827346642914212">Qama iphrofayela lakho le-Decentr</translation>
<translation id="6294831894865512704">Isandiso sifuna ukuthi ungene kuDecentr</translation>
<translation id="6295779123002464101">I-<ph name="FILE_NAME" /> kungenzeka ibe ingozi, ngakho-ke i-Decentr iyivimbile.</translation>
<translation id="6309712487085796862">I-Decentr isebenzisa ikhamela yakho.</translation>
<translation id="6327105987658262776">Asikho isibuyekezo esitholakalayo.</translation>
<translation id="6333502561965082103">Okunye ukusebenza ku-Decentr kuyaqhubeka. Sicela uzame futhi emuva kwesikhathi.</translation>
<translation id="6334986366598267305">Manje kulula ukusebenzisa i-Decentr nge-Akhawunti yakho ye-Google nakumakhompyutha abiwe.</translation>
<translation id="6347933965114150440">Isinqamuleli se-Decentr</translation>
<translation id="6366160072964553914">I-Decentr ivimbele lokhu kudawunilodwa ngoba ifayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="6373523479360886564">Ingabe uqinisekile ukuthi ufuna ukukhipha i-Decentr?</translation>
<translation id="6375219077595103062">Engeza isinqamuleli Kusiphathi Sephasiwedi</translation>
<translation id="6384011394608460044"><ph name="BEGIN_BOLD" />Indlela esisebenzisa ngayo le datha:<ph name="END_BOLD" /> I-Decentr ingalinganisela izintshisekelo zakho. Kamuva, isayithi olivakashelayo lingacela i-Decentr ukuthi ibone izintshisekelo zakho ukuze yenze izikhangiso ozibonayo ngokwezifiso zakho.</translation>
<translation id="6400112897226594999">Ilogo ye-Decentr ngaphakathi kwesikrini sekhompyutha.</translation>
<translation id="6403826409255603130">I-Decentr yisiphequluli sewebhu esiqalisa amakhasi wewebhu nezinhlelo zokusebenza ngesivinini sombani. Iyashesha, izinzile, futhi isebenziseka kalula. Dlulisa amehlo kuwebhu ngokuvikeleke kakhulu ngokuvikelwa kuhlelo olungayilungele ikhompyutha nobugebengu bokweba imininingwane ebucayi eyakhelwe ku-Decentr.</translation>
<translation id="6442900851116057561">Qalisa kabusha i-DecentrOS</translation>
<translation id="6443470774889161065">I-Decentr ilayisha kusengaphambili amakhasi engeziwe ongase uwavakashele, ukuze alayishe ngokushesha kakhudlwana lapho uwavakashela</translation>
<translation id="645458117210240797">Kuvaliwe • I-Decentr ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="6455857529632101747">Siyakwamukela kumaphrofayela we-Decentr</translation>
<translation id="6475912303565314141">Iphinde ilawule ukuthi iliphi ikhasi eliboniswa lapho uqala i-Decentr.</translation>
<translation id="648319183876919572">Ukubhrawuza Ngokuphepha Okugqamile kwenza okuningi ukukuvikela kumawebhusayithi ayingozi nakokudawunilodiwe</translation>
<translation id="6510925080656968729">Khipha i-Decentr</translation>
<translation id="651535675648445253">Izinqamuleli zivulwe ku-Decentr</translation>
<translation id="6539122709674868420">Inhlangano yakho ivala i-Decentr uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION" />. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="6542839706527980775">Iphrofayela ngalinye linolwazi lwalo lwe-Decentr njengamabhukhimakhi, umlando, amaphasiwedi, nokuningi</translation>
<translation id="6563921047760808519">Funda kabanzi mayelana <ph name="BEGIN_LINK" />nokuthi i-Decentr igcina kanjani idatha yakho iyimfihlo<ph name="END_LINK" /></translation>
<translation id="656935081669708576">Ungashintsha ukuze ubone amaphasiwedi kusuka kwenye iphrofayela ye-Decentr</translation>
<translation id="6570579332384693436">Ukuze kulungiswe amaphutha okupeletwa, i-Decentr ithumela umbhalo owuthayiphayo kuzinkambu zombhalo ku-Decentr</translation>
<translation id="6598877126913850652">Iya kuzilungiselelo zesaziso se-Decentr</translation>
<translation id="6613594504749178791">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-Decentr.</translation>
<translation id="665732753414869868">I-Decentr idinga imvume yekhamera ukudala imephu ye-3D yendawo yakho ekuzungezile</translation>
<translation id="6663852025006259149">Amasayithi cishe azosebenza njengoba ulindele kodwa ngeke akukhumbule ngemva kokuvala wonke amawindi e-Decentr</translation>
<translation id="6669284030132180248">Uma futhi ulondoloza amabhukhimakhi ku-Google Account yakho, ungakwazi ukulandelela izintengo zomkhiqizo ku-Decentr futhi waziswe uma intengo yehla.</translation>
<translation id="6676384891291319759">Finyelela i-inthanethi?</translation>
<translation id="668175097507315160">I-DecentrOS ayikwazanga ukuvumelanisa idatha yakho yenxa yephutha lokungena ngemvume.</translation>
<translation id="6692797197837897398">I-Decentr ikunikeza ukulawula okwengeziwe ezikhangisweni ozibonayo futhi ikhawulela lokho amasayithi angakufunda ngawe uma ekubonisa izikhangiso eziqondene nawe</translation>
<translation id="6709350901466051922">I-Decentr idinga imvume yemakrofoni kule sayithi</translation>
<translation id="6712881677154121168">Iphutha lokudawuniloda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6717134281241384636">Iphrofayela yakho ayikwazi ukusetshenziswa ngoba isuka kunguqulo entsha ye-Decentr. 

Ezinye izici kungenzeka zingatholakali. Sicela ucacise umkhombandlela wephrofayela ehlukile noma usebenzise inguqulo entsha ye-Decentr.</translation>
<translation id="6729124504294600478">Ukuze uthole ukwenza ngokomuntu ngamunye nezinye izakhi, ezifaka i-Decentr Kumsebenzi wewebhu nowe-app nakumasevisi alinkiwe e-Decentr</translation>
<translation id="6734291798041940871">I-Decentr isivele ifakiwe kubo bonke abasebenzisi kukhompuyutha yakho.</translation>
<translation id="673636774878526923">Ukuze ufinyelele ezintweni zakho ze-Decentr kuwo wonke amadivayisi wakho, ngena ngemvume, bese uvula ukuvumelanisa.</translation>
<translation id="674245979920622322">Awukavakashi kamuva nje. I-Decentr isuse i-<ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, nokungu-<ph name="COUNT" /> ngaphezulu</translation>
<translation id="67706546131546258">I-Decentr incoma ukuthi uskene leli fayela ngenxa yokuthi kungenzeka ukuthi liyingozi.</translation>
<translation id="6779406956731413166">I-DecentrOS yenziwa yenzeke yi-<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" /> engeziwe.</translation>
<translation id="6847869444787758381">I-Decentr ikuvumela kuthi wazi amaphasiwedi akho afakwe engcupheni</translation>
<translation id="684888714667046800">Ayikwazi ukuxhuma ku-inthanethi. Uma usebenzisa uhlelo lokuvikela, sicela uqinisekise ukuthi i-<ph name="PRODUCT_EXE_NAME" /> ikuhlelo lwabagunyaziwe.</translation>
<translation id="6857782730669500492">I-Decentr - <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">I-Decentr ithole ukuthi i-"<ph name="EXTENSION_NAME" />" inohlelo olungayilungele ikhompyutha</translation>
<translation id="6893813176749746474">I-Decentr ibuyekeziwe, kodwa awukakayisebenzisi okungenani izinsuku ezingu-30.</translation>
<translation id="691026815377248078">I-Decentr idinga ukufinyelela kwe-Bluetooth ukuze iqhubeke 
 nokumatanisa. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6929417474050522668">Lapho imizamo ivuliwe, Isilinganiso sesikhangiso sivumela amasayithi owavakashelayo ukuba acele ulwazi ku-Decentr olusiza isayithi ukukala ukusebenza kwezikhangiso zawo. Isilinganiso sesikhangiso sikhawulela ukulandelela indawo yonke ngokudlulisa ulwazi oluncane ngangokunokwenzeka phakathi kwamasayithi.</translation>
<translation id="6940431691900807093">Kamuva, isayithi olivakashelayo lingacela i-Decentr ukuthi ibone izintshisekelo zakho ukuze yenze izikhangiso ozibonayo ngokwezifiso zakho. I-Decentr ikwazi ukwabelana ngezintshisekelo ezifika ku-3.</translation>
<translation id="6964305034639999644">Vula isixhumanisi kuwindi le-Decentr inco&amp;gnito</translation>
<translation id="6978145336957848883">Amaphasiwedi angaqinile aqageleka kalula. Vumela i-Decentr <ph name="BEGIN_LINK" />ikudalele futhi ikhumbule amaphasiwedi aqinile<ph name="END_LINK" />.</translation>
<translation id="6981396265751285733">Uma ivuliwe, i-Decentr ikhulula inkumbulo kumathebhu angasebenzi. Lokhu kunikeza amathebhu asebenzayo namanye ama-app izinsiza zekhompyutha ezengeziwe futhi kugcina i-Decentr ishesha. Amathebhu akho angasebenzi aphinde asebenze ngokuzenzakalelayo uma ubuyela kuwo.</translation>
<translation id="6985329841647292029">Imigomo ye-DecentrOS</translation>
<translation id="6990124437352146030">I-Decentr idinga imvume ukuze ifinyelele kumakrofoni yakho yaleli sayithi</translation>
<translation id="7011190694940573312">Ukufakwa kwehlulekile ngenxa yokuthi lolu hlobo lwesistimu yokusebenza alusekelwe.</translation>
<translation id="7024536598735240744">Iphutha lokuvula: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">Ukufaka Kumisiwe.</translation>
<translation id="7045244423563602563">Yenza i-Decentr Ibe Ngeyakho</translation>
<translation id="705851970750939768">Buyekeza i-Decentr</translation>
<translation id="7067091210845072982">Uma isithombe singanayo incazelo ephelele, i-Decentr izozama ukukunikezela eyodwa. Ukuze udale izincazelo, izithombe zithunyelwa ku-Google.</translation>
<translation id="7141270731789036260">Yenza i-Chrome ibe ngokwezifiso ukuze ihlolwe</translation>
<translation id="7159538860914681762">Ukuze ulondoloze futhi usebenzise amaphasiwedi akho nokunye okwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume ku-Decentr</translation>
<translation id="7173822816570314652">Inhlangano yakho isula idatha ye-Decentr uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION" />. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="718435575166326686">I-Decentr idinga imvume yekhamera kule sayithi</translation>
<translation id="7196312274710523067">Ayikwazanga ukuqalisa i-Decentr. Zama futhi.</translation>
<translation id="7197677400338048821">I-Decentr ayikwazi ukuhlola iphasiwedi yakho. Zama futhi emva kwamahora angu-24.</translation>
<translation id="7213407614656404070">Sebenzisa i-Decentr noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app</translation>
