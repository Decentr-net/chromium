<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="1029669172902658969">Qalisa kabusha ukuze ubuyekeze i-&amp;tomiOS</translation>
<translation id="1040916596585577953">I-tomi incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="1042552502243217427">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-tomi isebenzisa amaseva e-tomi. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-tomi ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="1083934481477628225">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-tomi</translation>
<translation id="1098170124587656448">I-tomi ingasiza ukukugcina uphephile kusukela ekuphulweni kwedatha, kuzandiso ezimbi, nokuningi</translation>
<translation id="1104942323762546749">I-tomi ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="113122355610423240">I-tomi iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="1131805035311359397">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-tomi<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Chofoza imenyu ye-tomi</translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="1185134272377778587">Mayelana ne-tomi</translation>
<translation id="1188705220418984327">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kwetomi Kokuncanyelwayo Kwesistimu.</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1262876892872089030">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-tomi ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="1265577313130862557">I-tomi ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="126567311906253476">Uma ungena ngemvume kumasevisi etomi efana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kutomi nge-akhawunti efanayo</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Setha iphrofayela yakho entsha ye-tomi</translation>
<translation id="1324107359134968521">I-tomi idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1342274909142618978">Futhi sula idatha ku-tomi (<ph name="URL" />)</translation>
<translation id="1414495520565016063">Ungene ngemvume ku-tomi!</translation>
<translation id="1478370723027452770">Thola usizo nge-tomi Yokuhlola</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR" /></translation>
<translation id="1524282610922162960">Yabelana ngethebhu ye-tomi</translation>
<translation id="1553461853655228091">I-tomi idinga imvume yokufinyelela kwikhamera yakho ukudala imephu engu-3D yendawo yakho ekuzungezile</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Lesi sandiso asisasekelwa. Itomi incoma ukuthi usisuse.}one{Lezi zandiso azisasekelwa. Itomi incoma ukuthi uzisuse.}other{Lezi zandiso azisasekelwa. Itomi incoma ukuthi uzisuse.}}</translation>
<translation id="1574377791422810894">Amathuluzi okuphepha e-tomi</translation>
<translation id="1591808205441691831">I-tomi idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe ku-tomi Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume, le datha izohlala kule divayisi.</translation>
<translation id="1594928384848033697">Itomi ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="1625909126243026060">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-tomi</translation>
<translation id="1632539827495546968">Uma ufuna ukusebenzisa le akhawunti kanye kuphela, ungasebenzisa <ph name="GUEST_LINK_BEGIN" />Imodi Yesivakashi<ph name="GUEST_LINK_END" /> kwibhrawuza ye-tomi. Uma ufuna ukwengeza i-akhawunti yothile, <ph name="LINK_BEGIN" />engeza umuntu omusha<ph name="LINK_END" /> ku-<ph name="DEVICE_TYPE" /> yakho.

Izimvume ozinikezile kakade amawebhusayithi nama-app zingase zisebenze kule akhawunti. Ungakwazi nokuphatha ama-tomi Account wakho kokuthi <ph name="SETTINGS_LINK_BEGIN" />Amasethingi<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1715127912119967311">Ukusiza ukuthuthukisa lezi zici, i-tomi ithumela ukusebenzisana kwakho nazo ku-tomi. Le datha ingase ifundwe, icutshungulwe, futhi ichazwe ababuyekezi abangabantu.</translation>
<translation id="1722488837206509557">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="17264556997921157">Ungabona futhi ususe izihloko zesayithi ongaba nentshisekelo kuzo ezisetshenziswa ukukubonisa izikhangiso. I-tomi izolinganisa ongaba nentshisekelo kukho ngokusekelwe kumlando wakho wakamuva wokubhrawuza.</translation>
<translation id="1733725117201708356">I-tomi izosula idatha yokubhrawuza maduze</translation>
<translation id="1736443181683099871">I-tomi izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="1745121272106313518">I-tomi izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Uma i-HTTPS ingatholakali, i-tomi izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="1774152462503052664">Vumela i-tomi ukuthi isebenze ngemuva</translation>
<translation id="1779356040007214683">Ukuze senze i-tomi ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="1808667845054772817">Phinda ufake i-tomi</translation>
<translation id="1820835682567584003">I-tomi izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="18552579716432081">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-tomi Account yakho, <ph name="BEGIN_LINK" />phuma ngemvume ku-tomi<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">Ungaphatha ama-akhawunti we-tomi wakho angene ngemvume. Ama-akhawunti wakho we-tomi asetshenziselwe i-browser ye-tomi, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">Amasayithi angagcina ulwazi nge-tomi mayelana nezintshisekelo zakho. Ngokwesibonelo, uma uvakashela isayithi ukuze uthenge izicathulo zomjaho webanga elide, isayithi lingachaza intshisekelo yakho njengokugijima umjaho. Kamuva, uma uvakashela isayithi elihlukile ukuze ubhalisele umjaho, lelo sayithi lingakubonisa isikhangiso sezicathulo zokugijima ezisekelwe kuzintshisekelo zakho.</translation>
<translation id="1881322772814446296">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-tomi. Idatha yakho ye-tomi, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-tomi, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-tomi ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="1906696617298807388">Uma uthayipha ibha yekheli noma ibhokisi losesho, i-tomi ithumela lokho okuthayiphayo ku-tomi Drive ukuze ithole iziphakamiso zezinto. Lokhu kuvaliwe ku-Incognito.</translation>
<translation id="1911763535808217981">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-tomi njenge-Gmail ngaphandle kokungena ngemvume ku-tomi</translation>
<translation id="1929939181775079593">I-tomi ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="193439633299369377">I-tomiOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="1951406923938785464">I-tomi ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="1966382378801805537">I-tomi ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="1990262977744080398">Funda ukuthi kungani i-tomi ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="2008474315282236005">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-tomi njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2020032459870799438">Ukuze uhlole uma ngabe amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-tomi<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">Khetha ukuthi ufake phakathi umlando we-tomi ukuze uthole umuzwa womuntu siqu kumasevisi e-tomi</translation>
<translation id="2086476982681781442">I-tomi ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="2088953378266246249">Ulwazi olumayelana nendlela i-tomi ephatha ngayo izitifiketi zayo zempande</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-tomi ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-tomi ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-tomi ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="215352261310130060">I-tomi ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2157600032285353789">Ungavula amabhukhimakhi, imodi yokufunda, nokuningi kusukela kumenyu ye-tomi</translation>
<translation id="2174178932569897599">Yenza i-tomi ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="2185166961232948079">I-tomi - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Susa i-akhawunti kutomi</translation>
<translation id="2210682093923538346">Isayithi eyingozi. I-tomi isuse izaziso.</translation>
<translation id="2240214816234246077">Awukavakashi kamuva nje. I-tomi isuse i-<ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /></translation>
<translation id="2241627712206172106">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-tomi ngendlela abafuna ngayo nje.</translation>
<translation id="2313870531055795960">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-tomi. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-tomi ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2329088755516916767">Uma ivuliwe, i-tomi ilayisha kuqala amakhasi okwenza ukubhrawuza nokusesha kusheshe.</translation>
<translation id="2343156876103232566">Ukuze uthumele inombolo kusukela lapha kufoni yakho ye-Android, ngena ngemvume ku-tomi kuwo womabili amadivayisi.</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="2361918034042471035">Isandiso esithi "<ph name="EXTENSION_NAME" />" sifuna ukuthi ungene ngemvume kutomi</translation>
<translation id="2374216753258219393">Ukuze usebenzise lesi sandiso njenge-<ph name="USER_EMAIL_ADDRESS" />, ngena ngemvume kutomi.</translation>
<translation id="2384373936468275798">I-tomiOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-tomi esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-tomi esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-tomi esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-tomi esisodwa noma eziningi}}</translation>
<translation id="2401032172288869980">I-tomi idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Ngamathuluzi avela ku-tomi<ph name="END_LINK" />, ungabhrawuza ngokuphepha bese uhlala ulawula</translation>
<translation id="2451727308784734061">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha Kusiphathi Sephasiwedi. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="2478295928299953161">I-tomi izovala maduzane</translation>
<translation id="2483889755041906834">Ku-tomi</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="2513154137948333830">Ukuqalisa kuyadingeka: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2554739539410784893">I-tomi izama ukufaka amaphasiwedi akhona esikhundleni. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="2560420686485554789">I-tomi idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="2572494885440352020">Isisizi se-tomi</translation>
<translation id="2576118232315942160">Ukuze uthole amaphasiwedi akho kanye nokwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume kutomi</translation>
<translation id="2583187216237139145">Noma iyiphi idatha ye-tomi ekhiqizwa ngesikhathi sokusetshenziswa kwale phrofayela (efana nokudalwa kwamabhukhimakhi, umlando, amaphasiwedi, namanye amasethingi) ingasuswa umlawuli wephrofayela yomsebenzi. <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">Qhubeka usebenzisa i-tomi</translation>
<translation id="259935314519650377">Yehlulekile ukufaka enqolobaneni isifaki esidawunilodiwe. Iphutha: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="264613044588233783">I-tomi iyashesha ukuqalisa futhi izathi ezisebenzisa i-JavaScript kufanele zisebenze njengoba ziklanyiwe (okunconywayo)</translation>
<translation id="2648074677641340862">Iphutha le sistimu yokusebenza livele ngesikhathi sokufaka. Sicela uphinde ulande i-tomi.</translation>
<translation id="2661879430930417727">Uma wabelana ngedivayisi, abangane nomndeni bangaphequlula ngokuhlukile baphinde basethe i-tomi ngendlela abafuna ngayo</translation>
<translation id="268602741124540128">Siyakwamukela ku-tomi, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="2711502716910134313">Ithebhu le-tomi</translation>
<translation id="2718390899429598676">Ngokuvikela okungeziwe, i-tomi izobethela idatha yakho.</translation>
<translation id="2721354645805494590">Ukuze ususe i-tomi Account yakho ku-tomi, phuma ngemvume</translation>
<translation id="2738871930057338499">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 403 Yenqatshelwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="2770231113462710648">Guqula isiphequluli esizenzakalelayo sibe yi-:</translation>
<translation id="2785438272836277133">Lesi sandiso sinohlelo olungayilungele ikhompyutha futhi asiphephile. Sisuse ku-tomi ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
<translation id="2837693172913560447">Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS" /> iphrofayela entsha ye-tomi</translation>
<translation id="2846251086934905009">Iphutha lokufaka: Isifaki asiqedanga. Ukufakwa kukhanseliwe.</translation>
<translation id="2847479871509788944">Susa kusuka  ku-tomi...</translation>
<translation id="2850691299438350830">Kukugcina uphephile ku-tomi futhi kungase kusetshenziswe ukuthuthukisa ukuvikeleka kwakho kwamanye ama-app we-tomi lapho ungene ngemvume</translation>
<translation id="2885378588091291677">Isiphathi somsebenzi</translation>
<translation id="2910007522516064972">Mayelana ne-&amp;tomi</translation>
<translation id="2915996080311180594">Qala Kabusha Ngemuva Kwesikhathi</translation>
<translation id="2928420929544864228">Ukufaka kuqedile.</translation>
<translation id="2945997411976714835">Iphutha lokufaka: Inqubo yesifaki yehlulekile ukuqala.</translation>
<translation id="2970426615109535079">Inhlangano yakho iphatha itomi</translation>
<translation id="2977470724722393594">I-tomi isesikhathini samanje</translation>
<translation id="2977506796191543575">Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-tomi ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile</translation>
<translation id="2987208172821108655">Itomi ingenza lawa mathebhu angasebenzi ukuze ithuthukise okwenzekayo lapho ubhrawuza iphinde ikhulule izinsiza.</translation>
<translation id="3013473503895162900">Vula i-<ph name="URL" /> kuthebhu entsha ku-tomi.</translation>
<translation id="3032706164202344641">I-tomi ayikwazi ukuhlola iphasiwedi yakho. Zama futhi emuva kwesikhathi.</translation>
<translation id="3032787606318309379">Ingeza ku-tomi...</translation>
<translation id="3038232873781883849">Ilinde ukufaka...</translation>
<translation id="3068187312562070417">Amanye amaphrofayela e-tomi</translation>
<translation id="3068515742935458733">Siza ukwenza i-tomi ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK" /> ku-tomi</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-USB ibifinyelelwa yisandiso se-tomi esisodwa noma eziningi}=1{Idivayisi e-1 ye-USB ifinyelelwa yisandiso se-tomi esisodwa noma eziningi}one{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-tomi esisodwa noma eziningi}other{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-tomi esisodwa noma eziningi}}</translation>
<translation id="3101560983689755071">Umlando wakho wokubhrawuza uthinta izikhangiso ozibonayo kanye nezinto ozishisakalelayo njengoba kulinganiselwa ngezansi. Ukuze ivikele ubumfihlo bakho, i-tomi isula ngokuzenzakalelayo izintshisekelo zakho njalo ngenyanga. Izintshisekelo zingavuseleleka ngaphandle kwalapho uma uzisusa.</translation>
<translation id="3103660991484857065">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-tomi futhi.</translation>
<translation id="3130323860337406239">I-tomi isebenzisa imakrofoni yakho.</translation>
<translation id="3144188012276422546">Le thebhu isebenzisa izinsiza ezengeziwe. Ukuze uthuthukise ukusebenza kwakho, vumela itomi ikwenze kungasebenzi.</translation>
<translation id="3155163173539279776">Phinda uqalise i-tomi</translation>
<translation id="3179665906251668410">Vula isixhumanisi kuwindi le-tomi Inco&amp;gnito</translation>
<translation id="3185330573522821672">Yenza ngendlela oyifisayo iphrofayela yakho entsha ye-tomi</translation>
<translation id="3190315855212034486">Eshu! I-tomi iphahlazekile. Qalisa kabusha manje?</translation>
<translation id="3224847870593914902">Ukuze ususe i-tomi Account yakho ku-tomi, phuma ngemvume ku-tomi ekhasini Lamasethingi</translation>
<translation id="3258596308407688501">I-tomi ayikwazi ukufunda nokubhala umkhombandlela wayo wedatha:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3268051428841342958">I-V8 iyi-JavaScript ye-tomi futhi injini ye-WebAssembly isetshenziswe ukuthuthukisa ukusebenza kwesayithi</translation>
<translation id="3283186697780795848">Inguqulo ye-tomi engu-<ph name="PRODUCT_VERSION" /> ifakiwe</translation>
<translation id="3286538390144397061">Qala kabusha manje</translation>
<translation id="328888136576916638">Okhiye be-tomi API abekho. Okunye ukusebenza kwe-tomi kuzokhutshazwa.</translation>
<translation id="3296368748942286671">Qhubeka usebenzise izinhlelo zokusebenza ezingemuva uma i-tomi ivaliwe</translation>
<translation id="3300643253493387004">Ngenkathi sisetha ukufinyelela ku-akhawunti, usengasebenzisa itomi. Ungase ungakwazi ukufinyelela ezinye izinsiza kuze kuqedwe ukusetha.</translation>
<translation id="3313189106987092621">I-tomi izokuxwayisa ngaphambi kokulayisha noma iyiphi isayithi isebenzisa uxhumo olungavikelekile</translation>
<translation id="3316771292331273802">Uzophuma ngemvume emasayithini amaningi uma uvala wonke amawindi e-tomi, ngaphandle kwe-tomi Account yakho uma ungene ngemvume ku-tomi. Ukuvumela amasayithi akukhumbule, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3350761136195634146">Iphrofayela ye-tomi enale akhawunti isikhona kakade</translation>
<translation id="3387527074123400161">I-tomiOS</translation>
<translation id="3406848076815591792">Shintshela kwiphrofayela le-tomi elikhona kakade?</translation>
<translation id="3412460710772753638">Kokuthi Isiphathi Sephasiwedi kule divayisi</translation>
<translation id="3430503420100763906">Ngamaphrofayela we-tomi ungahlukanisa zonke izinto zakho ze-tomi. Dala amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="347328004046849135">I-tomi izokwazisa uma ungena ngemvume ngephasiwedi eyonakalisiwe</translation>
<translation id="3474745554856756813">Lokhu kuzobuyekeza izinto ezingu-<ph name="ITEMS_COUNT" /> kusuka kule divayisi. Ukuze ubuyise idatha yakho, ngena ngemvume ku-<ph name="USER_EMAIL" /> njengo.</translation>
<translation id="3497319089134299931">I-<ph name="SHORTCUT" /> ingashintsha phakathi kwamaphrofayela we-tomi</translation>
<translation id="3509308970982693815">Sicela uvale wonke amawindi we-tomi uphinde uzame futhi.</translation>
<translation id="3530103706039034513">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume.  Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume ku-tomi kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="3533435340678213462">Ukuze sivikele ubumfihlo bakho, sisula ngokuzenzakalelayo izintshisekelo zakho ezindala kunamaviki ama-4. Njengoba uqhubeka nokubhrawuza, intshisekelo ingase ivele ohlwini futhi. Noma ungasusa izithakazelo ongafuni ukuthi i-tomi izicabangele.</translation>
<translation id="3567254597502212821">Umlando wakho wokubhrawuza, irekhodi lamasayithi owavakashele usebenzisa i-tomi kule divayisi.</translation>
<translation id="3597003331831379823">Ihlulekile ukuqalisa isethaphu ngamalungelo aphakeme. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-tomi njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Isibuyekezo esisha se-tomi siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-tomi siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-tomi siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-tomi siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3651803019964686660">Ukuze uthumele inombolo kusukela ku-<ph name="ORIGIN" /> kufoni yakho ye-Android, ngena ngemvume ku-tomi kuwo womabili amadivayisi.</translation>
<translation id="3667616615096815454">Ayikwazi ukufaka, uhlelo lokusebenza alwaziwa kuseva.</translation>
<translation id="3669334504579945026">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kwetomi Kokuncanyelwayo Kwesistimu.</translation>
<translation id="3685209450716071127">I-tomi ayikwazi ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="3702352323269013324">Funda kabanzi mayelana nokwenza izikhangiso zibe ngezakho ku-tomi</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Umlawuli wakho ucela ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe lesi sibuyekezo}=1{Umlawuli wakho ucela ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe lesi sibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho ucela ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho ucela ukuthi uqalise kabusha i-tomi ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3713809861844741608">Vula isixhumanisi ku&amp;thebhu elisha le-tomi</translation>
<translation id="3728124580182886854">Linka i-tomi namanye amasevisi e-tomi ngokwenza ngokomuntu ngamunye nangezinye izinjongo</translation>
<translation id="3788675262216168505">Phatha Amaphrofayela e-tomi</translation>
<translation id="3790262771324122253">Funda ukuthi kungani i-tomi ivimbela ukudawuniloda okuthile</translation>
<translation id="379589255253486813">I-tomi izokwazisa uma kukhona okudinga isibuyekezo sakho</translation>
<translation id="3802055581630249637">I-tomi ilayisha kusengaphambili amakhasi okungenzeka uwavakashele, ukuze alayishe ngokushesha lapho uwavakashela</translation>
<translation id="3830894615770080216">Isistimu ye-tomiOS</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - tomi</translation>
<translation id="386822487697155367">Thola usizo nge-tomiOS</translation>
<translation id="3871664619793219264">Thola ibhrawuza yakho ye-tomi kusukela ku-<ph name="ACCOUNT_EMAIL" /></translation>
<translation id="388648406173476553">Yenza ngokwezifiso uphinde ulawule i-tomi. Okuthile kudinga ukuthi ukunake - chofoza ngemininingwane.</translation>
<translation id="3889543394854987837">Chofoza igama lakho ukuze uvule i-tomi uphinde uqale ukudlulisa amehlo.</translation>
<translation id="390528597099634151">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-tomi. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-tomi ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="3909353120217047026">Lesi sandiso sephula inqubomgomo Yesitolo sewebu se-tomi, futhi kungenzeka singabi esiphephile. Sisuse ku-tomi ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="391789666908693569">I-akhawunti yakho iphethwe i-<ph name="MANAGER_NAME" />. Umlawuli wakho angabona futhi ahlele le phrofayela yebhrawuza ye-tomi nedatha yayo efana namabhukhimakhi, umlando, namaphasiwedi.</translation>
<translation id="3941890832296813527">Iphutha lokufaka: Igama lefayela lesifaki alivumelekile noma alisekelwe.</translation>
<translation id="3945058413678539331">I-tomi izama ukukopisha amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="3962647064319009959">Funda ukuthi i-tomi ikugcina kanjani uphephile</translation>
<translation id="3975724895399328945">Mayelana ne-&amp;tomi Yokuhlola</translation>
<translation id="3997429360543082038">Mayelana ne-tomiOS</translation>
<translation id="4019629340646866719">I-tomiOS yenziwe ukuthi isebenze ngesofthiwe yomthombo ovulekile owengeziwe<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" />, njengoba kunjalo ngendawo yokuthuthukiswa kwe-<ph name="BEGIN_LINK_LINUX_OSS" />Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4036079820698952681">Siza i-tomi ibengcono ngokubika <ph name="BEGIN_LINK" />izilungiselelo zamanje<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="4055805654398742145">Umphathi Wephasiwedi</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Inhlangano yakho ivala i-tomi ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}one{Inhlangano yakho ivala i-tomi ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}other{Inhlangano yakho ivala i-tomi ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}}</translation>
<translation id="4118474109249235144">I-tomi Incognito</translation>
<translation id="4122186850977583290">Iya ekhasini elithi Mayelana netomi</translation>
<translation id="4148957013307229264">Iyafaka...</translation>
<translation id="4149336151887611710">Inhlangano yakho ingabona iphinde iphathe idatha yopheqululo kuphrofayela yakho yomsebenzi, efana namabhukhimakhi, umlando, namaphasiwedi akho. Ayikwazi ukubona idatha yopheqululo kumaphrofayela omuntu siqu e-tomi.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokungena ngemvume - i-tomi</translation>
<translation id="421369550622382712">Thola izinhlelo zokusebenza ezinhle, amageyimu, izandiso, namatimu we-tomi.</translation>
<translation id="4216212958613226427">Lolu limi lusetshenziselwa ukubonisa i-tomi UI</translation>
<translation id="4222932583846282852">Iyakhansela...</translation>
<translation id="4224210481850767180">Ukufaka kukhanseliwe.</translation>
<translation id="4230135487732243613">Xhumanisa idatha yakho ye-tomi kule akhawunti?</translation>
<translation id="4251772536351901305">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-tomi ebingazi ngawo ngaphambili, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izixwayiso ze-tomi.</translation>
<translation id="4269093074552541569">Phuma Ngemvume ku-tomi</translation>
<translation id="4271805377592243930">Thola usizo nge-tomi</translation>
<translation id="4281844954008187215">Imigomo yesevisi</translation>
<translation id="4285930937574705105">Ukufaka kuhlulekile ngenxa yephutha elingacacisiwe. Uma ngabe i-tomi iyasebenza manje, sicela uyivale uphinde uzame futhi.</translation>
<translation id="4304713468139749426">Isiphathi sephasiwedi</translation>
<translation id="4334294535648607276">Ukulanda kuqedile.</translation>
<translation id="439358628917130594">I-<ph name="MANAGER" /> idinga ukuthi ufunde uphinde wamukele Imigomo Yesevisi elandelayo ngaphambi kokusebenzisa le divayisi. Le migomo ayinwebi, iguqule noma ikhawulele Imigomo ye-tomiOS.</translation>
<translation id="4407044323746248786">Phuma ku-tomi noma kunjalo?</translation>
<translation id="4415566066719264597">Vumela i-tomi isebenze ngemuva</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Itomi incoma ukuthi usisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}one{Itomi incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}other{Itomi incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">Yenza ngokwezifiso uphinde ulawule i-tomi</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
<translation id="4434353761996769206">Iphutha lesifaki: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614">U-<ph name="MANAGER" /> uphatha itomi</translation>
<translation id="4447409407328223819">Mayelana ne-tomi Yokuhlola</translation>
<translation id="4501471624619070934">Ukufaka kuhlulekile ngoba ukufinyelela kukhawulelwe kuleli zwe.</translation>
<translation id="4510853178268397146">Lesi sandiso asikashicileli izindlela zangasese zokuziphatha, njengokuthi siyiqoqa futhi siyisebenzise kanjani idatha. I-tomi incoma ukuthi usisuse.</translation>
<translation id="452711251841752011">Siyakwamukela ku-tomi; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="4531137820806573936">I-tomi idinga imvume yokumepha indawo ekuzungezile futhi ilandelele izandla zakho</translation>
<translation id="4536805923587466102">Usuvele ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" /> kwenye iphrofayela ye-tomi</translation>
<translation id="4544142686420020088">I-tomi ayibuyekezekanga, kunokuthile okungahambanga kahle. <ph name="BEGIN_LINK" />Lungisa izinkinga zokubuyekaza kwe-tomi nezibuyekezo ezihlulekile.<ph name="END_LINK" /></translation>
<translation id="4545268686623374213">Itomi ingenza le thebhu ingasebenzi ukuze ithuthukise ukuzizwisa kwakho ukubhrawuza futhi igcine izinto zishesha.</translation>
<translation id="454579500955453258">Qhubeka kuphrofayela entsha ye-tomi?</translation>
<translation id="4567424176335768812">Ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" />. Manje ungakwazi ukufinyelela amabhukhimakhi, umlando, nezinye izilungiselelo kuwo wonke amadivayisi wakho ongene kuwo ngemvume.</translation>
<translation id="4570813286784708942">I-tomi ivimbele lokhu kudawuniloda ngoba uvale Ukuphequlula Okuphephile futhi ifayela alikwazi ukuqinisekiswa</translation>
<translation id="4594305310729380060">Kusiphathi Sephasiwedi kule divayisi</translation>
<translation id="459535195905078186">Izinhlelo zokusebenza ze-tomi</translation>
<translation id="4613863813562375431">Uhlobo lwe-tomiOS</translation>
<translation id="4617285639650863674">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kwe-tomi Kokuncanyelwayo Kwesistimu</translation>
<translation id="4621240073146040695">Icishe isesikhathini! Qalisa kabusha i-tomi ukuze uqedele ukubuyekeza.</translation>
<translation id="4665829708273112819">Isexwayiso: I-tomi ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="4673151026126227699">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-tomi, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="4677944499843243528">Iphrofayela ibukeka isetshenziswa enye inqubo ye-tomi (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />). I-tomi ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-tomi.</translation>
<translation id="4680828127924988555">Khansela Ukufaka</translation>
<translation id="469259825538636168">Enye idatha yakho yetomi ayikalondolozwa kutomi Account. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="4708193446201257833">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ukusuka kutomi Account yakho kutomi. I-<ph name="SHORTCUT" /> ingashintsha amasethingi wakho wamasevisi etomi.</translation>
<translation id="4708774505295300557">Umuntu othile ungene ngemvume ngaphambilini ku-tomi kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-tomi ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="4724676981607797757">Ukufaka kuhlulekile ngenxa yephutha lephrothokholi engasekelwe.</translation>
<translation id="4746050847053251315">Phuma ku-tomi noma kunjalo?</translation>
<translation id="4748217263233248895">Isibuyekezo esibalulekile sokuvikela se-tomi sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="4765210420921718862">Ungashintsha umqondo wakho noma kunini kumasethingi we-tomi. Izivivinyo zisebenza eduze kwendlela yamanje yokulethwa kwezikhangiso, ngakho ngeke ubone izinguquko ngokushesha.</translation>
<translation id="4788777615168560705">I-tomi ayikwazi ukuhlola iphasiwedi yakho. Zama futhi ngemva kwamahora angu-24 noma <ph name="BEGIN_LINK" />hlola amaphasiwedi ku-akhawunti yakho ye-tomi<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-tomi. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-tomi. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="4814736265800133385">Sebenzisa i-tomi ngaphandle kwe-akhawunti</translation>
<translation id="4888717733111232871">Umyalo obambeke ngaphakathi we-tomi wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="4893347770495441059">Qalisa kabusha ukuze Ubuyekeze i-&amp;tomi</translation>
<translation id="4942295735032723435">Ukuze uthole izibuyekezo zesikhathi esizayo ze-tomi, uzodinga i-macOS 11 noma eyakamuva. Le khompyutha isebenzisa i-macOS 10.15.</translation>
<translation id="4943838377383847465">I-tomi kumodi yasemuva.</translation>
<translation id="494490797786467921">Chofoza ukuze uvale ibhokisi lokungena ngemvume letomi</translation>
<translation id="4987820182225656817">Izihambeli zingasebenzisa i-tomi ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="4994636714258228724">Zingeze ngokwakho ku-tomi</translation>
<translation id="5114678101347489141">I-tomi ihlola izakhi ezintsha ezivumela amasayithi ukuthi alethe ukuzizwisa kokubhrawuza okufanayo kusetshenziswa ulwazi lwakho oluncane</translation>
