<translation id="6039377483953237732">‏גרסת ה-OS של Decentr</translation>
<translation id="6055895534982063517">‏גרסה חדשה של Decentr זמינה, והיא מהירה יותר מאי פעם.</translation>
<translation id="6063093106622310249">‏&amp;פתיחה ב-Decentr</translation>
<translation id="6072279588547424923">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏Decentr‏</translation>
<translation id="608006075545470555">הוספת פרופיל עבודה לדפדפן זה</translation>
<translation id="608189560609172163">‏Decentr לא הצליח לסנכרן את הנתונים שלך בשל שגיאת כניסה.</translation>
<translation id="6096348254544841612">‏כדי להתאים אישית את Decentr ולשלוט בו טוב יותר, כדאי להוריד את העדכון החדש.</translation>
<translation id="6120345080069858279">‏הסיסמה הזאת תישמר על ידי Decentr בחשבון Google שלך. אין צורך לזכור אותה.</translation>
<translation id="6129621093834146363">‏<ph name="FILE_NAME" /> מסוכן, ולכן Decentr חסם אותו.</translation>
<translation id="6134968993075716475">‏הגלישה הבטוחה כבויה. ההמלצה של Decentr היא להפעיל אותה.</translation>
<translation id="6145820983052037069">‏כאן ניתן לעבור בין פרופילים של Decentr</translation>
<translation id="6183079672144801177">‏יש לוודא שנכנסת ל-Decentr ב-<ph name="TARGET_DEVICE_NAME" /> שלך ולשלוח שוב.</translation>
<translation id="6212496753309875659">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של Decentr. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Decentr ולנסות שוב.</translation>
<translation id="6219195342503754812">{0,plural, =0{‏Decentr יופעל מחדש עכשיו}=1{‏Decentr יופעל מחדש בעוד שנייה אחת}two{‏Decentr יופעל מחדש בעוד # שניות}many{‏Decentr יופעל מחדש בעוד # שניות}other{‏Decentr יופעל מחדש בעוד # שניות}}</translation>
<translation id="6241367896540709610">‏נדרשת הרשאת גישה לאחסון ב-Decentr כדי להוריד קבצים</translation>
<translation id="6248213926982192922">‏יש להפוך את Decentr לדפדפן ברירת המחדל</translation>
<translation id="6266342355635466082">‏Decentr לא יכול לחפש עדכונים. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="6268381023930128611">‏האם לצאת מ-Decentr?</translation>
<translation id="6281746429495226318">‏התאמה אישית של פרופיל Decentr</translation>
<translation id="6290827346642914212">‏בחירת שם לפרופיל Decentr שלך</translation>
<translation id="6295779123002464101">‏<ph name="FILE_NAME" /> עלול להיות מסוכן, ולכן Decentr חסם אותו.</translation>
<translation id="6309712487085796862">‏Decentr משתמש במצלמה שלך.</translation>
<translation id="6333502561965082103">‏מתבצעת כרגע פעולה אחרת ב-Decentr. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="6334986366598267305">‏קל יותר כעת להשתמש ב-Decentr באמצעות חשבון Google שלך ובמחשבים משותפים.</translation>
<translation id="6373523479360886564">‏ברצונך באמת להסיר את התקנת Decentr?</translation>
<translation id="6403826409255603130">‏Decentr הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-Decentr.</translation>
<translation id="6434250628340475518">‏מערכת Decentr OS</translation>
<translation id="6455857529632101747">‏ברוך בואך לפרופילים של Decentr</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{‏Decentr יבצע אתחול בעוד שנייה אחת}two{‏Decentr יבצע אתחול בעוד # שניות}many{‏Decentr יבצע אתחול בעוד # שניות}other{‏Decentr יבצע אתחול בעוד # שניות}}</translation>
<translation id="6475912303565314141">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Decentr.</translation>
<translation id="6510925080656968729">‏הסרה של התקנת Decentr</translation>
<translation id="6542839706527980775">‏בכל פרופיל מאוחסנים נתוני Decentr משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6570579332384693436">‏Decentr שולח את הטקסט שמוקלד בשדות טקסט ל-Google כדי לתקן שגיאות כתיב</translation>
<translation id="6598877126913850652">‏מעבר אל הגדרות ההודעות של Decentr</translation>
<translation id="6613594504749178791">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Decentr‏.</translation>
<translation id="665732753414869868">‏נדרשת הרשאת גישה למצלמה ב-Decentr כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
