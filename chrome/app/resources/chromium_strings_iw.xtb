<translation id="379589255253486813">‏tomi יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="3802055581630249637">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת tomi טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3830894615770080216">‏מערכת tomiOS</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - tomi</translation>
<translation id="386822487697155367">‏קבלת עזרה בנושא tomiOS</translation>
<translation id="3871664619793219264">‏אפשר לקבל את הנתונים של <ph name="ACCOUNT_EMAIL" /> ולשמור אותם בדפדפן tomi</translation>
<translation id="388648406173476553">‏התאמה אישית וניהול של tomi נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="3889543394854987837">‏יש ללחוץ על השם שלך כדי לפתוח את tomi ולהתחיל לגלוש.</translation>
<translation id="390528597099634151">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל tomi הזה. כדי להפריד בין פעילויות גלישה, tomi יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="3909353120217047026">‏התוסף הזה מפר את המדיניות של חנות האינטרנט של tomi, ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-tomi כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="391789666908693569">‏החשבון שלך מנוהל על ידי <ph name="MANAGER_NAME" />. האדמין שלך יכול לראות ולערוך את הפרופיל הזה של דפדפן tomi ואת הנתונים שלו, כמו סימניות, היסטוריה וסיסמאות.</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="3945058413678539331">‏tomi מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="3962647064319009959">‏איך מערכת tomi שומרת על האבטחה שלך</translation>
<translation id="3975724895399328945">‏מידע על &amp;tomi for Testing</translation>
<translation id="3997429360543082038">‏מידע על tomiOS</translation>
<translation id="4019629340646866719">‏השימוש ב-tomiOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS" />סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4036079820698952681">‏דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /> יעזור לשפר את tomi</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4055805654398742145">מנהל הס&amp;יסמאות</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך דקה. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}one{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}two{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}other{‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}}</translation>
<translation id="4118474109249235144">‏מצב פרטי ב-tomi</translation>
<translation id="4122186850977583290">‏מעבר לדף 'מידע על tomi'</translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="4149336151887611710">‏האדמין בארגון שלך יכול לראות ולנהל את נתוני הגלישה בפרופיל העבודה שלך, כמו הסימניות, ההיסטוריה והסיסמאות. אין לאדמין אפשרות לראות את נתוני הגלישה בפרופילים האישיים של tomi.</translation>
<translation id="419998258129752635">‏<ph name="PAGE_TITLE" /> – כניסה לרשת – tomi</translation>
<translation id="421369550622382712">‏אפליקציות, משחקים, תוספים ועיצובים מעולים בשביל tomi.</translation>
<translation id="4216212958613226427">‏זו השפה שבה מוצג ממשק המשתמש של tomi</translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4224210481850767180">ההתקנה בוטלה.</translation>
<translation id="4230135487732243613">‏האם לקשר את הנתונים שלך ב-tomi לחשבון זה?</translation>
<translation id="4251772536351901305">‏מקבלים אזהרות לגבי אתרים מסוכנים, גם כאלה שלא היו ידועים ל-tomi לפני כן, בעזרת ניתוח של יותר נתונים מאתרים בהשוואה להגנה הרגילה. אפשר לדלג על האזהרות מ-tomi.</translation>
<translation id="4269093074552541569">‏יציאה מ-tomi</translation>
<translation id="4271805377592243930">‏עזרה בנושא tomi</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="4285930937574705105">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם tomi פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="4304713468139749426">מנהל הסיסמאות</translation>
<translation id="4334294535648607276">ההורדה הושלמה.</translation>
<translation id="439358628917130594">‏לפי דרישת <ph name="MANAGER" />, יש לקרוא את התנאים וההגבלות הבאים ולהסכים להם לפני השימוש במכשיר הזה. תנאים אלה לא מרחיבים, משנים או מגבילים את התנאים של tomiOS.</translation>
<translation id="4407044323746248786">‏לסגור את tomi בכל זאת?</translation>
<translation id="4415566066719264597">‏tomi יכול לפעול ברקע</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{‏אנחנו ממליצים להסיר אותו מ-tomi. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}one{‏אנחנו ממליצים להסיר אותם מ-tomi. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}two{‏אנחנו ממליצים להסיר אותם מ-tomi. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}other{‏אנחנו ממליצים להסיר אותם מ-tomi. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">‏התאמה אישית ושליטה ב-tomi</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="4434353761996769206">שגיאת מנהל התקנה: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614">‏הארגון '<ph name="MANAGER" />' מנהל את tomi</translation>
<translation id="4447409407328223819">‏מידע על tomi for Testing</translation>
<translation id="4501471624619070934">ההתקנה נכשלה כי הגישה מוגבלת במדינה הזו.</translation>
<translation id="4510853178268397146">‏לתוסף הזה לא פורסמו נוהלי פרטיות, למשל האופן שבו הוא אוסף נתונים ומשתמש בהם. ההמלצה של tomi היא להסיר אותו.</translation>
<translation id="452711251841752011">‏ברוך בואך אל tomi. נפתח חלון חדש בדפדפן</translation>
<translation id="4531137820806573936">‏ל-tomi נדרשת הרשאה כדי למפות את הסביבה שלך ולעקוב אחרי תנועות הידיים</translation>
<translation id="4536805923587466102">‏כבר נכנסת לחשבון בתור <ph name="USER_EMAIL_ADDRESS" /> בפרופיל tomi אחר</translation>
<translation id="4544142686420020088">‏tomi לא התעדכן, משהו השתבש. <ph name="BEGIN_LINK" />לטיפול בבעיות בעדכון של tomi ובעדכונים שנכשלו<ph name="END_LINK" /></translation>
<translation id="4545268686623374213">‏‫tomi יכול להשבית את הכרטיסייה הזו כדי לשפר את חוויית הגלישה ולהמשיך לגלוש במהירות.</translation>
<translation id="454579500955453258">‏להמשיך בפרופיל tomi חדש?</translation>
<translation id="4567424176335768812">נכנסת למערכת בתור <ph name="USER_EMAIL_ADDRESS" />. כעת יש לך אפשרות לגשת אל הסימניות, ההיסטוריה והגדרות אחרות שלך בכל המכשירים שבהם התחברת לחשבון.</translation>
<translation id="4570813286784708942">‏tomi חסם את ההורדה הזאת כי השבתת את הגלישה הבטוחה ואי אפשר לאמת את הקובץ</translation>
<translation id="4594305310729380060">שמירה למנהל הסיסמאות במכשיר הזה</translation>
<translation id="459535195905078186">‏יישומי tomi</translation>
<translation id="4613863813562375431">‏גרסת tomiOS</translation>
<translation id="4617285639650863674">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-tomi בקטע 'העדפות המערכת'</translation>
<translation id="4621240073146040695">‏העדכון כמעט הושלם! הפעל מחדש את tomi‏ כדי לסיים את העדכון.</translation>
<translation id="4665829708273112819">‏אזהרה: tomi לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="4673151026126227699">‏אם בנוסף ישותפו דוחות שימוש ב-tomi, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="4677944499843243528">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך tomi אחר (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. tomi נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את tomi מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="469259825538636168">‏חלק מהנתונים ב-tomi עדיין לא נשמרו בחשבון tomi. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="4708193446201257833">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון tomi ב-tomi. אפשר לשנות את ההגדרות של שירותי tomi באמצעות קיצור הדרך <ph name="SHORTCUT" />.</translation>
<translation id="4708774505295300557">‏מישהו נכנס בעבר ל-tomi מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-tomi כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="4746050847053251315">‏לסגור את tomi בכל זאת?</translation>
<translation id="4748217263233248895">‏בוצע עדכון אבטחה מיוחד של tomi. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="4765210420921718862">‏יש לך אפשרות לשנות את הבחירה בכל שלב בהגדרות של tomi. גרסאות הניסיון יפעלו במקביל לשיטה הנוכחית של הצגת המודעות, אז השינויים לא יורגשו מיד.</translation>
<translation id="4788777615168560705">‏tomi לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות או <ph name="BEGIN_LINK" />לבדוק את הסיסמאות בחשבון tomi<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש tomi. הטקסט המוקלד בדפדפן נשלח אל tomi. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="4814736265800133385">‏שימוש ב-tomi ללא חשבון</translation>
<translation id="4888717733111232871">‏כלל נכנס עבור tomi על מנת לאפשר תנועת mDNS.</translation>
<translation id="4893347770495441059">‏הפעלה מחדש לצורך עדכון &amp;tomi</translation>
<translation id="4942295735032723435">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-macOS מגרסה 11 ואילך. במחשב הזה פועלת גרסה 10.15 של macOS.</translation>
<translation id="4943838377383847465">‏tomi נמצא במצב רקע.</translation>
<translation id="494490797786467921">‏אפשר ללחוץ כדי לסגור את תיבת הדו-שיח של הכניסה ל-tomi</translation>
<translation id="4987820182225656817">‏אורחים יכולים להשתמש ב-tomi בלי להשאיר דבר מאחור.</translation>
<translation id="4994636714258228724">‏הוספת החשבון שלך ל-tomi</translation>
<translation id="5114678101347489141">‏אנחנו בודקים תכונות חדשות ב-tomi שמאפשרות לאתרים לספק את אותה חוויית הגלישה תוך שימוש בפחות פרטים אישיים</translation>
<translation id="5187123684706427865">‏נדרש אימות מחדש לחשבון tomi</translation>
<translation id="5224391634244552924">‏אין סיסמאות שמורות. tomi יכול לבדוק את הסיסמאות שלך רק אם שמרת אותן.</translation>
<translation id="5231355151045086930">‏יציאה מ-tomi</translation>
<translation id="5252179775517634216">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל tomi הזה. ייווצר פרופיל tomi חדש בשביל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5277894862589591112">‏כדי להחיל את השינויים שביצעת, יש להפעיל מחדש את tomi</translation>
<translation id="5294316920224716406">‏בגלישה במצב פרטי, tomi יציג אזהרה לפני טעינת אתר באמצעות חיבור לא מאובטח</translation>
<translation id="5296845517486664001">‏כשגרסאות הניסיון פעילות, ובמקרים שבהם צורפת באופן אקראי לגרסת ניסיון פעילה ב-tomi, היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-tomi מחיקה של תחומי העניין שלך על בסיס מתחלף מדי חודש.</translation>
<translation id="5310474266708705970">‏כניסה ל-tomi בתור <ph name="USER_EMAIL" /></translation>
<translation id="5352264705793813212">‏יש ל-tomi כמה המלצות לגבי בטיחות שכדאי לבדוק</translation>
<translation id="5352361688875342522">‏פרופילים אחרים ב-tomi</translation>
<translation id="5358375970380395591">‏הכניסה שלך מתבצעת באמצעות חשבון מנוהל שמעניק למנהל המערכת שלו שליטה על הפרופיל שלך ב-tomi. הנתונים שלך ב-tomi, כגון יישומים, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות tomi, אבל לא ניתן לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">קוד נוסף: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">‏כדי להשתמש בהתאמה אישית, צריך לכלול את tomi ב'פעילות באינטרנט ובאפליקציות'</translation>
<translation id="5383439451358640070">‏למה קבצים מסוימים נחסמים ב-tomi</translation>
<translation id="5386450000063123300">‏מתבצע עדכון של tomi‏ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">‏התרת כניסה אל tomi</translation>
<translation id="5405650547142096840">‏להסיר מ-‏tomi‏</translation>
<translation id="5427571867875391349">‏הגדרת tomi כדפדפן ברירת המחדל שלך</translation>
<translation id="5438241569118040789">‏<ph name="PAGE_TITLE" /> - tomi בגרסת בטא</translation>
<translation id="5473971139929175403">‏יכול להיות ש-tomi לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="5475924890392386523">‏‫tomi חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="5480860683791598150">‏tomi זקוק לגישה למיקום שלך כדי לשתף אותו עם האתר הזה</translation>
<translation id="5487574057737591516">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. אם ב-tomi הוגדר תחום עניין שגוי או שאינך רוצה לראות מודעות מסוימות, יש לך אפשרות להסיר תחומי עניין.</translation>
<translation id="549669000822060376">‏יש להמתין בזמן ש-tomi מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="5496810170689441661">‏tomi מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
