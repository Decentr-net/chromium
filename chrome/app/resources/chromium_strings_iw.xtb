<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="328888136576916638">‏המפתחות של tomi API חסרים. פונקציונליות מסוימת של tomi תהיה מושבתת.</translation>
<translation id="3296368748942286671">‏המשך הפעלת יישומים ברקע כאשר tomi סגור</translation>
<translation id="3300643253493387004">‏אנחנו מגדירים את הגישה לחשבון, אבל עדיין אפשר להשתמש ב-tomi. לחלק מהמשאבים תהיה לך גישה רק אחרי שההגדרה תסתיים.</translation>
<translation id="3313189106987092621">‏tomi יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="3316771292331273802">‏אם סוגרים את כל החלונות של tomi, מתבצעת יציאה מהחשבון ברוב האתרים, אבל לא מחשבון tomi, אם נכנסת אליו ב-tomi. כדי לאפשר לאתרים לזכור אותך, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3350761136195634146">‏כבר קיים פרופיל tomi עם החשבון הזה</translation>
<translation id="3387527074123400161">tomiOS</translation>
<translation id="3406848076815591792">‏לעבור לפרופיל קיים של tomi?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="3430503420100763906">‏באמצעות פרופילים ב-tomi, מפרידים את כל הפריטים ב-tomi. יוצרים פרופילים המיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="347328004046849135">‏אם מערכת tomi תזהה שנכנסת עם סיסמה שנחשפה, היא תתריע לך על כך</translation>
<translation id="3474745554856756813">‏פעולה זו תמחק <ph name="ITEMS_COUNT" /> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל tomi עם <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">‏ניתן לעבור בין פרופילים של tomi באמצעות <ph name="SHORTCUT" /></translation>
<translation id="3509308970982693815">‏יש לסגור את כל חלונות tomi ולנסות שוב.</translation>
<translation id="3530103706039034513">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER" />.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-tomi בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3533435340678213462">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-tomi כדי שלא יילקחו בחשבון.</translation>
<translation id="3567254597502212821">‏היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות tomi במכשיר הזה.</translation>
<translation id="3597003331831379823">הפעלת ההגדרה נכשלה עם הרשאות מורחבות. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-tomi בתור <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{‏יש עדכון חדש בשביל tomi והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש.}=1{‏יש עדכון חדש בשביל tomi והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. החלון האנונימי לא ייפתח מחדש.}one{‏יש עדכון חדש בשביל tomi והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏יש עדכון חדש בשביל tomi והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏יש עדכון חדש בשביל tomi והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="3651803019964686660">‏כדי לשלוח מספר מ-<ph name="ORIGIN" /> לטלפון Android שלך, צריך להיכנס אל tomi בשני המכשירים.</translation>
<translation id="3667616615096815454">אין אפשרות להתקין, האפליקציה לא מוכרת לשרת.</translation>
<translation id="3669334504579945026">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-tomi בקטע 'העדפות המערכת'.</translation>
<translation id="3685209450716071127">‏tomi לא יכול לבדוק את הסיסמאות שלך. יש לבדוק את החיבור לאינטרנט.</translation>
