<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6384011394608460044">‏<ph name="BEGIN_BOLD" />איך אנחנו משתמשים בנתונים האלה:<ph name="END_BOLD" /> tomi יכול להעריך מהם תחומי העניין שלך. לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-tomi כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
<translation id="6400112897226594999">‏הלוגו של tomi בתוך מסך מחשב.</translation>
<translation id="6403826409255603130">‏tomi הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-tomi.</translation>
<translation id="6442900851116057561">‏הפעלה מחדש של tomiOS</translation>
<translation id="6443470774889161065">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת tomi טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="645458117210240797">‏מושבת • tomi לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="6455857529632101747">‏ברוך בואך לפרופילים של tomi</translation>
<translation id="6466344609055215035">‏הסרת החשבון מ-tomi</translation>
<translation id="6475912303565314141">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את tomi.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="6510925080656968729">‏הסרה של התקנת tomi</translation>
<translation id="651535675648445253">‏קיצורי הדרך נפתחים ב-tomi</translation>
<translation id="6524389414524528185">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון tomi ב-tomi. אפשר לשנות את זה בכל שלב ב'הגדרות'.</translation>
<translation id="6539122709674868420">‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="6542839706527980775">‏בכל פרופיל מאוחסנים נתוני tomi משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6563921047760808519">‏<ph name="BEGIN_LINK" />מידע נוסף לגבי השמירה על פרטיות הנתונים ב-tomi<ph name="END_LINK" /></translation>
<translation id="656935081669708576">‏אפשר לעבור לפרופיל tomi אחר כדי לראות סיסמאות</translation>
<translation id="6570579332384693436">‏tomi שולח את הטקסט שמוקלד בשדות טקסט ל-tomi כדי לתקן שגיאות כתיב</translation>
<translation id="6598877126913850652">‏מעבר אל הגדרות ההודעות של tomi</translation>
<translation id="6613594504749178791">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את tomi‏.</translation>
<translation id="665732753414869868">‏נדרשת הרשאת גישה למצלמה ב-tomi כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="6663852025006259149">‏סביר להניח שאתרים יפעלו כצפוי, אבל ההעדפות שלך באתרים האלו יימחקו לאחר סגירת כל החלונות ב-tomi</translation>
<translation id="6669284030132180248">‏אם הסימניות שלך נשמרות גם בחשבון tomi, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-tomi ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="668175097507315160">‏לא בוצע סנכרון של הנתונים ב-tomiOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="6692797197837897398">‏ב-tomi יש לך יותר שליטה במודעות שמוצגות לך, וחלות הגבלות על המידע עליך שהאתרים יכולים לקבל בהצגת מודעות בהתאמה אישית.</translation>
<translation id="6709350901466051922">‏נדרשת הרשאת גישה למיקרופון ב-tomi עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6717134281241384636">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של tomi.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של tomi.</translation>
<translation id="6729124504294600478">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את tomi ב'פעילות באינטרנט ובאפליקציות' ובשירותי tomi המקושרים</translation>
<translation id="6734291798041940871">‏tomi כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="673636774878526923">‏כדי לקבל גישה אל הפריטים שלך ב-tomi בכל המכשירים, יש להיכנס לחשבון ולהפעיל את הסנכרון.</translation>
<translation id="674245979920622322">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות '<ph name="PERMISSION_1" />', '<ph name="PERMISSION_2" />' ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי tomi</translation>
<translation id="67706546131546258">‏ההמלצה של tomi היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="6779406956731413166">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-tomiOS.</translation>
<translation id="6847869444787758381">‏tomi מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME" /> ברשימת ההיתרים.</translation>
<translation id="6857782730669500492">‏tomi‏ - <ph name="PAGE_TITLE" /></translation>
<translation id="6873893289264747459">‏הפריט "<ph name="EXTENSION_NAME" />" שנמצא ב-tomi מכיל תוכנה זדונית</translation>
<translation id="6929417474050522668">‏כשגרסאות הניסיון פעילות, מדידת המודעות מאפשרת לאתרים שבהם ביקרת לבקש מ-tomi מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="6940431691900807093">‏לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-tomi כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך. tomi יכול לשתף עד 3 תחומי עניין.</translation>
<translation id="6964305034639999644">‏פתיחת הקישור בחלון &amp;אנונימי של tomi</translation>
<translation id="6978145336957848883">‏קל לנחש סיסמאות חלשות. באמצעות tomi אפשר <ph name="BEGIN_LINK" />ליצור ולזכור סיסמאות חזקות<ph name="END_LINK" />.</translation>
<translation id="6981396265751285733">‏כשההגדרה מופעלת, tomi מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-tomi פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי.</translation>
<translation id="6985329841647292029">‏התנאים לשימוש ב-tomiOS</translation>
<translation id="6990124437352146030">‏tomi זקוק להרשאת גישה למיקרופון בשביל האתר הזה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">ההתקנה נעצרה.</translation>
<translation id="7045244423563602563">‏אפשר להתאים אישית את tomi בדרך שנוחה לך</translation>
<translation id="705851970750939768">‏יש לעדכן את tomi‏</translation>
<translation id="7067091210845072982">‏אם אין לתמונה תיאור מועיל, tomi ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל tomi.</translation>
<translation id="7141270731789036260">‏התאמה אישית של tomi for Testing</translation>
<translation id="7163519456498498587">‏הסרה של <ph name="EXTENSION_NAME" /> מ-tomi</translation>
<translation id="7173822816570314652">‏לפי הגדרת הארגון, נתוני tomi נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION" />. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="718435575166326686">‏נדרשת הרשאת גישה למצלמה ב-tomi עבור האתר הזה</translation>
<translation id="7196312274710523067">‏לא ניתן היה להפעיל את tomi. יש לנסות שוב.</translation>
<translation id="7197677400338048821">‏tomi לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות.</translation>
<translation id="7213407614656404070">‏שימוש ב-tomi בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7223968959479464213">‏מנהל המשימות - tomi</translation>
<translation id="7246575524853130370">‏תחומי העניין שלך בהתאם להערכה של tomi</translation>
<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של tomi היא להסיר אותו}one{‏ההמלצה של tomi היא להסיר אותם}two{‏ההמלצה של tomi היא להסיר אותם}other{‏ההמלצה של tomi היא להסיר אותם}}</translation>
<translation id="7309928523159922338">‏מדידת המודעות מאפשרת לאתרים שביקרת בהם לבקש מ-tomi מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="731795002583552498">‏העדכון של tomi‏ מתבצע</translation>
<translation id="7318036098707714271">‏קובץ ההעדפות שלך פגום או לא חוקי. 

tomi לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7339898014177206373">חלון חדש</translation>
<translation id="734373864078049451">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-tomi נמצאים כאן.</translation>
<translation id="7349591376906416160">‏לפי הגדרת מנהל המערכת, tomi יפתח את<ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7355355292030546812">‏‫tomi חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות, כולל <ph name="USER_EMAIL" /></translation>
<translation id="7384121030444253939">‏התוסף הזה כבר לא נתמך. ההמלצה של tomi היא להסיר אותו.</translation>
<translation id="7398989605938454041">‏באמצעות פרופילים ב-tomi, מפרידים את כל הפריטים ב-tomi. באופן הזה קל יותר להפריד בין עבודה לפנאי.</translation>
<translation id="7449453770951226939">‏<ph name="PAGE_TITLE" /> - tomi בגרסת פיתוח</translation>
<translation id="7451052299415159299">‏tomi זקוק להרשאת גישה למצלמה בשביל האתר הזה</translation>
<translation id="7458892263350425044">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-tomi גישה</translation>
<translation id="7461356015007898716">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="7467949745582939695">‏להפעיל את tomi מחדש?</translation>
<translation id="7483335560992089831">‏לא ניתן להתקין את אותה גרסת tomi שפועלת כרגע. יש לסגור את tomi ולנסות שוב.</translation>
<translation id="751935028865900641">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של tomi, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון tomi אם הוא מחובר ל-tomi.</translation>
<translation id="753534427205733210">{0,plural, =1{‏tomi יופעל מחדש בעוד דקה}one{‏tomi יופעל מחדש בעוד # דקות}two{‏tomi יופעל מחדש בעוד # דקות}other{‏tomi יופעל מחדש בעוד # דקות}}</translation>
<translation id="7553334751796114046">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-tomi בקטע 'העדפות המערכת'</translation>
<translation id="7582945390259497898">‏tomi יכול להעריך מהם תחומי העניין שלך. לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-tomi כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME" /></translation>
<translation id="7585391435984513350">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה '<ph name="PERMISSION" />' הוסרה על ידי tomi</translation>
<translation id="761356813943268536">‏tomi משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="7617377681829253106">‏tomi השתפר</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="7682213815243802460">‏מידע נוסף לגבי התכונות האלה זמין בהגדרות של tomi.</translation>
<translation id="7686590090926151193">‏tomi אינו דפדפן ברירת המחדל שלך</translation>
<translation id="7689606757190482937">‏סנכרון והתאמה אישית של tomi בכל המכשירים שברשותך</translation>
<translation id="7699779824407626136">‏עדכון ל-tomi</translation>
<translation id="7745317241717453663">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל tomi עם <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="7786760609782648049">‏שיפור המהירות ב-tomi</translation>
<translation id="7790626492778995050">‏<ph name="PAGE_TITLE" /> – tomi בגרסת Canary</translation>
<translation id="7803986347287457849">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫tomi משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7828947555739565424">‏כבר קיים במכשיר פרופיל tomi עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="7859018312476869945">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, tomi שולח את הטקסט הזה למנוע החיפוש שמוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. האפשרות הזו מושבתת במצב הפרטי.</translation>
<translation id="7867198900892795913">‏עדכון tomi לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7877292582355102282">‏<ph name="BEGIN_BOLD" />איך ניתן לנהל את הנתונים שלך:<ph name="END_BOLD" /> כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-tomi כדי שלא יילקחו בחשבון.</translation>
<translation id="7888981273428720788">‏הגדרת tomi כדפדפן ברירת המחדל</translation>
<translation id="7934340546140346950">‏‫tomi משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="7937630085815544518">‏נכנסת ל-tomi כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="7975919845073681630">‏זוהי התקנה משנית של tomi, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="7997934263947464652">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של tomi היא להתקין אותם רק מ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="8013436988911883588">‏אחרי מתן גישה ל-tomi, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>
<translation id="8096472344908884505">‏<ph name="PAGE_TITLE" /> –‏ tomi for Testing</translation>
<translation id="8105840573057009683">‏נדרשת הרשאת מיקום ב-tomi עבור האתר הזה</translation>
<translation id="8133124826068723441">‏לא בוצע סנכרון של הנתונים ב-tomiOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="8166782796394721554">‏הפעלת הגנה נוספת במנוע WebAssembly ו-JavaScript של tomi</translation>
<translation id="81770708095080097">‏tomi‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8223363452568144035">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-tomi גישה</translation>
<translation id="8232193495299001329">‏‫tomi לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-tomi כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="8248265253516264921">‏אם אין לתמונה תיאור מועיל, tomi ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל tomi. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="8254601181414348851">‏להיכנס ל-tomi עם פרופיל חדש?</translation>
<translation id="8266560134891435528">‏tomi לא יכול לבדוק את הסיסמאות שלך כי לא נכנסת לחשבון</translation>
<translation id="8286943863733751221">‏<ph name="BEGIN_LINK" />ב-tomi מוצגות אזהרות<ph name="END_LINK" /> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="8318772038038596122">‏לפי הגדרת הארגון, tomi נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8330519371938183845">‏כניסה לחשבון תסנכרן ותתאים אישית את tomi בכל המכשירים שברשותך</translation>
<translation id="8340674089072921962">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-tomi</translation>
<translation id="8357820681460164151">‏כדי לגשת אל פריטים שונים בדפדפן tomi שלך מכל המכשירים, צריך להיכנס לחשבון ולהפעיל את הסנכרון</translation>
<translation id="8360718212975266891">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="8370517070665726704">‏Copyright <ph name="YEAR" /> tomi LLC.‎ כל הזכויות שמורות.</translation>
<translation id="8372327902843331129">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-tomi. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-tomi.</translation>
<translation id="837460953767177950">‏לאחר מכן יהיה עליך להפעיל מחדש את tomi.</translation>
<translation id="8397248745433792218">‏ההמלצה של tomi היא להסיר אותו. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" /></translation>
<translation id="8401454788024434101">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-tomi כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
