<translation id="8576826849825683917">‏מספר ארגונים מנהלים את tomi</translation>
<translation id="8586442755830160949">‏Copyright <ph name="YEAR" /> The tomi Authors. כל הזכויות שמורות.</translation>
<translation id="8608079656141766906">‏<ph name="BEGIN_BOLD" />איך אנחנו משתמשים בנתונים האלה:<ph name="END_BOLD" /> אתרים יכולים לשמור מידע ב-tomi לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="8619360774459241877">‏הפעלת tomi מתבצעת...</translation>
<translation id="8621669128220841554">‏ההתקנה נכשלה בשל שגיאה לא מזוהה. יש להוריד שוב את tomi.</translation>
<translation id="8648201657708811153">‏לא ניתן להגדיר את tomi for Testing כדפדפן ברירת המחדל.</translation>
<translation id="8697124171261953979">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את tomi או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="8704119203788522458">‏זהו ה-tomi שלך</translation>
<translation id="8719993436687031146">‏להיכנס אל tomi?</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="8796602469536043152">‏tomi זקוק להרשאת גישה אל המצלמה והמיקרופון בשביל האתר הזה</translation>
<translation id="8818550178040858407">‏להיכנס אל tomi?</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="8833697763442816810">‏מערכת tomiOS</translation>
<translation id="8846118132221683440">‏<ph name="BEGIN_BOLD" />באילו נתונים נעשה שימוש:<ph name="END_BOLD" /> היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות tomi במכשיר הזה.</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="8880203542552872219">‏אם שינית את הסיסמה הזו, יש לערוך את הסיסמה השמורה ב-tomi כך שהיא תתאים לסיסמה החדשה שלך.</translation>
<translation id="8907580949721785412">‏tomi מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="8931379085695076764">‏tomi יכול להעריך מהם תחומי העניין שלך על סמך היסטוריית הגלישה שלך מהשבועות האחרונים. המידע הזה נשאר במכשיר שלך.</translation>
<translation id="8941642502866065432">‏לא ניתן לעדכן את tomi</translation>
<translation id="897581876605952338">‏הלוגו של tomi Enterprise</translation>
<translation id="8986207147630327271">בחרת להוסיף פרופיל עבודה לדפדפן זה ולתת למנהל המערכת שליטה רק על פרופיל העבודה.</translation>
<translation id="8988036198400390003">‏ניהול הפרופילים ב-tomi</translation>
<translation id="9019929317751753759">‏כדי לשפר את האבטחה של tomi, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="9022552996538154597">‏כניסה אל tomi</translation>
<translation id="904366664621834601">‏‫tomi חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="9062666675513499497">‏כניסה אל tomi כשנכנסים לשירותי tomi אחרים</translation>
<translation id="907832235989677238">‏יש להיכנס אל tomi. אם רוצים להיכנס לחשבון באופן חד-פעמי בלבד, אפשר <ph name="GUEST_LINK_BEGIN" />להשתמש במכשיר כאורח<ph name="GUEST_LINK_END" />.</translation>
<translation id="9078733879136747090">‏tomi נסגר באופן אוטומטי</translation>
<translation id="9089354809943900324">‏tomi אינו מעודכן</translation>
<translation id="9093206154853821181">{0,plural, =1{‏tomi יופעל מחדש בעוד שעה}one{‏tomi יופעל מחדש בעוד # שעות}two{‏tomi יופעל מחדש בעוד # שעות}other{‏tomi יופעל מחדש בעוד # שעות}}</translation>
<translation id="9106612006984859720">‏כדי לקבל עדכונים של tomi בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="91086099826398415">‏פתיחת הקישור &amp;בכרטיסיית tomi חדשה</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="9144490074902256427">‏במהלך הפעולה של גרסאות הניסיון, תהיה לך אפשרות לראות ולהסיר את תחומי העניין שלפיהם האתרים הציגו לך את המודעות. ההערכה של תחומי העניין ב-tomi מתבססת על היסטוריית הגלישה שלך מהזמן האחרון.</translation>
<translation id="9158494823179993217">‏לפי הגדרת מנהל המערכת, tomi יפתח דפדפן חלופי כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="9185526690718004400">‏הפעלה מחדש לצורך עדכון &amp;tomi</translation>
<translation id="9190841055450128916">‏tomi ‏(mDNS-In)</translation>
<translation id="924957577793602335">‏אפשר להתאים אישית את tomi בדרך שנוחה לך</translation>
<translation id="93478295209880648">‏ייתכן ש-tomi לא יפעל כראוי כי הוא כבר לא נתמך ב-Windows XP וב-Windows Vista</translation>
<translation id="942598560705308788">‏אישורים שמנוהלים על ידי tomi</translation>
<translation id="965162752251293939">‏מי משתמש/ת ב-tomi?</translation>
<translation id="967427899662692980">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של tomi?</translation>
<translation id="983803489796659991">‏ההתקנה נכשלה כי שרת העדכון לא מכיל נתוני גיבוב (hash) של האפליקציה.</translation>
<translation id="985498048907240953">‏שימוש ב-tomi ללא חשבון</translation>
<translation id="985602178874221306">‏מחברי tomi</translation>
<translation id="992780518932311116">‏כדי להשתמש בשירותי המיקום, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-tomi גישה</translation>
</translationbundle>