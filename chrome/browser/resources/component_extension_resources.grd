        <include name="IDR_ARC_SUPPORT_UI_JS" file="chromeos/arc_support/ui.js" type="chrome_html" />
      </if>
      <include name="IDS_READING_MODE_DEFAULT_PNG" file="side_panel/read_anything/images/read_anything_default.png" type="BINDATA" />
      <include name="IDS_READING_MODE_LIGHT_PNG" file="side_panel/read_anything/images/read_anything_light.png" type="BINDATA" />
