{
  "manifest_version": 2,
  "name": "dVPN",
  "description": "Lelantos - Decentr VPN",
  "author": "Decentr",
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "icons": {
    "16": "assets/icons/16_active.png",
    "32": "assets/icons/32_active.png",
    "64": "assets/icons/64_active.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/icons/16_active.png",
      "32": "assets/icons/32_active.png",
      "64": "assets/icons/64_active.png"
    },
    "default_popup": "lelantos/index.html#",
    "default_title": "dVPN"
  },
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "unlimitedStorage",
    "<all_urls>",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "scripts/background-script.js"
    ]
  },
  "key": "",
  "minimum_chrome_version": "58",
  "version": "1.0.4"
}